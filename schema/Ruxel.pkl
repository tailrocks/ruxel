module Ruxel

// Runtime expressions are data: evaluation happens against each host's facts and results.
typealias Expr = Literal|Ref|Call|ListExpr|MapExpr|Lookup
class Literal { fixed kind = "literal"; value: Scalar? = null }
class Ref { fixed kind = "ref"; path: Listing<String> }
class Call { fixed kind = "call"; `function`: "eq"|"ne"|"lt"|"le"|"gt"|"ge"|"and"|"or"|"not"|"default"|"contains"|"length"|"concat"|"sha256"|"base64Encode"|"base64Decode"|"subelements"|"mapAttribute"|"bool"|"trim"|"join"|"urlencode"|"list"; args: Listing<Literal|Ref|Call|ListExpr|MapExpr|Lookup> }
class ListExpr { fixed kind = "list"; items: Listing<Literal|Ref|Call|ListExpr|MapExpr|Lookup> }
class MapExpr { fixed kind = "map"; entries: Mapping<String, Literal|Ref|Call|ListExpr|MapExpr|Lookup> }
class Lookup {
  fixed kind = "lookup"
  provider: "fnox"|"op"|"command"|"pipe"|"synthetic"
  key: String? = null
  vault: String? = null
  item: String? = null
  section: String? = null
  field: String? = null
  reference: String? = null
  argv: Listing<String>
}
typealias Scalar = String|Boolean|Int|Float
typealias Text = String|Expr
typealias Flag = Boolean|Expr
typealias NumberValue = Int(this >= 0)|Expr
typealias FileMode = String(matches(Regex("^[0-7]{3,4}$")))|Expr
typealias TextList = String|Listing<String>|Expr

class Host { address: String; port: Int(this >= 1 && this <= 65535) = 22; user: String? = null; vars: Mapping<String, Expr> }
class Group { hosts: Listing<String>; children: Listing<String>; vars: Mapping<String, Expr> }
class Inventory { hosts: Mapping<String, Host>; groups: Mapping<String, Group> }
class Config { inventory: Inventory; plays: Listing<Play> }
class Play {
  name: String
  targets: Listing<String>
  preTasks: Listing<Task>
  tasks: Listing<Task>
  handlers: Listing<Task>
  vars: Mapping<String, Expr>
  environment: Mapping<String, Expr>
  becomeUser: String? = null
}
class Task {
  name: String
  operation: Operation?(this != null && block.isEmpty || this == null && !block.isEmpty) = null
  `when`: Expr? = null
  `loop`: Expr? = null
  loopVar: String = "item"
  loopLabel: Expr? = null
  register: String? = null
  notify: Listing<String>
  tags: Listing<String>
  delegateTo: String? = null
  becomeUser: String? = null
  vars: Mapping<String, Expr>
  environment: Mapping<String, Expr>
  retries: Int(this >= 1) = 1
  delaySeconds: Int(this >= 0) = 0
  until: Expr? = null
  changedWhen: Expr? = null
  failedWhen: Expr? = null
  ignoreErrors: Boolean = false
  checkMode: Boolean? = null
  block: Listing<Task>
  rescue: Listing<Task>
  always: Listing<Task>
  noLog: Boolean = false
}
typealias Operation = Apt|AptRepository|AuthorizedKey|BlockInFile|Command|Copy|File|Filesystem|GetUrl|Git|SystemGroup|Firewall|LineInFile|Replace|Shell|Slurp|Stat|Sysctl|Service|User|VolumeGroup|LogicalVolume|Timezone|Mount|PostgresDatabase|PostgresRole|PostgresSchema|PostgresPrivileges|Template|Assert|Debug|Fail|Pause|SetFact

class Apt {
  fixed kind = "apt"
  autoremove: Flag? = null
  force: Flag? = null
  name: TextList? = null
  state: Text? = null
  update_cache: Flag? = null
  upgrade: Text? = null
}

class AptRepository {
  fixed kind = "apt_repository"
  filename: Text? = null
  repo: Text
  state: Text? = null
  update_cache: Flag? = null
}

class AuthorizedKey {
  fixed kind = "authorized_key"
  key: Text
  state: Text? = null
  user: Text
}

class BlockInFile {
  fixed kind = "blockinfile"
  block: Text? = null
  create: Flag? = null
  group: Text? = null
  mode: FileMode? = null
  owner: Text? = null
  path: Text
}

class Command {
  fixed kind = "command"
  argv: TextList? = null
  chdir: Text? = null
  cmd: Text?(this != null && argv == null || this == null && argv != null) = null
  creates: Text? = null
  removes: Text? = null
}

class Copy {
  fixed kind = "copy"
  content: Text? = null
  dest: Text
  force: Flag? = null
  group: Text? = null
  mode: FileMode? = null
  owner: Text? = null
  src: Text? = null
}

class File {
  fixed kind = "file"
  dest: Text? = null
  group: Text? = null
  mode: FileMode? = null
  owner: Text? = null
  path: Text? = null
  recurse: Flag? = null
  src: Text? = null
  state: Text? = null
}

class Filesystem {
  fixed kind = "filesystem"
  dev: Text
  fstype: "ext4"|"xfs"|Expr
  resizefs: Flag? = null
}

class GetUrl {
  fixed kind = "get_url"
  dest: Text
  url: Text
}

class Git {
  fixed kind = "git"
  accept_hostkey: Flag? = null
  dest: Text
  force: Flag? = null
  repo: Text
  update: Flag? = null
  version: Text? = null
}

class SystemGroup {
  fixed kind = "group"
  gid: NumberValue? = null
  name: Text
  state: Text? = null
}

class Firewall {
  fixed kind = "iptables"
  chain: Text
  comment: Text? = null
  destination: Text? = null
  ip_version: ("ipv4"|"ipv6"|Expr)? = null
  jump: Text? = null
  out_interface: Text? = null
  policy: Text? = null
  protocol: Text? = null
}

class LineInFile {
  fixed kind = "lineinfile"
  line: Text? = null
  path: Text
  regexp: Text? = null
  state: Text? = null
}

class Replace {
  fixed kind = "replace"
  path: Text
  regexp: Text
  replace: Text? = null
}

class Shell {
  fixed kind = "shell"
  argv: TextList? = null
  chdir: Text? = null
  cmd: Text?(this != null && argv == null || this == null && argv != null) = null
  creates: Text? = null
  executable: Text? = null
  removes: Text? = null
}

class Slurp {
  fixed kind = "slurp"
  src: Text
}

class Stat {
  fixed kind = "stat"
  follow: Flag? = null
  path: Text
}

class Sysctl {
  fixed kind = "sysctl"
  name: Text
  reload: Flag? = null
  state: Text? = null
  sysctl_file: Text? = null
  sysctl_set: Flag? = null
  value: Text? = null
}

class Service {
  fixed kind = "systemd"
  daemon_reload: Flag? = null
  enabled: Flag? = null
  name: Text? = null
  state: ("started"|"stopped"|"restarted"|Expr)? = null
}

class User {
  fixed kind = "user"
  append: Flag? = null
  comment: Text? = null
  create_home: Flag? = null
  group: Text? = null
  groups: TextList? = null
  home: Text? = null
  name: Text
  remove: Flag? = null
  shell: Text? = null
  state: Text? = null
  system: Flag? = null
  uid: NumberValue? = null
}

class VolumeGroup {
  fixed kind = "community.general.lvg"
  pvs: TextList? = null
  vg: Text
}

class LogicalVolume {
  fixed kind = "community.general.lvol"
  lv: Text
  resizefs: Flag? = null
  size: Text
  vg: Text
}

class Timezone {
  fixed kind = "community.general.timezone"
  name: Text
  state: Text? = null
}

class Mount {
  fixed kind = "ansible.posix.mount"
  fstype: Text? = null
  opts: Text? = null
  path: Text
  src: Text? = null
  state: Text? = null
}

class PostgresDatabase {
  fixed kind = "community.postgresql.postgresql_db"
  login_db: Text? = null
  login_port: NumberValue? = null
  login_user: Text? = null
  name: Text
  owner: Text? = null
  state: Text? = null
}

class PostgresRole {
  fixed kind = "community.postgresql.postgresql_user"
  login_db: Text? = null
  login_port: NumberValue? = null
  login_user: Text? = null
  name: Text
  password: Text? = null
  role_attr_flags: Text? = null
  state: Text? = null
}

class PostgresSchema {
  fixed kind = "community.postgresql.postgresql_schema"
  login_db: Text? = null
  login_port: NumberValue? = null
  login_user: Text? = null
  name: Text
  owner: Text? = null
  state: Text? = null
}

class PostgresPrivileges {
  fixed kind = "community.postgresql.postgresql_privs"
  login_db: Text? = null
  login_port: NumberValue? = null
  login_user: Text? = null
  objs: TextList? = null
  privs: TextList? = null
  role: Text
  schema: Text? = null
  state: Text? = null
  target_roles: TextList? = null
  type: Text
}

class Template {
  fixed kind = "template"
  content: Text? = null
  dest: Text
  force: Flag? = null
  group: Text? = null
  mode: FileMode? = null
  owner: Text? = null
  src: Text
}

class Assert {
  fixed kind = "assert"
  fail_msg: Text? = null
  that: TextList? = null
}

class Debug {
  fixed kind = "debug"
  msg: Text? = null
}

class Fail {
  fixed kind = "fail"
  msg: Text? = null
}

class Pause {
  fixed kind = "pause"
  prompt: Text? = null
  seconds: NumberValue? = null
  minutes: NumberValue? = null
}

class SetFact {
  fixed kind = "set_fact"
  values: Mapping<String, Expr>? = null
}
