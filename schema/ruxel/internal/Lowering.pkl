/// Lowers a workflow to the input of today's Ruxel engine,
/// `modulepath:/ruxel/engine/Engine.pkl`. Workflow authors never read this
/// file.
///
/// pklr shapes how this file is written. Each workaround names the pklr
/// limitation behind it:
///
/// - P3: expressions nest at most `max_depth` levels deep, 32 by default, and
///   every `let`, `else if`, call and lambda counts. ruxel asks for 256.
/// - P5: `outer.` resolves wrongly inside a constraint, so engine objects are
///   built by constructor functions whose inputs are parameters.
/// - P10: a nullable object property set at construction is still null in
///   the class's own defaults, so derived values live in methods.
/// - P11: a recursive module function is undefined inside a lambda, so
///   recursion goes through class methods (`Walker`, `Identity`).
/// - P12: `==` on some objects, such as hosts from an inventory module, does
///   not finish, so steps and hosts are compared by strings.
/// - P13: `.keys` on any object returns its property names.
/// - G16: a broken type constraint is reported without naming it, so rules
///   between fields are plain sentences thrown from here.
module Lowering

import "modulepath:/ruxel/Core.pkl" as core
import "modulepath:/ruxel/Debian.pkl" as debian
import "modulepath:/ruxel/Linux.pkl" as linux
import "modulepath:/ruxel/Systemd.pkl" as systemd
import "modulepath:/ruxel/engine/Engine.pkl" as engine

/// Replaced by the ruxel binary that serves this module, like the engine's
/// `Config.schemaFingerprint`.
hidden servedFingerprint: String = "unserved"

/// `workflowFingerprint` is the calling `Workflow.pkl`'s. The configuration
/// carries it as `languageFingerprint` when it matches this module's.
/// Otherwise one of the two is a copy, and it carries the copy's: a served
/// fingerprint ends in `@<nonce>`, a copy's does not. So admission refuses a
/// copy of either module, even an unmodified one, and names it as a copy.
function config(stages: Listing<core.Stage>, workflowFingerprint: String): engine.Config =
  let (copied = copiedClasses(stages.toList()))
  if (copied != null) throw(copied)
  else (configOf(hostsOf(stages), stages.toList(), checkedIndexes(stages))) {
    languageFingerprint = fingerprintOf(workflowFingerprint, servedFingerprint)
  }

/// pklr does not check the classes of list elements, so a stage or host
/// built from a copy of a layer module is refused here, like a copied
/// step in `Walker`.
function copiedClasses(stages: List<Any>): String? =
  if (stages.any((s) -> !(s is core.Stage))) copyMessage("stage")
  else if (stages.any((s) -> s.hosts.toList().any((h) -> !(h is core.Host)))) copyMessage("host")
  else null

/// `const` because `Walker.one` throws it: official Pkl lets a class body
/// reference only const module members (a class is not late bound), so
/// without this a copied step would be refused with a const error instead
/// of this message.
const function copyMessage(what: String): String =
  "A \(what)'s class comes from a copy of a ruxel layer module. Import the modules under \"modulepath:/ruxel/\", which the ruxel binary serves."

/// The served class of every step kind, by kind. A step of another class
/// is refused: a class copied from a layer module extends the served
/// `core.Step`, so it passes `is core.Step` and would lower as a generic
/// step of its kind, silently losing the class-specific handling — a
/// service's restart triggers, a package step's checks — and the class's
/// own rules.
///
/// Every kind the lowering lowers must name its class here, or a copy of
/// that class would lower as a generic step again.
const local canonicalClasses: Mapping<String, (core.Step) -> Boolean> = new {
  ["file"] = (s) -> s is core.File
  ["directory"] = (s) -> s is core.Directory
  ["symlink"] = (s) -> s is core.Symlink
  ["command"] = (s) -> s is core.Command
  ["script"] = (s) -> s is core.Script
  ["capture"] = (s) -> s is core.Capture
  ["fetchSecret"] = (s) -> s is core.FetchSecret
  ["recipe"] = (s) -> s is core.Recipe
  ["service"] = (s) -> s is systemd.Service
  ["systemdTimer"] = (s) -> s is systemd.SystemdTimer
  ["packageIndex"] = (s) -> s is debian.AptPackageIndex
  ["packages"] = (s) -> s is debian.AptPackages
  ["aptSystemUpgrade"] = (s) -> s is debian.AptSystemUpgrade
  ["aptPreference"] = (s) -> s is debian.AptPreference
  ["debconfEntry"] = (s) -> s is debian.DebconfEntry
  ["aptRepository"] = (s) -> s is debian.AptRepository
  ["timezone"] = (s) -> s is linux.Timezone
  ["user"] = (s) -> s is linux.User
  ["gitCheckout"] = (s) -> s is linux.GitCheckout
  ["sysctl"] = (s) -> s is linux.Sysctl
  ["group"] = (s) -> s is linux.Group
}

/// Whether the step's class is the served class of its kind, or a subclass
/// of it: a recipe of the workflow's own extends the served `Recipe`. A
/// kind no served class has is left to the lowering, which cannot lower it
/// either.
///
/// `const` because `Walker.one` calls it: official Pkl, unlike pklr, lets a
/// class body reference only const module members. The lookup stays legal
/// in a const context — `canonicalClasses` is const, so its stored checks
/// are const too.
const function canonicalStep(s: core.Step): Boolean =
  if (!canonicalClasses.containsKey(s.kind)) true
  else canonicalClasses[s.kind].apply(s)

function fingerprintOf(workflow: String, lowering: String): String =
  if (workflow == lowering) lowering
  else if (!workflow.contains("@")) workflow
  else if (!lowering.contains("@")) lowering
  else "\(workflow) with lowering \(lowering)"

/// Expands recipes, identifies every step and what it reacts to, merges
/// exact repeats, then indexes and checks each stage.
function checkedIndexes(stages: Listing<core.Stage>): List<StageIndex> =
  accepted(stages.toList(), stages.toList().map((s) -> stageIndex(merged(identified(walker.stage(s.steps.toList()))))))

function accepted(_stages: List<core.Stage>, _indexes: List<StageIndex>): List<StageIndex> =
  orFail(_indexes, positions(_indexes).flatMap((n) -> stageProblems(_stages[n], _indexes[n]))
    + heldMovesAcrossStages(_stages, _indexes)
    + preferenceOverlapAcrossStages(_stages, _indexes)
    + preferencePlanningAcrossStages(_stages, _indexes)
    + indexPlanningAcrossStages(_stages, _indexes)
    + repositoryPlanningAcrossStages(_stages, _indexes)
    + sysctlBootOrder(_stages, _indexes))

/// At boot the sysctl files load in file-name order: a later stage that
/// persists its value in a file sorting before an earlier stage's hands
/// the boot value back to the earlier stage — the live value follows the
/// stages, the boot value would not.
function sysctlBootOrder(_stages: List<core.Stage>, _indexes: List<StageIndex>): List<String> =
  positions(_indexes).flatMap((n) -> positions(_indexes).filter((m) -> m > n)
    .flatMap((m) -> bootClash(_stages[n], _indexes[n], _stages[m], _indexes[m])))

function bootClash(a: core.Stage, ia: StageIndex, b: core.Stage, ib: StageIndex): List<String> =
  let (pairs = sysctlsOf(ia).flatMap((x) -> sysctlsOf(ib)
    .filter((y) -> x.name == y.name && x.value != y.value && !(x.path <= y.path))
    .map((y) -> List(x, y))))
  if (pairs.isEmpty) List()
  else let (x = pairs.first.first) let (y = pairs.first.last)
    List("stages \"\(a.title)\" and \"\(b.title)\" set the sysctl \(x.name) to different values, and their files' boot order reverses them: \(x.path) loads after \(y.path) and hands the boot value back to stage \"\(a.title)\"; name the later stage's file so it sorts last, or use one file")

const function sysctlsOf(ix: StageIndex): List<core.Step> = ix.steps.filter((s) -> s is linux.Sysctl)

function orFail(_indexes: List<StageIndex>, _problems: List<String>): List<StageIndex> =
  if (_problems.isEmpty) _indexes.map((ix) -> withMetas(ix)) else throw(_problems.first)

// ── Inventory ───────────────────────────────────────────────────────────────

/// Every host a stage runs on or a capture reads from, once.
function hostsOf(stages: Listing<core.Stage>): List<core.Host> =
  stages.toList()
    .flatMap((s) -> s.hosts.toList() + captureHosts(flatten(s.steps.toList())) + fetchHosts(flatten(s.steps.toList())))
    .fold(List(), (seen, h) -> addHost(seen, h))

function captureHosts(steps: List<core.Step>): List<core.Host> =
  steps.filter((s) -> s is core.Capture && s.runOn != null).map((s) -> s.runOn)

/// The one host each FetchSecret reads from, which the inventory must name.
function fetchHosts(steps: List<core.Step>): List<core.Host> =
  steps.filter((s) -> s is core.FetchSecret).map((s) -> s.runOn)

/// Compares hosts by their settings. Not `==`: comparing objects from the
/// inventory module takes exponential time in pklr (P12).
function addHost(seen: List<core.Host>, h: core.Host): List<core.Host> =
  if (seen.any((x) -> x.name == h.name && signature(x) != signature(h))) throw("Host \(h.name) is declared twice with different settings")
  else if (seen.any((x) -> x.name == h.name)) seen
  else seen + List(h)

function signature(h: core.Host): String = fields(List(h.address, optional(h.sshHost), h.user, "\(h.port)"))

/// Encodes a nullable text so that `null` and the text "null" differ.
const function optional(v: String?): String = if (v == null) "-" else "+" + v

/// Encodes a list of texts unambiguously: each is prefixed with its length,
/// so no value, whatever characters it contains, can stand for two lists.
const function fields(values: List<String>): String = values.map((v) -> "\(v.length):\(v)").join("")

function configOf(_hosts: List<core.Host>, _stages: List<core.Stage>, _indexes: List<StageIndex>): engine.Config = new engine.Config {
  inventory { hosts { for (h in _hosts) { [h.name] = hostOf(h) } } }
  plays { for (n, s in _stages) { playOf(s.title, s.hosts.toList().map((h) -> h.name), _indexes[n]) } }
}

function hostOf(h: core.Host): engine.Host = new engine.Host {
  address = h.sshHost ?? h.address
  user = h.user
  port = h.port
  vars { ["ruxel_address"] = lit(h.address) }
}

// ── Stages ──────────────────────────────────────────────────────────────────

/// Facts about a stage's steps, computed once. pklr evaluates `let` eagerly,
/// so computing them here keeps later lookups shallow (P3).
class StageIndex {
  placed: List<Placed>
  steps: List<core.Step>
  /// Identity of each step. (Not `keys`: pklr reads `.keys` as an object's
  /// property names, P13.)
  ids: List<String>
  /// The engine result name of each step: its id, or for a repeated command,
  /// script, service or package step, its id and position.
  results: List<String>
  /// Positions of the steps each step reacts to: for each reference, every
  /// earlier step with that identity. A step that runs again where it is
  /// written has one result per run, and the reference fires when any run
  /// changed.
  deps: List<List<Int>>
  /// Positions of the captures whose output each step's content uses.
  uses: List<List<Int>>
  /// Task fields of each step; filled in by `withMetas` after the checks.
  metas: List<Meta> = List()
}

function stageIndex(_placed: List<Placed>): StageIndex = indexOf(_placed, _placed.map((p) -> p.step), _placed.map((p) -> p.id))

function indexOf(_placed: List<Placed>, _steps: List<core.Step>, _ids: List<String>): StageIndex =
  new StageIndex {
    placed = _placed
    steps = _steps
    ids = _ids
    results = positions(_steps).map((i) -> if (earlier(i).any((j) -> _ids[j] == _ids[i])) "\(_ids[i])_\(i)" else _ids[i])
    deps = positions(_steps).map((i) -> _placed[i].watches.flatMap((w) -> earlier(i).filter((j) -> _ids[j] == w)))
    uses = positions(_steps).map((i) -> found(_placed[i].reads.map((c) -> nearest(_ids, i, c))))
  }

/// The position of the last step before `i` with identity `id`.
function nearest(ids: List<String>, i: Int, id: String): Int? = earlier(i).fold(null, (hit, j) -> if (ids[j] == id) j else hit)

function found(hits: List<Int?>): List<Int> = hits.filter((j) -> j != null)

const function positions(list: List<Any>): List<Int> = if (list.isEmpty) List() else IntSeq(0, list.length - 1).toList()

function earlier(i: Int): List<Int> = if (i == 0) List() else IntSeq(0, i - 1).toList()

/// Only for a checked stage: every dependent comes after what it depends on.
function withMetas(ix: StageIndex): StageIndex =
  let (_tags = allTags(ix))
  let (_metas = positions(ix.steps).map((i) -> metaOf(ix, i, _tags[i])))
  (ix) { metas = _metas }

function stageProblems(s: core.Stage, ix: StageIndex): List<String> =
  (hostsTwice(s) + positions(ix.steps).flatMap((i) -> problemsAt(ix, i)) + repeatedCaptures(ix) + mixedTriggers(ix)).map((p) -> "Stage \"\(s.title)\": \(p)")

/// A capture runs once per stage, so every `stdout()` names exactly one
/// read, and a `local` holding a capture holds one value.
function repeatedCaptures(ix: StageIndex): List<String> =
  positions(ix.steps)
    .filter((j) -> ix.steps[j] is core.Capture && earlier(j).any((k) -> ix.ids[k] == ix.ids[j]))
    .map((j) -> let (k = earlier(j).filter((k) -> ix.ids[k] == ix.ids[j]).first)
      "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) repeats the capture at \(where(ix.placed[k])); a capture runs once per stage, so "
      + (if (listOf(ix.placed[j]) == listOf(ix.placed[k]))
          "list it once, or give a re-read after a change its own title"
        else "list it once in the stage and pass it to the recipe, which reads its stdout() without listing it, or give each read its own title (in a recipe used more than once, derive it from a parameter)"))

/// The list the author wrote the step in: "" for the stage's own steps, "1"
/// for the recipe at step 2, "1.0" for a recipe nested in it.
function listOf(p: Placed): String =
  positions(p.scope).filter((k) -> k < p.scope.length - 1).map((k) -> "\(p.scope[k])").join(".")

function hostsTwice(s: core.Stage): List<String> =
  let (names = s.hosts.toList().map((h) -> h.name))
  names.filter((n) -> names.filter((m) -> m == n).length > 1).toSet().toList().map((n) -> "host \(n) is listed twice")

function playOf(_title: String, _targets: List<String>, ix: StageIndex): engine.Play = new engine.Play {
  name = _title
  targets { for (t in _targets) { t } }
  tasks { for (i, _ in ix.steps) { for (t in lower(ix, i)) { t } } }
  handlers {
    for (n in restartedServices(ix.steps)) { restartHandler(n) }
    for (n in reloadedServices(ix.steps)) { reloadHandler(n) }
  }
}

/// One restart handler per service name, however many steps ask for it.
function restartedServices(steps: List<core.Step>): List<String> =
  steps.filter((x) -> x is systemd.Service && !x.restartOnChangeOf.isEmpty).map((x) -> x.name).toSet().toList()

/// One reload handler per service name, however many steps ask for it. A
/// service takes restart triggers or reload triggers, not both: the rule is
/// about the service, not about the step (`mixedTriggers`), so the two
/// lists never name the same service.
function reloadedServices(steps: List<core.Step>): List<String> =
  steps.filter((x) -> x is systemd.Service && !x.reloadOnChangeOf.isEmpty).map((x) -> x.name).toSet().toList()

/// A service takes restart triggers or reload triggers, not both. The rule
/// is about the service, not about the step: two steps that name the same
/// service, one with restart triggers and one with reload triggers, would
/// lower to two handlers for the same unit — a restart and a reload of one
/// unit, which the engine cannot carry out.
///
/// The steps are compared by the unit they name (`app` and `app.service`
/// are one unit), across the whole stage: a service takes one kind of
/// trigger wherever it is written.
function mixedTriggers(ix: StageIndex): List<String> =
  serviceUnits(ix).flatMap((unit) ->
    let (restarting = ix.steps.filter((s) -> s is systemd.Service && unitName(s.name) == unit && !s.restartOnChangeOf.isEmpty))
    let (reloading = ix.steps.filter((s) -> s is systemd.Service && unitName(s.name) == unit && !s.reloadOnChangeOf.isEmpty))
    if (restarting.isEmpty || reloading.isEmpty) List()
    else List("'\(restarting.first.name)' has both restartOnChangeOf and reloadOnChangeOf in this stage; a service takes restart triggers or reload triggers, not both"))

/// The units the stage's services name, once each.
function serviceUnits(ix: StageIndex): List<String> =
  ix.steps.filter((s) -> s is systemd.Service).map((s) -> unitName(s.name)).toSet().toList()

/// A step, the tags it inherits from the recipes around it, and where the
/// author wrote it.
class Placed {
  step: core.Step
  /// Filled in by `identified`, after the walk: computing it during the walk
  /// would exceed pklr's depth limit (P3).
  id: String = ""
  /// Ids of the steps this step reacts to, and of the captures it reads;
  /// filled in by `identified` like `id`.
  watches: List<String> = List()
  reads: List<String> = List()
  inherited: List<String>
  /// Position in `Stage.steps`, from 1.
  written: Int
  /// Positions through the nested recipe uses that contain the step, from
  /// the stage down; `scope.first + 1 == written`.
  scope: List<Int>
}

const function placedAt(_step: core.Step, _id: String, _inherited: List<String>, _written: Int, _scope: List<Int>): Placed =
  new Placed { step = _step; id = _id; inherited = _inherited; written = _written; scope = _scope }

function identified(placed: List<Placed>): List<Placed> =
  placed.map((p) -> identify(p, key(p.step), watched(p.step).map((w) -> key(w)), capturesUsed(p.step)))

function identify(p: Placed, _id: String, _watches: List<String>, _reads: List<String>): Placed =
  new Placed { step = p.step; id = _id; watches = _watches; reads = _reads; inherited = p.inherited; written = p.written; scope = p.scope }

function withInherited(q: Placed, extra: List<String>): Placed =
  new Placed { step = q.step; id = q.id; watches = q.watches; reads = q.reads; inherited = q.inherited + extra; written = q.written; scope = q.scope }

/// Expands recipes in place. A class, because pklr cannot call a recursive
/// module function inside a lambda (P11). Official Pkl, unlike pklr, lets a
/// class body reference only const module members, so every module member
/// this class calls is `const`.
class Walker {
  function stage(steps: List<core.Step>): List<Placed> =
    positions(steps).flatMap((i) -> this.one(steps[i], List(), i + 1, List(i)))

  /// The steps of a recipe use whose scope is `_scope`.
  function walk(steps: List<core.Step>, _inherited: List<String>, _written: Int, _scope: List<Int>): List<Placed> =
    positions(steps).flatMap((k) -> this.one(steps[k], _inherited, _written, _scope + List(k)))

  /// `_scope` ends with the step's own position in its list.
  function one(s: core.Step, _inherited: List<String>, _written: Int, _scope: List<Int>): List<Placed> =
    if (!(s is core.Step)) throw(copyMessage("step"))
    else if (!canonicalStep(s)) throw(copyMessage("step"))
    else if (s is core.Capture && s.runOn != null && !(s.runOn is core.Host)) throw(copyMessage("host"))
    else if (s is core.FetchSecret && !(s.runOn is core.Host)) throw(copyMessage("host"))
    else if (listed(s).any((w) -> !(w is core.Step) || !canonicalStep(w))) throw(copyMessage("step"))
    else if (s is core.Recipe && s.title != null) throw("A recipe takes no title: '\(s.title)'. Title its steps instead.")
    else if (s is core.Recipe) this.walk(s.steps().toList(), _inherited + s.tags.toList(), _written, _scope)
    else List(placedAt(s, "", _inherited, _written, _scope))
}

local walker = new Walker {}

function flatten(steps: List<core.Step>): List<core.Step> = walker.walk(steps, List(), 0, List()).map((p) -> p.step)

/// A step that manages a thing appears once per stage: an exact repeat lends
/// its tags to the first occurrence. Package steps, commands, scripts and
/// services run again where they are written; a capture is listed once
/// (`repeatedCaptures`).
function merged(placed: List<Placed>): List<Placed> = placed.fold(List(), (kept, p) -> mergeOne(kept, p))

function mergeOne(kept: List<Placed>, p: Placed): List<Placed> =
  if (!mergeable(p.step) || !kept.any((q) -> q.id == p.id)) kept + List(p)
  else kept.map((q) -> if (q.id == p.id) withInherited(sameStanza(q, p), ownTags(p)) else q)

/// The kept step of a merge. Two preferences that share the identity —
/// the package plus the pin (BB §3.7) — are one step, but their priorities
/// must then agree: the priority is not part of the identity, so a mismatch
/// would silently collapse the two stanzas into one and drop a priority.
function sameStanza(q: Placed, p: Placed): Placed =
  if (q.step is debian.AptPreference && p.step is debian.AptPreference && q.step.priority != p.step.priority)
    throw("'\(name(q.step))' (\(where(q))) and '\(name(p.step))' (\(where(p))) pin \(q.step.package) with \(q.step.pin) at different priorities (\(q.step.priority) and \(p.step.priority)); one stanza sets the priority of a package and a pin, so keep one priority or put the second in a later stage")
  else q

/// A step that manages a thing merges with an exact repeat. Package steps,
/// commands and scripts run again where they are written: their effect
/// depends on what ran before. Services are not merged either: each
/// occurrence carries its own restart triggers. A capture runs once per
/// stage (`repeatedCaptures`).
const function mergeable(s: core.Step): Boolean = !subjectsOf(s).isEmpty && !(s is systemd.Service)

// ── Checks: references must point at earlier steps of the same stage ───────

function problemsAt(ix: StageIndex, i: Int): List<String> =
  List(settings(ix.steps[i]), recipeDeps(ix, i), missingDeps(ix, i), silentDeps(ix, i), missingCaptures(ix, i), conflicts(ix, i), nested(ix, i), keyringModes(ix, i), sysctlFiles(ix, i), sysctlValues(ix, i), groupRels(ix, i), shellRels(ix, i), homeRemovals(ix, i), fileIdentities(ix, i), packageVersions(ix, i), holdConflicts(ix, i), preferenceConflicts(ix, i), pinUpgradeClashes(ix, i), preferencePlanning(ix, i), indexPlanning(ix, i), repositoryPlanning(ix, i)).flatMap((x) -> x)

/// Rules between fields of one step. Plain sentences rather than type
/// constraints: pklr reports a broken constraint without naming it (G16).
function settings(s: core.Step): List<String> =
  if (s is systemd.Service && !s.restartOnChangeOf.isEmpty && !s.reloadOnChangeOf.isEmpty)
    List("'\(name(s))' has both restartOnChangeOf and reloadOnChangeOf; a service takes restart triggers or reload triggers, not both")
  else if (s is systemd.Service && !s.running && !s.restartOnChangeOf.isEmpty)
    List("'\(name(s))' has running = false, so it cannot restart on a change; remove restartOnChangeOf or set running = true")
  else if (s is systemd.Service && !s.running && !s.reloadOnChangeOf.isEmpty)
    List("'\(name(s))' has running = false, so it cannot reload on a change; remove reloadOnChangeOf or set running = true")
  else if (s is systemd.SystemdTimer && s.onCalendar == null && s.onBoot == null)
    List("'\(name(s))' has no schedule: set onCalendar or onBoot")
  else if (s is systemd.SystemdTimer && s.onCalendar != null && (s.onCalendar.trim().isEmpty || s.onCalendar.contains("\n")))
    List("'\(name(s))': onCalendar must be a nonempty calendar expression on one line; a whitespace-only value is empty, and a line break would write another directive into the timer file")
  else if (s is systemd.SystemdTimer && s.persistent && s.onCalendar == null)
    List("'\(name(s))' is persistent, but only a calendar timer catches up: systemd remembers the last calendar run, not the last boot; set onCalendar, or persistent = false")
  else if (s is systemd.SystemdTimer && s.onBoot != null && onBootNegative(s.onBoot))
    List("'\(name(s))': onBoot \(s.onBoot) is negative; a timer fires after the boot, not before it")
  else if (s is systemd.SystemdTimer && s.onBoot != null && onBootTooLong(s.onBoot))
    List(onBootTooLongRefusal(s))
  else if (s is systemd.SystemdTimer && s.onBoot != null && onBootUntrusted(s.onBoot))
    List(onBootRefusal(s))
  else if (s is systemd.SystemdTimer && s.onBoot != null && onBootMicros(s.onBoot) == null)
    List(onBootRefusal(s))
  else if (s is systemd.SystemdTimer && s.service == null && s.name.length > 247)
    List("'\(name(s))': a timer name of \(s.name.length) characters without a service of its own would name the \(s.name.length + 8)-character unit \(timerTarget(s)), past systemd's 255; a timer name without a service may be at most 247 characters")
  else if (s is debian.AptRepository && s.components.isEmpty != s.suite.endsWith("/"))
    List(if (s.suite.endsWith("/")) "'\(name(s))': a flat repository (suite ending in /) takes no components" else "'\(name(s))': suite \(s.suite) needs components, such as \"main\"")
  else if (s is core.Action && s.changes is core.UnlessOutput && (s.changes.stdoutContains == null) == (s.changes.stderrContains == null))
    List("'\(name(s))': UnlessOutput takes exactly one of stdoutContains and stderrContains")
  else if (s is debian.AptPackages && !packageProblems(s.names.toList()).isEmpty)
    List("'\(name(s))': \(packageProblems(s.names.toList()).first)")
  else if (s is debian.AptPreference && !selectorProblems(s.package).isEmpty)
    List("'\(name(s))': \(selectorProblems(s.package).first)")
  else if (s is debian.AptPackages && s.hold && s.latest)
    List("'\(name(s))': a held package is never upgraded, so hold and latest cannot both be true; remove one of them")
  else if (s is debian.AptPackages && s.latest && s.names.toList().any((n) -> n.contains("=")))
    List("'\(name(s))': latest installs the newest version, so it cannot pin one (\(s.names.toList().filter((n) -> n.contains("=")).first)); remove the pin or set latest = false")
  else if (s is debian.AptRepository && s.suite.isEmpty)
    List("'\(name(s))': suite is empty; name a distribution such as \"stable\", or a path ending in / for a flat repository")
  else if (s is debian.AptRepository && !spaced(s).isEmpty)
    List("'\(name(s))': \(spaced(s).first) is written into the deb822 source, so it cannot contain spaces or line breaks")
  else if (s is core.Capture && (s.retry.delay < 1.s || s.retry.delay.toUnit("s").value.floor != s.retry.delay.toUnit("s").value))
    List("'\(name(s))': retry delay \(s.retry.delay) must be whole seconds, at least 1.s")
  else if (s is core.File && hasSecrets(s.content) && !secretMode(s.mode))
    List("'\(name(s))': \(s.path) holds a secret, so its mode must be 0600 or narrower, not \(s.mode)")
  else if (s is core.FetchSecret && !s.fnoxKey.matches(Regex("[A-Z][A-Z0-9_]{1,127}")))
    List("fnox key \"\(s.fnoxKey)\" is malformed: uppercase letters, digits and underscores only, starting with a letter, 2 to 128 characters")
  else if (s is debian.DebconfEntry && s.type == "password" && !(s.value is debian.SecretAnswer))
    List("'\(name(s))': a password's answer is a secret (debian.secretAnswer(…)), never static text; a literal password would be committed to the workflow and printed in the clear")
  else if (s is debian.DebconfEntry && s.type == "boolean" && !(s.value is debian.SecretAnswer) && s.value != "true" && s.value != "false")
    List("'\(name(s))': a boolean answer is \"true\" or \"false\", not \"\(s.value)\"; debconf frontends read those two strings alone")
  // `pklr` does not check the elements of a `Listing`, so the names of the
  // groups of an account are checked here: each one must be a user or group
  // name, with no NUL and no run-time value in it.
  else if (s is linux.User && !badAccountNames(s.group, s.groups).isEmpty)
    List("'\(name(s))': \"\(badAccountNames(s.group, s.groups.toList()).first)\" is not a user or group name")
  // The superuser's id is never a managed account's id, and an account
  // below UID 1000 is a system account the host keeps: it is never removed.
  // Removing an account therefore states its id, and the id is 1000 or more.
  // The root account itself keeps uid 0: changing it would disconnect the
  // root name from UID 0 and strand every file the superuser owns.
  else if (s is linux.User && s.uid != null && s.uid == 0)
    List("'\(name(s))': uid = 0 is rejected: the superuser's id is not for a managed account")
  else if (s is linux.User && s.user == "root" && s.uid != null)
    List("'\(name(s))': uid = \(s.uid) is rejected for root: the superuser's account keeps uid 0, and a change would strand every file it owns")
  // The superuser keeps its primary group too: a declared group on the
  // root account runs `usermod -g`, moving the superuser's primary group
  // away from the root group (gid 0) whatever the group is named.
  else if (s is linux.User && s.user == "root" && s.group != null)
    List("'\(name(s))': group = \(s.group) is rejected for root: the superuser keeps its primary group, the root group (gid 0)")
  else if (s is linux.User && s.state == "absent" && (s.user == "root" || s.uid == null || s.uid < 1000))
    List("'\(name(s))': state = \"absent\" is rejected for root and for an account below UID 1000; state the account's uid (1000 or more) to remove it")
  // userdel -r removes the home directory and mail spool, so a destructive
  // removal states which directory it takes with it.
  else if (s is linux.User && s.state == "absent" && s.removeHome && s.home == null)
    List("'\(name(s))': removeHome is rejected without home: removing a home directory states which one it is")
  // The root group's id is never a managed group's id, and the root group
  // itself is never removed: the account side refuses the superuser's id
  // and removal, and the group side refuses the superuser's primary group
  // the same way, for groupdel root strands every file root owns. The root
  // group itself keeps gid 0: changing it would detach every file owned by
  // numeric GID 0 from the root group.
  else if (s is linux.Group && s.gid != null && s.gid == 0)
    List("'\(name(s))': gid = 0 is rejected: the root group's id is not for a managed group")
  else if (s is linux.Group && s.name == "root" && s.gid != null)
    List("'\(name(s))': gid = \(s.gid) is rejected for root: the root group keeps gid 0, and a change would strand every file it owns")
  else if (s is linux.Group && s.state == "absent" && s.name == "root")
    List("'\(name(s))': state = \"absent\" is rejected for the root group: the superuser's primary group is the host's to keep")
  else List()

/// The agent's closed selector grammar, checked here so a workflow that could
/// never run fails before the run starts.
const local selector = Regex(#"([a-z0-9][a-z0-9+.-]+)(:([a-z0-9][a-z0-9-]*))?(=(([1-9][0-9]*:)?[0-9][A-Za-z0-9.+~-]*))?"#)

/// The names of an account that are not user or group names: the group the
/// account belongs to, and the other groups it belongs to. `pklr` does not
/// check the elements of a `Listing`, so they are checked here; a step
/// that states no supplementary groups has none to check.
const local function badAccountNames(group: String?, groups: Listing<String>?): List<String> =
  ((if (group == null) List() else List(group)) + (if (groups == null) List() else groups.toList()))
    .filter((n) -> !isAccountName(n))

/// Whether a string is a user or group name: the passwd spelling of one,
/// with no NUL and no run-time value in it.
const local function isAccountName(n: String): Boolean =
  n.matches(Regex("[a-z_][a-z0-9_-]{0,31}"))
    && !n.contains("\u{0}")
    && !n.contains("__ruxel_rt_8d41.")
    && !n.contains("__ruxel_secret_8d41.")

const function packageProblems(names: List<String>): List<String> =
  let (bad = names.filter((n) -> !n.matches(selector) || pseudoArch(n)))
  if (!bad.isEmpty) List("unsupported package \"\(bad.first)\"; use name, name=version, name:arch or name:arch=version, with an exact version and a real architecture (not any, native or all)")
  else
    let (repeated = names.map((n) -> packageName(n)).filter((p) -> let (same = names.filter((n) -> packageName(n) == p)) same.length > 1 && (same.any((n) -> archOf(n) == null) || same.map((n) -> archOf(n)).toSet().length != same.length)))
    if (repeated.isEmpty) List() else List("package \"\(repeated.first)\" is listed more than once; list it once, or once per explicit architecture")

/// A `PackageSelector` names the packages a preference applies to: a
/// name, a name with a real architecture or a trailing glob. A
/// pseudo-architecture names no real architecture, so it is refused, as it
/// is in a package step. A debconf answer takes a `DebconfPackage`
/// instead, whose exact-name type refuses the selector forms itself.
const function selectorProblems(selector: String): List<String> =
  if (!pseudoArch(selector)) List()
  else List("unsupported package \"\(selector)\"; use a name, a name with a real architecture (not any, native or all), or a trailing glob")

const function packageName(n: String): String = n.split("=").first.split(":").first
const function archOf(n: String): String? = let (s = n.split("=").first) if (s.contains(":")) s.split(":").last else null
const function pseudoArch(n: String): Boolean = let (a = archOf(n)) a != null && (List("any", "native", "all").contains(a) || a.split("-").contains("any"))

/// The first deb822 field value that contains whitespace.
const function spaced(r: debian.AptRepository): List<String> =
  List(List("url", r.url), List("suite", r.suite)).filter((f) -> hasSpace(f.last)).map((f) -> f.first)
    + (if (r.components.toList().any((c) -> c.isEmpty || hasSpace(c))) List("a component") else List())
    + (if (r.architectures.toList().any((a) -> a.isEmpty || hasSpace(a))) List("an architecture") else List())

const function hasSpace(text: String): Boolean = List(" ", "\t", "\n", "\r", "\u{b}", "\u{c}").any((c) -> text.contains(c))

/// Whether a text carries a secret reference (`module.fnox(…)`, …).
const function hasSecrets(text: String): Boolean = text.contains("__ruxel_secret_8d41.")

/// One octal digit of a file mode.
const function octal(digit: String): Int = "01234567".indexOf(digit)

/// A mode no wider than `0600`: nothing for group or other, no execute for
/// the owner — the modes a file with secret content may have. The rule reads
/// the last three digits, so the three- and four-digit spellings of one mode
/// (`600`, `0600`) are judged the same.
const function secretMode(mode: String): Boolean =
  List("0", "2", "4", "6").contains(mode.substring(mode.length - 3, mode.length - 2))
    && octal(mode.substring(mode.length - 2, mode.length - 1)) == 0
    && octal(mode.substring(mode.length - 1, mode.length)) == 0

/// The canonical four-digit spelling of a mode: Core accepts `600` and
/// `0600` as the same mode, so identity and emission read one mode, not one
/// spelling.
const function canonicalMode(mode: String): String =
  if (mode.length == 3) "0\(mode)" else mode

/// A recipe has no change of its own: name the steps that matter.
function recipeDeps(ix: StageIndex, i: Int): List<String> =
  listed(ix.steps[i]).filter((w) -> w is core.Recipe)
    .map((_) -> "'\(name(ix.steps[i]))' depends on a recipe; list the recipe's steps that matter instead")

function missingDeps(ix: StageIndex, i: Int): List<String> =
  positions(ix.placed[i].watches).filter((k) -> nearest(ix.ids, i, ix.placed[i].watches[k]) == null)
    .map((k) -> "'\(name(ix.steps[i]))' depends on '\(name(watched(ix.steps[i])[k]))', which is not an earlier step of this stage with exactly these settings")

function silentDeps(ix: StageIndex, i: Int): List<String> =
  watched(ix.steps[i]).filter((w) -> !canReportChange(w))
    .map((w) -> "'\(name(ix.steps[i]))' depends on '\(name(w))', which never reports a change")

function missingCaptures(ix: StageIndex, i: Int): List<String> =
  ix.placed[i].reads.filter((c) -> nearest(ix.ids, i, c) == null)
    .map((c) -> let (later = positions(ix.steps).filter((k) -> k > i && ix.ids[k] == c))
      if (later.isEmpty)
        "'\(name(ix.steps[i]))' (\(where(ix.placed[i]))) uses the output of a Capture that this stage does not list; list the capture earlier in the stage (a recipe that receives a capture as a parameter does not list it)"
      else
        "'\(name(ix.steps[i]))' (\(where(ix.placed[i]))) uses the output of '\(name(ix.steps[later.first]))', which comes later, at \(where(ix.placed[later.first])); list the capture before the step that reads it")

/// Two steps conflict when they manage the same thing with different
/// settings. Exact repeats were merged by `merged`; commands manage nothing.
function conflicts(ix: StageIndex, i: Int): List<String> =
  let (mine = subjectsOf(ix.steps[i]))
  earlier(i).filter((j) -> subjectsOf(ix.steps[j]).any((x) -> mine.contains(x)) && (ix.steps[j].kind != ix.steps[i].kind || identity.settings(ix.steps[j]) != identity.settings(ix.steps[i])))
    .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) both manage \(subjectsOf(ix.steps[j]).filter((x) -> mine.contains(x)).first)" + (if (ix.steps[j].kind != ix.steps[i].kind) ": \(withArticle(className(ix.steps[j]))) and \(withArticle(className(ix.steps[i])))" else " with different settings") + "; a stage declares one state for each thing, so put the second state in a later stage")

/// A regular file or a link leaves no room for anything inside it, so no
/// other step of the stage may manage a path beneath one. A Git checkout is
/// not such a leaf: steps may manage paths inside it that the repository
/// ignores (Oh My Zsh's `custom/plugins`), which no evaluation can tell
/// from tracked ones.
function nested(ix: StageIndex, i: Int): List<String> =
  earlier(i).flatMap((j) ->
    let (byEarlier = inside(leaves(ix.steps[j]), paths(ix.steps[i])))
    let (byLater = inside(leaves(ix.steps[i]), paths(ix.steps[j])))
    let (pair = if (byEarlier.isEmpty) byLater else byEarlier)
    if (pair.isEmpty) List()
    else List("'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) conflict: \(pair.first.first) is a file, so \(pair.first.last) cannot be inside it"))

/// Paths a step writes as a regular file or a link: its whole-file
/// subjects, and a sysctl's entry file — the entries are its subjects,
/// but the file it writes is a regular file of its own. A timer writes
/// its unit file, which is a regular file like any other.
const function leaves(s: core.Step): List<String> =
  if (s is linux.Sysctl) List(s.path)
  else if (List("file", "symlink", "aptRepository", "aptPreference", "systemdTimer").contains(s.kind)) subjectsOf(s)
  else List()

/// Apt repositories manage `/etc/apt/keyrings` (0755, one shared task), so
/// a `Directory` there would declare a second state for it.
function keyringModes(ix: StageIndex, i: Int): List<String> =
  earlier(i).filter((j) -> keyringClash(ix.steps[j], ix.steps[i]) || keyringClash(ix.steps[i], ix.steps[j]))
    .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) both manage /etc/apt/keyrings: apt repositories create it (0755), so remove the Directory")

const function keyringClash(a: core.Step, b: core.Step): Boolean =
  a is debian.AptRepository && b is core.Directory && b.path == "/etc/apt/keyrings"

/// A sysctl step manages the entries of the file at its `path`, never the
/// file itself, so any other step that manages the same path declares a
/// second state for the same file: whichever ran later would clobber the
/// other. The predicate is the step's path subjects, not a list of kinds:
/// a file, a directory, a link, a checkout, an apt repository's source or
/// keyring, a validate candidate — anything that names the path. Two
/// sysctl steps may share a file — each manages its own entry, and their
/// subjects are their names in it.
function sysctlFiles(ix: StageIndex, i: Int): List<String> =
  earlier(i).filter((j) -> sysctlClash(ix.steps[j], ix.steps[i]) || sysctlClash(ix.steps[i], ix.steps[j]))
    .map((j) -> let (p = if (ix.steps[j] is linux.Sysctl) ix.steps[j].path else ix.steps[i].path)
      "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) both manage the file \(p): a Sysctl manages the entries of the file, not the file itself, so give the sysctl its own path or move the other step to another stage")

const function sysctlClash(a: core.Step, b: core.Step): Boolean =
  a is linux.Sysctl && !(b is linux.Sysctl) && paths(b).contains(a.path)

/// The kernel holds one live value for one parameter: two sysctl steps of
/// one stage that ask for different values of one name would change it
/// back and forth on every apply — and disagree at boot, where file
/// precedence picks one — whatever files they persist in. Steps asking
/// for the same value are fine; each persists its own entry.
function sysctlValues(ix: StageIndex, i: Int): List<String> =
  if (!(ix.steps[i] is linux.Sysctl)) List()
  else earlier(i).filter((j) -> ix.steps[j] is linux.Sysctl && ix.steps[j].name == ix.steps[i].name && ix.steps[j].value != ix.steps[i].value)
    .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) ask for different values of the sysctl \(ix.steps[i].name) (\(ix.steps[j].value) and \(ix.steps[i].value)); the kernel holds one live value, so put the second value in a later stage")

/// An account needs the groups it names. A same-stage group step that
/// removes one contradicts the account whatever the order — one side ends
/// the stage needing a group the other removed — and one that creates it
/// must come first: the tasks run where the author wrote them, so a clean
/// host would run useradd -g before groupadd.
function groupRels(ix: StageIndex, i: Int): List<String> =
  let (u = ix.steps[i])
  if (!(u is linux.User)) List()
  else if (u.state == "present") requiredGroups(u).flatMap((n) -> positions(ix.steps)
    .filter((j) -> groupProvider(ix.steps[j], n))
    .flatMap((j) -> groupRel(ix, i, j, n)))
  // The inverse removal dependency: groupdel refuses a group that is
  // still an account's primary group, so the account removal runs first.
  else primaryGroup(u).flatMap((n) -> positions(ix.steps)
    .filter((j) -> j < i && ix.steps[j] is linux.Group && ix.steps[j].name == n && ix.steps[j].state == "absent")
    .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) removes the group \(n) before '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) removes the account that keeps it as its primary group; list the account removal first"))

/// The primary group of an account: the one it names, or the group
/// useradd creates with the login name when it names none.
const function primaryGroup(u: linux.User): List<String> =
  if (u.group != null) List(u.group) else List(u.user)

/// The groups a present account needs: its primary group and its
/// supplementary ones. A step that states no supplementary groups names
/// none.
const function requiredGroups(u: linux.User): List<String> =
  (if (u.group == null) List() else List(u.group)) + (if (u.groups == null) List() else u.groups.toList())

/// Whether the step provides the group `n`: a group step that names it,
/// or an account the host's useradd gives a group of its own name to
/// (USERGROUPS_ENAB) — the implicit group the footprint model claims
/// and the file-identity model resolves, here as an ordering provider:
/// `useradd -G bob alice` runs before a later `User { user = "bob" }`
/// has created the group it names.
const function groupProvider(s: core.Step, n: String): Boolean =
  (s is linux.Group && s.name == n) || (s is linux.User && s.user == n && s.group == null)

function groupRel(ix: StageIndex, i: Int, j: Int, n: String): List<String> =
  let (g = ix.steps[j])
  if (g is linux.Group && g.state == "absent")
    List("'\(name(ix.steps[i]))' (\(where(ix.placed[i]))) needs the group \(n), which '\(name(g))' (\(where(ix.placed[j]))) removes: an account cannot keep a removed group, so declare the group present or drop it from the account")
  else if (g is linux.User && g.state == "absent")
    List("'\(name(ix.steps[i]))' (\(where(ix.placed[i]))) needs the group \(n), which '\(name(g))' (\(where(ix.placed[j]))) removes: an account cannot keep a removed group, so declare the group present or drop it from the account")
  else if (j > i)
    List("'\(name(ix.steps[i]))' (\(where(ix.placed[i]))) needs the group \(n), which '\(name(g))' (\(where(ix.placed[j]))) \(if (g is linux.User) "creates with its account; list that account before this one" else "creates; list the group before the account")")
  else List()

/// A declared login shell must exist where the account's task runs:
/// `useradd` and `usermod` verify the shell path, so a same-stage `File`
/// or `Symlink` that manages it is the step that writes it — one that
/// comes after the account would fail an otherwise self-contained
/// workflow at apply time, though lowering preserves source order and
/// sees no relationship.
function shellRels(ix: StageIndex, i: Int): List<String> =
  let (u = ix.steps[i])
  if (!(u is linux.User) || u.state != "present" || u.shell == null) List()
  else positions(ix.steps)
    .filter((j) -> j > i && (ix.steps[j] is core.File || ix.steps[j] is core.Symlink) && paths(ix.steps[j]).contains(u.shell))
    .map((j) -> "'\(name(ix.steps[i]))' (\(where(ix.placed[i]))) names the shell \(u.shell), which '\(name(ix.steps[j]))' (\(where(ix.placed[j]))) manages; list the shell's step before the account")

/// A removal with `removeHome` deletes the home directory and everything
/// in it (`userdel -r`), so no step may manage a path at or inside it.
function homeRemovals(ix: StageIndex, i: Int): List<String> =
  earlier(i).flatMap((j) ->
    let (byEarlier = removedInside(ix.steps[j], paths(ix.steps[i])))
    let (byLater = removedInside(ix.steps[i], paths(ix.steps[j])))
    let (pair = if (byEarlier.isEmpty) byLater else byEarlier)
    if (pair.isEmpty) List()
    else List("'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) conflict: \(pair.first.first) is removed with the account's home directory, so \(pair.first.last) cannot be inside it"))

/// Pairs `(home, path)` where `path` is the removed home or lies inside it.
const function removedInside(a: core.Step, candidates: List<String>): List<List<String>> =
  let (h = (if (a is linux.User && a.state == "absent" && a.removeHome) a.home else null))
  if (h == null) List()
  else candidates.filter((p) -> p == h || p.startsWith(h + "/")).map((p) -> List(h, p))

/// A file resolves its owner and group by name: an identity a same-stage
/// step creates comes first — a clean host resolves no name before its
/// account or group exists — and an identity the same stage removes
/// cannot serve: the file would fail or keep unmapped numeric ownership.
function fileIdentities(ix: StageIndex, i: Int): List<String> =
  if (!(ix.steps[i] is core.File)) List()
  else ownerNeeds(ix.steps[i]).flatMap((p) -> positions(ix.steps)
    .filter((j) -> providerOf(ix.steps[j], p))
    .flatMap((j) -> identityRel(ix, i, j, p)))

/// The identities a file names: its owner (a user name) and its group.
const function ownerNeeds(f: core.File): List<List<String>> =
  (if (f.owner == null) List() else List(List(f.owner, "owner")))
    + (if (f.group == null) List() else List(List(f.group, "group")))

/// Whether the step provides the named identity: an account for an owner,
/// a group for a group — or the group useradd creates with the login name.
const function providerOf(s: core.Step, p: List<String>): Boolean =
  (p[1] == "owner" && s is linux.User && s.user == p[0])
    || (p[1] == "group" && ((s is linux.Group && s.name == p[0]) || (s is linux.User && s.user == p[0] && s.group == null)))

function identityRel(ix: StageIndex, i: Int, j: Int, p: List<String>): List<String> =
  let (g = ix.steps[j])
  if ((g is linux.User || g is linux.Group) && g.state == "absent")
    List("'\(name(ix.steps[i]))' (\(where(ix.placed[i]))) needs the \(p[1]) \(p[0]), which '\(name(g))' (\(where(ix.placed[j]))) removes: a file cannot use a removed identity, so declare it present or drop it from the file")
  else if (j > i)
    List("'\(name(ix.steps[i]))' (\(where(ix.placed[i]))) needs the \(p[1]) \(p[0]), which '\(name(g))' (\(where(ix.placed[j]))) creates; list the \(if (g is linux.User) "account" else "group") before the file")
  else List()

/// Two package steps of a stage must agree on a package's version: pins that
/// differ, or a pin and a `latest` step, would change it back and forth.
/// Exact repeats are fine. A selector without an architecture may be any.
function packageVersions(ix: StageIndex, i: Int): List<String> =
  if (!(ix.steps[i] is debian.AptPackages)) List()
  else earlier(i).filter((j) -> ix.steps[j] is debian.AptPackages).flatMap((j) ->
    let (clashes = ix.steps[i].names.toList().flatMap((a) -> ix.steps[j].names.toList().filter((b) -> versionClash(ix.steps[j], b, ix.steps[i], a)).map((b) -> List(b, a))))
    if (clashes.isEmpty) List()
    else List("'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) ask for different versions of \(packageName(clashes.first.first)) (\(clashes.first.first) and \(clashes.first.last)\(if (ix.steps[j].latest || ix.steps[i].latest) ", one upgrading" else "")); a stage declares one state for each thing, so put the second in a later stage"))

/// A held package is never moved: a step that holds a package and a later
/// step of the same stage that moves its version — `latest`, or a pin to a
/// version the hold does not name — would ask apt to move a frozen
/// package, which apt refuses. A plain install moves nothing (a held
/// package counts as installed), a repeat of the hold freezes it again,
/// and another architecture is another package, so only an overlapping
/// version movement is refused. A whole-system upgrade is a movement of
/// every package: the plain `dist-upgrade` apt-get runs without
/// `--ignore-hold` leaves the held package below its candidate, so the
/// declared whole-system result is false wherever a hold stands — drop
/// the hold or the upgrade.
function holdConflicts(ix: StageIndex, i: Int): List<String> =
  if (!(ix.steps[i] is debian.AptPackages || ix.steps[i] is debian.AptSystemUpgrade)) List()
  else earlier(i).filter((j) -> ix.steps[j] is debian.AptPackages && ix.steps[j].hold).flatMap((j) ->
    let (held = ix.steps[j].names.toList())
    let (moved = if (ix.steps[i] is debian.AptSystemUpgrade) List() else ix.steps[i].names.toList().filter((x) -> held.any((h) -> holdMove(ix.steps[i], h, x)) && !supersededInStage(ix, j, i, x)))
    if (ix.steps[i] is debian.AptSystemUpgrade)
      List("'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) holds \(held.first), and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) upgrades the whole system; a system upgrade moves every package to its candidate and cannot leave a held package behind, so drop the hold or the upgrade")
    else if (moved.isEmpty) List()
    else List("'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) holds \(moved.first), and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) would move it; a held package is never upgraded, so put the second in a later stage"))

/// Whether the later package step `i` moves the held name `h`: the same
/// package with an overlapping architecture, and a version movement —
/// `latest`, or a pin naming a version the hold does not (the hold froze
/// whatever was installed, so any pin may move it). Versions are compared
/// as Debian orders them, so one version spelled two ways (`1.01`, `1.1`)
/// moves nothing. A later `hold` step is not a mover: the agent lifts the
/// requested holds for that transaction alone, installs the new pin and
/// restores and verifies the hold (`install.rs`), so the step that
/// re-freezes the package may move it. The same-stage pair of two `hold`
/// steps for one package stays refused by `packageVersions`: one stage
/// declares one state for the package, while across stages the steps are
/// sequential plays and the later hold is the one transition that
/// re-freezes it.
const function holdMove(i: debian.AptPackages, h: String, n: String): Boolean =
  coversHold(h, n)
    && !i.hold
    && (i.latest || (versionOf(n) != null && !versionEqual(versionOf(n), versionOf(h))))

/// Whether one held name covers the other's package: the same package
/// with an overlapping architecture. Another architecture is another
/// package, and a name without an architecture is any of them.
const function coversHold(h: String, n: String): Boolean =
  packageName(h) == packageName(n)
    && (archOf(h) == null || archOf(n) == null || archOf(h) == archOf(n))

/// Whether a later hold supersedes the hold at step `j` for the name
/// `x` within the stage: a later hold step that covers `x` re-froze the
/// package at its own version, so the superseded hold no longer blocks a
/// movement of `x` — the effective hold does.
const function supersededInStage(ix: StageIndex, j: Int, i: Int, x: String): Boolean =
  positions(ix.steps).any((k) -> k > j && k < i
    && ix.steps[k] is debian.AptPackages && ix.steps[k].hold
    && ix.steps[k].names.toList().any((h) -> coversHold(h, x)))

/// Whether the hold at `(n, j)` still freezes `x` on some machine the
/// mover runs: supersession is tracked per shared machine, not by stage
/// order — a re-freeze on another host does not supersede this host's
/// hold. The re-pin and re-hold is the one supported transition that
/// moves a frozen package, so the freeze it leaves is the effective one
/// where it runs.
const function effectiveHold(_stages: List<core.Stage>, _indexes: List<StageIndex>, n: Int, j: Int, m: Int, i: Int, x: String): Boolean =
  _stages[n].hosts.toList().any((a) -> _stages[m].hosts.toList().any((b) -> sameConnection(a, b)
    && !supersededOn(_stages, _indexes, n, j, m, i, x, a)))

/// Whether a later hold step that covers `x` re-froze the package on the
/// machine `host` before the mover ran — including a hold in the mover's
/// own stage before the mover.
const function supersededOn(_stages: List<core.Stage>, _indexes: List<StageIndex>, n: Int, j: Int, m: Int, i: Int, x: String, host: core.Host): Boolean =
  positions(_indexes).any((n2) ->
    _stages[n2].hosts.toList().any((h2) -> sameConnection(h2, host))
      && positions(_indexes[n2].steps).any((j2) -> (n2 > n || (n2 == n && j2 > j)) && (n2 < m || (n2 == m && j2 < i))
        && _indexes[n2].steps[j2] is debian.AptPackages && _indexes[n2].steps[j2].hold
        && _indexes[n2].steps[j2].names.toList().any((h) -> coversHold(h, x))))

/// Whether two stages run on at least one common machine: holds and apt
/// preference fragments outlive the stage that wrote them, so the stages
/// collide wherever they share one. Hosts are one machine when they
/// connect alike — the effective SSH target (`sshHost`, or the address),
/// the user and the port decide, not the inventory name: an alias of the
/// same machine shares its apt state just the same.
const function hostsOverlap(a: core.Stage, b: core.Stage): Boolean =
  a.hosts.toList().any((x) -> b.hosts.toList().any((y) -> sameConnection(x, y)))

/// Whether two hosts open the same connection.
const function sameConnection(x: core.Host, y: core.Host): Boolean =
  (x.sshHost ?? x.address) == (y.sshHost ?? y.address) && x.user == y.user && x.port == y.port

/// The same refusal as `holdConflicts`, across stages of one host: a hold
/// is a mark on the package, and the mark outlives the stage that set it,
/// so a later stage that moves the held package asks apt to move a frozen
/// package just the same — and a later whole-system upgrade cannot leave
/// the held package behind and still deliver its declared result. Only
/// the order (hold, then move) collides — the reverse converges — and
/// only between stages whose hosts overlap.
function heldMovesAcrossStages(_stages: List<core.Stage>, _indexes: List<StageIndex>): List<String> =
  positions(_indexes).flatMap((m) -> earlier(m).filter((n) -> hostsOverlap(_stages[n], _stages[m])).flatMap((n) ->
    positions(_indexes[n].steps).filter((j) -> _indexes[n].steps[j] is debian.AptPackages && _indexes[n].steps[j].hold).flatMap((j) ->
      let (held = _indexes[n].steps[j].names.toList())
      let (upgraded = positions(_indexes[m].steps).filter((i) -> _indexes[m].steps[i] is debian.AptSystemUpgrade).map((i) ->
        "'\(name(_indexes[n].steps[j]))' (\(where(_indexes[n].placed[j]))) of stage \"\(_stages[n].title)\" holds \(held.first), and '\(name(_indexes[m].steps[i]))' (\(where(_indexes[m].placed[i]))) of stage \"\(_stages[m].title)\" upgrades the whole system; a system upgrade moves every package to its candidate and cannot leave a held package behind, and the hold outlives its stage, so drop the hold or the upgrade"))
      let (movedSteps = positions(_indexes[m].steps).filter((i) -> _indexes[m].steps[i] is debian.AptPackages).flatMap((i) ->
        let (moved = _indexes[m].steps[i].names.toList().filter((x) -> held.any((h) -> holdMove(_indexes[m].steps[i], h, x)) && effectiveHold(_stages, _indexes, n, j, m, i, x)))
        if (moved.isEmpty) List()
        else List("'\(name(_indexes[n].steps[j]))' (\(where(_indexes[n].placed[j]))) of stage \"\(_stages[n].title)\" holds \(moved.first), and '\(name(_indexes[m].steps[i]))' (\(where(_indexes[m].placed[i]))) of stage \"\(_stages[m].title)\" would move it; a held package is never upgraded, and the hold outlives its stage, so put the two stages on different hosts")))
      upgraded + movedSteps)))

const function versionClash(p: debian.AptPackages, a: String, q: debian.AptPackages, b: String): Boolean =
  packageName(a) == packageName(b)
    && (archOf(a) == null || archOf(b) == null || archOf(a) == archOf(b))
    && (versionOf(a) != null && versionOf(b) != null && !versionEqual(versionOf(a), versionOf(b))
      || versionOf(a) != null && q.latest
      || versionOf(b) != null && p.latest)

const function versionOf(n: String): String? = if (n.contains("=")) n.split("=").last else null

/// Whether two pins name one Debian version: `versionCompare` orders
/// them equal. A pin with no version is never equal to a pin with one:
/// an unversioned hold froze whatever the host has installed, so any pin
/// may move it — even `0`, whose digit run the ordering reads as the
/// empty string. This is the one comparison `versionClash` and
/// `holdMove` share, so the two rules cannot disagree about one
/// spelling.
const function versionEqual(a: String?, b: String?): Boolean =
  if (a == null || b == null) a == b else versionCompare(a, b) == 0

/// The Debian ordering of two versions (`[epoch:]upstream[-revision]`),
/// mirroring the agent's `apt_version.rs` (itself dpkg's `verrevcmp`),
/// which is the contract: the epoch compares numerically (an absent
/// epoch is `0`), the upstream and the revision compare character by
/// character — `~` sorts before everything, including the end of the
/// string, letters before other characters, digit runs numerically with
/// leading zeros insignificant — and an absent revision equals a zero
/// revision, so `1.0` and `1.0-0` are one version. Answers -1, 0 or 1.
const function versionCompare(a: String, b: String): Int =
  let (pa = versionSplit(a))
  let (pb = versionSplit(b))
  let (epoch = verrevcmp(pa[0], pb[0]))
  if (epoch != 0) epoch
  else let (upstream = verrevcmp(pa[1], pb[1]))
    if (upstream != 0) upstream else verrevcmp(pa[2], pb[2])

/// The three parts of a version. The epoch is the text before the first
/// colon (a text no digit parses to `0`, as `apt_version.rs`'s
/// `parse().unwrap_or(0)` reads it); the revision follows the last
/// hyphen of the rest, and an absent revision is the empty string.
const function versionSplit(v: String): List<String> =
  let (colons = v.split(":"))
  let (rest = if (colons.length < 2) v else IntSeq(1, colons.length - 1).toList().map((k) -> colons[k]).join(":"))
  let (hyphen = rest.split("-"))
  List(
    (if (colons.length < 2 || !colons.first.matches(Regex("[0-9]*"))) "" else colons.first),
    (if (hyphen.length < 2) rest else IntSeq(0, hyphen.length - 2).toList().map((k) -> hyphen[k]).join("-")),
    (if (hyphen.length < 2) "" else hyphen.last))

/// One `verrevcmp` walk over two components. `s` is
/// `(i, j, phase, first, result)`: the two positions, the phase (0 the
/// character loop, 1 and 2 the leading-zero skips, 3 the digit run, 4
/// the run's verdict, 5 done), the first differing digit and the result
/// once decided. Every step consumes what one loop turn of
/// `apt_version.rs` consumes, so the walk mirrors it turn for turn.
const function verrevcmp(a: String, b: String): Int =
  IntSeq(0, 2 * (a.length + b.length) + 12).toList()
    .fold(List(0, 0, 0, 0, 0), (s, _) -> verrevStep(a, b, s)).last

const function verrevStep(a: String, b: String, s: List<Int>): List<Int> =
  let (i = s.first)
  let (j = s[1])
  let (first = s[3])
  if (s[2] == 5) s
  else if (s[2] == 0)
    if ((i < a.length && !isDigit(a.substring(i, i + 1))) || (j < b.length && !isDigit(b.substring(j, j + 1))))
      let (cmp = orderCompare(orderAt(a, i), orderAt(b, j)))
      if (cmp != 0) List(i, j, 5, first, cmp) else List(i + 1, j + 1, 0, first, 0)
    else List(i, j, 1, first, 0)
  else if (s[2] == 1)
    if (i < a.length && a.substring(i, i + 1) == "0") List(i + 1, j, 1, first, 0) else List(i, j, 2, first, 0)
  else if (s[2] == 2)
    if (j < b.length && b.substring(j, j + 1) == "0") List(i, j + 1, 2, first, 0) else List(i, j, 3, first, 0)
  else if (s[2] == 3)
    if (i < a.length && j < b.length && isDigit(a.substring(i, i + 1)) && isDigit(b.substring(j, j + 1)))
      List(i + 1, j + 1, 3, (if (first != 0) first else digitCompare(a.substring(i, i + 1), b.substring(j, j + 1))), 0)
    else List(i, j, 4, first, 0)
  else if (i < a.length && isDigit(a.substring(i, i + 1))) List(i, j, 5, first, 1)
  else if (j < b.length && isDigit(b.substring(j, j + 1))) List(i, j, 5, first, -1)
  else if (first != 0) List(i, j, 5, first, first)
  else if (i >= a.length && j >= b.length) List(i, j, 5, first, 0)
  else List(i, j, 0, first, 0)

const function isDigit(c: String): Boolean = "0123456789".contains(c)

/// The character's weight in the character loop: `apt_version.rs`'s
/// `order` reads a digit or the end of the string as `0`, `~` as -1, a
/// letter as itself and anything else above every letter. A digit is
/// never compared here — both positions at digits end the loop — so its
/// weight only meets a real character, where it plays the end of the
/// string.
const function orderAt(s: String, i: Int): String =
  if (i >= s.length) "" else let (c = s.substring(i, i + 1)) if (isDigit(c)) "" else c

const local letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const local others = ##"!"#$%&'()*+,-./:;<=>?@[\]^_`{|}"##

/// How two weights order: `~` before the end of the string before
/// letters before others, and one weight equal to itself.
const function orderCompare(x: String, y: String): Int =
  if (orderRank(x) != orderRank(y)) (if (orderRank(x) < orderRank(y)) -1 else 1)
  else if (x == y) 0
  else let (table = if (letters.contains(x)) letters else others)
    (if (table.indexOf(x) < table.indexOf(y)) -1 else 1)

const function orderRank(z: String): Int =
  if (z == "~") 0 else if (z == "") 1 else if (letters.contains(z)) 2 else 3

/// One digit's weight in the first differing digit of a run.
const function digitCompare(x: String, y: String): Int =
  if (x == y) 0 else (if ("0123456789".indexOf(x) < "0123456789".indexOf(y)) -1 else 1)

/// Two preference stanzas whose selectors can name one package declare
/// two states for it: apt_preferences(5) applies every matching stanza,
/// so the higher priority would decide silently. A second stanza for one
/// and the same selector is the `conflicts` pass's business; here the
/// selectors differ and only overlap.
function preferenceConflicts(ix: StageIndex, i: Int): List<String> =
  if (!(ix.steps[i] is debian.AptPreference)) List()
  else earlier(i).filter((j) -> ix.steps[j] is debian.AptPreference && ix.steps[j].package != ix.steps[i].package && selectorsOverlap(ix.steps[j].package, ix.steps[i].package))
    .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) pin overlapping package selectors (\(ix.steps[j].package) and \(ix.steps[i].package)); apt applies every matching stanza and the highest priority decides, so keep one selector or put the second in a later stage")

/// The same collision as `preferenceConflicts`, across stages of one host:
/// the fragment each stage writes persists in /etc/apt/preferences.d/, and
/// apt applies every matching stanza. One and the same selector stays the
/// `conflicts` pass's business; here the selectors differ and only overlap.
function preferenceOverlapAcrossStages(_stages: List<core.Stage>, _indexes: List<StageIndex>): List<String> =
  positions(_indexes).flatMap((m) -> earlier(m).filter((n) -> hostsOverlap(_stages[n], _stages[m])).flatMap((n) ->
    positions(_indexes[n].steps).filter((j) -> _indexes[n].steps[j] is debian.AptPreference).flatMap((j) ->
      positions(_indexes[m].steps).filter((i) -> _indexes[m].steps[i] is debian.AptPreference && _indexes[m].steps[i].package != _indexes[n].steps[j].package && selectorsOverlap(_indexes[n].steps[j].package, _indexes[m].steps[i].package)).map((i) ->
        "'\(name(_indexes[n].steps[j]))' (\(where(_indexes[n].placed[j]))) of stage \"\(_stages[n].title)\" and '\(name(_indexes[m].steps[i]))' (\(where(_indexes[m].placed[i]))) of stage \"\(_stages[m].title)\" pin overlapping package selectors (\(_indexes[n].steps[j].package) and \(_indexes[m].steps[i].package)); apt applies every matching stanza and the highest priority decides, so keep one selector or put the two stages on different hosts")
      )))

/// A whole-system upgrade moves every package to its candidate, so an
/// exact version pin in the same stage cannot hold: the upgrade moves the
/// package away from the declared pin — and a later apply of the pin may
/// even refuse the downgrade — so the stage cannot converge. The two
/// never belong in one stage, in either order.
function pinUpgradeClashes(ix: StageIndex, i: Int): List<String> =
  if (ix.steps[i] is debian.AptSystemUpgrade)
    earlier(i).flatMap((j) ->
      if (!(ix.steps[j] is debian.AptPackages)) List()
      else let (pinned = ix.steps[j].names.toList().filter((n) -> versionOf(n) != null))
        if (pinned.isEmpty) List()
        else List("'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) pins \(pinned.first), and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) upgrades the whole system; a system upgrade moves the package away from the declared pin, so put the two in different stages"))
  else if (ix.steps[i] is debian.AptPackages && ix.steps[i].names.toList().any((n) -> versionOf(n) != null))
    earlier(i).filter((j) -> ix.steps[j] is debian.AptSystemUpgrade)
      .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) upgrades the whole system, and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) pins \(ix.steps[i].names.toList().filter((n) -> versionOf(n) != null).first); a system upgrade moves the package away from the declared pin, so put the two in different stages")
  else List()

/// A preference stanza is written with the generic copy task, which in
/// `check` and `diff` writes nothing: a later package step or system
/// upgrade of the same stage then plans against the candidate policy the
/// host still has, while apply mode plans against the stanza just
/// written. A plain install is such a plan too: it resolves every package
/// it may not find installed against the candidate of that policy, so a
/// stanza that leaves a package without a candidate makes apply fail
/// where check reported a pending install. Check and apply would
/// disagree, so the combination is refused. Only an earlier preference is
/// a problem: a preference written after the plan reads nothing the plan
/// needed.
function preferencePlanning(ix: StageIndex, i: Int): List<String> =
  if (!(ix.steps[i] is debian.AptPackages || ix.steps[i] is debian.AptSystemUpgrade)) List()
  else earlier(i).filter((j) -> ix.steps[j] is debian.AptPreference)
    .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) writes an apt preference, and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) plans against the candidate policy; in check and diff mode the preference is never written before the plan runs, so check and apply disagree — put the two in different stages")

/// The same refusal as `preferencePlanning`, across stages of one host:
/// the host has one apt policy, and the fragment the earlier stage writes
/// outlives the stage, so splitting the steps across stages does not
/// separate them — the stage-local advice cannot apply here. Check and
/// diff skip the Copy that writes the stanza in every stage, so the later
/// stage plans against the candidate policy the host still has, while
/// apply writes the preference in the earlier play first. The stages must
/// not share a host.
function preferencePlanningAcrossStages(_stages: List<core.Stage>, _indexes: List<StageIndex>): List<String> =
  positions(_indexes).flatMap((m) -> earlier(m).filter((n) -> hostsOverlap(_stages[n], _stages[m])).flatMap((n) ->
    positions(_indexes[n].steps).filter((j) -> _indexes[n].steps[j] is debian.AptPreference).flatMap((j) ->
      positions(_indexes[m].steps).filter((i) -> _indexes[m].steps[i] is debian.AptPackages || _indexes[m].steps[i] is debian.AptSystemUpgrade).map((i) ->
        "'\(name(_indexes[n].steps[j]))' (\(where(_indexes[n].placed[j]))) of stage \"\(_stages[n].title)\" writes an apt preference, and '\(name(_indexes[m].steps[i]))' (\(where(_indexes[m].placed[i]))) of stage \"\(_stages[m].title)\" plans against the candidate policy; in check and diff mode the preference is never written before the plan runs, so check and apply disagree — put the two stages on different hosts")
      )))

/// The package index is refreshed by a task that never reports a change
/// and runs only in apply, so a system upgrade after it simulates
/// `dist-upgrade` in check and diff against the package lists the host
/// already has, while apply refreshes first and can move versions that
/// only appeared in the refresh. Check and apply would disagree, so the
/// combination is refused. Only an earlier refresh is a problem: a
/// refresh written after the upgrade reads the same lists the upgrade
/// moved.
function indexPlanning(ix: StageIndex, i: Int): List<String> =
  if (!(ix.steps[i] is debian.AptSystemUpgrade)) List()
  else earlier(i).filter((j) -> ix.steps[j] is debian.AptPackageIndex)
    .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) refreshes the package index, and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) plans against the package lists the host already has; in check and diff mode the index is never refreshed before the plan runs, so check and apply disagree — put the two in different stages")

/// A repository is written with the generic copy task, which in `check`
/// and `diff` writes nothing: a system upgrade after it simulates
/// `dist-upgrade` against the candidates the old source or suite still
/// names, while apply writes the `.sources` file first and can move
/// versions the new one offers. Check and apply would disagree, so the
/// combination is refused. Only an earlier repository is a problem: a
/// repository written after the upgrade reads the same candidates the
/// upgrade moved.
function repositoryPlanning(ix: StageIndex, i: Int): List<String> =
  if (!(ix.steps[i] is debian.AptPackages || ix.steps[i] is debian.AptSystemUpgrade)) List()
  else earlier(i).filter((j) -> ix.steps[j] is debian.AptRepository)
    .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) writes an apt repository, and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) plans against the candidate policy; in check and diff mode the repository is never written before the plan runs, so check and apply disagree — put the two in different stages")

/// The same refusal as `indexPlanning`, across stages of one host: the
/// lists the earlier stage refreshes outlive the stage, so splitting the
/// steps across stages does not separate them — the stage-local advice
/// cannot apply here. Check and diff skip the index command in every
/// stage, so the later stage simulates `dist-upgrade` against the package
/// lists the host already has, while apply refreshes the lists in the
/// earlier play first and can move versions that only appeared in the
/// refresh. The stages must not share a host.
function indexPlanningAcrossStages(_stages: List<core.Stage>, _indexes: List<StageIndex>): List<String> =
  positions(_indexes).flatMap((m) -> earlier(m).filter((n) -> hostsOverlap(_stages[n], _stages[m])).flatMap((n) ->
    positions(_indexes[n].steps).filter((j) -> _indexes[n].steps[j] is debian.AptPackageIndex).flatMap((j) ->
      positions(_indexes[m].steps).filter((i) -> _indexes[m].steps[i] is debian.AptSystemUpgrade).map((i) ->
        "'\(name(_indexes[n].steps[j]))' (\(where(_indexes[n].placed[j]))) of stage \"\(_stages[n].title)\" refreshes the package index, and '\(name(_indexes[m].steps[i]))' (\(where(_indexes[m].placed[i]))) of stage \"\(_stages[m].title)\" plans against the package lists the host already has; in check and diff mode the index is never refreshed before the plan runs, so check and apply disagree — put the two stages on different hosts")
      )))

/// The same refusal as `repositoryPlanning`, across stages of one host:
/// the `.sources` file the earlier stage writes outlives the stage, so
/// the later stage's simulation still runs against the candidates the
/// host had while apply wrote the repository first. The stages must not
/// share a host.
function repositoryPlanningAcrossStages(_stages: List<core.Stage>, _indexes: List<StageIndex>): List<String> =
  positions(_indexes).flatMap((m) -> earlier(m).filter((n) -> hostsOverlap(_stages[n], _stages[m])).flatMap((n) ->
    positions(_indexes[n].steps).filter((j) -> _indexes[n].steps[j] is debian.AptRepository).flatMap((j) ->
      positions(_indexes[m].steps).filter((i) -> _indexes[m].steps[i] is debian.AptPackages || _indexes[m].steps[i] is debian.AptSystemUpgrade).map((i) ->
        "'\(name(_indexes[n].steps[j]))' (\(where(_indexes[n].placed[j]))) of stage \"\(_stages[n].title)\" writes an apt repository, and '\(name(_indexes[m].steps[i]))' (\(where(_indexes[m].placed[i]))) of stage \"\(_stages[m].title)\" plans against the candidate policy; in check and diff mode the repository is never written before the plan runs, so check and apply disagree — put the two stages on different hosts")
      )))

/// Whether two package selectors can name one package: an unarchived
/// selector covers the package on every architecture, so the
/// architectures must not clash, and the names must overlap.
const function selectorsOverlap(a: String, b: String): Boolean =
  (archOf(a) == null || archOf(b) == null || archOf(a) == archOf(b)) && nameOverlap(a, b)

/// The names of two selectors overlap when either one's trailing glob
/// (BB §13 knows no other) matches the other's name, or when both spell
/// one name. Every glob match is a prefix match, so no regex support of
/// either evaluator is needed.
const function nameOverlap(a: String, b: String): Boolean =
  let (x = baseOf(a))
  let (y = baseOf(b))
  (if (a.endsWith("*") && b.endsWith("*")) x.startsWith(y) || y.startsWith(x)
  else if (a.endsWith("*")) y.startsWith(x)
  else if (b.endsWith("*")) x.startsWith(y)
  else x == y)

/// The package name of a selector: without its trailing glob and without
/// its architecture (`ba*` is `ba`, `bash:amd64` is `bash`).
const function baseOf(s: String): String = packageName(if (s.endsWith("*")) s.substring(0, s.length - 1) else s)

/// The paths a step manages as file-system things: its path-bearing
/// subjects, and a sysctl's entry file.
const function paths(s: core.Step): List<String> =
  subjectsOf(s).filter((x) -> x.startsWith("/")) + (if (s is linux.Sysctl) List(s.path) else List())

/// Pairs `(file, path)` where `path` lies beneath `file`.
const function inside(files: List<String>, candidates: List<String>): List<List<String>> =
  files.flatMap((f) -> candidates.filter((p) -> p.startsWith(f + "/")).map((p) -> List(f, p)))

function className(s: core.Step): String = s.kind.capitalize()

function withArticle(word: String): String = (if ("AEIOU".contains(word.take(1))) "an " else "a ") + word

/// Where the author wrote a step: `step 2`, `step 4 of the recipe at step 1`,
/// or `step 2 of the recipe at step 3 of the recipe at step 1`.
function where(p: Placed): String =
  positions(p.scope).fold("", (acc, k) ->
    if (k == 0) "step \(p.scope[0] + 1)" else "step \(p.scope[k] + 1) of the recipe at " + acc)

/// Steps listed in `onChangeOf`, `restartOnChangeOf` or `reloadOnChangeOf`, as
/// written.
const function listed(s: core.Step): List<core.Step> =
  if (s is core.Action) s.onChangeOf.toList()
  else if (s is systemd.Service) s.restartOnChangeOf.toList() + s.reloadOnChangeOf.toList()
  else List()

/// Steps whose change this step reacts to. Recipes are rejected by
/// `recipeDeps`.
function watched(s: core.Step): List<core.Step> = listed(s).filter((w) -> !(w is core.Recipe))

function canReportChange(s: core.Step): Boolean =
  !(s is core.Capture || s is debian.AptPackageIndex || (s is core.Action && s.changes == "never"))

/// Ids of the captures whose output this step's content uses.
function capturesUsed(s: core.Step): List<String> =
  if (s is core.File) placeholder.findMatchesIn(s.content).map((m) -> m.groups[1].value)
    .filter((p) -> p.startsWith("results.")).map((p) -> p.split(".")[1])
  else List()

// ── Identity, names and tags ────────────────────────────────────────────────

/// A step's identity: its kind and every setting that shapes its tasks. For
/// a command or script that includes, recursively, the identity of every
/// step it reacts to. For a step that does not merge (`mergeable`) it
/// includes the step's line in the plan; for a step that merges it does not.
/// Steps are never compared with `==` (P12).
function key(s: core.Step): String = identity.key(s)

/// A class, like `Walker`: pklr cannot recurse through a module function
/// inside a lambda (P11). Settings are encoded with `fields`, so no two
/// different settings print alike.
class Identity {
  function key(s: core.Step): String =
    // 128 bits: no one can make two different steps share an identity.
    if (s is core.Capture) s.id() else "\(s.kind)_" + this.fingerprint(s).sha256.substring(0, 32)

  function fingerprint(s: core.Step): String =
    (if (mergeable(s)) "" else fields(List(label(s)))) + this.settings(s)

  function settings(s: core.Step): String =
    if (!(s is core.Action)) stateFingerprints[s.kind].apply(s)
    // The recursive part, the keys of the steps this one reacts to, stays
    // outside `fields`: every level counts against pklr's depth limit along
    // a chain. Keys are generated (`<kind>_<hex>`), so a plain join after the
    // self-delimiting fields is unambiguous.
    else fields(List(if (s is core.Command) fields(s.run.toList()) else s.bash, optional(s.creates), changesText(s))) + envFingerprint(s)
      + listed(s).map((w) -> if (w is core.Recipe) "recipe" else this.key(w)).join(",")
}

/// A command's environment in its identity: two commands that differ only in
/// their environment are different steps. Entries in canonical key order —
/// the same pairs in another declaration order are one action — and a value
/// as its text (`SecretText.toString()` is the reference placeholder, which
/// no static text can contain, so the two cannot collide).
const function envFingerprint(s: core.Step): String =
  if (!(s is core.Action)) ""
  else keyOrder.canonical(s.environment.keys.toList()).map((k) -> fields(List(k, s.environment[k].toString()))).join("")

local identity = new Identity {}

/// Canonical key order for a fingerprint: declaration order is an accident
/// of authoring, so the same mapping written in another order must
/// fingerprint alike. pklr has no `sort`, so this is an insertion sort; the
/// keys are validated (`EnvKey` is `[A-Za-z_][A-Za-z0-9_]*`), so plain
/// string comparison is the one order both evaluators agree on. A class,
/// like `Walker`: pklr cannot recurse through a module function inside a
/// lambda (P11); every module member it calls is `const`, which official Pkl
/// requires of a class body.
class KeyOrder {
  function canonical(keys: List<String>): List<String> =
    keys.fold(List(), (sorted, key) -> this.insert(key, sorted))

  /// The entries as one canonical set: sorted, with a repeat dropped. The
  /// groups of an account are a set — the engine sorts and deduplicates the
  /// supplementary groups it reconciles — so the same members in another
  /// order, or spelled with a repeat, are one state, not two.
  function set(entries: List<String>): List<String> =
    this.unique(this.canonical(entries))

  function unique(sorted: List<String>): List<String> =
    positions(sorted).filter((i) -> i == 0 || sorted[i] != sorted[i - 1]).map((i) -> sorted[i])

  function insert(key: String, sorted: List<String>): List<String> =
    if (sorted.isEmpty || key <= sorted.first)
      List(key) + sorted
    else List(sorted.first) + this.insert(key, this.tail(sorted))

  /// pklr has no `drop`; the tail is rebuilt by position.
  function tail(sorted: List<String>): List<String> =
    positions(sorted).filter((i) -> i > 0).map((i) -> sorted[i])
}

const local keyOrder = new KeyOrder {}

const local stateFingerprints: Mapping<String, (core.Step) -> String> = new {
  ["file"] = (s) -> fields(List(s.path, s.content.sha256, canonicalMode(s.mode), optional(s.owner), optional(s.group), fields(s.validate.toList())))
  ["fetchSecret"] = (s) -> fields(List(s.fromPath, s.runOn.name, s.fnoxKey))
  ["directory"] = (s) -> fields(List(s.path, canonicalMode(s.mode)))
  ["symlink"] = (s) -> fields(List(s.path, s.target))
  ["packageIndex"] = (_) -> ""
  ["packages"] = (s) -> fields(List(fields(s.names.toList()), "\(s.latest)", "\(s.hold)"))
  ["aptSystemUpgrade"] = (s) -> "\(s.autoremove)"
  // Identity is the package plus the pin (BB §3.7): the priority is not
  // part of it, so a repeat of the same stanza is the same step. Two
  // stanzas that differ only in the priority are refused at the merge
  // (`sameStanza`), which compares the priorities.
  ["aptPreference"] = (s) -> fields(List(s.package, s.pin))
  ["debconfEntry"] = (s) -> fields(List(s.package, s.question, s.type, valueIdentity(s.value)))
  ["aptRepository"] = (s) -> fields(List(s.name, s.url, s.suite, fields(s.components.toList()), s.signingKey, fields(s.architectures.toList())))
  ["timezone"] = (s) -> s.name
  // The groups are a set — the engine sorts and deduplicates what it
  // reconciles — so their fingerprint is the canonical set, not the order
  // the author wrote them in. Unset groups are a state of their own: the
  // memberships are unmanaged, unlike an explicit empty set, which
  // removes every one of them.
  ["user"] = (s) -> fields(List(s.user, optional(s.shell), optional(s.home), optional(s.group), if (s.groups == null) "-" else fields(keyOrder.set(s.groups.toList())), if (s.uid == null) "-" else "\(s.uid)", "\(s.system)", s.state, "\(s.removeHome)"))
  ["group"] = (s) -> fields(List(s.name, if (s.gid == null) "-" else "\(s.gid)", s.state))
  ["gitCheckout"] = (s) -> fields(List(s.repository, s.path, s.commit))
  ["sysctl"] = (s) -> fields(List(s.name, s.value, s.path))
  // Restart and reload triggers add up across steps, so they are not part of
  // identity.
  ["service"] = (s) -> fields(List(s.name, "\(s.enabled)", "\(s.running)"))
  ["systemdTimer"] = (s) -> fields(List(s.name, timerTarget(s), optional(s.onCalendar), onBootText(s.onBoot), "\(s.persistent)", "\(s.enabled)"))
  ["capture"] = (s) -> s.id()
}

const function changesText(a: core.Action): String =
  if (a.changes is core.UnlessOutput) fields(List("unless", optional(a.changes.stdoutContains), optional(a.changes.stderrContains))) else a.changes

/// What a step manages; empty for steps that manage nothing. An apt
/// repository manages the two files it writes, so a `File` at either path
/// conflicts with it.
const function subjectsOf(s: core.Step): List<String> = subjects[s.kind].apply(s)

const local subjects: Mapping<String, (core.Step) -> List<String>> = new {
  ["file"] = (s) -> List(s.path) + (if (s.validate.isEmpty) List() else List(candidate(s)))
  ["directory"] = (s) -> List(s.path)
  ["symlink"] = (s) -> List(s.path)
  ["gitCheckout"] = (s) -> List(s.path)
  ["sysctl"] = (s) -> List("the sysctl \(s.name) in \(s.path)")
  ["aptRepository"] = (s) -> List(sourcesPath(s), keyringPath(s))
  ["service"] = (s) -> List("service \(unitName(s.name))")
  ["systemdTimer"] = (s) -> List(timerPath(s.name), timerEnablePath(s.name))
  // The account and the things it declares states for: its explicit uid
  // is a managed thing of its own — two accounts with one id fail the
  // second useradd on the duplicate — and its explicit home is a path the
  // step creates (present) or deletes with its contents (absent with
  // removeHome). A present account that states no primary group claims
  // the group useradd creates with its login name (USERGROUPS_ENAB), so
  // that implicit group is its footprint too.
  ["user"] = (s) -> List("the account \(s.user)") + (if ((s.state == "present" || s.removeHome) && s.home != null) List(s.home) else List()) + (if (s.uid == null) List() else List("uid \(s.uid)")) + (if (s.state == "present" && s.group == null) List("the group \(s.user)") else List())
  // An explicit gid is a managed thing of its own, the way a uid is.
  ["group"] = (s) -> List("the group \(s.name)") + (if (s.gid == null) List() else List("gid \(s.gid)"))
  ["timezone"] = (_) -> List("the timezone")
  ["fetchSecret"] = (s) -> List("the fnox key \(s.fnoxKey)")
  ["packages"] = (_) -> List()
  ["packageIndex"] = (_) -> List()
  ["aptSystemUpgrade"] = (_) -> List()
  // One answer per question: the debconf config database stores one value
  // per question name, and the owners are just owners, so the question —
  // not the owning package — is the thing managed. A second answer for one
  // question declares a second state for it, so the two conflict.
  ["debconfEntry"] = (s) -> List("the debconf answer of \(s.question)")
  // One apt preference stanza per package: a second stanza for one package
  // declares a second state for it, so the two conflict. The fragment the
  // stanza writes is managed too: a `File` at that path would write a
  // second state for the same file, overwriting the stanza on every apply.
  ["aptPreference"] = (s) -> List("the apt preference of \(s.package)", preferencePath(s.package))
  ["command"] = (_) -> List()
  ["script"] = (_) -> List()
  ["capture"] = (_) -> List()
}

/// systemd's name for a service: `foo` is `foo.service`.
const function unitName(name: String): String = if (name.contains(".")) name else "\(name).service"

/// The service a timer starts: the one it names, or the service of its
/// own name when it names none, as systemd does: `foo.timer` starts
/// `foo.service`.
const function timerTarget(t: systemd.SystemdTimer): String = unitName(t.service ?? t.name)

/// systemd's name for a timer: `foo` is `foo.timer`.
const function timerUnit(name: String): String = "\(name).timer"

/// Where a timer's unit file lives: the directory systemd reads its own
/// units from.
const function timerPath(name: String): String = "/etc/systemd/system/\(timerUnit(name))"

/// Where `systemctl enable` puts the timer's enablement symlink: the
/// `[Install]` section the unit file carries is what enable reads, and
/// this schema writes that section itself (`WantedBy=timers.target`), so
/// the link is the timer's own state — a `Symlink` there declares a
/// second state for a thing the timer manages and is refused. A
/// `Service` has no such known link: the `[Install]` section of its unit
/// is the author's own, so its enablement link is not the service
/// step's to own.
const function timerEnablePath(name: String): String = "/etc/systemd/system/timers.target.wants/\(timerUnit(name))"

/// The timer file: the schedule the timer fires on. The `[Install]` section
/// is what `systemctl enable` reads, so the unit can be enabled at boot;
/// whether it is enabled is the unit's own state, not the file's.
function timerContent(t: systemd.SystemdTimer): String =
  new Listing {
    "[Unit]"
    "Description=\(t.name) timer"
    ""
    "[Timer]"
    when (t.onCalendar != null) { "OnCalendar=\(t.onCalendar)" }
    when (t.onBoot != null) { "OnBootSec=\(onBootSpan(t))" }
    // The unit the timer activates when it fires: a timer that names no
    // service starts the service of its own name.
    "Unit=\(timerTarget(t))"
    when (t.persistent) { "Persistent=true" }
    ""
    "[Install]"
    "WantedBy=timers.target"
    ""
  }.join("\n")

/// The boot delay as the unit systemd reads it: whole seconds, or whole
/// milliseconds — the contract is whole-millisecond, and no fraction of
/// one is ever emitted.
///
/// The delay has been checked before the timer is lowered — `settings`
/// refuses one that is not provably the delay the author wrote — so the
/// count of microseconds is there. The throw is the backstop that keeps
/// a wrong delay from being written: each refusal is refused, never
/// rounded to another delay.
const function onBootSpan(t: systemd.SystemdTimer): String =
  let (micros = onBootMicros(t.onBoot))
  if (onBootTooLong(t.onBoot)) throw(onBootTooLongRefusal(t))
  else if (onBootUntrusted(t.onBoot)) throw(onBootRefusal(t))
  else if (micros == null) throw(onBootRefusal(t))
  else if (micros % 1000000 == 0) "\(micros ~/ 1000000)"
  else "\(micros ~/ 1000)ms"

/// The sentence that refuses a boot delay that is not a whole number of
/// milliseconds this schema can carry. One sentence for both places that
/// refuse one, so that the refusal reads the same wherever it is found.
const function onBootRefusal(t: systemd.SystemdTimer): String =
  "'\(label(t))': onBoot \(t.onBoot) must be a whole number of milliseconds; a systemd timer reads the delay in seconds or milliseconds"

/// The largest count of milliseconds whose every integer a `Float` can
/// hold exactly: 2^53. A boot delay at or beyond it is refused whole,
/// because no schema arithmetic can recover the digits the evaluators
/// drop: they deliver a `Duration` as a number in its unit held in a
/// `Float`, so `9007199254740993.ms` arrives here as
/// `9007199254740992.ms` already, and every integer below 2^53 is the
/// one the author wrote. The bound is the binding one of the two this
/// schema knows.
const maxExactMillis = 9007199254740992

/// The longest span systemd can schedule: a time span is a count of
/// microseconds in a 64-bit unsigned integer whose top value is the
/// infinity sentinel, so the longest span `parse_usec` accepts is
/// 18446744073709551614µs — the 18446744073709551 whole milliseconds
/// below it (18446744073709 s). This bound is stated for the record and
/// never binds: `maxExactMillis` is far below it, so everything this
/// schema admits is a span systemd can parse.
const maxSchedulableMillis = 18446744073709551

/// The magnitude where a `.5` fraction is no longer representable in a
/// `Float` — 2^52 milliseconds, where the resolution reaches one whole
/// millisecond. Above it a `.5` is silently lost and rounds into an even
/// millisecond count (the tie-break is to even), so an even count there
/// cannot be proven to be the delay the author wrote, and a value that
/// still carries a fraction cannot have carried one honestly.
const maxFractionalMillis = 4503599627370496

/// The delay in whole microseconds: `null` when it is negative, beyond
/// the milliseconds this schema can hold exactly, inside the neighborhood
/// a lost `.5` leaves, or not a whole number of milliseconds — the
/// contract is whole-millisecond, so a fraction of one is refused even
/// where the evaluators carry it exactly. Every accepted count is the
/// one the author wrote: below 2^53 milliseconds every integer is exact
/// in the `Float` the evaluators deliver, and the integer path never
/// meets a `Float` at all.
const function onBootMicros(d: Duration?): Int? =
  if (d == null) null
  else if (onBootTooLong(d) || onBootUntrusted(d)) null
  else if (d.value is Int)
    let (count = exactMicros(d.value, d.unit))
    if (count == null || count >= maxExactMillis * 1000) null else count
  else
    let (value = d.value.toFloat())
    let (millis = millisOf(d.unit, value))
    if (millis < 0 || millis >= maxExactMillis.toFloat()) null
    else
      let (floor = millis.floor)
      let (ceil = millis.ceil)
      if (roundedOf(d.unit, floor) == value) wholeMicros(floor)
      else if (roundedOf(d.unit, ceil) == value) wholeMicros(ceil)
      else null

/// Whether the delay is beyond the milliseconds this schema can hold
/// exactly (or beyond systemd's own span, which the first bound already
/// covers): the whole neighborhood of an unrecoverable literal is
/// refused, so every accepted delay is the one the author wrote.
const function onBootTooLong(d: Duration): Boolean =
  microsOf(d.unit, d.value.toFloat()) >= maxExactMillis.toFloat() * 1000.0

/// Whether the delay is inside the neighborhood a silently lost `.5`
/// leaves behind: at or beyond `maxFractionalMillis` a `.5` cannot
/// survive the evaluators' `Float` and rounds into an even millisecond
/// count, so an even count there may be an odd author value with its
/// `.5` lost and refused with the sentence the other invalid delays get,
/// rather than rounded to the millisecond next to it. Only an odd
/// whole-millisecond count is provably the authored integer there. A
/// value that still carries a fraction needs no rule of its own: the
/// whole-millisecond rule refuses it wherever it appears.
const function onBootUntrusted(d: Duration): Boolean =
  let (micros = microsOf(d.unit, d.value.toFloat()))
  micros >= maxFractionalMillis.toFloat() * 1000.0
    && micros / 1000.0 == (micros / 1000.0).floor
    && micros.toInt() / 1000 % 2 == 0

/// The sentence that refuses a boot delay this schema cannot hold
/// exactly. It names the bound and deliberately not the delay: the
/// delay in the message would be the value the evaluators rounded, not
/// the one the author wrote. One sentence for both places that refuse
/// one, so the refusal reads the same wherever it is found.
const function onBootTooLongRefusal(t: systemd.SystemdTimer): String =
  "'\(label(t))': onBoot is beyond the \(maxExactMillis - 1)ms this schema can hold exactly; a longer delay arrives from the evaluators already rounded, and would fire at a time the author never wrote"

/// The whole-microsecond count of a delay whose value is an integer in
/// its own unit, taken in whole-number arithmetic and still a whole
/// number of milliseconds: an integer a finer unit counts must divide
/// into milliseconds exactly (`500.us` is the half millisecond it is and
/// stays refused), and only a `Float`'s fraction is kept where it
/// survives. A multiplication that would leave the range of an `Int` is
/// refused, never rounded.
const function exactMicros(value: Int, unit: String): Int? =
  if (value < 0) null
  else if (unit == "ns") (if (value % 1000000 == 0) value ~/ 1000 else null)
  else if (unit == "us") (if (value % 1000 == 0) value else null)
  else if (unit == "ms") scaledMicros(value, 1000)
  else if (unit == "s") scaledMicros(value, 1000000)
  else if (unit == "min") scaledMicros(value, 60000000)
  else if (unit == "h") scaledMicros(value, 3600000000)
  else scaledMicros(value, 86400000000)

/// The microsecond count of an integer delay in a coarser unit: the
/// multiplication is refused where it would leave the range of an `Int`,
/// because a wrapped or rounded overflow is a delay the author never
/// wrote.
const function scaledMicros(value: Int, factor: Int): Int? =
  if (value > 9223372036854775807 ~/ factor) null else value * factor

/// The delay in milliseconds, counted in the unit the delay was written
/// in. The whole-millisecond proof runs in this space on purpose: at a
/// magnitude where the microsecond product would round, this one still
/// shows the fraction the conversion cannot carry.
const function millisOf(unit: String, value: Float): Float =
  if (unit == "ns") value / 1000000.0
  else if (unit == "us") value / 1000.0
  else if (unit == "ms") value
  else if (unit == "s") value * 1000.0
  else if (unit == "min") value * 60000.0
  else if (unit == "h") value * 3600000.0
  else value * 86400000.0

/// The whole-millisecond count, converted back to the unit the delay was
/// written in: the inverse of `millisOf`, so the two together say the
/// count is exactly the delay and not a millisecond next to it.
const function roundedOf(unit: String, millis: Float): Float =
  if (unit == "ns") millis * 1000000.0
  else if (unit == "us") millis * 1000.0
  else if (unit == "ms") millis
  else if (unit == "s") millis / 1000.0
  else if (unit == "min") millis / 60000.0
  else if (unit == "h") millis / 3600000.0
  else millis / 86400000.0

/// The microsecond count of a whole-millisecond candidate: the integer
/// arithmetic keeps every digit the float proof just approved.
const function wholeMicros(millis: Float): Int? =
  if (millis >= maxExactMillis.toFloat()) null else millis.toInt() * 1000

/// The delay in microseconds, counted in the unit the delay was written
/// in. The factors are whole numbers or clean halves of one, so the
/// conversion is exact in one direction and the check that converts back
/// undoes the other.
const function microsOf(unit: String, value: Float): Float =
  if (unit == "ns") value / 1000.0
  else if (unit == "us") value
  else if (unit == "ms") value * 1000.0
  else if (unit == "s") value * 1000000.0
  else if (unit == "min") value * 60000000.0
  else if (unit == "h") value * 3600000000.0
  else value * 86400000000.0

/// The whole-microsecond count, converted back to the unit the delay was
/// written in: the delay the author wrote, if the count is the one they
/// wrote. The conversion is the inverse of `microsOf`, so the two
/// together say that the count is exactly the delay and not a
/// microsecond next to it.
const function roundedMicrosOf(unit: String, micros: Float): Float =
  if (unit == "ns") micros * 1000.0
  else if (unit == "us") micros
  else if (unit == "ms") micros / 1000.0
  else if (unit == "s") micros / 1000000.0
  else if (unit == "min") micros / 60000000.0
  else if (unit == "h") micros / 3600000000.0
  else micros / 86400000000.0

/// Whether a boot delay is before the boot: a timer fires after it.
const function onBootNegative(d: Duration): Boolean = d.value.toFloat() < 0

/// The boot delay as the text that identifies the step: the delay in
/// whole milliseconds, so that two spellings of one delay — `1.001.s` and
/// `1001.ms` — are one step, and not two steps that manage the same unit
/// file with different settings. A delay that is not a whole number of
/// milliseconds, or not provable, keeps its own text, so that it is
/// never the same step as a delay it is not.
const function onBootText(d: Duration?): String =
  if (d == null) "-"
  else
    let (micros = onBootMicros(d))
    if (micros == null) "\(d)"
    else "\(micros ~/ 1000)"

const function sourcesPath(r: debian.AptRepository): String = "/etc/apt/sources.list.d/\(r.name).sources"
const function keyringPath(r: debian.AptRepository): String = "/etc/apt/keyrings/\(r.name).asc"

function name(s: core.Step): String = label(s)

/// The step's line in the plan: its title, or the generated description.
const function label(s: core.Step): String = s.title ?? (if (s is core.Recipe) "a recipe" else describe(s))

function restartName(serviceName: String): String = "Restart \(serviceName)"

function reloadName(serviceName: String): String = "Reload \(serviceName)"

/// The handler a service's watched steps notify: the restart handler, or
/// the reload handler when the service takes reload triggers. A service
/// takes one kind of trigger or the other (`settings`).
function handlerName(s: core.Step): String =
  if (s is systemd.Service && !s.reloadOnChangeOf.isEmpty) reloadName(s.name) else restartName(s.name)

/// Common task fields, worked out once per step.
class Meta {
  name: String
  tags: List<String>
  notify: List<String>
  register: String?
  /// Result names of the steps this step reacts to.
  watching: List<String> = List()
  /// Environment values, as engine expressions: literals for static text,
  /// lookups for secrets. Only actions have any.
  environment: Mapping<String, engine.Expr> = new {}
  /// Whether a secret appears in the step: such a task is never logged.
  noLog: Boolean = false
}

function metaOf(ix: StageIndex, i: Int, _tags: List<String>): Meta =
  let (_name = name(ix.steps[i]))
  let (_notify = dependents(ix, i).filter((j) -> ix.steps[j] is systemd.Service).map((j) -> handlerName(ix.steps[j])).toSet().toList())
  let (_register = if (dependents(ix, i).any((j) -> ix.steps[j] is core.Action) || ix.steps[i] is core.Capture || ix.steps[i] is systemd.SystemdTimer) ix.results[i] else null)
  new Meta { name = _name; tags = _tags; notify = _notify; register = _register; watching = ix.deps[i].map((j) -> ix.results[j]); environment = envOf(ix.steps[i]); noLog = secretStep(ix.steps[i]) }

/// Positions of the steps that react to step `i` or read its output. They
/// always come later in the stage.
function dependents(ix: StageIndex, i: Int): List<Int> =
  positions(ix.steps).filter((j) -> ix.deps[j].contains(i) || ix.uses[j].contains(i))

/// A step runs under its own tags, its recipes' tags, and the tags of every
/// step that depends on it, directly or not, so `--tags` never runs a step
/// without what it reads. One pass from the last step to the first sees each
/// dependent's final tags.
function allTags(ix: StageIndex): List<List<String>> =
  let (n = ix.steps.length)
  let (backwards = positions(ix.steps).fold(List(), (later, k) -> later + List(tagsOf(ix, n - 1 - k, later))))
  positions(ix.steps).map((i) -> backwards[n - 1 - i])

/// `later[k]` holds the tags of step `n - 1 - k`.
function tagsOf(ix: StageIndex, i: Int, later: List<List<String>>): List<String> =
  (ownTags(ix.placed[i]) + dependents(ix, i).flatMap((j) -> later[ix.steps.length - 1 - j])).toSet().toList()

function ownTags(p: Placed): List<String> = p.step.tags.toList() + p.inherited

function helperMeta(_name: String, m: Meta, _register: String?): Meta =
  new Meta { name = _name; tags = m.tags; notify = List(); register = _register; noLog = m.noLog }

// ── Steps ───────────────────────────────────────────────────────────────────

/// The description shown in plans when a step has no `title`.
const function describe(s: core.Step): String = describers[s.kind].apply(s)

const local describers: Mapping<String, (core.Step) -> String> = new {
  ["file"] = (s) -> "Write \(s.path)"
  ["directory"] = (s) -> "Create directory \(s.path)"
  ["symlink"] = (s) -> "Link \(s.path) to \(s.target)"
  ["packageIndex"] = (_) -> "Refresh apt package index"
  ["packages"] = (s) -> (if (s.hold) "Install and hold " else (if (s.latest) "Install or upgrade " else "Install ")) + s.names.join(", ")
  ["aptSystemUpgrade"] = (s) -> "Upgrade every installed package to the newest candidate" + (if (s.autoremove) " and remove the orphaned ones" else "")
  ["aptPreference"] = (s) -> "Pin \(s.package) with \(s.pin) at priority \(s.priority)"
  ["debconfEntry"] = (s) -> "Set \(s.question) for \(s.package)"
  ["aptRepository"] = (s) -> "Configure \(s.name) apt repository"
  ["timezone"] = (s) -> "Set timezone to \(s.name)"
  ["user"] = (s) -> (if (s.state == "absent") "Remove account " else "Manage account ") + s.user
  ["group"] = (s) -> (if (s.state == "absent") "Remove group " else "Manage group ") + s.name
  ["gitCheckout"] = (s) -> "Check out \(s.repository) into \(s.path)"
  ["sysctl"] = (s) -> "Set sysctl \(s.name) to \(s.value) in \(s.path)"
  ["service"] = (s) -> (if (s.running) "Start " else "Stop ") + s.name + (if (s.enabled) ", enabled at boot" else ", disabled at boot")
  ["systemdTimer"] = (s) -> "Manage timer " + s.name + (if (s.onCalendar == null) "" else " on \(s.onCalendar)")
  ["command"] = (s) -> "Run " + s.run.join(" ")
  ["script"] = (s) -> "Run script " + s.bash.trim().split("\n").first
  ["capture"] = (s) -> s.description()
  ["fetchSecret"] = (s) -> "Fetch \(s.fromPath) into fnox"
}

/// A table, not an `if … else if` chain: pklr counts each `else if` against
/// its depth limit of 32 (P3).
function lower(ix: StageIndex, i: Int): List<engine.Task> =
  (if (firstRepository(ix) == i) List(keyringsTask(ix)) else List()) + lowerers[ix.steps[i].kind].apply(ix.steps[i], ix.metas[i])

/// The stage's first apt repository, which creates `/etc/apt/keyrings` once
/// for all of them.
function firstRepository(ix: StageIndex): Int? =
  let (repositories = positions(ix.steps).filter((k) -> ix.steps[k] is debian.AptRepository))
  if (repositories.isEmpty) null else repositories.first

/// One task for the directory every repository of the stage writes its key
/// into: root's, 0755, so nobody else can replace a key. It runs under all
/// the repositories' tags and notifies all their services, and steps
/// reacting to any of them see its result (`anyChanged`).
function keyringsTask(ix: StageIndex): engine.Task =
  let (owners = positions(ix.steps).filter((k) -> ix.steps[k] is debian.AptRepository))
  task(new Meta {
    name = "Create /etc/apt/keyrings"
    tags = owners.flatMap((k) -> ix.metas[k].tags).toSet().toList()
    notify = owners.flatMap((k) -> ix.metas[k].notify).toSet().toList()
    register = keyringsResult
  }, (directory("/etc/apt/keyrings", "0755")) { owner = "root"; group = "root" }, null, null)

const keyringsResult: String = "aptKeyrings"

local lowerers: Mapping<String, (core.Step, Meta) -> List<engine.Task>> = new {
  ["file"] = (s, m) -> validateTasks(s, m) + List(task(m, copy(s.path, s), null, null))
  ["directory"] = (s, m) -> List(task(m, directory(s.path, s.mode), null, null))
  ["symlink"] = (s, m) -> List(task(m, symlink(s.path, s.target), null, null))
  ["packageIndex"] = (_, m) -> List(task(m, command(List("apt-get", "-q", "update"), null, null), null, lit(false)))
  ["packages"] = (s, m) -> List(task(m, apt(s.names.toList(), s.latest, s.hold), null, null))
  ["aptSystemUpgrade"] = (s, m) -> List(task(m, aptUpgrade(s.autoremove), null, null))
  ["aptPreference"] = (s, m) -> List(task(m, copyText(preferencePath(s.package), preferenceContent(s)), null, null))
  ["debconfEntry"] = (s, m) -> List(task(m, debconf(s), null, null))
  ["aptRepository"] = (s, m) -> List(task(keyringMeta(s, m), keyring(s), null, null), task(m, sourcesFile(s), null, null))
  ["timezone"] = (s, m) -> List(task(m, timezone(s.name), null, null))
  // `linux.User` lowers to the engine's user operation alone: the operation
  // creates a missing account and changes the settings of an existing one,
  // so no pre-check reads /etc/passwd before it.
  ["user"] = (s, m) -> List(task(m, user(s.user, s.shell, s.home, s.group, if (s.groups == null) null else keyOrder.set(s.groups.toList()), s.uid, s.system, s.state, s.removeHome), null, null))
  ["group"] = (s, m) -> List(task(m, group(s.name, s.gid, s.state), null, null))
  ["gitCheckout"] = (s, m) -> List(task(m, git(s.repository, s.path, s.commit), null, null))
  ["sysctl"] = (s, m) -> List(task(m, sysctl(s.name, s.value, s.path), null, null))
  ["service"] = (s, m) -> List(task(m, service(s.name, s.enabled, if (s.running) "started" else "stopped"), null, null))
  ["systemdTimer"] = (s, m) -> List(task(timerFileMeta(m), copyText(timerPath(s.name), timerContent(s)), null, null), task(timerEnableMeta(s, m), (service(timerUnit(s.name), s.enabled, null)) { when (m.register != null) { daemon_reload = ref(List("results", "\(m.register)_unit", "changed")) } }, null, timerChanged(m)))
  ["command"] = (s, m) -> actionTasks(s, s.run.toList(), m)
  ["script"] = (s, m) -> actionTasks(s, bash(s.bash), m)
  ["capture"] = (s, m) -> List(captureTask(task(m, command(bash(s.bash), null, null), null, lit(false)), s, m.register))
  ["fetchSecret"] = (s, m) -> List(fetchSecretTask(s, m))
}

/// The FetchSecret task: a read-only slurp the controller turns into a fnox
/// store. The task is no-log (a secret-bearing step), and the controller
/// runs it in apply only — in check and diff it answers known-after-apply
/// without contacting the host or fnox.
function fetchSecret(s: core.FetchSecret): engine.FetchSecret =
  new engine.FetchSecret { path = s.fromPath; key = s.fnoxKey }

/// The fetch is delegated to the one host the file is read on, like a
/// capture with a `runOn`: a stage that runs on several hosts reads the
/// file on the named host alone, never on a host that does not have it,
/// and the host is named in the task, so the plan shows where the read
/// happens.
function fetchSecretTask(s: core.FetchSecret, m: Meta): engine.Task =
  (task(m, fetchSecret(s), null, null)) {
    delegateTo = s.runOn.name
    delegateAllow = new Listing { s.runOn.name }
  }

// File: stage, validate, then publish. A secret's candidate is temporary:
// validation removes it in the block's `always`, success or failure, so no
// resolved plaintext survives the run. A file without secrets keeps the
// persistent candidate, so a second apply reports no change.
function validateTasks(f: core.File, m: Meta): List<engine.Task> =
  if (f.validate.isEmpty) List()
  else if (hasSecrets(f.content)) List(temporaryValidation(f, m))
  else List(
    task(helperMeta("Stage \(f.path)", m, null), candidateCopy(f), null, null),
    task(helperMeta("Validate \(f.path)", m, null), validateCommand(f), null, lit(false))
  )

/// The validation of a secret-bearing file, one block task: the candidate is
/// staged and the validator run in the block, and the candidate removed in
/// `always`, which the engine runs whether the validator succeeds, fails or
/// errors — a plain sequence would stop at the failure and leave the
/// resolved secret on the host.
function temporaryValidation(f: core.File, m: Meta): engine.Task =
  blockTask(
    helperMeta("Validate \(f.path)", m, null),
    List(
      task(helperMeta("Stage \(f.path)", m, null), candidateCopy(f), null, lit(false)),
      task(helperMeta("Validate \(f.path)", m, null), validateCommand(f), null, lit(false))
    ),
    List(task(helperMeta("Remove \(candidate(f))", m, null), candidateRemoval(f), null, lit(false)))
  )

function validateCommand(f: core.File): engine.Command =
  command(f.validate.toList().map((a) -> a.replaceAll("%s", candidate(f))), null, null)

/// Absence is idempotent, so the cleanup removes the candidate once and never
/// reports a change again.
function candidateRemoval(f: core.File): engine.File = new engine.File { path = candidate(f); state = "absent" }

/// A task with no operation of its own that runs its block and then its
/// `always`. No register: the engine refuses one on a block task.
function blockTask(m: Meta, _block: List<engine.Task>, _always: List<engine.Task>): engine.Task = new engine.Task {
  name = m.name
  tags { for (t in m.tags) { t } }
  environment { for (k, v in m.environment) { [k] = v } }
  noLog = m.noLog
  block { for (t in _block) { t } }
  always { for (t in _always) { t } }
}

/// The candidate is root's alone (0600), whatever the file's owner, so no one
/// else can change it between staging and validation.
function candidateCopy(f: core.File): engine.Copy = new engine.Copy {
  dest = candidate(f)
  content = runtimeText(f.content)
  mode = "0600"
  owner = "root"
  group = "root"
}

/// `.<name>.ruxel-candidate` beside the file: validators that resolve
/// relative includes still work, and `*`, `*.conf` and `*.d` loaders skip
/// dotfiles. For a file without secrets it stays, so that a second apply
/// reports no change; a secret-bearing file's candidate is temporary
/// (`temporaryValidation`).
const function candidate(f: core.File): String =
  let (slash = f.path.lastIndexOf("/"))
  let (base = f.path.substring(slash + 1, f.path.length))
  // A file name has at most 255 bytes; a long or non-ASCII one is hashed.
  "\(f.path.substring(0, slash + 1)).\(if (base.length <= 238 && base.matches(Regex("[ -~]*"))) base else base.sha256.substring(0, 32)).ruxel-candidate"

/// The keyring task notifies and registers too: a new key is a change of
/// the repository.
function keyringMeta(r: debian.AptRepository, m: Meta): Meta = new Meta {
  name = "Install \(r.name) apt signing key"
  tags = m.tags
  notify = m.notify
  register = if (m.register == null) null else "\(m.register)_key"
}

function keyring(r: debian.AptRepository): engine.Copy = copyText(keyringPath(r), r.signingKey)

function sourcesFile(r: debian.AptRepository): engine.Copy = copyText(sourcesPath(r), new Listing {
  "Types: deb"
  "URIs: \(r.url)"
  "Suites: \(r.suite)"
  when (!r.components.isEmpty) { "Components: \(r.components.join(" "))" }
  when (!r.architectures.isEmpty) { "Architectures: \(r.architectures.join(" "))" }
  "Signed-By: \(keyringPath(r))"
}.join("\n") + "\n")

// Command and Script: a `creates` guard is a probe and a `when` condition, so
// the controller checks the path before it resolves the task's environment: a
// skipped action reads no secret store. That probe is stale by the time the
// command executes, so the command carries the path too and the agent re-stats
// it itself before it runs (`Command.creates`). `onChangeOf` needs the watched
// steps' results beside the probe; the agent gets them handed down as
// `Command.run_if_changed`, the same disjunct its `when` carries, because it
// cannot read the controller's results.
function actionTasks(a: core.Action, argv: List<String>, m: Meta): List<engine.Task> =
  let (watched = if (a.onChangeOf.isEmpty) null else anyChanged(m.watching))
  if (a.creates == null)
    List(task(m, command(argv, null, watched), watched, changeRule(a)))
  else List(
    task(helperMeta("Check whether \(a.creates) exists", m, probeKey(a.creates)), stat(a.creates), null, null),
    task(m, command(argv, a.creates, watched), createsGuard(a, m), changeRule(a))
  )

/// The command runs when the created path is absent, or when any watched step
/// changed: a watcher must re-run the action that created nothing yet.
function createsGuard(a: core.Action, m: Meta): engine.Expr =
  if (a.onChangeOf.isEmpty) existsGuard(a)
  else call2("or", anyChanged(m.watching), existsGuard(a))

/// The probe's registered `stat.exists`, negated: the guarded command runs
/// only when the path is missing.
function existsGuard(a: core.Action): engine.Expr =
  call1("not", ref(List("results", probeKey(a.creates), "stat", "exists")))

/// `or` of the `changed` results of the watched steps. An apt repository
/// also changes when only its keyring does.
function anyChanged(ids: List<String>): engine.Expr =
  ids.flatMap((id) -> if (id.startsWith("aptRepository_")) List(id, "\(id)_key", keyringsResult) else List(id))
    .map((id) -> ref(List("results", id, "changed")))
    .fold(null, (acc, e) -> if (acc == null) e else call2("or", acc, e))

/// `always` is a change whenever the command runs, and in check and diff
/// whenever it would run: the engine skips it there (`skipped`), and the
/// steps that react to it must still see a pending change. A `creates` skip
/// is two different things: the probe's `when` skips the task on the
/// controller, before `changedWhen` is ever evaluated, and a step not
/// selected by `onChangeOf` stays unchanged; the agent's own recheck skips
/// with `skip.cause` and reports no change (`ran`).
function changeRule(a: core.Action): engine.Expr =
  if (a.changes == "never") lit(false)
  else if (a.changes is core.UnlessOutput) unlessOutput(a.changes, ran(a))
  else ran(a)

/// The command ran, or would run in check and diff — except when the agent's
/// recheck of `creates` skipped it: the path exists now, so there was nothing
/// to run and there is nothing to report. Every other skip is a check-mode
/// skip of a command that would have run.
function ran(a: core.Action): engine.Expr =
  call2("or", ref(List("result", "changed")),
    if (a.creates == null) pendingSkipped()
    else call2("and", pendingSkipped(), call2("ne", skipCause(), lit(createsRecheckSkip))))

/// Whether the agent did not run the command because the mode says so: the
/// engine reports `skipped` in check and diff, without a reason of its own.
function pendingSkipped(): engine.Expr = call2("default", ref(List("result", "skipped")), lit(false))

/// The reason the agent skipped with, empty for every skip without one.
function skipCause(): engine.Expr = call2("default", ref(List("result", "skip", "cause")), lit(""))

/// `skip.cause` of the agent's `creates` recheck; the agent spells it the
/// same way, and only that skip reports no change.
const createsRecheckSkip = "creates_exists"

/// Changed when the command ran or would run (see `changeRule`; a `creates`
/// recheck skip reports no change) and its output lacks the marker. In check
/// and diff the output is empty, so a command that would run counts as a change.
function unlessOutput(u: core.UnlessOutput, wouldRun: engine.Expr): engine.Expr = call2("and", wouldRun,
  if (u.stdoutContains != null) call1("not", call2("contains", ref(List("result", "stdout")), lit(u.stdoutContains)))
  else call1("not", call2("contains", ref(List("result", "stderr")), lit(u.stderrContains))))

function probeKey(path: String): String = "exists_" + path.sha256.substring(0, 32)

function restartHandler(serviceName: String): engine.Task =
  task(new Meta { name = restartName(serviceName); tags = List(); notify = List(); register = null }, service(serviceName, null, "restarted"), null, null)

/// The reload handler: a handler kind of its own, beside the restart. The
/// engine's `reloaded` state asks the unit to reload its configuration,
/// which only a running unit can do.
function reloadHandler(serviceName: String): engine.Task =
  task(new Meta { name = reloadName(serviceName); tags = List(); notify = List(); register = null }, service(serviceName, null, "reloaded"), null, null)

/// The task that writes the timer file: the step's own plan line, and the
/// handlers its change notifies. Its result is registered under its own
/// name, so that the enablement task can fold the file's change into the
/// step's result.
function timerFileMeta(m: Meta): Meta = new Meta {
  name = m.name
  tags = m.tags
  notify = m.notify
  register = if (m.register == null) null else "\(m.register)_unit"
  noLog = m.noLog
}

/// The task that enables the timer unit: the unit's own state, not the
/// step's plan line, so the plan says which unit was enabled. It holds the
/// step's result, so that a watcher of the timer sees the change of both
/// of the step's tasks.
function timerEnableMeta(t: systemd.SystemdTimer, m: Meta): Meta = new Meta {
  name = (if (t.enabled) "Enable timer " else "Disable timer ") + t.name
  tags = m.tags
  notify = m.notify
  register = m.register
  noLog = m.noLog
}

/// The change rule of the enablement task: the step changed when the
/// enablement was repaired, or when the unit file changed. The file's own
/// result is registered beside the step's, so both changes are one, and a
/// watcher of the timer sees the enablement drift even when the file was
/// unchanged.
function timerChanged(m: Meta): engine.Expr? =
  if (m.register == null) null
  else call2("or", ref(List("result", "changed")), ref(List("results", "\(m.register)_unit", "changed")))

function bash(script: String): List<String> = List("/bin/bash", "-c", "set -euo pipefail\n" + script)

// ── Engine constructors ─────────────────────────────────────────────────────

function task(m: Meta, _operation: engine.Operation, _when: engine.Expr?, _changedWhen: engine.Expr?): engine.Task = new engine.Task {
  name = m.name
  operation = _operation
  tags { for (t in m.tags) { t } }
  notify { for (n in m.notify) { n } }
  environment { for (k, v in m.environment) { [k] = v } }
  noLog = m.noLog
  when (_when != null) { `when` = _when }
  when (_changedWhen != null) { changedWhen = _changedWhen }
  when (m.register != null) { register = m.register }
}

/// A capture runs in check and diff too (`checkMode = false`): later steps
/// need its real output, and it only reads.
function captureTask(t: engine.Task, c: core.Capture, _result: String): engine.Task = (t) {
  checkMode = false
  when (c.runOn != null) { delegateTo = c.runOn.name; delegateAllow = new Listing { c.runOn.name } }
  when (c.retry.attempts > 1) {
    retries = c.retry.attempts - 1
    delaySeconds = c.retry.delay.toUnit("s").value.toInt()
    until = call2("eq", ref(List("results", _result, "rc")), lit(0))
  }
}

function copy(_dest: String, f: core.File): engine.Copy = new engine.Copy {
  dest = _dest
  content = runtimeText(f.content)
  mode = canonicalMode(f.mode)
  owner = f.owner
  group = f.group
}

function copyText(_dest: String, _content: String): engine.Copy =
  new engine.Copy { dest = _dest; content = _content; mode = "0644"; owner = "root"; group = "root" }

function directory(_path: String, _mode: String): engine.File = new engine.File { path = _path; state = "directory"; mode = canonicalMode(_mode) }
function symlink(_path: String, _target: String): engine.File = new engine.File { path = _path; src = _target; state = "link" }
function apt(_names: List<String>, _upgrade: Boolean, _hold: Boolean): engine.Apt = new engine.Apt {
  name = if (_names.length == 1) _names.first else new Listing { for (n in _names) { n } }
  state = if (_upgrade) "latest" else "present"
  hold = if (_hold) true else null
}

/// The whole system: apt's `dist-upgrade`, and with it the removal of the
/// packages nothing needs any more.
function aptUpgrade(_autoremove: Boolean): engine.Apt = new engine.Apt {
  upgrade = "dist"
  autoremove = if (_autoremove) true else null
}

/// One apt preferences stanza, in the file apt reads it from. The name is
/// the package selector with the characters apt_preferences(5) refuses in
/// a fragment name replaced by a dash, and the full SHA-256 of the
/// selector, so two selectors never write one file: the sanitizing is not
/// one-to-one (`+`, `:` and `*` all become a dash), so the digest alone
/// separates two selectors that sanitize to one basename — a truncated
/// one does not (two such selectors once shared an eight-hex-digit
/// prefix). apt loads only fragments without an extension or with the
/// `.pref` extension, so the file ends in `.pref`.
///
/// The sanitized selector is capped at 185 characters: a fragment name
/// must fit NAME_MAX (255 bytes), and the name carries the separator, the
/// 64-hex digest and the `.pref` extension besides the selector (185 + 1
/// + 64 + 5 = 255), while a selector may be far longer. A `PackageSelector`
/// admits only ASCII (Debian.pkl), so one character is one byte. The digest
/// stays full, so the cap cannot make two selectors share a file.
const function preferencePath(package: String): String =
  "/etc/apt/preferences.d/\(preferenceName(package)).pref"

const function preferenceName(package: String): String =
  let (sanitized = package.replaceAll(":", "-").replaceAll("*", "-").replaceAll("+", "-"))
  "\(sanitized.substring(0, if (sanitized.length > 185) 185 else sanitized.length))-\(package.sha256)"

/// The stanza itself: one field per line, the way apt_preferences(5) reads
/// it.
function preferenceContent(p: debian.AptPreference): String =
  "Package: \(p.package)\nPin: \(p.pin)\nPin-Priority: \(p.priority)\n"

/// One debconf selection. A secret answer lowers to a lookup, which the
/// engine resolves in its store; the task is never logged, and the answer
/// reaches the host on the standard input, never in an argument.
function debconf(e: debian.DebconfEntry): engine.Debconf = new engine.Debconf {
  package = e.package
  question = e.question
  type = e.type
  value = debconfValue(e.value)
}

/// The answer of a debconf selection: static text, or a secret the engine
/// resolves at apply time. `DebconfEntry.value` is the closed
/// `OneLine|SecretAnswer` union (Debian.pkl), so no other branch exists.
function debconfValue(v: Any): engine.Expr =
  if (v is debian.SecretAnswer) secretValue(v.parts)
  else lit(v)

/// What enters the identity of a debconf answer: the text of a static
/// answer, or the encoded reference of a secret one — the reference, never
/// the secret itself. Each variant is tagged and length-encoded (`fields`),
/// so a static answer that spells a secret's encoding ("f3:KEY") cannot
/// collide with the secret answer of that secret and silently discard it.
const function valueIdentity(v: Any): String =
  if (v is debian.SecretAnswer) fields(List("secret", v.parts)) else fields(List("static", v.toString()))
function timezone(_name: String): engine.Timezone = new engine.Timezone { name = _name }
/// The engine's user operation: the account and every setting the step
/// manages. The flags it offers beyond these (`append`, `comment`,
/// `create_home`) are not exposed: create-home follows the engine default.
/// `system` is creation-only — it shapes an account the operation
/// creates, never an existing one (`useradd --system`).
/// The supplementary groups are the canonical set the fingerprint takes,
/// and the operation carries them whenever the step states them — an
/// explicit empty list is `groups = []`, which removes every membership;
/// a step that states no groups omits the field and leaves memberships
/// unmanaged.
function user(_name: String, _shell: String?, _home: String?, _group: String?, _groups: List<String>?, _uid: Int?, _system: Boolean, _state: "present"|"absent", _removeHome: Boolean): engine.User = new engine.User {
  name = _name
  when (_shell != null) { shell = _shell }
  when (_home != null) { home = _home }
  when (_group != null) { group = _group }
  when (_groups != null) { groups = new Listing { for (g in (_groups ?? List())) { g } } }
  when (_uid != null) { uid = _uid }
  system = _system
  state = _state
  remove = _removeHome
}
/// The engine's group operation: the group, its id and whether it is there.
function group(_name: String, _gid: Int?, _state: "present"|"absent"): engine.SystemGroup = new engine.SystemGroup {
  name = _name
  when (_gid != null) { gid = _gid }
  state = _state
}
function git(_repo: String, _dest: String, _version: String): engine.Git = new engine.Git { repo = _repo; dest = _dest; version = _version }
/// The engine's sysctl operation: the parameter, its value, and the file
/// that holds the entry. The engine writes the entry and applies the file,
/// and `sysctl_set` turns on live-value reconciliation: every apply reads
/// the live kernel value and corrects it when it drifted, so a parameter
/// another process changed is never left stale. `reload` is off: the file
/// may hold other steps' and unmanaged entries, and a whole-file
/// `sysctl -p` would reset every one of them — the managed key is applied
/// live by `sysctl_set` alone. The flags it offers beyond this are not
/// exposed.
function sysctl(_name: String, _value: String, _path: String): engine.Sysctl = new engine.Sysctl { name = _name; value = _value; sysctl_file = _path; sysctl_set = true; reload = false; state = "present" }
function service(_name: String, _enabled: Boolean?, _state: String?): engine.Service = new engine.Service { name = _name; enabled = _enabled; state = _state }
/// Follows links, as the `creates` guard does: a dangling
/// link does not count as the path existing.
function stat(_path: String): engine.Stat = new engine.Stat { path = _path; follow = true }
/// The command itself, with its guard: `_creates` is the path the agent
/// re-stats before it executes, `_runIfChanged` the watched-step result that
/// makes the path stale (`onChangeOf`). Neither is a change rule; that is the
/// task's `changedWhen`.
function command(_argv: List<String>, _creates: String?, _runIfChanged: engine.Expr?): engine.Command = new engine.Command {
  argv = new Listing { for (a in _argv) { a } }
  when (_creates != null) { creates = _creates }
  when (_runIfChanged != null) { run_if_changed = _runIfChanged }
}

// ── Run-time and secret text ────────────────────────────────────────────────

local placeholder = Regex(#"__ruxel_rt_8d41\.([A-Za-z0-9_.]+?)__"#)
local knownPlaceholder = Regex(#"inventoryHost|vars\.ruxel_address|results\.capture_[0-9a-f]{32}\.stdout"#)
/// One regex for both, because pklr has no `sortBy` to order two match lists:
/// a match carries group 1 when it is a run-time value, group 2 when it is a
/// secret. The payloads are disjoint (`[A-Za-z0-9_.]` cannot spell a secret
/// encoding), so one scan cannot take a placeholder of one kind for the
/// other. The secret payload is captured permissively — across lines too, as
/// a `join` separator may carry a newline — but tempered against the `__`
/// terminator, and the terminator may not open another reserved prefix: a
/// placeholder can never swallow a later one, an unterminated placeholder
/// fails the prefix count in `segmentsOf` and is refused. Malformed text is
/// parsed and refused, never left behind as literal content.
///
/// The terminator of a placeholder — secret or run-time alike — may not
/// be the opening of another reserved
/// prefix: `ruxel_rt_8d41.` or `ruxel_secret_8d41.` followed by a
/// placeholder body — the run-time name, or a secret's encoded-body attempt:
/// its length-prefixed parts (`f`, `g`, `o`, `r`, `s` atoms of `size:text`,
/// `Core.sized`). The guard recognizes every terminated candidate and
/// leaves body validation to the parser: a body that carries the `:` of a
/// `size:text` part refuses the terminator whatever its tag — unknown or
/// uppercase, oversized length prefix, underscore-bearing text, wrong atom
/// count are the parser's refusals — and so does a body that is empty or
/// one run of words — punctuation, whitespace and line breaks included —
/// which is an attempt without its colon: the same
/// candidate alone is parsed and refused, so overlapped it is refused too,
/// never left behind as literal content. A chained candidate — its own
/// terminator opening yet another reserved prefix that begins a
/// placeholder of its own — is recognized the same way: the run of three
/// sharing their delimiters refuses every terminator in turn and leaves
/// no middle body behind. A candidate body is scanned
/// once: one lookahead asserts the `:`, one pass finds the terminator,
/// never a rescan of the suffix per split — a long colon-bearing run
/// without a terminator is linear to pass as the literal text it is, never
/// a quadratic stall. A candidate is terminated only by a `__` that opens
/// no reserved prefix of its own: the `__` that a following word completes
/// into another reserved prefix is that opening's delimiter, never the
/// candidate's terminator. Both alternatives carry that same terminator
/// lookahead: a run-time name's `__` may not open a reserved candidate
/// either — the run-time match would consume the secret's opening `__`,
/// the overlap-aware prefix count would call the prefix covered, and the
/// candidate would be left behind as literal content beside the reference.
/// Literal text that only looks like a prefix —
/// the reserved words without an encoded body — is ordinary content and
/// passes: the words beside a placeholder's delimiters carry no terminator
/// of their own.
const local anyPlaceholder = Regex(#"__ruxel_rt_8d41\.([A-Za-z0-9_.]+?)__(?!ruxel_rt_8d41\.[A-Za-z0-9_.]+__|ruxel_secret_8d41\.(?:(?=(?:(?!__)[\s\S])*?:)(?:(?!__)[\s\S])*?|(?:(?!__)[\s\S])*?)__(?!ruxel_rt_8d41\.|ruxel_secret_8d41\.)|ruxel_secret_8d41\.(?:(?!__)[\s\S])*?__(?=ruxel_rt_8d41\.[A-Za-z0-9_.]+__|ruxel_secret_8d41\.(?:(?!__)[\s\S])*?__(?!ruxel_rt_8d41\.|ruxel_secret_8d41\.)))|__ruxel_secret_8d41\.((?:(?!__)[\s\S])*?)__(?!ruxel_rt_8d41\.[A-Za-z0-9_.]+__|ruxel_secret_8d41\.(?:(?=(?:(?!__)[\s\S])*?:)(?:(?!__)[\s\S])*?|(?:(?!__)[\s\S])*?)__(?!ruxel_rt_8d41\.|ruxel_secret_8d41\.)|ruxel_secret_8d41\.(?:(?!__)[\s\S])*?__(?=ruxel_rt_8d41\.[A-Za-z0-9_.]+__|ruxel_secret_8d41\.(?:(?!__)[\s\S])*?__(?!ruxel_rt_8d41\.|ruxel_secret_8d41\.)))"#)
/// The reserved prefixes, of both kinds: a run-time name's opening and a
/// secret's are counted alike.
const local reservedPrefix = Regex(#"__ruxel_rt_8d41\.|__ruxel_secret_8d41\."#)
/// The same terminator rule as a whole candidate from its opening `__`: a
/// reserved prefix a terminator opened counts as covered only where the
/// words carry no candidate of their own — the `__` that completes into a
/// whole placeholder is that placeholder's opening delimiter, never the
/// match's accounting.
const local standaloneCandidate = Regex(#"^__(?:ruxel_rt_8d41\.[A-Za-z0-9_.]+__|ruxel_secret_8d41\.(?:(?=(?:(?!__)[\s\S])*?:)(?:(?!__)[\s\S])*?|(?:(?!__)[\s\S])*?)__(?!ruxel_rt_8d41\.|ruxel_secret_8d41\.)|ruxel_secret_8d41\.(?:(?!__)[\s\S])*?__(?=ruxel_rt_8d41\.[A-Za-z0-9_.]+__|ruxel_secret_8d41\.(?:(?!__)[\s\S])*?__(?!ruxel_rt_8d41\.|ruxel_secret_8d41\.)))"#)
/// The reserved words beside a placeholder's delimiters: a prefix a
/// terminator opened is the word's own text — never a candidate of its
/// own — whatever follows elsewhere. The classification is local: only a
/// candidate NAME after the prefix starts a candidate, the run of the
/// name's allowed characters — `f2:AB` and its like, or a run-time name —
/// while the reserved words WITHOUT an encoded body are ordinary content:
/// `ruxel_rt_8d41.` or `ruxel_secret_8d41.` beside the delimiters, a bare
/// word that trails off with nothing after the dot. The exemption is only
/// for a genuinely bodyless word — the words, and then nothing that could
/// continue a name: a reserved word followed by candidate content is a
/// body-carrying candidate like any other. A candidate name that is
/// terminated is a whole placeholder and refused by the terminator rule;
/// unterminated it alone fails the prefix count, and overlapped it counts
/// as never covered, never left behind as literal content.
const local candidateName = Regex(#"^__(?:ruxel_rt_8d41\.|ruxel_secret_8d41\.)(?!(?:ruxel_rt_8d41\.|ruxel_secret_8d41\.)+(?![A-Za-z0-9_.:]))[A-Za-z0-9_.:]"#)

/// Text without placeholders stays a string. Run-time placeholders
/// (`currentHost`, `Capture.stdout()`) become engine references, secret
/// placeholders (`module.fnox(…)`, …) engine lookups, inside a `concat`.
///
/// The literal pieces come from match positions, not `split`: like Java's,
/// `split` drops trailing empty pieces, which loses a placeholder at the end.
function runtimeText(text: String): engine.Text =
  let (segs = segmentsOf(text))
  if (segs.isEmpty) text
  else new engine.Call {
    `function` = "concat"
    args {
      for (k, seg in segs) {
        lit(text.substring(if (k == 0) 0 else segs[k - 1].end, seg.start))
        ...(seg.exprs())
      }
      lit(text.substring(segs.last.end, text.length))
    }
  }

/// One placeholder in a text: a run-time value (`runtime`) or a secret
/// reference (`secret`), and where it sits. A secret lowers to one engine
/// expression per part, so a joined pair stays visible as two lookups.
class Segment {
  start: Int
  end: Int
  runtime: String?
  secret: String?

  function exprs(): List<engine.Expr> =
    if (secret != null) parser.exprs(secret) else List(ref((runtime ?? "").split(".")))
}

const function segmentAt(_start: Int, _end: Int, _runtime: String?, _secret: String?): Segment =
  new Segment { start = _start; end = _end; runtime = _runtime; secret = _secret }

/// Every placeholder of a text, in order. A run-time placeholder the language
/// does not know is refused here, like a secret reference that does not
/// decode (in `SecretParser`).
function segmentsOf(text: String): List<Segment> =
  let (matches = anyPlaceholder.findMatchesIn(text))
  let (all = matches.map((m) ->
    if (m.groups[1] != null)
      segmentAt(codePointOffset(text, m.start), codePointOffset(text, m.end), m.groups[1].value, null)
    else
      segmentAt(codePointOffset(text, m.start), codePointOffset(text, m.end), null, m.groups[2].value)))
  // The prefix count is overlap-aware: a placeholder's own reserved
  // prefixes are accounted for — its opening, and the terminator that
  // following literal text completes into another full prefix, which is
  // the word's own text and never a second secret: the reserved words
  // beside a placeholder's delimiters, carrying no terminator of their
  // own, classified by their local shape alone. A prefix the terminator
  // opened is never covered when the words begin a candidate name —
  // terminated it is a whole candidate, refused by the same rule the
  // terminator lookahead carries; unterminated it trails off as an
  // attempt whose absence of a closing `__` is not evidence that the
  // prefix belongs to the match. A prefix a run-time body swallowed whole
  // is never covered either: both are a placeholder's opening delimiter,
  // not the match's accounting. Only a prefix that starts outside every
  // placeholder's own delimiters is a secret reference of its own that
  // never matched, and refuses the text as malformed.
  let (stray = reservedPrefix.findMatchesIn(text).filter((p) ->
    matches.filter((m) ->
      m.start == p.start
        || (m.end - 2 <= p.start && p.start < m.end
          && standaloneCandidate.findMatchesIn(text.substring(codePointOffset(text, p.start), text.length)).isEmpty
          && candidateName.findMatchesIn(text.substring(codePointOffset(text, p.start), text.length)).isEmpty)).isEmpty).length)
  let (badSecret = all.filter((s) -> s.secret != null && ((s.secret ?? "").isEmpty || (s.secret ?? "").contains("_"))))
  let (strange = all.filter((s) -> s.runtime != null && !(s.runtime ?? "").matches(knownPlaceholder)))
  if (stray > 0 || !badSecret.isEmpty) throw(malformed)
  else if (!strange.isEmpty) throw("File content contains an unknown run-time value: __ruxel_rt_8d41.\(strange.first.runtime ?? "")__")
  else all

/// Regex match offsets count UTF-16 code units, while Pkl string indexes
/// count code points. Convert an offset to the code-point index `substring`
/// expects. Every non-BMP code point contributes two UTF-16 units; the
/// cumulative boundaries therefore map each valid UTF-16 offset back to its
/// code-point index.
const function intBoundaries(): List<Int> = new Listing<Int> { 0 }.toList()

const function codePointOffset(text: String, utf16Offset: Int): Int =
  let (widths = text.codePoints.toList().map((point) -> if (point > 0xffff) 2 else 1))
  let (boundaries = widths.fold(intBoundaries(), (units, width) -> units + List(units.last + width)))
  let (matches = positions(boundaries).filter((i) -> boundaries[i] == utf16Offset))
  if (matches.isEmpty) throw("File content contains a placeholder at an invalid Unicode boundary")
  else matches.first

/// Decodes the reference encoding of a secret (`core.SecretText.parts`): one
/// engine lookup per store part, a literal per `join` separator, in the
/// authoring grammar `lookup (separator lookup)*` — `join` writes a
/// separator only between two lookups, so a leading, doubled or trailing
/// separator is a forged encoding, refused as malformed rather than lowered
/// to a lookup plus arbitrary static text. A class, like `Walker`: pklr
/// cannot recurse through a module function inside a lambda (P11); every
/// module member it calls is `const`, which official Pkl requires of a class
/// body.
class SecretParser {
  /// A complete encoding is never empty and never contains a literal `_`:
  /// the length-prefixed encoding writes every underscore as `\u{1f}`.
  /// Those are structural failures of the encoding, so they use the one
  /// malformed-reference sentence rather than a later atom's error.
  function exprs(code: String): List<engine.Expr> =
    if (code.isEmpty || code.contains("_")) throw(malformed)
    else this.afterLookup(code)

  /// A lookup may end the encoding; a separator may not sit at the start.
  function afterLookup(code: String): List<engine.Expr> =
    if (code.isEmpty) throw(malformed)
    else (let (head = this.lookup(code))
      if (head.rest.isEmpty) head.exprs
      else head.exprs + this.afterSeparator(head.rest))

  /// A separator must sit between two lookups: what follows is a lookup,
  /// never the end of the encoding.
  function afterSeparator(code: String): List<engine.Expr> =
    (let (head = this.separator(code)) head.exprs + this.afterLookup(head.rest))

  function separator(code: String): Atom =
    let (tag = code.take(1))
    let (body = code.substring(1, code.length))
    if (tag == "s")
      let (v = this.take(body)) atom(List(lit(separatorValidated(unescape(v[0])))), v[1])
    else throw(malformed)

  function lookup(code: String): Atom =
    let (tag = code.take(1))
    let (body = code.substring(1, code.length))
    if (tag == "f")
      let (v = this.take(body)) atom(List(fnoxLookup(fnoxKeyValidated(unescape(v[0])))), v[1])
    else if (tag == "g")
      let (key = this.take(body)) (let (format = this.take(key[1])) atom(List(generatedLookup(fnoxKeyValidated(unescape(key[0])), generatedFormatValidated(unescape(format[0])))), format[1]))
    else if (tag == "r")
      let (v = this.take(body)) atom(List(opReference(opReferenceValidated(unescape(v[0])))), v[1])
    else if (tag == "o")
      let (vault = this.take(body))
      let (item = this.take(vault[1]))
      let (section = this.take(item[1]))
      let (field = this.take(section[1]))
      atom(List(opFields(opLabelValidated("vault", unescape(vault[0])), opLabelValidated("item", unescape(item[0])), if (section[0].isEmpty) null else opSectionValidated(unescape(section[0])), opFieldValidated(unescape(field[0])))), field[1])
    else throw(malformed)

  /// Reads one length-prefixed string of the encoding: the text, and the
  /// rest. The prefix is the text's own length, as `Core.sized` writes it,
  /// so it is as long as the text needs: a prefix of more than eighteen
  /// digits names more text than any body can hold and is refused. The
  /// body that remains is the real bound.
  ///
  /// The prefix is read without a regular expression: the body may be a
  /// million characters long, and a scan of it is a cost the encoding does
  /// not need.
  function take(body: String): List<String> =
    let (colon = body.indexOf(":"))
    let (digits = if (colon <= 0) "" else body.substring(0, colon))
    let (named = colon > 0 && digits.matches(Regex("[0-9]+")) && digits.length <= 18)
    let (size = if (named) digits.toInt() else 0)
    if (!named || colon + 1 + size > body.length) throw(malformed)
    else
      List(body.substring(colon + 1, colon + 1 + size), body.substring(colon + 1 + size, body.length))
}

/// One parsed atom of a secret reference: what it lowers to, and the rest of
/// the encoding.
class Atom {
  exprs: List<engine.Expr>
  rest: String
}

const function atom(_exprs: List<engine.Expr>, _rest: String): Atom =
  new Atom { exprs = _exprs; rest = _rest }

const local parser = new SecretParser {}
const malformed: String = "File content contains a malformed secret reference"

/// Lowering re-validates everything it decodes with the same sentences the
/// store functions use in Core: a forged `SecretText.parts` that fits the
/// length-prefixed shape still cannot smuggle an illegal key, format,
/// reference, label or separator past the decode. The types are the first
/// layer, the store functions the second; this is the third, because pklr
/// skips the first two on function parameters.
const function fnoxKeyValidated(key: String): String =
  if (key.matches(Regex("[A-Z][A-Z0-9_]{1,127}"))) key
  else throw("fnox key \"\(key)\" is malformed: uppercase letters, digits and underscores only, starting with a letter, 2 to 128 characters")

/// Validates a generated key's format and hands the whole encoding on: the
/// format reaches the engine, because generation is apply-time work the
/// engine performs.
const function generatedFormatValidated(format: String): String =
  if (List("hex16", "hex32", "base64-32", "alnum32").contains(format)) format
  else throw("fnoxGenerated format \"\(format)\" is not one of hex16, hex32, base64-32 or alnum32")

const function opReferenceValidated(reference: String): String =
  let (parts = referenceParts(reference))
  if (parts.length == 3 || parts.length == 4) opReferenceLabelsValidated(reference, parts)
  else if (isOpReference(reference)) reference
  else throw("\"\(reference)\" is not an op:// reference: op://<vault>/<item>/<field>, or with a section op://<vault>/<item>/<section>/<field>, and no `?`")

const function referenceParts(reference: String): List<String> =
  if (reference.startsWith("op://") && !reference.contains("?")) (
    let (rest = reference.substring(5, reference.length))
    if (rest.endsWith("/")) List() else rest.split("/")
  )
  else List()

const function opReferenceLabelsValidated(reference: String, parts: List<String>): String =
  let (vault = opLabelValidated("vault", parts[0]))
  let (item = opLabelValidated("item", parts[1]))
  let (section = if (parts.length == 4) opReferenceLabelValidated("section", parts[2]) else "")
  let (field = opReferenceLabelValidated("field", parts.last))
  reference

/// A label of a full `op://` reference. A dot is an ordinary character
/// there: the parts of a reference are separated by `/`, and the reference
/// is read as it is written. The CLI's own selector syntax — a comma and an
/// equals sign — is refused, as it is in the structured selector.
const function opReferenceLabelValidated(what: String, label: String): String =
  if (label.contains(",") || label.contains("="))
    throw("1Password \(what) \"\(label)\" may not contain a comma or an equals sign: `op item get --fields` reads them as selectors, so it would fetch unintended fields")
  else opLabelValidated(what, label)

const function opLabelValidated(what: String, label: String): String =
  if (label.contains("__ruxel_secret_8d41.") || label.contains("__ruxel_rt_8d41."))
    throw("1Password \(what) \"\(label)\" carries a secret or run-time value; a selector is static text only")
  else if (label.contains("\u{0}"))
    throw("1Password \(what) \"\(label)\" contains NUL, which no selector can hold")
  else if (label.contains("\u{1f}") || label.contains("\u{1e}"))
    throw("1Password \(what) \"\(label)\" contains \\u{1f} or \\u{1e}, which the secret reference encoding reserves; use another character")
  else if (!label.isEmpty && !label.contains("/") && !label.contains("\n")) label
  else throw("1Password \(what) \"\(label)\" is malformed: not empty, and no `/`, no line break")

/// A field reaches `op item get --fields`, which parses `,`, `=` and `.` as
/// its own selector syntax — a dot is the section separator — so the decode
/// refuses them where Core's `onePassword` does.
const function opFieldValidated(field: String): String =
  if (field.contains(",") || field.contains("="))
    throw("1Password field \"\(field)\" may not contain a comma or an equals sign: `op item get --fields` reads them as selectors, so it would fetch unintended fields")
  else if (field.contains("."))
    throw("1Password field \"\(field)\" may not contain a dot: `op item get --fields` reads a dot as the section separator, so it would fetch a different selector than the author named")
  else opLabelValidated("field", field)

/// A section and its field together form the CLI's `--fields` selector, so
/// the same comma, equals-sign and dot rule applies to both components.
const function opSectionValidated(section: String): String =
  if (section.contains(",") || section.contains("="))
    throw("1Password section \"\(section)\" may not contain a comma or an equals sign: `op item get --fields` reads them as selectors, so it would fetch unintended fields")
  else if (section.contains("."))
    throw("1Password section \"\(section)\" may not contain a dot: `op item get --fields` reads a dot as the section separator, so it would fetch a different selector than the author named")
  else opLabelValidated("section", section)

/// A separator that decodes to \u{1f} was not written by `join`: the encoding
/// reserves the character, and `join` refuses a separator holding it (see
/// `Core.sized`, which makes the two spellings distinguishable).
const function separatorValidated(separator: String): String =
  if (separator.contains("__ruxel_secret_8d41.") || separator.contains("__ruxel_rt_8d41."))
    throw("join separator \"\(separator)\" carries a secret or run-time value; the text between two joined secrets is static text only")
  else if (separator.contains("\u{0}"))
    throw("join separator contains NUL; use text without a NUL")
  else if (separator.contains("\u{1f}"))
    throw("join separator contains \\u{1f} or \\u{1e}, which the secret reference encoding reserves; use another character")
  else separator

const local function isOpLabel(label: String): Boolean =
  !label.isEmpty
    && !label.contains("/")
    && !label.contains("\n")
    && !label.contains("\u{0}")
    && !label.contains("\u{1e}")
    && !label.contains("\u{1f}")
    && !label.contains("__ruxel_secret_8d41.")
    && !label.contains("__ruxel_rt_8d41.")

const local function hasFieldSelectorSyntax(field: String): Boolean =
  field.contains(",") || field.contains("=") || field.contains(".")

const local function isOpReference(r: String): Boolean =
  r.startsWith("op://") && !r.contains("?") && (
    let (rest = r.substring(5, r.length))
    let (parts = rest.split("/"))
    !rest.endsWith("/") && (parts.length == 3 || parts.length == 4)
      && parts.every((p) -> isOpLabel(p))
      && !hasFieldSelectorSyntax(parts.last)
      && (parts.length != 4 || !hasFieldSelectorSyntax(parts[2])))

/// Reverses `Core.sized`: `_` is written `\u{1f}`, a literal `\u{1f}` as
/// `\u{1e}`, so decoding recovers exactly what was encoded.
const local function unescape(text: String): String = text.replaceAll("\u{1f}", "_").replaceAll("\u{1e}", "\u{1f}")

const function fnoxLookup(_key: String): engine.Lookup = new engine.Lookup { provider = "fnox"; key = _key }
const function generatedLookup(_key: String, _format: String): engine.Lookup =
  new engine.Lookup { provider = "fnox-generated"; key = _key; format = _format }
const function opReference(_reference: String): engine.Lookup = new engine.Lookup { provider = "op"; reference = _reference }
const function opFields(_vault: String, _item: String, _section: String?, _field: String): engine.Lookup =
  new engine.Lookup { provider = "op"; vault = _vault; item = _item; section = _section; field = _field }

/// A whole secret as one engine value: a single lookup, or `concat` for a
/// joined pair. Environment values take this form; file content flattens the
/// parts into its own `concat`.
const function secretValue(parts: String): engine.Expr =
  let (exprs = parser.exprs(parts))
  if (exprs.length == 1) exprs.first else (new engine.Call { `function` = "concat"; args { for (e in exprs) { e } } })

// ── Environment values ──────────────────────────────────────────────────────

/// The engine environment of a step: a literal per static value, a lookup per
/// secret. Only actions have any.
function envOf(s: core.Step): Mapping<String, engine.Expr> =
  if (!(s is core.Action)) new Mapping {}
  else new Mapping { for (k, v in s.environment) { [envKey(s, k)] = envValue(s, k, v) } }

/// Whether a secret appears anywhere in a step: its file content, an
/// environment value, or the step itself carrying one (FetchSecret). Such a
/// task is never logged.
const function secretStep(s: core.Step): Boolean =
  s is core.FetchSecret
    || (s is core.File && hasSecrets(s.content))
    || (s is core.Action && s.environment.keys.toList().any((k) -> s.environment[k] is core.SecretText))
    || (s is debian.DebconfEntry && s.value is debian.SecretAnswer)

function envKey(s: core.Step, key: String): String =
  if (key.matches(Regex("[A-Za-z_][A-Za-z0-9_]*"))) key
  else throw("'\(name(s))': environment key \(key) is not a variable name; use letters, digits and underscores, not starting with a digit")

function envValue(s: core.Step, key: String, v: Any): engine.Expr =
  if (v is core.SecretText) secretValue(v.parts)
  else if (!placeholder.findMatchesIn(v).isEmpty)
    throw("'\(name(s))': environment value \(key) is a run-time value; a program that needs host state reads it from the rendered config or a capture")
  else if (hasSecrets(v))
    throw("'\(name(s))': environment value \(key) interpolates a secret into text; pass the secret itself, as in environment { [\"\(key)\"] = module.fnox(…) }")
  else lit(v)

const function lit(v: engine.Scalar): engine.Literal = new engine.Literal { value = v }
const function ref(p: List<String>): engine.Ref = new engine.Ref { path { for (x in p) { x } } }
function call1(f: String, x: engine.Expr): engine.Call = new engine.Call { `function` = f; args { x } }
function call2(f: String, x: engine.Expr, y: engine.Expr): engine.Call = new engine.Call { `function` = f; args { x; y } }
