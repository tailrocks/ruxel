/// Lowers a workflow to the input of today's Ruxel engine,
/// `modulepath:/ruxel/engine/Engine.pkl`. Workflow authors never read this
/// file.
///
/// pklr shapes how this file is written. Each workaround names the pklr
/// limitation behind it:
///
/// - P3: expressions nest at most `max_depth` levels deep, 32 by default, and
///   every `let`, `else if`, call and lambda counts. ruxel asks for 256.
/// - P5: `outer.` resolves wrongly inside a constraint, so engine objects are
///   built by constructor functions whose inputs are parameters.
/// - P10: a nullable object property set at construction is still null in
///   the class's own defaults, so derived values live in methods.
/// - P11: a recursive module function is undefined inside a lambda, so
///   recursion goes through class methods (`Walker`, `Identity`).
/// - P12: `==` on some objects, such as hosts from an inventory module, does
///   not finish, so steps and hosts are compared by strings.
/// - P13: `.keys` on any object returns its property names.
/// - G16: a broken type constraint is reported without naming it, so rules
///   between fields are plain sentences thrown from here.
module Lowering

import "modulepath:/ruxel/Core.pkl" as core
import "modulepath:/ruxel/Debian.pkl" as debian
import "modulepath:/ruxel/Linux.pkl" as linux
import "modulepath:/ruxel/Systemd.pkl" as systemd
import "modulepath:/ruxel/engine/Engine.pkl" as engine

/// Replaced by the ruxel binary that serves this module, like the engine's
/// `Config.schemaFingerprint`.
hidden servedFingerprint: String = "unserved"

/// `workflowFingerprint` is the calling `Workflow.pkl`'s. The configuration
/// carries it as `languageFingerprint` when it matches this module's.
/// Otherwise one of the two is a copy, and it carries the copy's: a served
/// fingerprint ends in `@<nonce>`, a copy's does not. So admission refuses a
/// copy of either module, even an unmodified one, and names it as a copy.
function config(stages: Listing<core.Stage>, workflowFingerprint: String): engine.Config =
  let (copied = copiedClasses(stages.toList()))
  if (copied != null) throw(copied)
  else (configOf(hostsOf(stages), stages.toList(), checkedIndexes(stages))) {
    languageFingerprint = fingerprintOf(workflowFingerprint, servedFingerprint)
  }

/// pklr does not check the classes of list elements, so a stage or host
/// built from a copy of a layer module is refused here, like a copied
/// step in `Walker`.
function copiedClasses(stages: List<Any>): String? =
  if (stages.any((s) -> !(s is core.Stage))) copyMessage("stage")
  else if (stages.any((s) -> s.hosts.toList().any((h) -> !(h is core.Host)))) copyMessage("host")
  else null

/// `const` because `Walker.one` throws it: official Pkl lets a class body
/// reference only const module members (a class is not late bound), so
/// without this a copied step would be refused with a const error instead
/// of this message.
const function copyMessage(what: String): String =
  "A \(what)'s class comes from a copy of a ruxel layer module. Import the modules under \"modulepath:/ruxel/\", which the ruxel binary serves."

/// The served class of every step kind, by kind. A step of another class
/// is refused: a class copied from a layer module extends the served
/// `core.Step`, so it passes `is core.Step` and would lower as a generic
/// step of its kind, silently losing the class-specific handling — a
/// service's restart triggers, a package step's checks — and the class's
/// own rules.
///
/// Every kind the lowering lowers must name its class here, or a copy of
/// that class would lower as a generic step again.
const local canonicalClasses: Mapping<String, (core.Step) -> Boolean> = new {
  ["file"] = (s) -> s is core.File
  ["directory"] = (s) -> s is core.Directory
  ["symlink"] = (s) -> s is core.Symlink
  ["command"] = (s) -> s is core.Command
  ["script"] = (s) -> s is core.Script
  ["capture"] = (s) -> s is core.Capture
  ["recipe"] = (s) -> s is core.Recipe
  ["service"] = (s) -> s is systemd.Service
  ["packageIndex"] = (s) -> s is debian.AptPackageIndex
  ["packages"] = (s) -> s is debian.AptPackages
  ["aptRepository"] = (s) -> s is debian.AptRepository
  ["timezone"] = (s) -> s is linux.Timezone
  ["loginShell"] = (s) -> s is linux.User
  ["gitCheckout"] = (s) -> s is linux.GitCheckout
}

/// Whether the step's class is the served class of its kind, or a subclass
/// of it: a recipe of the workflow's own extends the served `Recipe`. A
/// kind no served class has is left to the lowering, which cannot lower it
/// either.
///
/// `const` because `Walker.one` calls it: official Pkl, unlike pklr, lets a
/// class body reference only const module members. The lookup stays legal
/// in a const context — `canonicalClasses` is const, so its stored checks
/// are const too.
const function canonicalStep(s: core.Step): Boolean =
  if (!canonicalClasses.containsKey(s.kind)) true
  else canonicalClasses[s.kind].apply(s)

function fingerprintOf(workflow: String, lowering: String): String =
  if (workflow == lowering) lowering
  else if (!workflow.contains("@")) workflow
  else if (!lowering.contains("@")) lowering
  else "\(workflow) with lowering \(lowering)"

/// Expands recipes, identifies every step and what it reacts to, merges
/// exact repeats, then indexes and checks each stage.
function checkedIndexes(stages: Listing<core.Stage>): List<StageIndex> =
  accepted(stages.toList(), stages.toList().map((s) -> stageIndex(merged(identified(walker.stage(s.steps.toList()))))))

function accepted(_stages: List<core.Stage>, _indexes: List<StageIndex>): List<StageIndex> =
  orFail(_indexes, positions(_indexes).flatMap((n) -> stageProblems(_stages[n], _indexes[n])))

function orFail(_indexes: List<StageIndex>, _problems: List<String>): List<StageIndex> =
  if (_problems.isEmpty) _indexes.map((ix) -> withMetas(ix)) else throw(_problems.first)

// ── Inventory ───────────────────────────────────────────────────────────────

/// Every host a stage runs on or a capture reads from, once.
function hostsOf(stages: Listing<core.Stage>): List<core.Host> =
  stages.toList()
    .flatMap((s) -> s.hosts.toList() + captureHosts(flatten(s.steps.toList())))
    .fold(List(), (seen, h) -> addHost(seen, h))

function captureHosts(steps: List<core.Step>): List<core.Host> =
  steps.filter((s) -> s is core.Capture && s.runOn != null).map((s) -> s.runOn)

/// Compares hosts by their settings. Not `==`: comparing objects from the
/// inventory module takes exponential time in pklr (P12).
function addHost(seen: List<core.Host>, h: core.Host): List<core.Host> =
  if (seen.any((x) -> x.name == h.name && signature(x) != signature(h))) throw("Host \(h.name) is declared twice with different settings")
  else if (seen.any((x) -> x.name == h.name)) seen
  else seen + List(h)

function signature(h: core.Host): String = fields(List(h.address, optional(h.sshHost), h.user, "\(h.port)"))

/// Encodes a nullable text so that `null` and the text "null" differ.
const function optional(v: String?): String = if (v == null) "-" else "+" + v

/// Encodes a list of texts unambiguously: each is prefixed with its length,
/// so no value, whatever characters it contains, can stand for two lists.
const function fields(values: List<String>): String = values.map((v) -> "\(v.length):\(v)").join("")

function configOf(_hosts: List<core.Host>, _stages: List<core.Stage>, _indexes: List<StageIndex>): engine.Config = new engine.Config {
  inventory { hosts { for (h in _hosts) { [h.name] = hostOf(h) } } }
  plays { for (n, s in _stages) { playOf(s.title, s.hosts.toList().map((h) -> h.name), _indexes[n]) } }
}

function hostOf(h: core.Host): engine.Host = new engine.Host {
  address = h.sshHost ?? h.address
  user = h.user
  port = h.port
  vars { ["ruxel_address"] = lit(h.address) }
}

// ── Stages ──────────────────────────────────────────────────────────────────

/// Facts about a stage's steps, computed once. pklr evaluates `let` eagerly,
/// so computing them here keeps later lookups shallow (P3).
class StageIndex {
  placed: List<Placed>
  steps: List<core.Step>
  /// Identity of each step. (Not `keys`: pklr reads `.keys` as an object's
  /// property names, P13.)
  ids: List<String>
  /// The engine result name of each step: its id, or for a repeated command,
  /// script, service or package step, its id and position.
  results: List<String>
  /// Positions of the steps each step reacts to: for each reference, every
  /// earlier step with that identity. A step that runs again where it is
  /// written has one result per run, and the reference fires when any run
  /// changed.
  deps: List<List<Int>>
  /// Positions of the captures whose output each step's content uses.
  uses: List<List<Int>>
  /// Task fields of each step; filled in by `withMetas` after the checks.
  metas: List<Meta> = List()
}

function stageIndex(_placed: List<Placed>): StageIndex = indexOf(_placed, _placed.map((p) -> p.step), _placed.map((p) -> p.id))

function indexOf(_placed: List<Placed>, _steps: List<core.Step>, _ids: List<String>): StageIndex =
  new StageIndex {
    placed = _placed
    steps = _steps
    ids = _ids
    results = positions(_steps).map((i) -> if (earlier(i).any((j) -> _ids[j] == _ids[i])) "\(_ids[i])_\(i)" else _ids[i])
    deps = positions(_steps).map((i) -> _placed[i].watches.flatMap((w) -> earlier(i).filter((j) -> _ids[j] == w)))
    uses = positions(_steps).map((i) -> found(_placed[i].reads.map((c) -> nearest(_ids, i, c))))
  }

/// The position of the last step before `i` with identity `id`.
function nearest(ids: List<String>, i: Int, id: String): Int? = earlier(i).fold(null, (hit, j) -> if (ids[j] == id) j else hit)

function found(hits: List<Int?>): List<Int> = hits.filter((j) -> j != null)

const function positions(list: List<Any>): List<Int> = if (list.isEmpty) List() else IntSeq(0, list.length - 1).toList()

function earlier(i: Int): List<Int> = if (i == 0) List() else IntSeq(0, i - 1).toList()

/// Only for a checked stage: every dependent comes after what it depends on.
function withMetas(ix: StageIndex): StageIndex =
  let (_tags = allTags(ix))
  let (_metas = positions(ix.steps).map((i) -> metaOf(ix, i, _tags[i])))
  (ix) { metas = _metas }

function stageProblems(s: core.Stage, ix: StageIndex): List<String> =
  (hostsTwice(s) + positions(ix.steps).flatMap((i) -> problemsAt(ix, i)) + repeatedCaptures(ix)).map((p) -> "Stage \"\(s.title)\": \(p)")

/// A capture runs once per stage, so every `stdout()` names exactly one
/// read, and a `local` holding a capture holds one value.
function repeatedCaptures(ix: StageIndex): List<String> =
  positions(ix.steps)
    .filter((j) -> ix.steps[j] is core.Capture && earlier(j).any((k) -> ix.ids[k] == ix.ids[j]))
    .map((j) -> let (k = earlier(j).filter((k) -> ix.ids[k] == ix.ids[j]).first)
      "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) repeats the capture at \(where(ix.placed[k])); a capture runs once per stage, so "
      + (if (listOf(ix.placed[j]) == listOf(ix.placed[k]))
          "list it once, or give a re-read after a change its own title"
        else "list it once in the stage and pass it to the recipe, which reads its stdout() without listing it, or give each read its own title (in a recipe used more than once, derive it from a parameter)"))

/// The list the author wrote the step in: "" for the stage's own steps, "1"
/// for the recipe at step 2, "1.0" for a recipe nested in it.
function listOf(p: Placed): String =
  positions(p.scope).filter((k) -> k < p.scope.length - 1).map((k) -> "\(p.scope[k])").join(".")

function hostsTwice(s: core.Stage): List<String> =
  let (names = s.hosts.toList().map((h) -> h.name))
  names.filter((n) -> names.filter((m) -> m == n).length > 1).toSet().toList().map((n) -> "host \(n) is listed twice")

function playOf(_title: String, _targets: List<String>, ix: StageIndex): engine.Play = new engine.Play {
  name = _title
  targets { for (t in _targets) { t } }
  tasks { for (i, _ in ix.steps) { for (t in lower(ix, i)) { t } } }
  handlers { for (n in restartedServices(ix.steps)) { restartHandler(n) } }
}

/// One restart handler per service name, however many steps ask for it.
function restartedServices(steps: List<core.Step>): List<String> =
  steps.filter((x) -> x is systemd.Service && !x.restartOnChangeOf.isEmpty).map((x) -> x.name).toSet().toList()

/// A step, the tags it inherits from the recipes around it, and where the
/// author wrote it.
class Placed {
  step: core.Step
  /// Filled in by `identified`, after the walk: computing it during the walk
  /// would exceed pklr's depth limit (P3).
  id: String = ""
  /// Ids of the steps this step reacts to, and of the captures it reads;
  /// filled in by `identified` like `id`.
  watches: List<String> = List()
  reads: List<String> = List()
  inherited: List<String>
  /// Position in `Stage.steps`, from 1.
  written: Int
  /// Positions through the nested recipe uses that contain the step, from
  /// the stage down; `scope.first + 1 == written`.
  scope: List<Int>
}

const function placedAt(_step: core.Step, _id: String, _inherited: List<String>, _written: Int, _scope: List<Int>): Placed =
  new Placed { step = _step; id = _id; inherited = _inherited; written = _written; scope = _scope }

function identified(placed: List<Placed>): List<Placed> =
  placed.map((p) -> identify(p, key(p.step), watched(p.step).map((w) -> key(w)), capturesUsed(p.step)))

function identify(p: Placed, _id: String, _watches: List<String>, _reads: List<String>): Placed =
  new Placed { step = p.step; id = _id; watches = _watches; reads = _reads; inherited = p.inherited; written = p.written; scope = p.scope }

function withInherited(q: Placed, extra: List<String>): Placed =
  new Placed { step = q.step; id = q.id; watches = q.watches; reads = q.reads; inherited = q.inherited + extra; written = q.written; scope = q.scope }

/// Expands recipes in place. A class, because pklr cannot call a recursive
/// module function inside a lambda (P11). Official Pkl, unlike pklr, lets a
/// class body reference only const module members, so every module member
/// this class calls is `const`.
class Walker {
  function stage(steps: List<core.Step>): List<Placed> =
    positions(steps).flatMap((i) -> this.one(steps[i], List(), i + 1, List(i)))

  /// The steps of a recipe use whose scope is `_scope`.
  function walk(steps: List<core.Step>, _inherited: List<String>, _written: Int, _scope: List<Int>): List<Placed> =
    positions(steps).flatMap((k) -> this.one(steps[k], _inherited, _written, _scope + List(k)))

  /// `_scope` ends with the step's own position in its list.
  function one(s: core.Step, _inherited: List<String>, _written: Int, _scope: List<Int>): List<Placed> =
    if (!(s is core.Step)) throw(copyMessage("step"))
    else if (!canonicalStep(s)) throw(copyMessage("step"))
    else if (s is core.Capture && s.runOn != null && !(s.runOn is core.Host)) throw(copyMessage("host"))
    else if (listed(s).any((w) -> !(w is core.Step) || !canonicalStep(w))) throw(copyMessage("step"))
    else if (s is core.Recipe && s.title != null) throw("A recipe takes no title: '\(s.title)'. Title its steps instead.")
    else if (s is core.Recipe) this.walk(s.steps().toList(), _inherited + s.tags.toList(), _written, _scope)
    else List(placedAt(s, "", _inherited, _written, _scope))
}

local walker = new Walker {}

function flatten(steps: List<core.Step>): List<core.Step> = walker.walk(steps, List(), 0, List()).map((p) -> p.step)

/// A step that manages a thing appears once per stage: an exact repeat lends
/// its tags to the first occurrence. Package steps, commands, scripts and
/// services run again where they are written; a capture is listed once
/// (`repeatedCaptures`).
function merged(placed: List<Placed>): List<Placed> = placed.fold(List(), (kept, p) -> mergeOne(kept, p))

function mergeOne(kept: List<Placed>, p: Placed): List<Placed> =
  if (!mergeable(p.step) || !kept.any((q) -> q.id == p.id)) kept + List(p)
  else kept.map((q) -> if (q.id == p.id) withInherited(q, ownTags(p)) else q)

/// A step that manages a thing merges with an exact repeat. Package steps,
/// commands and scripts run again where they are written: their effect
/// depends on what ran before. Services are not merged either: each
/// occurrence carries its own restart triggers. A capture runs once per
/// stage (`repeatedCaptures`).
const function mergeable(s: core.Step): Boolean = !subjectsOf(s).isEmpty && !(s is systemd.Service)

// ── Checks: references must point at earlier steps of the same stage ───────

function problemsAt(ix: StageIndex, i: Int): List<String> =
  List(settings(ix.steps[i]), recipeDeps(ix, i), missingDeps(ix, i), silentDeps(ix, i), missingCaptures(ix, i), conflicts(ix, i), nested(ix, i), keyringModes(ix, i), packageVersions(ix, i)).flatMap((x) -> x)

/// Rules between fields of one step. Plain sentences rather than type
/// constraints: pklr reports a broken constraint without naming it (G16).
function settings(s: core.Step): List<String> =
  if (s is systemd.Service && !s.running && !s.restartOnChangeOf.isEmpty)
    List("'\(name(s))' has running = false, so it cannot restart on a change; remove restartOnChangeOf or set running = true")
  else if (s is debian.AptRepository && s.components.isEmpty != s.suite.endsWith("/"))
    List(if (s.suite.endsWith("/")) "'\(name(s))': a flat repository (suite ending in /) takes no components" else "'\(name(s))': suite \(s.suite) needs components, such as \"main\"")
  else if (s is core.Action && s.changes is core.UnlessOutput && (s.changes.stdoutContains == null) == (s.changes.stderrContains == null))
    List("'\(name(s))': UnlessOutput takes exactly one of stdoutContains and stderrContains")
  else if (s is debian.AptPackages && !packageProblems(s.names.toList()).isEmpty)
    List("'\(name(s))': \(packageProblems(s.names.toList()).first)")
  else if (s is debian.AptPackages && s.latest && s.names.toList().any((n) -> n.contains("=")))
    List("'\(name(s))': latest installs the newest version, so it cannot pin one (\(s.names.toList().filter((n) -> n.contains("=")).first)); remove the pin or set latest = false")
  else if (s is debian.AptRepository && s.suite.isEmpty)
    List("'\(name(s))': suite is empty; name a distribution such as \"stable\", or a path ending in / for a flat repository")
  else if (s is debian.AptRepository && !spaced(s).isEmpty)
    List("'\(name(s))': \(spaced(s).first) is written into the deb822 source, so it cannot contain spaces or line breaks")
  else if (s is core.Capture && (s.retry.delay < 1.s || s.retry.delay.toUnit("s").value.floor != s.retry.delay.toUnit("s").value))
    List("'\(name(s))': retry delay \(s.retry.delay) must be whole seconds, at least 1.s")
  else if (s is core.File && hasSecrets(s.content) && !secretMode(s.mode))
    List("'\(name(s))': \(s.path) holds a secret, so its mode must be 0600 or narrower, not \(s.mode)")
  else List()

/// The agent's closed selector grammar, checked here so a workflow that could
/// never run fails before the run starts.
const local selector = Regex(#"([a-z0-9][a-z0-9+.-]+)(:([a-z0-9][a-z0-9-]*))?(=(([1-9][0-9]*:)?[0-9][A-Za-z0-9.+~-]*))?"#)

const function packageProblems(names: List<String>): List<String> =
  let (bad = names.filter((n) -> !n.matches(selector) || pseudoArch(n)))
  if (!bad.isEmpty) List("unsupported package \"\(bad.first)\"; use name, name=version, name:arch or name:arch=version, with an exact version and a real architecture (not any, native or all)")
  else
    let (repeated = names.map((n) -> packageName(n)).filter((p) -> let (same = names.filter((n) -> packageName(n) == p)) same.length > 1 && (same.any((n) -> archOf(n) == null) || same.map((n) -> archOf(n)).toSet().length != same.length)))
    if (repeated.isEmpty) List() else List("package \"\(repeated.first)\" is listed more than once; list it once, or once per explicit architecture")

const function packageName(n: String): String = n.split("=").first.split(":").first
const function archOf(n: String): String? = let (s = n.split("=").first) if (s.contains(":")) s.split(":").last else null
const function pseudoArch(n: String): Boolean = let (a = archOf(n)) a != null && (List("any", "native", "all").contains(a) || a.split("-").contains("any"))

/// The first deb822 field value that contains whitespace.
const function spaced(r: debian.AptRepository): List<String> =
  List(List("url", r.url), List("suite", r.suite)).filter((f) -> hasSpace(f.last)).map((f) -> f.first)
    + (if (r.components.toList().any((c) -> c.isEmpty || hasSpace(c))) List("a component") else List())
    + (if (r.architectures.toList().any((a) -> a.isEmpty || hasSpace(a))) List("an architecture") else List())

const function hasSpace(text: String): Boolean = List(" ", "\t", "\n", "\r", "\u{b}", "\u{c}").any((c) -> text.contains(c))

/// Whether a text carries a secret reference (`module.fnox(…)`, …).
const function hasSecrets(text: String): Boolean = text.contains("__ruxel_secret_8d41.")

/// One octal digit of a file mode.
const function octal(digit: String): Int = "01234567".indexOf(digit)

/// A mode no wider than `0600`: nothing for group or other, no execute for
/// the owner — the modes a file with secret content may have. The rule reads
/// the last three digits, so the three- and four-digit spellings of one mode
/// (`600`, `0600`) are judged the same.
const function secretMode(mode: String): Boolean =
  List("0", "2", "4", "6").contains(mode.substring(mode.length - 3, mode.length - 2))
    && octal(mode.substring(mode.length - 2, mode.length - 1)) == 0
    && octal(mode.substring(mode.length - 1, mode.length)) == 0

/// The canonical four-digit spelling of a mode: Core accepts `600` and
/// `0600` as the same mode, so identity and emission read one mode, not one
/// spelling.
const function canonicalMode(mode: String): String =
  if (mode.length == 3) "0\(mode)" else mode

/// A recipe has no change of its own: name the steps that matter.
function recipeDeps(ix: StageIndex, i: Int): List<String> =
  listed(ix.steps[i]).filter((w) -> w is core.Recipe)
    .map((_) -> "'\(name(ix.steps[i]))' depends on a recipe; list the recipe's steps that matter instead")

function missingDeps(ix: StageIndex, i: Int): List<String> =
  positions(ix.placed[i].watches).filter((k) -> nearest(ix.ids, i, ix.placed[i].watches[k]) == null)
    .map((k) -> "'\(name(ix.steps[i]))' depends on '\(name(watched(ix.steps[i])[k]))', which is not an earlier step of this stage with exactly these settings")

function silentDeps(ix: StageIndex, i: Int): List<String> =
  watched(ix.steps[i]).filter((w) -> !canReportChange(w))
    .map((w) -> "'\(name(ix.steps[i]))' depends on '\(name(w))', which never reports a change")

function missingCaptures(ix: StageIndex, i: Int): List<String> =
  ix.placed[i].reads.filter((c) -> nearest(ix.ids, i, c) == null)
    .map((c) -> let (later = positions(ix.steps).filter((k) -> k > i && ix.ids[k] == c))
      if (later.isEmpty)
        "'\(name(ix.steps[i]))' (\(where(ix.placed[i]))) uses the output of a Capture that this stage does not list; list the capture earlier in the stage (a recipe that receives a capture as a parameter does not list it)"
      else
        "'\(name(ix.steps[i]))' (\(where(ix.placed[i]))) uses the output of '\(name(ix.steps[later.first]))', which comes later, at \(where(ix.placed[later.first])); list the capture before the step that reads it")

/// Two steps conflict when they manage the same thing with different
/// settings. Exact repeats were merged by `merged`; commands manage nothing.
function conflicts(ix: StageIndex, i: Int): List<String> =
  let (mine = subjectsOf(ix.steps[i]))
  earlier(i).filter((j) -> subjectsOf(ix.steps[j]).any((x) -> mine.contains(x)) && (ix.steps[j].kind != ix.steps[i].kind || identity.settings(ix.steps[j]) != identity.settings(ix.steps[i])))
    .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) both manage \(subjectsOf(ix.steps[j]).filter((x) -> mine.contains(x)).first)" + (if (ix.steps[j].kind != ix.steps[i].kind) ": \(withArticle(className(ix.steps[j]))) and \(withArticle(className(ix.steps[i])))" else " with different settings") + "; a stage declares one state for each thing, so put the second state in a later stage")

/// A regular file or a link leaves no room for anything inside it, so no
/// other step of the stage may manage a path beneath one. A Git checkout is
/// not such a leaf: steps may manage paths inside it that the repository
/// ignores (Oh My Zsh's `custom/plugins`), which no evaluation can tell
/// from tracked ones.
function nested(ix: StageIndex, i: Int): List<String> =
  earlier(i).flatMap((j) ->
    let (byEarlier = inside(leaves(ix.steps[j]), paths(ix.steps[i])))
    let (byLater = inside(leaves(ix.steps[i]), paths(ix.steps[j])))
    let (pair = if (byEarlier.isEmpty) byLater else byEarlier)
    if (pair.isEmpty) List()
    else List("'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) conflict: \(pair.first.first) is a file, so \(pair.first.last) cannot be inside it"))

/// Paths a step writes as a regular file or a link.
const function leaves(s: core.Step): List<String> =
  if (List("file", "symlink", "aptRepository").contains(s.kind)) subjectsOf(s) else List()

/// Apt repositories manage `/etc/apt/keyrings` (0755, one shared task), so
/// a `Directory` there would declare a second state for it.
function keyringModes(ix: StageIndex, i: Int): List<String> =
  earlier(i).filter((j) -> keyringClash(ix.steps[j], ix.steps[i]) || keyringClash(ix.steps[i], ix.steps[j]))
    .map((j) -> "'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) both manage /etc/apt/keyrings: apt repositories create it (0755), so remove the Directory")

const function keyringClash(a: core.Step, b: core.Step): Boolean =
  a is debian.AptRepository && b is core.Directory && b.path == "/etc/apt/keyrings"

/// Two package steps of a stage must agree on a package's version: pins that
/// differ, or a pin and a `latest` step, would change it back and forth.
/// Exact repeats are fine. A selector without an architecture may be any.
function packageVersions(ix: StageIndex, i: Int): List<String> =
  if (!(ix.steps[i] is debian.AptPackages)) List()
  else earlier(i).filter((j) -> ix.steps[j] is debian.AptPackages).flatMap((j) ->
    let (clashes = ix.steps[i].names.toList().flatMap((a) -> ix.steps[j].names.toList().filter((b) -> versionClash(ix.steps[j], b, ix.steps[i], a)).map((b) -> List(b, a))))
    if (clashes.isEmpty) List()
    else List("'\(name(ix.steps[j]))' (\(where(ix.placed[j]))) and '\(name(ix.steps[i]))' (\(where(ix.placed[i]))) ask for different versions of \(packageName(clashes.first.first)) (\(clashes.first.first) and \(clashes.first.last)\(if (ix.steps[j].latest || ix.steps[i].latest) ", one upgrading" else "")); a stage declares one state for each thing, so put the second in a later stage"))

const function versionClash(p: debian.AptPackages, a: String, q: debian.AptPackages, b: String): Boolean =
  packageName(a) == packageName(b)
    && (archOf(a) == null || archOf(b) == null || archOf(a) == archOf(b))
    && (versionOf(a) != null && versionOf(b) != null && versionOf(a) != versionOf(b)
      || versionOf(a) != null && q.latest
      || versionOf(b) != null && p.latest)

const function versionOf(n: String): String? = if (n.contains("=")) n.split("=").last else null

const function paths(s: core.Step): List<String> = subjectsOf(s).filter((x) -> x.startsWith("/"))

/// Pairs `(file, path)` where `path` lies beneath `file`.
const function inside(files: List<String>, candidates: List<String>): List<List<String>> =
  files.flatMap((f) -> candidates.filter((p) -> p.startsWith(f + "/")).map((p) -> List(f, p)))

function className(s: core.Step): String = s.kind.capitalize()

function withArticle(word: String): String = (if ("AEIOU".contains(word.take(1))) "an " else "a ") + word

/// Where the author wrote a step: `step 2`, `step 4 of the recipe at step 1`,
/// or `step 2 of the recipe at step 3 of the recipe at step 1`.
function where(p: Placed): String =
  positions(p.scope).fold("", (acc, k) ->
    if (k == 0) "step \(p.scope[0] + 1)" else "step \(p.scope[k] + 1) of the recipe at " + acc)

/// Steps listed in `onChangeOf` or `restartOnChangeOf`, as written.
const function listed(s: core.Step): List<core.Step> =
  if (s is core.Action) s.onChangeOf.toList()
  else if (s is systemd.Service) s.restartOnChangeOf.toList()
  else List()

/// Steps whose change this step reacts to. Recipes are rejected by
/// `recipeDeps`.
function watched(s: core.Step): List<core.Step> = listed(s).filter((w) -> !(w is core.Recipe))

function canReportChange(s: core.Step): Boolean =
  !(s is core.Capture || s is debian.AptPackageIndex || (s is core.Action && s.changes == "never"))

/// Ids of the captures whose output this step's content uses.
function capturesUsed(s: core.Step): List<String> =
  if (s is core.File) placeholder.findMatchesIn(s.content).map((m) -> m.groups[1].value)
    .filter((p) -> p.startsWith("results.")).map((p) -> p.split(".")[1])
  else List()

// ── Identity, names and tags ────────────────────────────────────────────────

/// A step's identity: its kind and every setting that shapes its tasks. For
/// a command or script that includes, recursively, the identity of every
/// step it reacts to. For a step that does not merge (`mergeable`) it
/// includes the step's line in the plan; for a step that merges it does not.
/// Steps are never compared with `==` (P12).
function key(s: core.Step): String = identity.key(s)

/// A class, like `Walker`: pklr cannot recurse through a module function
/// inside a lambda (P11). Settings are encoded with `fields`, so no two
/// different settings print alike.
class Identity {
  function key(s: core.Step): String =
    // 128 bits: no one can make two different steps share an identity.
    if (s is core.Capture) s.id() else "\(s.kind)_" + this.fingerprint(s).sha256.substring(0, 32)

  function fingerprint(s: core.Step): String =
    (if (mergeable(s)) "" else fields(List(label(s)))) + this.settings(s)

  function settings(s: core.Step): String =
    if (!(s is core.Action)) stateFingerprints[s.kind].apply(s)
    // The recursive part, the keys of the steps this one reacts to, stays
    // outside `fields`: every level counts against pklr's depth limit along
    // a chain. Keys are generated (`<kind>_<hex>`), so a plain join after the
    // self-delimiting fields is unambiguous.
    else fields(List(if (s is core.Command) fields(s.run.toList()) else s.bash, optional(s.creates), changesText(s))) + envFingerprint(s)
      + listed(s).map((w) -> if (w is core.Recipe) "recipe" else this.key(w)).join(",")
}

/// A command's environment in its identity: two commands that differ only in
/// their environment are different steps. Entries in canonical key order —
/// the same pairs in another declaration order are one action — and a value
/// as its text (`SecretText.toString()` is the reference placeholder, which
/// no static text can contain, so the two cannot collide).
const function envFingerprint(s: core.Step): String =
  if (!(s is core.Action)) ""
  else keyOrder.canonical(s.environment.keys.toList()).map((k) -> fields(List(k, s.environment[k].toString()))).join("")

local identity = new Identity {}

/// Canonical key order for a fingerprint: declaration order is an accident
/// of authoring, so the same mapping written in another order must
/// fingerprint alike. pklr has no `sort`, so this is an insertion sort; the
/// keys are validated (`EnvKey` is `[A-Za-z_][A-Za-z0-9_]*`), so plain
/// string comparison is the one order both evaluators agree on. A class,
/// like `Walker`: pklr cannot recurse through a module function inside a
/// lambda (P11); every module member it calls is `const`, which official Pkl
/// requires of a class body.
class KeyOrder {
  function canonical(keys: List<String>): List<String> =
    keys.fold(List(), (sorted, key) -> this.insert(key, sorted))

  function insert(key: String, sorted: List<String>): List<String> =
    if (sorted.isEmpty || key <= sorted.first)
      List(key) + sorted
    else List(sorted.first) + this.insert(key, this.tail(sorted))

  /// pklr has no `drop`; the tail is rebuilt by position.
  function tail(sorted: List<String>): List<String> =
    positions(sorted).filter((i) -> i > 0).map((i) -> sorted[i])
}

const local keyOrder = new KeyOrder {}

const local stateFingerprints: Mapping<String, (core.Step) -> String> = new {
  ["file"] = (s) -> fields(List(s.path, s.content.sha256, canonicalMode(s.mode), optional(s.owner), optional(s.group), fields(s.validate.toList())))
  ["directory"] = (s) -> fields(List(s.path, canonicalMode(s.mode)))
  ["symlink"] = (s) -> fields(List(s.path, s.target))
  ["packageIndex"] = (_) -> ""
  ["packages"] = (s) -> fields(List(fields(s.names.toList()), "\(s.latest)"))
  ["aptRepository"] = (s) -> fields(List(s.name, s.url, s.suite, fields(s.components.toList()), s.signingKey, fields(s.architectures.toList())))
  ["timezone"] = (s) -> s.name
  ["loginShell"] = (s) -> fields(List(s.user, s.shell))
  ["gitCheckout"] = (s) -> fields(List(s.repository, s.path, s.commit))
  // Restart triggers add up across steps, so they are not part of identity.
  ["service"] = (s) -> fields(List(s.name, "\(s.enabled)", "\(s.running)"))
  ["capture"] = (s) -> s.id()
}

const function changesText(a: core.Action): String =
  if (a.changes is core.UnlessOutput) fields(List("unless", optional(a.changes.stdoutContains), optional(a.changes.stderrContains))) else a.changes

/// What a step manages; empty for steps that manage nothing. An apt
/// repository manages the two files it writes, so a `File` at either path
/// conflicts with it.
const function subjectsOf(s: core.Step): List<String> = subjects[s.kind].apply(s)

const local subjects: Mapping<String, (core.Step) -> List<String>> = new {
  ["file"] = (s) -> List(s.path) + (if (s.validate.isEmpty) List() else List(candidate(s)))
  ["directory"] = (s) -> List(s.path)
  ["symlink"] = (s) -> List(s.path)
  ["gitCheckout"] = (s) -> List(s.path)
  ["aptRepository"] = (s) -> List(sourcesPath(s), keyringPath(s))
  ["service"] = (s) -> List("service \(unitName(s.name))")
  ["loginShell"] = (s) -> List("the login shell of \(s.user)")
  ["timezone"] = (_) -> List("the timezone")
  ["packages"] = (_) -> List()
  ["packageIndex"] = (_) -> List()
  ["command"] = (_) -> List()
  ["script"] = (_) -> List()
  ["capture"] = (_) -> List()
}

/// systemd's name for a service: `foo` is `foo.service`.
const function unitName(name: String): String = if (name.contains(".")) name else "\(name).service"

const function sourcesPath(r: debian.AptRepository): String = "/etc/apt/sources.list.d/\(r.name).sources"
const function keyringPath(r: debian.AptRepository): String = "/etc/apt/keyrings/\(r.name).asc"

function name(s: core.Step): String = label(s)

/// The step's line in the plan: its title, or the generated description.
const function label(s: core.Step): String = s.title ?? (if (s is core.Recipe) "a recipe" else describe(s))

function restartName(serviceName: String): String = "Restart \(serviceName)"

/// Common task fields, worked out once per step.
class Meta {
  name: String
  tags: List<String>
  notify: List<String>
  register: String?
  /// Result names of the steps this step reacts to.
  watching: List<String> = List()
  /// Environment values, as engine expressions: literals for static text,
  /// lookups for secrets. Only actions have any.
  environment: Mapping<String, engine.Expr> = new {}
  /// Whether a secret appears in the step: such a task is never logged.
  noLog: Boolean = false
}

function metaOf(ix: StageIndex, i: Int, _tags: List<String>): Meta =
  let (_name = name(ix.steps[i]))
  let (_notify = dependents(ix, i).filter((j) -> ix.steps[j] is systemd.Service).map((j) -> restartName(ix.steps[j].name)).toSet().toList())
  let (_register = if (dependents(ix, i).any((j) -> ix.steps[j] is core.Action) || ix.steps[i] is core.Capture) ix.results[i] else null)
  new Meta { name = _name; tags = _tags; notify = _notify; register = _register; watching = ix.deps[i].map((j) -> ix.results[j]); environment = envOf(ix.steps[i]); noLog = secretStep(ix.steps[i]) }

/// Positions of the steps that react to step `i` or read its output. They
/// always come later in the stage.
function dependents(ix: StageIndex, i: Int): List<Int> =
  positions(ix.steps).filter((j) -> ix.deps[j].contains(i) || ix.uses[j].contains(i))

/// A step runs under its own tags, its recipes' tags, and the tags of every
/// step that depends on it, directly or not, so `--tags` never runs a step
/// without what it reads. One pass from the last step to the first sees each
/// dependent's final tags.
function allTags(ix: StageIndex): List<List<String>> =
  let (n = ix.steps.length)
  let (backwards = positions(ix.steps).fold(List(), (later, k) -> later + List(tagsOf(ix, n - 1 - k, later))))
  positions(ix.steps).map((i) -> backwards[n - 1 - i])

/// `later[k]` holds the tags of step `n - 1 - k`.
function tagsOf(ix: StageIndex, i: Int, later: List<List<String>>): List<String> =
  (ownTags(ix.placed[i]) + dependents(ix, i).flatMap((j) -> later[ix.steps.length - 1 - j])).toSet().toList()

function ownTags(p: Placed): List<String> = p.step.tags.toList() + p.inherited

function helperMeta(_name: String, m: Meta, _register: String?): Meta =
  new Meta { name = _name; tags = m.tags; notify = List(); register = _register; noLog = m.noLog }

// ── Steps ───────────────────────────────────────────────────────────────────

/// The description shown in plans when a step has no `title`.
const function describe(s: core.Step): String = describers[s.kind].apply(s)

const local describers: Mapping<String, (core.Step) -> String> = new {
  ["file"] = (s) -> "Write \(s.path)"
  ["directory"] = (s) -> "Create directory \(s.path)"
  ["symlink"] = (s) -> "Link \(s.path) to \(s.target)"
  ["packageIndex"] = (_) -> "Refresh apt package index"
  ["packages"] = (s) -> (if (s.latest) "Install or upgrade " else "Install ") + s.names.join(", ")
  ["aptRepository"] = (s) -> "Configure \(s.name) apt repository"
  ["timezone"] = (s) -> "Set timezone to \(s.name)"
  ["loginShell"] = (s) -> "Set \(s.user) login shell to \(s.shell)"
  ["gitCheckout"] = (s) -> "Check out \(s.repository) into \(s.path)"
  ["service"] = (s) -> (if (s.running) "Start " else "Stop ") + s.name + (if (s.enabled) ", enabled at boot" else ", disabled at boot")
  ["command"] = (s) -> "Run " + s.run.join(" ")
  ["script"] = (s) -> "Run script " + s.bash.trim().split("\n").first
  ["capture"] = (s) -> s.description()
}

/// A table, not an `if … else if` chain: pklr counts each `else if` against
/// its depth limit of 32 (P3).
function lower(ix: StageIndex, i: Int): List<engine.Task> =
  (if (firstRepository(ix) == i) List(keyringsTask(ix)) else List()) + lowerers[ix.steps[i].kind].apply(ix.steps[i], ix.metas[i])

/// The stage's first apt repository, which creates `/etc/apt/keyrings` once
/// for all of them.
function firstRepository(ix: StageIndex): Int? =
  let (repositories = positions(ix.steps).filter((k) -> ix.steps[k] is debian.AptRepository))
  if (repositories.isEmpty) null else repositories.first

/// One task for the directory every repository of the stage writes its key
/// into: root's, 0755, so nobody else can replace a key. It runs under all
/// the repositories' tags and notifies all their services, and steps
/// reacting to any of them see its result (`anyChanged`).
function keyringsTask(ix: StageIndex): engine.Task =
  let (owners = positions(ix.steps).filter((k) -> ix.steps[k] is debian.AptRepository))
  task(new Meta {
    name = "Create /etc/apt/keyrings"
    tags = owners.flatMap((k) -> ix.metas[k].tags).toSet().toList()
    notify = owners.flatMap((k) -> ix.metas[k].notify).toSet().toList()
    register = keyringsResult
  }, (directory("/etc/apt/keyrings", "0755")) { owner = "root"; group = "root" }, null, null)

const keyringsResult: String = "aptKeyrings"

local lowerers: Mapping<String, (core.Step, Meta) -> List<engine.Task>> = new {
  ["file"] = (s, m) -> validateTasks(s, m) + List(task(m, copy(s.path, s), null, null))
  ["directory"] = (s, m) -> List(task(m, directory(s.path, s.mode), null, null))
  ["symlink"] = (s, m) -> List(task(m, symlink(s.path, s.target), null, null))
  ["packageIndex"] = (_, m) -> List(task(m, command(List("apt-get", "-q", "update"), null, null), null, lit(false)))
  ["packages"] = (s, m) -> List(task(m, apt(s.names.toList(), s.latest), null, null))
  ["aptRepository"] = (s, m) -> List(task(keyringMeta(s, m), keyring(s), null, null), task(m, sourcesFile(s), null, null))
  ["timezone"] = (s, m) -> List(task(m, timezone(s.name), null, null))
  ["loginShell"] = (s, m) -> List(accountProbe(s.user, m), task(m, user(s.user, s.shell), null, null))
  ["gitCheckout"] = (s, m) -> List(task(m, git(s.repository, s.path, s.commit), null, null))
  ["service"] = (s, m) -> List(task(m, service(s.name, s.enabled, if (s.running) "started" else "stopped"), null, null))
  ["command"] = (s, m) -> actionTasks(s, s.run.toList(), m)
  ["script"] = (s, m) -> actionTasks(s, bash(s.bash), m)
  ["capture"] = (s, m) -> List(captureTask(task(m, command(bash(s.bash), null, null), null, lit(false)), s, m.register))
}

// File: stage, validate, then publish. A secret's candidate is temporary:
// validation removes it in the block's `always`, success or failure, so no
// resolved plaintext survives the run. A file without secrets keeps the
// persistent candidate, so a second apply reports no change.
function validateTasks(f: core.File, m: Meta): List<engine.Task> =
  if (f.validate.isEmpty) List()
  else if (hasSecrets(f.content)) List(temporaryValidation(f, m))
  else List(
    task(helperMeta("Stage \(f.path)", m, null), candidateCopy(f), null, null),
    task(helperMeta("Validate \(f.path)", m, null), validateCommand(f), null, lit(false))
  )

/// The validation of a secret-bearing file, one block task: the candidate is
/// staged and the validator run in the block, and the candidate removed in
/// `always`, which the engine runs whether the validator succeeds, fails or
/// errors — a plain sequence would stop at the failure and leave the
/// resolved secret on the host.
function temporaryValidation(f: core.File, m: Meta): engine.Task =
  blockTask(
    helperMeta("Validate \(f.path)", m, null),
    List(
      task(helperMeta("Stage \(f.path)", m, null), candidateCopy(f), null, lit(false)),
      task(helperMeta("Validate \(f.path)", m, null), validateCommand(f), null, lit(false))
    ),
    List(task(helperMeta("Remove \(candidate(f))", m, null), candidateRemoval(f), null, lit(false)))
  )

function validateCommand(f: core.File): engine.Command =
  command(f.validate.toList().map((a) -> a.replaceAll("%s", candidate(f))), null, null)

/// Absence is idempotent, so the cleanup removes the candidate once and never
/// reports a change again.
function candidateRemoval(f: core.File): engine.File = new engine.File { path = candidate(f); state = "absent" }

/// A task with no operation of its own that runs its block and then its
/// `always`. No register: the engine refuses one on a block task.
function blockTask(m: Meta, _block: List<engine.Task>, _always: List<engine.Task>): engine.Task = new engine.Task {
  name = m.name
  tags { for (t in m.tags) { t } }
  environment { for (k, v in m.environment) { [k] = v } }
  noLog = m.noLog
  block { for (t in _block) { t } }
  always { for (t in _always) { t } }
}

/// The candidate is root's alone (0600), whatever the file's owner, so no one
/// else can change it between staging and validation.
function candidateCopy(f: core.File): engine.Copy = new engine.Copy {
  dest = candidate(f)
  content = runtimeText(f.content)
  mode = "0600"
  owner = "root"
  group = "root"
}

/// `.<name>.ruxel-candidate` beside the file: validators that resolve
/// relative includes still work, and `*`, `*.conf` and `*.d` loaders skip
/// dotfiles. For a file without secrets it stays, so that a second apply
/// reports no change; a secret-bearing file's candidate is temporary
/// (`temporaryValidation`).
const function candidate(f: core.File): String =
  let (slash = f.path.lastIndexOf("/"))
  let (base = f.path.substring(slash + 1, f.path.length))
  // A file name has at most 255 bytes; a long or non-ASCII one is hashed.
  "\(f.path.substring(0, slash + 1)).\(if (base.length <= 238 && base.matches(Regex("[ -~]*"))) base else base.sha256.substring(0, 32)).ruxel-candidate"

/// The keyring task notifies and registers too: a new key is a change of
/// the repository.
function keyringMeta(r: debian.AptRepository, m: Meta): Meta = new Meta {
  name = "Install \(r.name) apt signing key"
  tags = m.tags
  notify = m.notify
  register = if (m.register == null) null else "\(m.register)_key"
}

function keyring(r: debian.AptRepository): engine.Copy = copyText(keyringPath(r), r.signingKey)

function sourcesFile(r: debian.AptRepository): engine.Copy = copyText(sourcesPath(r), new Listing {
  "Types: deb"
  "URIs: \(r.url)"
  "Suites: \(r.suite)"
  when (!r.components.isEmpty) { "Components: \(r.components.join(" "))" }
  when (!r.architectures.isEmpty) { "Architectures: \(r.architectures.join(" "))" }
  "Signed-By: \(keyringPath(r))"
}.join("\n") + "\n")

// Command and Script: a `creates` guard is a probe and a `when` condition, so
// the controller checks the path before it resolves the task's environment: a
// skipped action reads no secret store. That probe is stale by the time the
// command executes, so the command carries the path too and the agent re-stats
// it itself before it runs (`Command.creates`). `onChangeOf` needs the watched
// steps' results beside the probe; the agent gets them handed down as
// `Command.run_if_changed`, the same disjunct its `when` carries, because it
// cannot read the controller's results.
function actionTasks(a: core.Action, argv: List<String>, m: Meta): List<engine.Task> =
  let (watched = if (a.onChangeOf.isEmpty) null else anyChanged(m.watching))
  if (a.creates == null)
    List(task(m, command(argv, null, watched), watched, changeRule(a)))
  else List(
    task(helperMeta("Check whether \(a.creates) exists", m, probeKey(a.creates)), stat(a.creates), null, null),
    task(m, command(argv, a.creates, watched), createsGuard(a, m), changeRule(a))
  )

/// The command runs when the created path is absent, or when any watched step
/// changed: a watcher must re-run the action that created nothing yet.
function createsGuard(a: core.Action, m: Meta): engine.Expr =
  if (a.onChangeOf.isEmpty) existsGuard(a)
  else call2("or", anyChanged(m.watching), existsGuard(a))

/// The probe's registered `stat.exists`, negated: the guarded command runs
/// only when the path is missing.
function existsGuard(a: core.Action): engine.Expr =
  call1("not", ref(List("results", probeKey(a.creates), "stat", "exists")))

/// `or` of the `changed` results of the watched steps. An apt repository
/// also changes when only its keyring does.
function anyChanged(ids: List<String>): engine.Expr =
  ids.flatMap((id) -> if (id.startsWith("aptRepository_")) List(id, "\(id)_key", keyringsResult) else List(id))
    .map((id) -> ref(List("results", id, "changed")))
    .fold(null, (acc, e) -> if (acc == null) e else call2("or", acc, e))

/// `always` is a change whenever the command runs, and in check and diff
/// whenever it would run: the engine skips it there (`skipped`), and the
/// steps that react to it must still see a pending change. A `creates` skip
/// is two different things: the probe's `when` skips the task on the
/// controller, before `changedWhen` is ever evaluated, and a step not
/// selected by `onChangeOf` stays unchanged; the agent's own recheck skips
/// with `skip.cause` and reports no change (`ran`).
function changeRule(a: core.Action): engine.Expr =
  if (a.changes == "never") lit(false)
  else if (a.changes is core.UnlessOutput) unlessOutput(a.changes, ran(a))
  else ran(a)

/// The command ran, or would run in check and diff — except when the agent's
/// recheck of `creates` skipped it: the path exists now, so there was nothing
/// to run and there is nothing to report. Every other skip is a check-mode
/// skip of a command that would have run.
function ran(a: core.Action): engine.Expr =
  call2("or", ref(List("result", "changed")),
    if (a.creates == null) pendingSkipped()
    else call2("and", pendingSkipped(), call2("ne", skipCause(), lit(createsRecheckSkip))))

/// Whether the agent did not run the command because the mode says so: the
/// engine reports `skipped` in check and diff, without a reason of its own.
function pendingSkipped(): engine.Expr = call2("default", ref(List("result", "skipped")), lit(false))

/// The reason the agent skipped with, empty for every skip without one.
function skipCause(): engine.Expr = call2("default", ref(List("result", "skip", "cause")), lit(""))

/// `skip.cause` of the agent's `creates` recheck; the agent spells it the
/// same way, and only that skip reports no change.
const createsRecheckSkip = "creates_exists"

/// Changed when the command ran or would run (see `changeRule`; a `creates`
/// recheck skip reports no change) and its output lacks the marker. In check
/// and diff the output is empty, so a command that would run counts as a change.
function unlessOutput(u: core.UnlessOutput, wouldRun: engine.Expr): engine.Expr = call2("and", wouldRun,
  if (u.stdoutContains != null) call1("not", call2("contains", ref(List("result", "stdout")), lit(u.stdoutContains)))
  else call1("not", call2("contains", ref(List("result", "stderr")), lit(u.stderrContains))))

/// The engine's user operation creates a missing account. This step only
/// changes an existing one, so a read-only probe fails first, in check and
/// diff too. It looks the name up exactly as the user operation does: a
/// literal name in /etc/passwd, not NSS and not a numeric ID. The name is
/// only ever passed as a quoted argument.
///
/// CAT.03 renamed the class `LoginShell` to `User`, which is to create a
/// missing account (building-blocks §3.2). The probe then contradicts the
/// class: dropping it is Lowering surgery beyond the rename and waits for
/// the serial Lowering queue, so it stays and the step still changes the
/// shell of an existing account only.
function accountProbe(account: String, m: Meta): engine.Task = (task(helperMeta("Check that account \(account) exists", m, null), command(bash(
  "awk -F: 'BEGIN { account = ARGV[1]; ARGV[1] = \"\" } $1 == account { found = 1 } END { exit !found }' \(shellQuote(account)) /etc/passwd || { printf 'account %s does not exist in /etc/passwd; User changes the shell of an existing account\\n' \(shellQuote(account)) >&2; exit 1; }"
), null, null), null, lit(false))) { checkMode = false }

function shellQuote(s: String): String = "'" + s.replaceAll("'", #"'\''"#) + "'"

function probeKey(path: String): String = "exists_" + path.sha256.substring(0, 32)

function restartHandler(serviceName: String): engine.Task =
  task(new Meta { name = restartName(serviceName); tags = List(); notify = List(); register = null }, service(serviceName, null, "restarted"), null, null)

function bash(script: String): List<String> = List("/bin/bash", "-c", "set -euo pipefail\n" + script)

// ── Engine constructors ─────────────────────────────────────────────────────

function task(m: Meta, _operation: engine.Operation, _when: engine.Expr?, _changedWhen: engine.Expr?): engine.Task = new engine.Task {
  name = m.name
  operation = _operation
  tags { for (t in m.tags) { t } }
  notify { for (n in m.notify) { n } }
  environment { for (k, v in m.environment) { [k] = v } }
  noLog = m.noLog
  when (_when != null) { `when` = _when }
  when (_changedWhen != null) { changedWhen = _changedWhen }
  when (m.register != null) { register = m.register }
}

/// A capture runs in check and diff too (`checkMode = false`): later steps
/// need its real output, and it only reads.
function captureTask(t: engine.Task, c: core.Capture, _result: String): engine.Task = (t) {
  checkMode = false
  when (c.runOn != null) { delegateTo = c.runOn.name; delegateAllow = new Listing { c.runOn.name } }
  when (c.retry.attempts > 1) {
    retries = c.retry.attempts - 1
    delaySeconds = c.retry.delay.toUnit("s").value.toInt()
    until = call2("eq", ref(List("results", _result, "rc")), lit(0))
  }
}

function copy(_dest: String, f: core.File): engine.Copy = new engine.Copy {
  dest = _dest
  content = runtimeText(f.content)
  mode = canonicalMode(f.mode)
  owner = f.owner
  group = f.group
}

function copyText(_dest: String, _content: String): engine.Copy =
  new engine.Copy { dest = _dest; content = _content; mode = "0644"; owner = "root"; group = "root" }

function directory(_path: String, _mode: String): engine.File = new engine.File { path = _path; state = "directory"; mode = canonicalMode(_mode) }
function symlink(_path: String, _target: String): engine.File = new engine.File { path = _path; src = _target; state = "link" }
function apt(_names: List<String>, _upgrade: Boolean): engine.Apt = new engine.Apt {
  name = if (_names.length == 1) _names.first else new Listing { for (n in _names) { n } }
  state = if (_upgrade) "latest" else "present"
}
function timezone(_name: String): engine.Timezone = new engine.Timezone { name = _name }
function user(_name: String, _shell: String): engine.User = new engine.User { name = _name; shell = _shell }
function git(_repo: String, _dest: String, _version: String): engine.Git = new engine.Git { repo = _repo; dest = _dest; version = _version }
function service(_name: String, _enabled: Boolean?, _state: String): engine.Service = new engine.Service { name = _name; enabled = _enabled; state = _state }
/// Follows links, as the `creates` guard does: a dangling
/// link does not count as the path existing.
function stat(_path: String): engine.Stat = new engine.Stat { path = _path; follow = true }
/// The command itself, with its guard: `_creates` is the path the agent
/// re-stats before it executes, `_runIfChanged` the watched-step result that
/// makes the path stale (`onChangeOf`). Neither is a change rule; that is the
/// task's `changedWhen`.
function command(_argv: List<String>, _creates: String?, _runIfChanged: engine.Expr?): engine.Command = new engine.Command {
  argv = new Listing { for (a in _argv) { a } }
  when (_creates != null) { creates = _creates }
  when (_runIfChanged != null) { run_if_changed = _runIfChanged }
}

// ── Run-time and secret text ────────────────────────────────────────────────

local placeholder = Regex(#"__ruxel_rt_8d41\.([A-Za-z0-9_.]+?)__"#)
local knownPlaceholder = Regex(#"inventoryHost|vars\.ruxel_address|results\.capture_[0-9a-f]{32}\.stdout"#)
/// One regex for both, because pklr has no `sortBy` to order two match lists:
/// a match carries group 1 when it is a run-time value, group 2 when it is a
/// secret. The payloads are disjoint (`[A-Za-z0-9_.]` cannot spell a secret
/// encoding), so one scan cannot take a placeholder of one kind for the
/// other. The secret payload is captured permissively — across lines too, as
/// a `join` separator may carry a newline — but tempered against the `__`
/// terminator, and the terminator may not open another reserved prefix: a
/// placeholder can never swallow a later one, an unterminated placeholder
/// fails the prefix count in `segmentsOf` and is refused. Malformed text is
/// parsed and refused, never left behind as literal content.
const local anyPlaceholder = Regex(#"__ruxel_rt_8d41\.([A-Za-z0-9_.]+?)__|__ruxel_secret_8d41\.((?:(?!__)[\s\S])*?)__(?!ruxel_(?:rt|secret)_8d41\.)"#)
const local secretPrefix = Regex(#"__ruxel_secret_8d41\."#)

/// Text without placeholders stays a string. Run-time placeholders
/// (`currentHost`, `Capture.stdout()`) become engine references, secret
/// placeholders (`module.fnox(…)`, …) engine lookups, inside a `concat`.
///
/// The literal pieces come from match positions, not `split`: like Java's,
/// `split` drops trailing empty pieces, which loses a placeholder at the end.
function runtimeText(text: String): engine.Text =
  let (segs = segmentsOf(text))
  if (segs.isEmpty) text
  else new engine.Call {
    `function` = "concat"
    args {
      for (k, seg in segs) {
        lit(text.substring(if (k == 0) 0 else segs[k - 1].end, seg.start))
        ...(seg.exprs())
      }
      lit(text.substring(segs.last.end, text.length))
    }
  }

/// One placeholder in a text: a run-time value (`runtime`) or a secret
/// reference (`secret`), and where it sits. A secret lowers to one engine
/// expression per part, so a joined pair stays visible as two lookups.
class Segment {
  start: Int
  end: Int
  runtime: String?
  secret: String?

  function exprs(): List<engine.Expr> =
    if (secret != null) parser.exprs(secret) else List(ref((runtime ?? "").split(".")))
}

const function segmentAt(_start: Int, _end: Int, _runtime: String?, _secret: String?): Segment =
  new Segment { start = _start; end = _end; runtime = _runtime; secret = _secret }

/// Every placeholder of a text, in order. A run-time placeholder the language
/// does not know is refused here, like a secret reference that does not
/// decode (in `SecretParser`).
function segmentsOf(text: String): List<Segment> =
  let (all = anyPlaceholder.findMatchesIn(text).map((m) ->
    if (m.groups[1] != null)
      segmentAt(codePointOffset(text, m.start), codePointOffset(text, m.end), m.groups[1].value, null)
    else
      segmentAt(codePointOffset(text, m.start), codePointOffset(text, m.end), null, m.groups[2].value)))
  let (prefixes = secretPrefix.findMatchesIn(text).length)
  let (secrets = all.filter((s) -> s.secret != null).length)
  let (badSecret = all.filter((s) -> s.secret != null && ((s.secret ?? "").isEmpty || (s.secret ?? "").contains("_"))))
  let (strange = all.filter((s) -> s.runtime != null && !(s.runtime ?? "").matches(knownPlaceholder)))
  if (prefixes > secrets || !badSecret.isEmpty) throw(malformed)
  else if (!strange.isEmpty) throw("File content contains an unknown run-time value: __ruxel_rt_8d41.\(strange.first.runtime ?? "")__")
  else all

/// Regex match offsets count UTF-16 code units, while Pkl string indexes
/// count code points. Convert an offset to the code-point index `substring`
/// expects. Every non-BMP code point contributes two UTF-16 units; the
/// cumulative boundaries therefore map each valid UTF-16 offset back to its
/// code-point index.
const function intBoundaries(): List<Int> = new Listing<Int> { 0 }.toList()

const function codePointOffset(text: String, utf16Offset: Int): Int =
  let (widths = text.codePoints.toList().map((point) -> if (point > 0xffff) 2 else 1))
  let (boundaries = widths.fold(intBoundaries(), (units, width) -> units + List(units.last + width)))
  let (matches = positions(boundaries).filter((i) -> boundaries[i] == utf16Offset))
  if (matches.isEmpty) throw("File content contains a placeholder at an invalid Unicode boundary")
  else matches.first

/// Decodes the reference encoding of a secret (`core.SecretText.parts`): one
/// engine lookup per store part, a literal per `join` separator, in the
/// authoring grammar `lookup (separator lookup)*` — `join` writes a
/// separator only between two lookups, so a leading, doubled or trailing
/// separator is a forged encoding, refused as malformed rather than lowered
/// to a lookup plus arbitrary static text. A class, like `Walker`: pklr
/// cannot recurse through a module function inside a lambda (P11); every
/// module member it calls is `const`, which official Pkl requires of a class
/// body.
class SecretParser {
  /// A complete encoding is never empty and never contains a literal `_`:
  /// the length-prefixed encoding writes every underscore as `\u{1f}`.
  /// Those are structural failures of the encoding, so they use the one
  /// malformed-reference sentence rather than a later atom's error.
  function exprs(code: String): List<engine.Expr> =
    if (code.isEmpty || code.contains("_")) throw(malformed)
    else this.afterLookup(code)

  /// A lookup may end the encoding; a separator may not sit at the start.
  function afterLookup(code: String): List<engine.Expr> =
    if (code.isEmpty) throw(malformed)
    else (let (head = this.lookup(code))
      if (head.rest.isEmpty) head.exprs
      else head.exprs + this.afterSeparator(head.rest))

  /// A separator must sit between two lookups: what follows is a lookup,
  /// never the end of the encoding.
  function afterSeparator(code: String): List<engine.Expr> =
    (let (head = this.separator(code)) head.exprs + this.afterLookup(head.rest))

  function separator(code: String): Atom =
    let (tag = code.take(1))
    let (body = code.substring(1, code.length))
    if (tag == "s")
      let (v = this.take(body)) atom(List(lit(separatorValidated(unescape(v[0])))), v[1])
    else throw(malformed)

  function lookup(code: String): Atom =
    let (tag = code.take(1))
    let (body = code.substring(1, code.length))
    if (tag == "f")
      let (v = this.take(body)) atom(List(fnoxLookup(fnoxKeyValidated(unescape(v[0])))), v[1])
    else if (tag == "g")
      let (key = this.take(body)) (let (format = this.take(key[1])) atom(List(fnoxLookup(fnoxKeyValidated(unescape(key[0])))), formatValidated(unescape(format[0]), format[1])))
    else if (tag == "r")
      let (v = this.take(body)) atom(List(opReference(opReferenceValidated(unescape(v[0])))), v[1])
    else if (tag == "o")
      let (vault = this.take(body))
      let (item = this.take(vault[1]))
      let (section = this.take(item[1]))
      let (field = this.take(section[1]))
      atom(List(opFields(opLabelValidated("vault", unescape(vault[0])), opLabelValidated("item", unescape(item[0])), if (section[0].isEmpty) null else opSectionValidated(unescape(section[0])), opFieldValidated(unescape(field[0])))), field[1])
    else throw(malformed)

  /// Reads one length-prefixed string of the encoding: the text, and the
  /// rest. A digit run longer than six cannot fit the text that remains.
  function take(body: String): List<String> =
    let (heads = sizedHead.findMatchesIn(body))
    if (heads.isEmpty || heads.first.groups[1].value.length > 6 || heads.first.end + heads.first.groups[1].value.toInt() > body.length) throw(malformed)
    else
      let (size = heads.first.groups[1].value.toInt())
      List(body.substring(heads.first.end, heads.first.end + size), body.substring(heads.first.end + size, body.length))
}

/// One parsed atom of a secret reference: what it lowers to, and the rest of
/// the encoding.
class Atom {
  exprs: List<engine.Expr>
  rest: String
}

const function atom(_exprs: List<engine.Expr>, _rest: String): Atom =
  new Atom { exprs = _exprs; rest = _rest }

const local parser = new SecretParser {}
const local sizedHead = Regex(#"^([0-9]+):"#)
const malformed: String = "File content contains a malformed secret reference"

/// Lowering re-validates everything it decodes with the same sentences the
/// store functions use in Core: a forged `SecretText.parts` that fits the
/// length-prefixed shape still cannot smuggle an illegal key, format,
/// reference, label or separator past the decode. The types are the first
/// layer, the store functions the second; this is the third, because pklr
/// skips the first two on function parameters.
const function fnoxKeyValidated(key: String): String =
  if (key.matches(Regex("[A-Z][A-Z0-9_]{1,127}"))) key
  else throw("fnox key \"\(key)\" is malformed: uppercase letters, digits and underscores only, starting with a letter, 2 to 128 characters")

/// Validates a generated key's format and hands the rest of the encoding on:
/// the format itself lowers to nothing, because generation is apply-time
/// work.
const function formatValidated(format: String, rest: String): String =
  if (List("hex16", "hex32", "base64-32", "alnum32").contains(format)) rest
  else throw("fnoxGenerated format \"\(format)\" is not one of hex16, hex32, base64-32 or alnum32")

const function opReferenceValidated(reference: String): String =
  let (parts = referenceParts(reference))
  if (parts.length == 3 || parts.length == 4) opReferenceLabelsValidated(reference, parts)
  else if (isOpReference(reference)) reference
  else throw("\"\(reference)\" is not an op:// reference: op://<vault>/<item>/<field>, or with a section op://<vault>/<item>/<section>/<field>, and no `?`")

const function referenceParts(reference: String): List<String> =
  if (reference.startsWith("op://") && !reference.contains("?")) (
    let (rest = reference.substring(5, reference.length))
    if (rest.endsWith("/")) List() else rest.split("/")
  )
  else List()

const function opReferenceLabelsValidated(reference: String, parts: List<String>): String =
  let (vault = opLabelValidated("vault", parts[0]))
  let (item = opLabelValidated("item", parts[1]))
  let (section = if (parts.length == 4) opSectionValidated(parts[2]) else "")
  let (field = opFieldValidated(parts.last))
  reference

const function opLabelValidated(what: String, label: String): String =
  if (label.contains("__ruxel_secret_8d41.") || label.contains("__ruxel_rt_8d41."))
    throw("1Password \(what) \"\(label)\" carries a secret or run-time value; a selector is static text only")
  else if (label.contains("\u{0}"))
    throw("1Password \(what) \"\(label)\" contains NUL, which no selector can hold")
  else if (label.contains("\u{1f}") || label.contains("\u{1e}"))
    throw("1Password \(what) \"\(label)\" contains \\u{1f} or \\u{1e}, which the secret reference encoding reserves; use another character")
  else if (!label.isEmpty && !label.contains("/") && !label.contains("\n")) label
  else throw("1Password \(what) \"\(label)\" is malformed: not empty, and no `/`, no line break")

/// A field reaches `op item get --fields`, which parses `,`, `=` and `.` as
/// its own selector syntax — a dot is the section separator — so the decode
/// refuses them where Core's `onePassword` does.
const function opFieldValidated(field: String): String =
  if (field.contains(",") || field.contains("="))
    throw("1Password field \"\(field)\" may not contain a comma or an equals sign: `op item get --fields` reads them as selectors, so it would fetch unintended fields")
  else if (field.contains("."))
    throw("1Password field \"\(field)\" may not contain a dot: `op item get --fields` reads a dot as the section separator, so it would fetch a different selector than the author named")
  else opLabelValidated("field", field)

/// A section and its field together form the CLI's `--fields` selector, so
/// the same comma, equals-sign and dot rule applies to both components.
const function opSectionValidated(section: String): String =
  if (section.contains(",") || section.contains("="))
    throw("1Password section \"\(section)\" may not contain a comma or an equals sign: `op item get --fields` reads them as selectors, so it would fetch unintended fields")
  else if (section.contains("."))
    throw("1Password section \"\(section)\" may not contain a dot: `op item get --fields` reads a dot as the section separator, so it would fetch a different selector than the author named")
  else opLabelValidated("section", section)

/// A separator that decodes to \u{1f} was not written by `join`: the encoding
/// reserves the character, and `join` refuses a separator holding it (see
/// `Core.sized`, which makes the two spellings distinguishable).
const function separatorValidated(separator: String): String =
  if (separator.contains("__ruxel_secret_8d41.") || separator.contains("__ruxel_rt_8d41."))
    throw("join separator \"\(separator)\" carries a secret or run-time value; the text between two joined secrets is static text only")
  else if (separator.contains("\u{0}"))
    throw("join separator contains NUL; use text without a NUL")
  else if (separator.contains("\u{1f}"))
    throw("join separator contains \\u{1f} or \\u{1e}, which the secret reference encoding reserves; use another character")
  else separator

const local function isOpLabel(label: String): Boolean =
  !label.isEmpty
    && !label.contains("/")
    && !label.contains("\n")
    && !label.contains("\u{0}")
    && !label.contains("\u{1e}")
    && !label.contains("\u{1f}")
    && !label.contains("__ruxel_secret_8d41.")
    && !label.contains("__ruxel_rt_8d41.")

const local function hasFieldSelectorSyntax(field: String): Boolean =
  field.contains(",") || field.contains("=") || field.contains(".")

const local function isOpReference(r: String): Boolean =
  r.startsWith("op://") && !r.contains("?") && (
    let (rest = r.substring(5, r.length))
    let (parts = rest.split("/"))
    !rest.endsWith("/") && (parts.length == 3 || parts.length == 4)
      && parts.every((p) -> isOpLabel(p))
      && !hasFieldSelectorSyntax(parts.last)
      && (parts.length != 4 || !hasFieldSelectorSyntax(parts[2])))

/// Reverses `Core.sized`: `_` is written `\u{1f}`, a literal `\u{1f}` as
/// `\u{1e}`, so decoding recovers exactly what was encoded.
const local function unescape(text: String): String = text.replaceAll("\u{1f}", "_").replaceAll("\u{1e}", "\u{1f}")

const function fnoxLookup(_key: String): engine.Lookup = new engine.Lookup { provider = "fnox"; key = _key }
const function opReference(_reference: String): engine.Lookup = new engine.Lookup { provider = "op"; reference = _reference }
const function opFields(_vault: String, _item: String, _section: String?, _field: String): engine.Lookup =
  new engine.Lookup { provider = "op"; vault = _vault; item = _item; section = _section; field = _field }

/// A whole secret as one engine value: a single lookup, or `concat` for a
/// joined pair. Environment values take this form; file content flattens the
/// parts into its own `concat`.
const function secretValue(parts: String): engine.Expr =
  let (exprs = parser.exprs(parts))
  if (exprs.length == 1) exprs.first else (new engine.Call { `function` = "concat"; args { for (e in exprs) { e } } })

// ── Environment values ──────────────────────────────────────────────────────

/// The engine environment of a step: a literal per static value, a lookup per
/// secret. Only actions have any.
function envOf(s: core.Step): Mapping<String, engine.Expr> =
  if (!(s is core.Action)) new Mapping {}
  else new Mapping { for (k, v in s.environment) { [envKey(s, k)] = envValue(s, k, v) } }

/// Whether a secret appears anywhere in a step: its file content, or an
/// environment value. Such a task is never logged.
const function secretStep(s: core.Step): Boolean =
  (s is core.File && hasSecrets(s.content))
    || (s is core.Action && s.environment.keys.toList().any((k) -> s.environment[k] is core.SecretText))

function envKey(s: core.Step, key: String): String =
  if (key.matches(Regex("[A-Za-z_][A-Za-z0-9_]*"))) key
  else throw("'\(name(s))': environment key \(key) is not a variable name; use letters, digits and underscores, not starting with a digit")

function envValue(s: core.Step, key: String, v: Any): engine.Expr =
  if (v is core.SecretText) secretValue(v.parts)
  else if (!placeholder.findMatchesIn(v).isEmpty)
    throw("'\(name(s))': environment value \(key) is a run-time value; a program that needs host state reads it from the rendered config or a capture")
  else if (hasSecrets(v))
    throw("'\(name(s))': environment value \(key) interpolates a secret into text; pass the secret itself, as in environment { [\"\(key)\"] = module.fnox(…) }")
  else lit(v)

const function lit(v: engine.Scalar): engine.Literal = new engine.Literal { value = v }
const function ref(p: List<String>): engine.Ref = new engine.Ref { path { for (x in p) { x } } }
function call1(f: String, x: engine.Expr): engine.Call = new engine.Call { `function` = f; args { x } }
function call2(f: String, x: engine.Expr, y: engine.Expr): engine.Call = new engine.Call { `function` = f; args { x; y } }
