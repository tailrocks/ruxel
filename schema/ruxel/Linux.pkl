/// Linux system steps: the timezone, accounts and groups, a kernel
/// parameter, a Git working tree pinned to one commit, and a Git branch
/// followed over SSH.
///
/// The ruxel binary serves this module at `modulepath:/ruxel/Linux.pkl`.
/// Workflow files import it beside `Core.pkl`, qualifying every class:
///
///     import "modulepath:/ruxel/Linux.pkl" as linux
///     new linux.Timezone { name = "UTC" }
module Linux

import "modulepath:/ruxel/Core.pkl" as core

// The typealiases and functions below are copied from Core.pkl; keep them in
// sync — pklr cannot share typealiases across modules, and would silently
// drop the constraints of a dotted alias such as `core.Static`.

/// Text known before the run. Run-time values (`currentHost`,
/// `Capture.stdout()`) are allowed only in `File.content`; secrets
/// (`module.fnox`, …) only in `File.content` and action `environment`
/// values. Every other text field is `Static`, and neither a run-time value
/// nor a secret reference can be one: they carry the reserved prefixes
/// `__ruxel_rt_8d41.` and `__ruxel_secret_8d41.`, which nothing else may
/// contain.
///
/// No NUL either: no path, argument or name can hold one.
typealias Static = String(!contains("__ruxel_rt_8d41.") && !contains("__ruxel_secret_8d41.") && !contains("\u{0}"))

/// The name of a service or an account: not empty, and not starting with
/// `-`, which the tools that take it would read as an option.
typealias Name = Static(!isEmpty && !startsWith("-"))

/// An absolute path in normal form: no empty, `.` or `..` segments and no
/// trailing `/`, so two spellings of one path are the same text. No NUL,
/// which no Unix path can hold.
typealias AbsolutePath = Static(this == "/" || matches(Regex("(/[^/]+)+")) && !contains("\u{0}") && !split("/").any((segment) -> segment == "." || segment == ".."))

/// An absolute path that can be a file: any but `/`, which is a directory.
typealias FilePath = AbsolutePath(this != "/")

/// A user or group name: a `Name` without the passwd and group delimiters.
typealias Account = Name(!contains(":") && !contains("\n"))

/// A user or group name: a lower-case name of at most 32 characters, the
/// way the passwd and group files spell one. A name starts with a letter
/// or an underscore and continues with letters, digits, `_` or `-`.
typealias Username = Static(matches(Regex("[a-z_][a-z0-9_-]{0,31}")))

/// A numeric user id: 0 to 60000.
typealias Uid = Int(isBetween(0, 60000))

/// A numeric group id: 0 to 60000.
typealias Gid = Int(isBetween(0, 60000))

/// Whether a managed thing is there or not: `"present"` (the default) or
/// `"absent"`. Copied from `Core.pkl`; keep the copies in sync.
typealias Presence = "present"|"absent"

/// An iptables chain name: at most 28 bytes, as the firewall allows — the
/// kernel's `XT_EXTENSION_MAXNAMELEN` is 29, and the chain parser refuses
/// names of that length and more. The name is ASCII, so its length in
/// characters is its length in bytes. The name is not the spelling of an
/// option: the chain parser refuses a name that begins with `-` or `!`.
/// The name holds no whitespace: the chain parser refuses every character
/// `isspace` accepts, so a name that holds one is refused at apply and
/// must be refused here. And the name is not a target the firewall would
/// read instead of the chain: a chain named `LOG` or `REJECT` never
/// survives `xtables_find_target`, so it is refused at apply and must be
/// refused here. `RETURN` and `QUEUE` are builtin standard targets too,
/// and a chain by either name never survives either.
typealias ChainName = Static(!isEmpty && length <= 28 && isAscii(this) && !startsWith("-") && !startsWith("!") && !hasWhitespace(this) && this != "DROP" && this != "ACCEPT" && this != "REJECT" && this != "LOG" && this != "RETURN" && this != "QUEUE")

/// An outgoing interface name: at most 15 characters, the kernel's
/// interface-name limit (`IFNAMSIZ` is 16, the name and its terminator),
/// and without what the kernel refuses in a name: the `/`, the `:`, and
/// the whitespace, and never the exact names `.` and `..`.
typealias InterfaceName = Static(!isEmpty && length < 16 && isAscii(this) && !contains("/") && !contains(":") && !hasWhitespace(this) && this != "." && this != ".." && !endsWith("+"))

/// Whether the text is ASCII: the firewall measures the names it takes in
/// bytes — the chain name's length and the interface name's limit are byte
/// limits, and the firewall reads a name the way C does, by its encoded
/// length — while a length in characters is not a length in bytes. Where
/// the name is ASCII the two lengths are one, so the name the schema
/// admits is the name the firewall accepts.
const local function isAscii(s: String): Boolean =
  s.matches(Regex("[\\x00-\\x7F]*"))

/// Whether the text holds whitespace: the characters `isspace` accepts —
/// the space, the tab, the newline, the vertical tab, the form feed and
/// the carriage return. The kernel refuses them in an interface name and
/// the chain parser of the firewall refuses them in a chain name.
const local function hasWhitespace(s: String): Boolean =
  s.contains(" ") || s.contains("\t") || s.contains("\n") || s.contains("\u{0B}") || s.contains("\u{0C}") || s.contains("\r")

/// A destination address: an IPv4 or an IPv6 address, with an optional
/// prefix length — the network the rule matches.
typealias Destination = Static(isDestination(this))

/// Whether the text is an address with an optional prefix: an IPv4 address
/// with a prefix of at most 32 bits, an IPv6 address with a prefix of at
/// most 128 bits.
const local function isDestination(s: String): Boolean =
  if (!s.contains("/")) isIpv4(s) || isIpv6Address(s)
  else
    let (parts = s.split("/"))
    if (parts.length != 2) false
    else
      let (prefix = parts[1])
      if (!prefix.matches(Regex("[0-9]{1,3}"))) false
      else if (isIpv4(parts[0])) prefix.toInt() <= 32
      else if (isIpv6Address(parts[0])) prefix.toInt() <= 128
      else false

/// A SHA-1 (40) or SHA-256 (64) Git object ID.
typealias CommitSha = String(matches(Regex("[0-9a-f]{40}|[0-9a-f]{64}")))

/// An SSH Git URL: the `scp`-like `user@host:path` or the `ssh://`
/// scheme. Never `https`: a branch checkout authenticates over SSH, and
/// the two transports take different credentials, so one spelling cannot
/// name both. No spaces and no control characters, which no URL can hold,
/// and no run-time value or secret reference: the repository is static
/// text.
typealias SshGitUrl = Static(isSshGitUrl(this))

/// Whether the text is an SSH Git URL: the `ssh://` scheme with a user,
/// a host and an optional numeric port in range, or the `scp`-like
/// `user@host:path`. A URI scheme (`://`) that is not `ssh://` —
/// `https://`, or `https://user@host:port/…` — is refused, and so is a
/// text without a user or without a path.
const local function isSshGitUrl(s: String): Boolean =
  !s.contains(" ") && !s.matches(Regex("(?s).*[\\x00-\\x1f\\x7f].*")) && (isSshSchemeUrl(s) || isScpGitUrl(s))

const local function isSshSchemeUrl(s: String): Boolean =
  s.startsWith("ssh://") && (
    let (rest = s.substring(7, s.length))
    let (at = rest.indexOf("@"))
    let (slash = if (rest.contains("/")) rest.indexOf("/") else rest.length)
    let (authority = rest.substring(at + 1, slash))
    at > 0 && slash > at + 1 && slash < rest.length - 1
      && !sshAuthorityHost(authority).isEmpty
      && isDialablePort(sshAuthorityPort(authority)))

/// The host of an `ssh://` authority: the bracketed IPv6 literal, or the
/// text before the port's colon. Empty when the authority names no host,
/// as in `ssh://git@:/repo`, which the Git agent could only fail to
/// resolve.
const local function sshAuthorityHost(authority: String): String =
  if (authority.startsWith("[")) (
    if (!authority.contains("]")) "" else authority.substring(1, authority.indexOf("]")))
  else if (authority.contains(":")) authority.substring(0, authority.indexOf(":"))
  else authority

/// The port of an `ssh://` authority, or null when it names none. A colon
/// with nothing after it, as in `ssh://git@host:/repo`, names no port the
/// agent could dial, and neither does a number outside 1–65535, which no
/// SSH server listens on.
const local function sshAuthorityPort(authority: String?): String? =
  if (authority == null || authority.startsWith("[")) (
    if (authority != null && authority.contains("]") && authority.substring(authority.indexOf("]") + 1, authority.length).startsWith(":"))
      authority.substring(authority.indexOf("]") + 2, authority.length)
    else null)
  else if (authority.contains(":")) authority.substring(authority.indexOf(":") + 1, authority.length)
  else null

/// Whether the port text is a port the agent can dial: digits in 1–65535.
const local function isDialablePort(port: String?): Boolean =
  port == null || (port.matches(Regex("[0-9]+")) && port.length <= 5 && port.toInt() >= 1 && port.toInt() <= 65535)

const local function isScpGitUrl(s: String): Boolean =
  let (at = s.indexOf("@"))
  let (rest = if (at < 0) "" else s.substring(at + 1, s.length))
  let (colon = rest.indexOf(":"))
  !s.contains("://") && !s.startsWith("-") && at > 0 && colon > 0 && colon < rest.length - 1

/// A Git branch name: letters, digits, `.`, `_`, `/` and `-`, never an
/// empty component and never `.` or `..` beside a separator, no component
/// starting or ending with a dot, and never a `.lock` suffix or a leading
/// dash, which the Git agent refuses as a flag-like positional — the way
/// `git check-ref-format --branch` reads one. A 40- or 64-character
/// lowercase hex string also matches, but the Lowering refuses it there:
/// that spells a commit SHA, which is pinned with `GitCheckout`, never
/// followed here.
typealias BranchName = Static(matches(Regex("[A-Za-z0-9._/-]+")) && !contains("..") && !startsWith("/") && !startsWith("-") && !endsWith("/") && !contains("//") && this != "." && !startsWith("./") && !endsWith("/.") && !contains("/./") && !endsWith(".lock") && !this.split("/").toList().any((c) -> c.startsWith(".") || c.endsWith(".")))

/// `https://`, a host name, IPv4 address or bracketed IPv6 address, an
/// optional port from 1 to 65535, and an optional path without spaces.
typealias HttpsUrl = Static(isHttpsUrl(this))

const local function isHttpsUrl(s: String): Boolean =
  s.startsWith("https://") && (
    let (rest = s.substring(8, s.length))
    let (slash = if (rest.contains("/")) rest.indexOf("/") else rest.length)
    isAuthority(rest.substring(0, slash)) && !rest.contains(" ") && !rest.matches(Regex("(?s).*[\\x00-\\x1f\\x7f].*")))

const local function isAuthority(a: String): Boolean =
  if (a.startsWith("["))
    a.contains("]") && (let (close = a.indexOf("]")) isIpv6Address(a.substring(1, close)) && isPort(a.substring(close + 1, a.length)))
  else
    let (colon = if (a.contains(":")) a.indexOf(":") else a.length)
    a.substring(0, colon).matches(Regex(#"[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*"#)) && isPort(a.substring(colon, a.length))

const local function isPort(p: String): Boolean =
  p == "" || p.matches(Regex(":[0-9]{1,5}")) && p.substring(1, p.length).toInt() >= 1 && p.substring(1, p.length).toInt() <= 65535

/// At most one `::`; hex groups of one to four digits; eight groups in all,
/// fewer with `::`; an IPv4 tail counts as two. Written without relying on
/// `split` keeping empty pieces, which pklr, like Java, drops at the end.
const local function isIpv6Address(a: String): Boolean =
  let (gap = a.contains("::"))
  let (groups = a.split(":").filter((g) -> !g.isEmpty))
  let (tail = !groups.isEmpty && groups.last.contains("."))
  let (hex = groups.filter((g) -> !g.contains(".")))
  let (count = hex.length + (if (tail) 2 else 0))
  a.contains(":")
    && (!gap || a.indexOf("::") == a.lastIndexOf("::"))
    && (!a.startsWith(":") || a.startsWith("::"))
    && (!a.endsWith(":") || a.endsWith("::"))
    && hex.every((g) -> g.matches(Regex("[0-9a-fA-F]{1,4}")))
    && hex.length + (if (tail) 1 else 0) == groups.length
    && (!tail || isIpv4(groups.last) && !a.endsWith("::"))
    && (if (gap) count <= 7 else count == 8)

/// Four octets. `split` drops the trailing empty piece, so an address that
/// ends with `.` would read as if it named one octet less and pass; such an
/// address is refused, like one with an empty octet.
const local function isIpv4(s: String): Boolean =
  let (parts = s.split("."))
  !s.endsWith(".") && parts.length == 4 && parts.every((p) -> p.matches(Regex("0|[1-9][0-9]{0,2}")) && p.toInt() <= 255)

/// A tz database name such as `UTC` or `Europe/Berlin`: relative, no `.`
/// or `..` components.
typealias TimezoneName = Name(matches(Regex("[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*")))

/// A kernel parameter name: dot-separated segments of letters, digits,
/// underscores and hyphens, not starting with `-`, the way `/proc/sys`
/// spells them (`net.ipv4.conf.br-123.forwarding`) — or slash-first
/// notation, where the first separator is `/` and every later `/` a
/// separator and every `.` a literal of its component
/// (`net/ipv4/conf/enp3s0.200/forwarding`), the spelling a component
/// with a literal dot needs. The notations never mix: a dotted name
/// admits no slash, and a slash-first name keeps its dots inside
/// components.
typealias SysctlName = Static((matches(Regex(#"[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)*"#)) || matches(Regex(#"[A-Za-z0-9_-]+(/[A-Za-z0-9_.-]+)+"#))) && !startsWith("-") && !split("/").any((segment) -> segment == "." || segment == ".."))

/// A kernel parameter value: one line of text, with no line break in it, so
/// one entry is one line of one file. No NUL either: the value reaches the
/// kernel through a process argument, and an argument cannot hold one.
typealias SysctlValue = Static(!contains("\n") && !contains("\r") && !contains("\u{0}"))

/// A sysctl persistence file: one the system loader reads at boot —
/// `/etc/sysctl.conf` or a `*.conf` of `/etc/sysctl.d`,
/// `/usr/local/lib/sysctl.d` or `/usr/lib/sysctl.d`, the recognized
/// configuration files `sysctl --system` loads. `/run/sysctl.d` is
/// recognized too, but `/run` is
/// volatile runtime state (tmpfs), normally cleared at reboot, so a file
/// written there is gone before the next boot's sysctl loading — it is
/// not a persistence path. A file elsewhere is written but never read
/// again: the parameter silently reverts after reboot.
typealias SysctlFile = FilePath(matches(Regex(#"(/etc/sysctl\.conf|/(etc|usr/lib|usr/local/lib)/sysctl\.d/[^/]+\.conf)"#)))

class Timezone extends core.Step {
  hidden fixed kind = "timezone"
  name: TimezoneName
}

/// A kernel parameter, set in a sysctl file and applied live.
///
/// The step manages one entry in the file at `path` and applies it live:
/// every apply reconciles the live kernel value too, so a parameter
/// another process changed is corrected.
///
/// Its identity is the name and the path, so two stages (or one stage with
/// two files) may set the same name in different files, each entry its
/// own; two different values for one name in one stage conflict — the
/// kernel holds one live value. The file itself is not the
/// step's to own: any other step that manages that path — a `File`, a
/// `Directory`, a `Symlink`, a `GitCheckout`, an apt repository's source
/// file — conflicts with it, while any number of sysctl steps may share a
/// file, each entry its own.
class Sysctl extends core.Step {
  hidden fixed kind = "sysctl"
  name: SysctlName
  value: SysctlValue
  /// The file that holds the entry: a file the system loader reads at
  /// boot — `/etc/sysctl.conf` or a `*.conf` of `/etc/sysctl.d`,
  /// `/usr/local/lib/sysctl.d` or `/usr/lib/sysctl.d`, which the agent
  /// reads and rewrites atomically.
  /// `/run/sysctl.d` is out: `/run` is volatile runtime state (tmpfs), so
  /// the entry would be gone before the next boot's sysctl loading. A
  /// file elsewhere would never be loaded again either, so the parameter
  /// silently reverts after reboot.
  path: SysctlFile = "/etc/sysctl.d/90-ruxel.conf"
}

/// An account and the settings of it.
///
/// The step manages one account: it creates the account when it is missing
/// and changes the settings of an existing one. There is no `create = false`
/// field: a step that must not create an account states the account
/// earlier in the same stage, or keeps the existence probe as a `Capture`.
///
/// Its identity is the whole account, so two steps that manage one account
/// with different settings conflict: a stage declares one state for each
/// thing it manages.
class User extends core.Step {
  hidden fixed kind = "user"
  /// The account's name.
  user: Username
  /// The account's login shell: a file path, any absolute path but `/`
  /// itself, which is a directory. The shell must exist on the host; a site
  /// that manages login access says in its runbook that root account and
  /// key changes run only through its gated apply path. The shell is
  /// never the account's home: the home is a directory the account's
  /// task creates and uses, while the shell is a regular executable file
  /// `shell_allowed` verifies — including the claimed home `/home/<user>`
  /// of an account that states none — so one path cannot stand for both.
  shell: FilePath?(this == null || state != "present" || this != (home ?? "/home/\(user)")) = null
  /// The account's home directory: a file path, any absolute path but `/`
  /// itself. An explicit home of a present account is a path the step
  /// manages — the agent creates the directory — so no other step may own
  /// it.
  home: FilePath? = null
  /// The group the account belongs to. The root account keeps its primary
  /// group: a step for `root` may not declare one. A present account that
  /// states none gets the group `useradd` creates with its login name
  /// (USERGROUPS_ENAB), and a same-stage `Group` of that name conflicts
  /// with the account — state the group explicitly to manage it.
  group: Username? = null
  /// The other groups the account belongs to. Unset leaves the account's
  /// supplementary memberships unmanaged; an explicit empty listing
  /// (`groups = new {}`) removes every one of them, so the account keeps
  /// none. The property is nullable, so a listing is written as an
  /// assignment (`groups = new Listing { … }`), never as an amendment.
  groups: Listing<Username>? = null
  /// The account's numeric id. The root account keeps uid 0: a step for
  /// `root` may not declare one.
  uid: Uid? = null
  /// Whether a created account is a system account (`useradd --system`).
  /// Creation only: the flag shapes an account that does not exist yet —
  /// `useradd --help` defines `--system` as "create a system account" —
  /// and a step for an existing account leaves its kind alone.
  system: Boolean = false
  /// Whether the account is there (`present`) or gone (`absent`).
  state: Presence = "present"
  /// Whether removing the account removes its home directory too
  /// (`userdel -r`). The step then states the home: the directory and
  /// everything in it goes, so no step may manage a path inside it.
  removeHome: Boolean = false
}

/// A group.
///
/// The step manages one group: it creates the group when it is missing and
/// changes the id of an existing one. Its identity is the group, so two
/// steps that manage one group with different ids conflict.
class Group extends core.Step {
  hidden fixed kind = "group"
  /// The group's name.
  name: Username
  /// The group's numeric id. The root group keeps gid 0: a step for `root`
  /// may not declare one.
  gid: Gid? = null
  /// Whether the group is there (`present`) or gone (`absent`).
  state: Presence = "present"
}

/// A Git working tree pinned to one commit. Another step may manage a path
/// inside it only where the repository ignores that path (Oh My Zsh's
/// `custom/`): a change to a tracked file makes the next checkout fail.
class GitCheckout extends core.Step {
  hidden fixed kind = "gitCheckout"
  repository: HttpsUrl
  path: AbsolutePath
  commit: CommitSha
}

/// A Git working tree following a branch over SSH. The branch floats: the
/// step updates the tree to the branch head on every apply, so a tag —
/// which names one commit — never floats here. Resolve a tag to its SHA
/// at author time and pin it with `GitCheckout` instead; a 40- or
/// 64-character lowercase hex branch is refused for the same reason: that
/// spells a SHA, not a branch.
///
/// Its identity is the path, like a pinned checkout's, so a branch and a
/// pin of one path are two states for it and are refused. The tree must
/// be clean: the step never force-resets, and a dirty tree fails the
/// apply instead of being overwritten.
class GitBranch extends core.Step {
  hidden fixed kind = "gitBranch"
  repository: SshGitUrl
  path: AbsolutePath
  branch: BranchName
  /// Accept the host key on first contact (`StrictHostKeyChecking`
  /// `accept-new`). Without it a host the controller never saw fails the
  /// clone instead of trusting a key it was never given — and the agent
  /// enforces strict rejection even where SSH is configured leniently,
  /// so the field is a genuine opt-in.
  acceptHostKey: Boolean = false
}

/// A rule in an iptables chain.
///
///     new IptablesRule { chain = "INPUT"; protocol = "tcp"; destination = "10.0.0.0/8"; jump = "DROP" }
///
/// The chain and the match (protocol, destination, outgoing interface)
/// identify the rule: two rules that match the same way in the same chain
/// are the same rule, so they must agree on their jump. `state = "absent"`
/// removes the rule instead of adding it.
///
/// The match must be one the firewall can administer: the protocol and the
/// destination belong to the IP version of the rule (`icmp` is IPv4's,
/// `icmpv6` IPv6's, and the address is of the version's family), and the
/// `INPUT` and `PREROUTING` chains carry no outgoing interface, because a
/// packet there has none yet.
class IptablesRule extends core.Step {
  hidden fixed kind = "iptablesRule"
  chain: ChainName
  destination: Destination? = null
  protocol: "all"|"tcp"|"udp"|"icmp"|"icmpv6" = "all"
  outInterface: InterfaceName? = null
  jump: "DROP"|"ACCEPT"|"REJECT"|"LOG" = "DROP"
  ipVersion: "ipv4"|"ipv6" = "ipv4"
  state: Presence = "present"
}
