module Engine

// Runtime expressions are data: evaluation happens against each host's facts and results.
typealias Expr = Literal|Ref|Call|ListExpr|MapExpr|Lookup
class Literal { fixed kind = "literal"; value: Scalar? = null }
class Ref { fixed kind = "ref"; path: Listing<String>(!this.isEmpty) }
class Call { fixed kind = "call"; `function`: "eq"|"ne"|"lt"|"le"|"gt"|"ge"|"and"|"or"|"not"|"default"|"contains"|"length"|"concat"|"sha256"|"base64Encode"|"base64Decode"|"mapAttribute"|"if"|"map"|"flatMap"|"string"|"bool"|"trim"|"join"|"urlencode"|"list"; args: Listing<Literal|Ref|Call|ListExpr|MapExpr|Lookup>(`function` == "concat" || (List("if", "flatMap").contains(`function`) && this.length == 3) || (List("not", "length", "sha256", "base64Encode", "base64Decode", "string", "bool", "trim", "urlencode", "list").contains(`function`) && this.length == 1) || (!List("concat", "if", "flatMap", "not", "length", "sha256", "base64Encode", "base64Decode", "string", "bool", "trim", "urlencode", "list").contains(`function`) && this.length == 2)) }
class ListExpr { fixed kind = "list"; items: Listing<Literal|Ref|Call|ListExpr|MapExpr|Lookup> }
class MapExpr { fixed kind = "map"; entries: Mapping<String, Literal|Ref|Call|ListExpr|MapExpr|Lookup> }
class Lookup {
  fixed kind = "lookup"
  provider: "fnox"|"op"|"command"|"synthetic"
  /// A fnox key is an `FnoxKey` (`Core.pkl`): `[A-Z][A-Z0-9_]{1,127}` —
  /// the grammar model validation and the backend enforce with the same
  /// sentence. The constraint cannot carry a message; the Rust layers name
  /// it when they refuse a key.
  key: String?(provider != "fnox" || (this != null && this.matches(Regex("[A-Z][A-Z0-9_]{1,127}")))) = null
  /// The structured 1Password selector. Vault, item and field are always
  /// stated — there is no default vault or field; the engine's own checks
  /// (model validation and resolution) refuse a lookup that omits one. The
  /// constraints here cannot: pklr evaluates a nullable property's constraint
  /// against its `null` default too, so `this != null` could never be
  /// demanded from the schema. `section` narrows a label that several
  /// sections carry; without it, resolution fails on such a label, naming
  /// the sections.
  vault: String? = null
  item: String? = null
  section: String? = null
  field: String? = null
  /// The `op://` reference form; never combined with structured selectors.
  /// Enforced here alone: `section` carries no constraint of its own, since
  /// one that read `reference` would close the cycle this constraint opens
  /// (it reads `section`), which official Pkl evaluates eagerly, to a stack
  /// overflow; pklr tolerates the cycle and never showed it.
  reference: String?(provider != "op" || this == null || (vault == null && item == null && section == null && field == null)) = null
  argv: Listing<String>(provider != "command" || !this.isEmpty)
}
typealias Scalar = String|Boolean|Int|Float
typealias Username = String(matches(Regex("^[A-Za-z0-9_.][A-Za-z0-9_.-]*$")))
/// A become account name. All-digit names are refused: `runuser` and `getent passwd`
/// treat a numeric key as a UID, so such a name could select a different account.
typealias BecomeUser = Username(!matches(Regex("^[0-9]+$")))
typealias Text = String|Expr
typealias Flag = Boolean|Expr
typealias NumberValue = Int(this >= 0)|Expr
typealias FileMode = String(matches(Regex("^[0-7]{3,4}$")))|Expr
typealias TextList = String|*Listing<String>|Expr
typealias PrivilegeList = String(contains(Regex("[^,\\s]")))|*Listing<String>(!this.isEmpty && this.every((value) -> !value.trim().isEmpty))|Expr
typealias CommandArgs = *Listing<String>(!this.isEmpty && !this[0].isEmpty)|Expr
typealias Port = Int(this >= 1 && this <= 65535)|Expr

class Host { address: String; port: Int(this >= 1 && this <= 65535) = 22; user: String? = null; vars: Mapping<String, Expr> }
class Group { hosts: Listing<String>; children: Listing<String>; vars: Mapping<String, Expr> }
class Inventory { hosts: Mapping<String, Host>; groups: Mapping<String, Group> }
class Ssh { user: Username = "root"; identityFile: String(!this.isEmpty); knownHostsFile: String(!this.isEmpty) }
class Guard { allow: Listing<String>; deny: Listing<String> }
class Config {
  /// Set by the ruxel binary that serves this schema; ruxel refuses a configuration evaluated against another copy.
  fixed schemaFingerprint: String = "unserved"
  /// Set by the workflow language (`modulepath:/ruxel/internal/Lowering.pkl`) when it builds this configuration; ruxel refuses one built by copies of the language modules.
  languageFingerprint: String? = null
  inventory: Inventory
  plays: Listing<Play>
  ssh: Ssh? = null
}
class Play {
  name: String
  targets: Listing<String>
  preTasks: Listing<Task>
  tasks: Listing<Task>
  handlers: Listing<Task>
  vars: Mapping<String, Expr>
  environment: Mapping<String, Expr>
  becomeUser: BecomeUser? = null
}
class Task {
  name: String
  operation: Operation?(this != null && block.isEmpty && rescue.isEmpty && always.isEmpty || this == null && !block.isEmpty && `loop` == null && loopLabel == null && loopVar == "item") = null
  `when`: Expr? = null
  `loop`: Expr? = null
  loopVar: String(!List("vars", "facts", "results", "inventoryHost", "setFacts").contains(this)) = "item"
  loopLabel: Expr? = null
  register: String?(this == null || block.isEmpty) = null
  notify: Listing<String>
  tags: Listing<String>
  delegateTo: Text? = null
  delegateAllow: Listing<String>?(this == null || delegateTo != null)
  delegateLocalhost: Boolean?(this == null || delegateTo != null) = null
  becomeUser: BecomeUser? = null
  vars: Mapping<String, Expr>
  environment: Mapping<String, Expr>
  retries: Int?(this == null || this >= 0) = null
  delaySeconds: Int(this >= 0) = 5
  until: Expr? = null
  changedWhen: Expr? = null
  failedWhen: Expr? = null
  ignoreErrors: Boolean(!this || block.isEmpty) = false
  checkMode: Boolean? = null
  block: Listing<Task>
  rescue: Listing<Task>
  always: Listing<Task>
  noLog: Boolean = false
}
typealias Operation = Apt|AptRepository|AuthorizedKey|BlockInFile|Command|Copy|File|Filesystem|GetUrl|Git|SystemGroup|Firewall|LineInFile|Replace|Shell|Slurp|Stat|Sysctl|Service|User|VolumeGroup|LogicalVolume|Timezone|Mount|PostgresDatabase|PostgresRole|PostgresSchema|PostgresPrivileges|Template|Assert|Debug|Fail|Pause|SetFact

class Apt {
  fixed kind = "apt"
  autoremove: Flag? = null
  force: Flag? = null
  /// Each entry is `name`, `name=version`, `name:arch` or `name:arch=version`, with one
  /// exact Debian version. Globs, version patterns, APT escapes, the `any`, `native` and
  /// `all` architectures, and a package listed twice are refused before apt runs. A missing
  /// package must have its own installable version (the pinned one, or a default candidate):
  /// virtual packages are refused. Pins are compared with Debian version ordering, so `1.01`
  /// satisfies `=1.1`. Pins cannot be combined with `upgrade`, and `APT_CONFIG` is not
  /// supported in the task environment.
  name: TextList?
  state: ("present"|"latest"|Expr)? = null
  update_cache: Flag? = null
  upgrade: ("dist"|Expr)? = null
}

class AptRepository {
  fixed kind = "apt_repository"
  filename: Text
  repo: Text
  state: ("present"|Expr)? = null
  update_cache: Flag? = null
}

class AuthorizedKey {
  fixed kind = "authorized_key"
  key: Text
  state: ("present"|Expr)? = null
  user: Text
}

class BlockInFile {
  fixed kind = "blockinfile"
  block: Text
  create: Flag? = null
  group: Text? = null
  mode: FileMode? = null
  owner: Text? = null
  path: Text
}

class Command {
  fixed kind = "command"
  argv: CommandArgs
  chdir: Text? = null
  /// Guard-only: the path whose existence skips the command. The controller
  /// probes it before it resolves the task's environment, so a task the probe
  /// skips reads no secret store; the agent re-stats it immediately before it
  /// runs the command, where the probe's answer can already be stale. It gates
  /// execution only: it never decides the reported change.
  creates: Text? = null
  /// The evaluated `onChangeOf` guard: a watched step had changed when the
  /// controller dispatched the command. A watcher re-runs the command even
  /// where the created path exists, so this overrides the agent's `creates`
  /// recheck — the first disjunct of the same `when`, handed down because the
  /// agent cannot read the controller's results.
  run_if_changed: Flag? = null
}

class Copy {
  fixed kind = "copy"
  content: Text?(this != null && src == null || this == null && src != null) = null
  dest: Text
  force: Flag? = null
  group: Text? = null
  mode: FileMode? = null
  owner: Text? = null
  src: Text? = null
}

class File {
  fixed kind = "file"
  group: Text? = null
  mode: FileMode? = null
  owner: Text? = null
  path: Text(state is Expr || state != "link" || src != null)
  recurse: Flag?(this != true || state is Expr || state == "directory") = null
  src: Text? = null
  state: ("file"|"directory"|"absent"|"link"|Expr)? = null
}

class Filesystem {
  fixed kind = "filesystem"
  dev: Text
  fstype: "ext4"|"xfs"|Expr
  resizefs: Flag? = null
}

class GetUrl {
  fixed kind = "get_url"
  dest: Text
  url: String(startsWith("http://") || startsWith("https://"))|Expr
}

class Git {
  fixed kind = "git"
  accept_hostkey: Flag? = null
  dest: Text
  force: Flag? = null
  repo: Text
  update: Flag? = null
  version: Text? = null
}

class SystemGroup {
  fixed kind = "group"
  gid: NumberValue? = null
  name: Text
  state: ("present"|"absent"|Expr)? = null
}

class Firewall {
  fixed kind = "iptables"
  chain: Text
  comment: Text? = null
  destination: Text? = null
  ip_version: ("ipv4"|"ipv6"|Expr)? = null
  jump: Text? = null
  out_interface: Text? = null
  policy: Text?(this == null || protocol == null && destination == null && out_interface == null && jump == null && comment == null) = null
  protocol: Text? = null
}

class LineInFile {
  fixed kind = "lineinfile"
  line: Text?(state is Expr || (state == "absent" && (this != null || regexp != null)) || (state != "absent" && this != null)) = null
  path: Text
  regexp: Text? = null
  state: ("present"|"absent"|Expr)? = null
}

class Replace {
  fixed kind = "replace"
  path: Text
  regexp: Text
  replace: Text? = null
}

class Shell {
  fixed kind = "shell"
  chdir: Text? = null
  cmd: String(this.length > 0)|Expr
  /// Guard-only: see `Command.creates`.
  creates: Text? = null
  executable: Text? = null
  /// See `Command.run_if_changed`.
  run_if_changed: Flag? = null
}

class Slurp {
  fixed kind = "slurp"
  src: Text
}

class Stat {
  fixed kind = "stat"
  follow: Flag? = null
  path: Text
}

class Sysctl {
  fixed kind = "sysctl"
  name: String(matches(Regex("^[A-Za-z0-9_./:][A-Za-z0-9_./:-]*$")))|Expr
  reload: Flag? = null
  state: ("present"|Expr)? = null
  sysctl_file: Text? = null
  sysctl_set: Flag? = null
  value: Scalar|Expr
}

class Service {
  fixed kind = "systemd"
  daemon_reload: Flag? = null
  enabled: Flag? = null
  name: Text?(this != null || state == null && enabled == null) = null
  state: ("started"|"stopped"|"restarted"|Expr)? = null
}

class User {
  fixed kind = "user"
  append: Flag? = null
  comment: Text? = null
  create_home: Flag? = null
  group: Text? = null
  groups: (*Listing<String>(this.every((value) -> value is String))|Expr)?
  home: Text? = null
  name: Text
  remove: Flag? = null
  shell: Text? = null
  state: ("present"|"absent"|Expr)? = null
  system: Flag? = null
  uid: NumberValue? = null
}

class VolumeGroup {
  fixed kind = "volume_group"
  pvs: *Listing<String>(!this.isEmpty && this.every((value) -> value is String))|Expr
  vg: Text
}

class LogicalVolume {
  fixed kind = "logical_volume"
  lv: Text
  resizefs: Flag? = null
  size: Text
  vg: Text
}

class Timezone {
  fixed kind = "timezone"
  name: String(!isEmpty && !startsWith("-"))|Expr
}

class Mount {
  fixed kind = "mount"
  fstype: Text
  opts: Text? = null
  path: Text
  src: Text
  state: ("mounted"|Expr)? = null
}

class PostgresDatabase {
  fixed kind = "postgres_database"
  login_db: Text? = null
  login_port: Port? = null
  login_user: Text? = null
  name: Text
  owner: Text? = null
  state: ("present"|Expr)? = null
}

class PostgresRole {
  fixed kind = "postgres_role"
  login_db: Text? = null
  login_port: Port? = null
  login_user: Text? = null
  name: Text
  password: Text? = null
  role_attr_flags: Text? = null
  state: ("present"|Expr)? = null
}

class PostgresSchema {
  fixed kind = "postgres_schema"
  login_db: Text
  login_port: Port? = null
  login_user: Text? = null
  name: Text
  owner: Text? = null
  state: ("present"|Expr)? = null
}

class PostgresPrivileges {
  fixed kind = "postgres_privileges"
  login_db: Text
  login_port: Port? = null
  login_user: Text? = null
  objs: TextList?(type is Expr || type != "database" || this != null)
  privs: PrivilegeList
  role: Text
  schema: Text? = null
  state: ("present"|Expr)? = null
  target_roles: TextList?(this == null || type is Expr || type == "default_privs")
  type: "database"|"schema"|"table"|"default_privs"|Expr
}

class Template {
  fixed kind = "template"
  content: Text?(this != null && src == null || this == null && src != null) = null
  dest: Text
  force: Flag? = null
  group: Text? = null
  mode: FileMode? = null
  owner: Text? = null
  src: Text? = null
}

class Assert {
  fixed kind = "assert"
  fail_msg: Text? = null
  that: Boolean|*Listing<Boolean|Expr>(!this.isEmpty)|Expr
}

class Debug {
  fixed kind = "debug"
  msg: Text? = null
}

class Fail {
  fixed kind = "fail"
  msg: Text? = null
}

class Pause {
  fixed kind = "pause"
  prompt: Text? = null
  seconds: NumberValue? = null
  minutes: NumberValue? = null
}

class SetFact {
  fixed kind = "set_fact"
  values: Mapping<String, Expr>
}
