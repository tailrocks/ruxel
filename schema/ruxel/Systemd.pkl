/// systemd services.
///
/// The ruxel binary serves this module at `modulepath:/ruxel/Systemd.pkl`.
/// Workflow files import it beside `Core.pkl`, qualifying every class:
///
///     import "modulepath:/ruxel/Systemd.pkl" as systemd
///     new systemd.Service { name = "nginx" }
module Systemd

import "modulepath:/ruxel/Core.pkl" as core

// The typealiases and functions below are copied from Core.pkl; keep them in
// sync — pklr cannot share typealiases across modules, and would silently
// drop the constraints of a dotted alias such as `core.Static`.

/// Text known before the run. Run-time values (`currentHost`,
/// `Capture.stdout()`) are allowed only in `File.content`; secrets
/// (`module.fnox`, …) only in `File.content` and action `environment`
/// values. Every other text field is `Static`, and neither a run-time value
/// nor a secret reference can be one: they carry the reserved prefixes
/// `__ruxel_rt_8d41.` and `__ruxel_secret_8d41.`, which nothing else may
/// contain.
///
/// No NUL either: no path, argument or name can hold one.
typealias Static = String(!contains("__ruxel_rt_8d41.") && !contains("__ruxel_secret_8d41.") && !contains("\u{0}"))

/// The name of a service or an account: not empty, and not starting with
/// `-`, which the tools that take it would read as an option.
typealias Name = Static(!isEmpty && !startsWith("-"))

/// A systemd service: `nginx` or `nginx.service`, not another unit type
/// such as `sshd.socket`, which the agent does not track. Canonical unit
/// name characters only (letters, digits, `:_.@-`, and `\xNN` escapes), at
/// most 255 of them. A template needs its instance: `getty@tty1`, not
/// `getty@`.
typealias ServiceName = Name(length <= 255 && matches(Regex(#"([A-Za-z0-9:_.@-]|\\x[0-9a-f]{2})+"#)) && (!contains(".") && length <= 247 || endsWith(".service") && length > 8) && !startsWith("@") && !endsWith("@") && !contains("@.service"))

/// A systemd timer unit: `postgresql-multixact-monitor`, the name of the
/// `.timer` unit it manages. Canonical unit name characters only, at most
/// 249 of them, and no `.`: a timer is named by its own name, and the
/// `.timer` unit is that name with the suffix, so a timer is never a
/// service (`Service` names `.service` units only). The limit leaves room
/// for the suffix, so the unit name systemd reads fits its own limit of
/// 255 characters.
typealias TimerName = Name(length <= 255 && matches(Regex(#"([A-Za-z0-9:_.@-]|\\x[0-9a-f]{2})+"#)) && !contains(".") && length <= 249 && !startsWith("@") && !endsWith("@"))

/// A systemd service.
class Service extends core.Step {
  hidden fixed kind = "service"
  name: ServiceName
  /// Starts at boot.
  enabled: Boolean = true
  /// Is running now. `false` stops it.
  running: Boolean = true
  /// Restarts the service at the end of the stage when one of these steps
  /// changed. Each must be an earlier step of the same stage that can
  /// report a change, and not a recipe. Only for a running service. A step
  /// that runs again where it is written counts once for every earlier run
  /// with the same settings; the service is restarted when any changed.
  ///
  /// A later step's `onChangeOf { service }` fires when this step enabled,
  /// started or stopped the service, not when the restart ran. To react to a
  /// restart, react to the steps the service restarts on.
  restartOnChangeOf: Listing<core.Step>
  /// Reloads the service at the end of the stage when one of these steps
  /// changed: the service reads its new configuration without restarting
  /// (a PostgreSQL `SIGHUP`). Each must be an earlier step of the same
  /// stage that can report a change, and not a recipe. Only for a running
  /// service.
  ///
  /// A service takes restart triggers or reload triggers, not both: writing
  /// both is an evaluation error naming the service. A reload needs a
  /// running service, so a stopped service with reload triggers is rejected
  /// like a stopped service with restart triggers.
  reloadOnChangeOf: Listing<core.Step>
}

/// A systemd timer: a `.timer` unit that starts a service on a schedule.
///
/// The timer owns its unit file and its enablement, and nothing else. It
/// writes `/etc/systemd/system/<name>.timer` itself and manages that
/// path — declaring a `File` for it too is refused as a second state —
/// and it names the service it starts: the service of its own name when
/// it names none, whose unit file stays the author's `File`. Reloading
/// systemd stays the author's `Command` step, in the order the author
/// wrote it.
class SystemdTimer extends core.Step {
  hidden fixed kind = "systemdTimer"
  /// The name of the `.timer` unit: `postgresql-multixact-monitor` is
  /// `postgresql-multixact-monitor.timer`.
  name: TimerName
  /// The service the timer starts: the unit the timer activates when it
  /// fires. A timer that names no service starts the service of its own
  /// name, as systemd does: `postgresql-maintenance.timer` starts
  /// `postgresql-maintenance.service`. The workflow declares that service
  /// as a `Service` of its own, or the unit comes from a package.
  service: ServiceName? = null
  /// When the timer fires: a systemd calendar expression, such as `daily`
  /// or `*-*-* 03:00:00`. One expression on one line: an empty expression
  /// names no time, and a line break would write another directive into the
  /// unit file.
  onCalendar: Static? = null
  /// How long after boot the timer fires.
  onBoot: Duration? = null
  /// Whether the timer fires for a run it missed while the machine was off.
  /// Only a calendar timer catches up: systemd remembers the last calendar
  /// run, not the last boot.
  persistent: Boolean = false
  /// Enabled at boot.
  enabled: Boolean = true
}
