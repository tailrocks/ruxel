/// Debian package management: apt repositories, the package index, and the
/// packages a host has installed.
///
/// The ruxel binary serves this module at `modulepath:/ruxel/Debian.pkl`.
/// Workflow files import it beside `Core.pkl`, qualifying every class:
///
///     import "modulepath:/ruxel/Debian.pkl" as debian
///     new debian.AptPackages { names { "nginx" } }
module Debian

import "modulepath:/ruxel/Core.pkl" as core

// The typealiases and functions below are copied from Core.pkl; keep them in
// sync — pklr cannot share typealiases across modules, and would silently
// drop the constraints of a dotted alias such as `core.Static`.

/// Text known before the run. Run-time values (`currentHost`,
/// `Capture.stdout()`) are allowed only in `File.content`; secrets
/// (`module.fnox`, …) only in `File.content` and action `environment`
/// values. Every other text field is `Static`, and neither a run-time value
/// nor a secret reference can be one: they carry the reserved prefixes
/// `__ruxel_rt_8d41.` and `__ruxel_secret_8d41.`, which nothing else may
/// contain.
///
/// No NUL either: no path, argument or name can hold one.
typealias Static = String(!contains("__ruxel_rt_8d41.") && !contains("__ruxel_secret_8d41.") && !contains("\u{0}"))

/// A list of `Static` texts. The constraint is on the whole list because
/// pklr does not check the elements of a `Listing`, and properties of this
/// type need an explicit `= new {}` default, which pklr does not supply for a
/// constrained `Listing` typealias.
typealias StaticList = Listing<String>(!toList().any((a) -> a.contains("__ruxel_rt_8d41.") || a.contains("__ruxel_secret_8d41.") || a.contains("\u{0}")))

/// `https://`, a host name, IPv4 address or bracketed IPv6 address, an
/// optional port from 1 to 65535, and an optional path without spaces.
typealias HttpsUrl = Static(isHttpsUrl(this))

const local function isHttpsUrl(s: String): Boolean =
  s.startsWith("https://") && (
    let (rest = s.substring(8, s.length))
    let (slash = if (rest.contains("/")) rest.indexOf("/") else rest.length)
    isAuthority(rest.substring(0, slash)) && !rest.contains(" ") && !rest.matches(Regex("(?s).*[\\x00-\\x1f\\x7f].*")))

const local function isAuthority(a: String): Boolean =
  if (a.startsWith("["))
    a.contains("]") && (let (close = a.indexOf("]")) isIpv6Address(a.substring(1, close)) && isPort(a.substring(close + 1, a.length)))
  else
    let (colon = if (a.contains(":")) a.indexOf(":") else a.length)
    a.substring(0, colon).matches(Regex(#"[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*"#)) && isPort(a.substring(colon, a.length))

const local function isPort(p: String): Boolean =
  p == "" || p.matches(Regex(":[0-9]{1,5}")) && p.substring(1, p.length).toInt() >= 1 && p.substring(1, p.length).toInt() <= 65535

/// At most one `::`; hex groups of one to four digits; eight groups in all,
/// fewer with `::`; an IPv4 tail counts as two. Written without relying on
/// `split` keeping empty pieces, which pklr, like Java, drops at the end.
const local function isIpv6Address(a: String): Boolean =
  let (gap = a.contains("::"))
  let (groups = a.split(":").filter((g) -> !g.isEmpty))
  let (tail = !groups.isEmpty && groups.last.contains("."))
  let (hex = groups.filter((g) -> !g.contains(".")))
  let (count = hex.length + (if (tail) 2 else 0))
  a.contains(":")
    && (!gap || a.indexOf("::") == a.lastIndexOf("::"))
    && (!a.startsWith(":") || a.startsWith("::"))
    && (!a.endsWith(":") || a.endsWith("::"))
    && hex.every((g) -> g.matches(Regex("[0-9a-fA-F]{1,4}")))
    && hex.length + (if (tail) 1 else 0) == groups.length
    && (!tail || isIpv4(groups.last) && !a.endsWith("::"))
    && (if (gap) count <= 7 else count == 8)

/// Four octets. `split` drops the trailing empty piece, so an address that
/// ends with `.` would read as if it named one octet less and pass; such an
/// address is refused, like one with an empty octet.
const local function isIpv4(s: String): Boolean =
  let (parts = s.split("."))
  !s.endsWith(".") && parts.length == 4 && parts.every((p) -> p.matches(Regex("0|[1-9][0-9]{0,2}")) && p.toInt() <= 255)

/// Downloads the current apt package lists. Never reports a change.
class AptPackageIndex extends core.Step {
  hidden fixed kind = "packageIndex"
}

/// Debian packages that are installed. Each name is `name`, `name=version`,
/// `name:arch` or `name:arch=version`, with one exact Debian version; a
/// package is listed once, or once per explicit architecture.
class AptPackages extends core.Step {
  hidden fixed kind = "packages"
  names: StaticList(!isEmpty)
  /// Upgrades them to the newest version on every run, not only once. The
  /// names cannot then pin a version.
  latest: Boolean = false
}

/// A signed apt repository, written as a deb822 source with its own keyring.
/// It manages both files, so a stage cannot also write either of them with a
/// `File`.
class AptRepository extends core.Step {
  hidden fixed kind = "aptRepository"
  /// Names the files `/etc/apt/sources.list.d/<name>.sources` and
  /// `/etc/apt/keyrings/<name>.asc`.
  name: String(matches(Regex("[a-z0-9][a-z0-9.-]*")) && length <= 247)
  url: HttpsUrl
  /// A distribution such as `"stable"`, or a path ending in `/` for a flat
  /// repository.
  suite: Static
  /// Required for a distribution, empty for a flat repository.
  components: StaticList = new {}
  /// ASCII-armored public key, committed next to the workflow. A changed
  /// key counts as a change of this step.
  signingKey: Static(startsWith("-----BEGIN PGP PUBLIC KEY BLOCK-----"))
  /// Debian architectures to fetch indexes for, such as `"amd64"`. Empty
  /// leaves it to apt: the host's own architecture and any foreign ones
  /// dpkg is configured for.
  architectures: StaticList = new {}
}
