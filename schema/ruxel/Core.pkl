/// The Ruxel workflow language: the core of a workflow.
///
/// A workflow is a list of stages. A stage runs a list of steps on a list of
/// hosts. A step says how one thing on a host should be: a package is
/// installed, a file has this content, a service is running. This module
/// holds the workflow shape itself (`Stage`, `Host`, `Recipe`, `Step`) and
/// the steps that are not tied to one system: files, links, commands,
/// scripts and captures. The steps that belong to one system live in the
/// modules beside it: `Linux.pkl`, `Systemd.pkl`, `Debian.pkl`.
///
/// The ruxel binary serves this module at `modulepath:/ruxel/Core.pkl`.
/// `Workflow.pkl` extends it, so workflow files amend
/// `modulepath:/ruxel/Workflow.pkl` and use its classes without a prefix;
/// recipe and inventory files extend this module directly:
///
///     extends "modulepath:/ruxel/Core.pkl"
///     class ApiProxy extends Recipe { … }
///
/// Naming: `title` is always the step's line in the plan; `name` is always the
/// name of the managed thing (a package repository, a service, a timezone).
open module Core

/// Text known before the run. Run-time values (`currentHost`,
/// `Capture.stdout()`) are allowed only in `File.content`; secrets
/// (`core.fnox`, …) only in `File.content` and action `environment`
/// values. Every other text field is `Static`, and a run-time value or a
/// secret reference can never be one: a run-time value is text that contains
/// the reserved prefix `__ruxel_rt_8d41.`, a secret reference the reserved
/// prefix `__ruxel_secret_8d41.`, and nothing else may contain either.
///
/// No NUL either: no path, argument or name can hold one.
typealias Static = String(!contains("__ruxel_rt_8d41.") && !contains("__ruxel_secret_8d41.") && !contains("\u{0}"))

/// A list of `Static` texts. The constraint is on the whole list because
/// pklr does not check the elements of a `Listing`, and properties of this
/// type need an explicit `= new {}` default, which pklr does not supply for a
/// constrained `Listing` typealias.
typealias StaticList = Listing<String>(!toList().any((a) -> a.contains("__ruxel_rt_8d41.") || a.contains("__ruxel_secret_8d41.") || a.contains("\u{0}")))

/// An absolute path in normal form: no empty, `.` or `..` segments and no
/// trailing `/`, so two spellings of one path are the same text. No NUL,
/// which no Unix path can hold.
typealias AbsolutePath = Static(this == "/" || matches(Regex("(/[^/]+)+")) && !contains("\u{0}") && !split("/").any((segment) -> segment == "." || segment == ".."))

/// An absolute path that can be a file: any but `/`, which is a directory.
typealias FilePath = AbsolutePath(this != "/")

/// `https://`, a host name, IPv4 address or bracketed IPv6 address, an
/// optional port from 1 to 65535, and an optional path without spaces.
typealias HttpsUrl = Static(isHttpsUrl(this))

const local function isHttpsUrl(s: String): Boolean =
  s.startsWith("https://") && (
    let (rest = s.substring(8, s.length))
    let (slash = if (rest.contains("/")) rest.indexOf("/") else rest.length)
    isAuthority(rest.substring(0, slash)) && !rest.contains(" ") && !rest.matches(Regex("(?s).*[\\x00-\\x1f\\x7f].*")))

const local function isAuthority(a: String): Boolean =
  if (a.startsWith("["))
    a.contains("]") && (let (close = a.indexOf("]")) isIpv6Address(a.substring(1, close)) && isPort(a.substring(close + 1, a.length)))
  else
    let (colon = if (a.contains(":")) a.indexOf(":") else a.length)
    a.substring(0, colon).matches(Regex(#"[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*"#)) && isPort(a.substring(colon, a.length))

const local function isPort(p: String): Boolean =
  p == "" || p.matches(Regex(":[0-9]{1,5}")) && p.substring(1, p.length).toInt() >= 1 && p.substring(1, p.length).toInt() <= 65535

/// A Unix file mode: three octal digits, or four with a leading `0` (`0644`
/// and `644` are the same mode, as they are to `chmod`).
typealias FileMode = String(matches(Regex("0?[0-7]{3}")))

/// A SHA-1 (40) or SHA-256 (64) Git object ID.
typealias CommitSha = String(matches(Regex("[0-9a-f]{40}|[0-9a-f]{64}")))

/// `localhost` and `all` are reserved: the engine uses them for the
/// controller itself and for every host.
typealias HostName = String(matches(Regex("[a-z0-9][a-z0-9-]*")) && this != "localhost" && this != "all")

/// IPv4 (`192.0.2.1`, each part 0 to 255), or IPv6 (`2001:db8::1`, an
/// embedded IPv4 tail allowed) with an optional zone such as `%eth0` for
/// link-local addresses.
typealias IpAddress = String(isIpv4(this) || isIpv6(this))

/// `0.0.0.0`, or an IPv6 address that is all zeros or maps `0.0.0.0`
/// (`::ffff:0.0.0.0`): the addresses ruxel's transport refuses.
const local function isUnspecified(s: String): Boolean =
  s == "0.0.0.0" || s.contains(":") && (
    let (groups = ipv6Groups(s.split("%").first))
    groups.length == 8 && (groups.every((g) -> isZero(g))
      || IntSeq(0, 4).toList().every((k) -> isZero(groups[k])) && groups[5].toLowerCase().matches(Regex("0*ffff")) && isZero(groups[6]) && isZero(groups[7])))

/// The eight groups of a valid IPv6 address; an IPv4 tail counts as two,
/// written `0` and `0` for `0.0.0.0` and `1` and `1` otherwise.
const local function ipv6Groups(a: String): List<String> =
  let (gap = a.contains("::"))
  let (left = tokens(if (gap) a.substring(0, a.indexOf("::")) else a))
  let (right = if (gap) tokens(a.substring(a.indexOf("::") + 2, a.length)) else List())
  let (missing = 8 - left.length - right.length)
  left + (if (missing <= 0) List() else IntSeq(1, missing).toList().map((_) -> "0")) + right

const local function tokens(part: String): List<String> =
  if (part.isEmpty) List()
  else part.split(":").flatMap((g) -> if (g.contains(".")) (if (g == "0.0.0.0") List("0", "0") else List("1", "1")) else List(g))

const local function isZero(group: String): Boolean = group.matches(Regex("0+"))

/// Four octets. `split` drops the trailing empty piece, so an address that
/// ends with `.` would read as if it named one octet less and pass; such an
/// address is refused, like one with an empty octet.
const local function isIpv4(s: String): Boolean =
  let (parts = s.split("."))
  !s.endsWith(".") && parts.length == 4 && parts.every((p) -> p.matches(Regex("0|[1-9][0-9]{0,2}")) && p.toInt() <= 255)

const local function isIpv6(s: String): Boolean =
  let (zoned = s.split("%"))
  !s.endsWith("%") && zoned.length <= 2 && (zoned.length == 1 || zoned[1].matches(Regex("[A-Za-z0-9_.-]+"))) && isIpv6Address(zoned[0])

/// At most one `::`; hex groups of one to four digits; eight groups in all,
/// fewer with `::`; an IPv4 tail counts as two. Written without relying on
/// `split` keeping empty pieces, which pklr, like Java, drops at the end.
const local function isIpv6Address(a: String): Boolean =
  let (gap = a.contains("::"))
  let (groups = a.split(":").filter((g) -> !g.isEmpty))
  let (tail = !groups.isEmpty && groups.last.contains("."))
  let (hex = groups.filter((g) -> !g.contains(".")))
  let (count = hex.length + (if (tail) 2 else 0))
  a.contains(":")
    && (!gap || a.indexOf("::") == a.lastIndexOf("::"))
    && (!a.startsWith(":") || a.startsWith("::"))
    && (!a.endsWith(":") || a.endsWith("::"))
    && hex.every((g) -> g.matches(Regex("[0-9a-fA-F]{1,4}")))
    && hex.length + (if (tail) 1 else 0) == groups.length
    && (!tail || isIpv4(groups.last) && !a.endsWith("::"))
    && (if (gap) count <= 7 else count == 8)

/// A command line: a program, which cannot be empty, and its arguments.
typealias Arguments = StaticList(!isEmpty && !toList().first.isEmpty)

/// The name of a service or an account: not empty, and not starting with
/// `-`, which the tools that take it would read as an option.
typealias Name = Static(!isEmpty && !startsWith("-"))

/// A user or group name: a `Name` without the passwd and group delimiters.
typealias Account = Name(!contains(":") && !contains("\n"))

/// A user or group name: a lower-case name of at most 32 characters, the
/// way the passwd and group files spell one. A name starts with a letter
/// or an underscore and continues with letters, digits, `_` or `-`.
typealias Username = Static(matches(Regex("[a-z_][a-z0-9_-]{0,31}")))

/// A numeric user id: 0 to 60000.
typealias Uid = Int(isBetween(0, 60000))

/// A numeric group id: 0 to 60000.
typealias Gid = Int(isBetween(0, 60000))

/// Whether a thing is there or not.
typealias Presence = "present"|"absent"

/// The SSH user ruxel logs in as: letters, digits, `._-`, not starting with
/// `-`, as the engine accepts.
typealias SshUser = Static(matches(Regex("[A-Za-z0-9._-]+")) && !startsWith("-"))

/// An SSH config alias or host: letters, digits, `._:%[]-`, not starting with
/// `-`, as the engine accepts.
typealias SshHost = Static(matches(Regex(#"[A-Za-z0-9._:%\[\]-]+"#)) && !startsWith("-"))

/// A kernel parameter name: dot-separated segments of letters, digits,
/// underscores and hyphens, not starting with `-`, the way `/proc/sys`
/// spells them (`net.ipv4.conf.br-123.forwarding`) — or slash-first
/// notation, where the first separator is `/` and every later `/` a
/// separator and every `.` a literal of its component
/// (`net/ipv4/conf/enp3s0.200/forwarding`), the spelling a component
/// with a literal dot needs. The notations never mix: a dotted name
/// admits no slash, and a slash-first name keeps its dots inside
/// components.
typealias SysctlName = Static((matches(Regex(#"[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)*"#)) || matches(Regex(#"[A-Za-z0-9_-]+(/[A-Za-z0-9_.-]+)+"#))) && !startsWith("-"))

/// A kernel parameter value: one line of text, with no line break in it, so
/// one entry is one line of one file.
typealias SysctlValue = Static(!contains("\n") && !contains("\r"))

// ── Hosts and stages ────────────────────────────────────────────────────────

/// A machine that stages run on.
class Host {
  /// Inventory name, shown in progress output.
  name: HostName
  /// The host's IP address. It is also what `currentHost.address` renders.
  /// Not an unspecified address (`0.0.0.0`, `::`), which ruxel never
  /// connects to.
  address: IpAddress(!isUnspecified(this))
  /// The SSH target, when it is not `address`: an alias from the SSH config.
  sshHost: SshHost? = null
  user: SshUser = "root"
  port: Int(isBetween(1, 65535)) = 22
}

/// A list of steps that runs on a list of hosts.
///
/// Every host runs the steps in order. The next stage starts only after this
/// stage has finished on all of its hosts.
class Stage {
  title: Static
  /// Each host once.
  hosts: Listing<Host>(!isEmpty)
  steps: Listing<Step>
}

/// One thing on a host and how it should be.
abstract class Step {
  /// Identifies the step type for tools; every step class sets it.
  hidden fixed kind: String
  /// Replaces the generated description in plans and progress output. For
  /// `AptPackages`, `AptPackageIndex`, `Service`, `Command`, `Script` and
  /// `Capture`, two otherwise equal steps with different plan lines are
  /// different steps; for steps that manage a thing (`File`, `Directory`, …)
  /// the title is only a label.
  title: Static? = null
  /// Labels for `ruxel apply --tags`.
  tags: StaticList = new {}
}

/// A reusable group of steps with typed parameters. A recipe used twice in a
/// stage adds its steps twice: things it manages merge, commands run twice,
/// and a capture that does not depend on a parameter is the same capture
/// both times, which is rejected (see `Capture`).
///
///     class ApiProxy extends Recipe {
///       backends: Listing<Host>
///       function steps(): Listing<Step> = new { … }
///     }
///
/// Tags on a recipe apply to all of its steps.
///
/// A recipe has no line of its own in the plan, so it takes no `title`.
abstract class Recipe extends Step {
  hidden fixed kind = "recipe"

  abstract function steps(): Listing<Step>
}

/// The host that a step is running on, for use in `File.content`. Ruxel
/// fills in the values on each host. Write `module.currentHost.address`:
/// Pkl does not show inherited members inside nested objects.
const currentHost: CurrentHost = new CurrentHost {}

class CurrentHost {
  fixed name: String = "__ruxel_rt_8d41.inventoryHost__"
  fixed address: String = "__ruxel_rt_8d41.vars.ruxel_address__"
}

// ── Secrets ─────────────────────────────────────────────────────────────────

/// A key of the controller's fnox store: a letter, then letters, digits and
/// underscores, 2 to 128 characters in all.
typealias FnoxKey = String(matches(Regex("[A-Z][A-Z0-9_]{1,127}")))

/// A 1Password vault, item, field or section label: any non-empty text but a
/// `/`, which separates the parts of a reference, a newline, NUL, the
/// reserved secret and run-time prefixes, and `\u{1e}`/`\u{1f}`, which the
/// secret reference encoding reserves (see `SecretText`).
typealias OpLabel = String(isOpLabel(this))

/// One `op://` reference: `op://<vault>/<item>/<field>`, or with a section,
/// `op://<vault>/<item>/<section>/<field>`, each part an `OpLabel`. A query
/// (`?…`) names an attribute of a field, not a value, and is refused.
///
/// The parts of a reference are separated by `/`, so a dot is an ordinary
/// character of a label there: `op://Vault/Item/API.Password` names the
/// field labeled `API.Password`. The CLI's `--fields` selector, which the
/// structured `onePassword` uses, reads a dot as its section separator; a
/// reference is not that selector.
///
/// `split` drops the trailing empty piece, so a reference that ends with `/`
/// would read as if it named one part less and pass; such a reference is
/// refused, like one with an empty part.
typealias OpReference = String(isOpReference(this))

const local function isOpLabel(label: String): Boolean =
  !label.isEmpty
    && !label.contains("/")
    && !label.contains("\n")
    && !label.contains("\u{0}")
    && !label.contains("\u{1e}")
    && !label.contains("\u{1f}")
    && !label.contains("__ruxel_secret_8d41.")
    && !label.contains("__ruxel_rt_8d41.")

const local function isOpReference(r: String): Boolean =
  r.startsWith("op://") && !r.contains("?") && (
    let (rest = r.substring(5, r.length))
    let (parts = rest.split("/"))
    !rest.endsWith("/") && (parts.length == 3 || parts.length == 4)
      && parts.every((p) -> isOpLabel(p))
      && !hasReferenceSelectorSyntax(parts.last)
      && (parts.length != 4 || !hasReferenceSelectorSyntax(parts[2])))

/// The 1Password CLI parses `,` as a field-list separator and `=` as a
/// selector, in a `--fields` selector and in a reference alike. A dot is
/// not among them: it is the section separator of the `--fields` selector,
/// and the parts of a reference are separated by `/`, so a dot is an
/// ordinary character of a label there.
const local function hasReferenceSelectorSyntax(label: String): Boolean =
  label.contains(",") || label.contains("=")

/// The 1Password CLI parses `,` as a field-list separator, `=` as a
/// selector and `.` as the section separator. Only a field reaches
/// `--fields`; a section-qualified field is written as `section.field`, so a
/// dot inside a field or section reads as a different selector than the
/// author named.
const local function hasFieldSelectorSyntax(field: String): Boolean =
  field.contains(",") || field.contains("=") || field.contains(".")

/// The formats `fnoxGenerated` creates a missing key in: 16 or 32 hex
/// characters, 32 bytes base64-encoded, or 32 letters and digits.
typealias GeneratedFormat = "hex16"|"hex32"|"base64-32"|"alnum32"

/// A value that lives in a secret store (fnox, 1Password) and reaches a host
/// only at apply time. It is not `String` and never becomes one: a secret can
/// be interpolated into `File.content` and used as a `Command`/`Script`
/// `environment` value, and nothing else. Assignment to a path, name, script
/// or SQL field, trimming, comparison and concatenation into static text are
/// refused — by this module's types (`Static` rejects the reserved prefix
/// below) or by Lowering, which reads every field.
///
/// Interpolating a secret carries a reference, never a value: evaluation
/// contacts no store, and plans and diffs show a fingerprint, never text.
class SecretText {
  /// The value's parts, encoded: what store each part is read from and, for
  /// `join`, the separators between them. Every string is stored with its
  /// length, and `_` is written `\u{1f}`, so the encoding cannot contain the
  /// `__` that ends the reference. Lowering decodes it; nothing else reads it.
  hidden parts: String

  /// The reference a secret interpolates as. The reserved prefix
  /// `__ruxel_secret_8d41.` is what `Static` rejects, so a secret cannot hide
  /// in a path or a name, and every operation on a `SecretText` but the sinks
  /// above fails, because Pkl has no string operation on a class.
  function toString(): String = "__ruxel_secret_8d41.\(parts)__"

  /// Two secrets and the static text between them, as one secret: the
  /// kubeadm pair is `fnox("…ID").join(".", fnox("…SECRET"))`. The result is
  /// a `SecretText` with the same limits; the separator is the only static
  /// text a secret can sit beside.
  function join(separator: Static, other: SecretText): SecretText =
    (let (mine = parts) new SecretText { parts = mine + "s" + sized(separatorChecked(separator)) + other.parts })
}

/// Reads one value from the controller's fnox store. Evaluation names the
/// key; the store is read at apply time only.
function fnox(key: FnoxKey): SecretText = new SecretText { parts = "f" + sized(fnoxKeyChecked(key)) }

/// Like `fnox`, but `apply` creates the key, in this format, when it is
/// missing: once per run, before any secret is resolved, under the fnox write
/// lock. `plan`, `check` and `diff` never generate.
function fnoxGenerated(key: FnoxKey, format: GeneratedFormat): SecretText =
  new SecretText { parts = "g" + sized(fnoxKeyChecked(key)) + sized(generatedFormatChecked(format)) }

/// Reads one field of one 1Password item. Vault and field are always named:
/// no lookup defaults either. A `section` selects a field inside a section;
/// without one, a label that several sections carry fails at apply, naming
/// them, rather than taking the first match. Only the named field is
/// fetched, never the whole item.
///
/// Pkl has no optional function parameters, so the optional part of the read
/// is the last argument, an options object: `new OnePasswordOptions {}`
/// reads a field outside any section, `new { section = "…" }` one inside.
/// (A bare `new {}` works under official Pkl but not under pklr, which
/// cannot type an entirely empty anonymous amend.)
function onePassword(vault: OpLabel, item: OpLabel, field: OpLabel, options: OnePasswordOptions): SecretText =
  new SecretText {
    parts = "o" + sized(opLabelChecked("vault", vault)) + sized(opLabelChecked("item", item))
      + sized(if (options.section == null) null else opSectionChecked(options.section))
      + sized(opFieldChecked(field))
  }

/// The optional half of a 1Password read: the section the field lives in.
/// A plain `String?`, checked by `onePassword` itself: pklr mishandles a
/// nullable typealias with a constraint as a property type of a class an
/// author amends (`new { section = "…" }`).
class OnePasswordOptions {
  section: String? = null
}

/// Reads the 1Password value one `op://` reference names.
function onePasswordReference(reference: OpReference): SecretText =
  new SecretText { parts = "r" + sized(referenceChecked(reference)) }

// pklr does not check a function parameter's type constraint, so each store
// function checks its arguments itself, with a sentence that names the
// argument; official Pkl rejects the same call at the signature.
const local function fnoxKeyChecked(key: String): String =
  if (key.matches(Regex("[A-Z][A-Z0-9_]{1,127}"))) key
  else throw("fnox key \"\(key)\" is malformed: uppercase letters, digits and underscores only, starting with a letter, 2 to 128 characters")

const local function generatedFormatChecked(format: String): String =
  if (List("hex16", "hex32", "base64-32", "alnum32").contains(format)) format
  else throw("fnoxGenerated format \"\(format)\" is not one of hex16, hex32, base64-32 or alnum32")

const local function separatorChecked(separator: String): String =
  if (separator.contains("__ruxel_secret_8d41.") || separator.contains("__ruxel_rt_8d41."))
    throw("join separator \"\(separator)\" carries a secret or run-time value; the text between two joined secrets is static text only")
  else if (separator.contains("\u{0}"))
    throw("join separator contains NUL; use text without a NUL")
  else if (separator.contains("\u{1f}") || separator.contains("\u{1e}"))
    throw("join separator contains \\u{1f} or \\u{1e}, which the secret reference encoding reserves; use another character")
  else separator

const local function opLabelChecked(what: String, label: String): String =
  if (label.contains("__ruxel_secret_8d41.") || label.contains("__ruxel_rt_8d41."))
    throw("1Password \(what) \"\(label)\" carries a secret or run-time value; a selector is static text only")
  else if (label.contains("\u{0}"))
    throw("1Password \(what) \"\(label)\" contains NUL, which no selector can hold")
  else if (label.contains("\u{1f}") || label.contains("\u{1e}"))
    throw("1Password \(what) \"\(label)\" contains \\u{1f} or \\u{1e}, which the secret reference encoding reserves; use another character")
  else if (!label.isEmpty && !label.contains("/") && !label.contains("\n")) label
  else throw("1Password \(what) \"\(label)\" is malformed: not empty, and no `/`, no line break")

/// A field reaches `op item get --fields`, which parses `,` as a list
/// separator, `=` as `label=`/`type=` selectors and `.` as the section
/// separator, so a legal `OpLabel` like `API,key` or `API.Password` would
/// fetch a different selector than the author named. The optional section
/// and the field form that one selector; vault and item are separate
/// arguments and carry no such rule.
const local function opFieldChecked(field: String): String =
  if (field.contains(",") || field.contains("="))
    throw("1Password field \"\(field)\" may not contain a comma or an equals sign: `op item get --fields` reads them as selectors, so it would fetch unintended fields")
  else if (field.contains("."))
    throw("1Password field \"\(field)\" may not contain a dot: `op item get --fields` reads a dot as the section separator, so it would fetch a different selector than the author named")
  else opLabelChecked("field", field)

/// A section and its field together form the CLI's `--fields` selector, so
/// the same comma, equals-sign and dot rule applies to both components.
const local function opSectionChecked(section: String): String =
  if (section.contains(",") || section.contains("="))
    throw("1Password section \"\(section)\" may not contain a comma or an equals sign: `op item get --fields` reads them as selectors, so it would fetch unintended fields")
  else if (section.contains("."))
    throw("1Password section \"\(section)\" may not contain a dot: `op item get --fields` reads a dot as the section separator, so it would fetch a different selector than the author named")
  else opLabelChecked("section", section)

const local function referenceParts(reference: String): List<String> =
  if (reference.startsWith("op://") && !reference.contains("?")) (
    let (rest = reference.substring(5, reference.length))
    if (rest.endsWith("/")) List() else rest.split("/")
  )
  else List()

const local function referenceLabelsChecked(reference: String, parts: List<String>): String =
  let (vault = opLabelChecked("vault", parts[0]))
  let (item = opLabelChecked("item", parts[1]))
  let (section = if (parts.length == 4) opReferenceLabelChecked("section", parts[2]) else "")
  let (field = opReferenceLabelChecked("field", parts.last))
  reference

/// A label of a full `op://` reference. A dot is an ordinary character
/// there: the parts of a reference are separated by `/`, and the reference
/// is read as it is written. The CLI's own selector syntax — a comma and an
/// equals sign — is refused, as it is in the structured selector.
const local function opReferenceLabelChecked(what: String, label: String): String =
  if (label.contains(",") || label.contains("="))
    throw("1Password \(what) \"\(label)\" may not contain a comma or an equals sign: `op item get --fields` reads them as selectors, so it would fetch unintended fields")
  else opLabelChecked(what, label)

const local function referenceChecked(reference: String): String =
  let (parts = referenceParts(reference))
  if (parts.length == 3 || parts.length == 4) referenceLabelsChecked(reference, parts)
  else if (isOpReference(reference)) reference
  else throw("\"\(reference)\" is not an op:// reference: op://<vault>/<item>/<field>, or with a section op://<vault>/<item>/<section>/<field>, and no `?`")

/// One length-prefixed string of the secret reference encoding: `f` for fnox
/// keys, `g` generated keys (key, format), `o` 1Password selectors (vault,
/// item, section, field; an empty section means none), `r` `op://`
/// references, `s` `join` separators. `_` is written `\u{1f}` so the encoding
/// cannot contain its own `__` terminator, and a literal `\u{1f}` is written
/// `\u{1e}` first, so the two cannot be confused: decoding recovers exactly
/// what was encoded, and what decodes to `\u{1f}` is refused (`join` refuses
/// the separator, Lowering re-validates every part it decodes).
const local function sized(text: String?): String =
  if (text == null) "0:" else "\(text.length):\(text.replaceAll("\u{1f}", "\u{1e}").replaceAll("_", "\u{1f}"))"

/// Reads one file on exactly one host and stores it in the controller's fnox
/// store under `fnoxKey`:
///
///     new FetchSecret {
///       title = "Store the cluster admin kubeconfig"
///       fromPath = "/etc/kubernetes/admin.conf"
///       runOn = inventory.firstControlPlane
///       fnoxKey = "K8S_ADMIN_KUBECONFIG"
///     }
///
/// - The content travels as a no-log slurp and is written with `fnox set
///   --from-file`, the byte-preserving store; it never appears in output,
///   results or the ledger, and it is
///   never copied anywhere else — no workflow step handles the plaintext.
/// - It reports a change only when the fetched content differs from the
///   stored value, compared on the controller by the keyed secret
///   fingerprint. Identity is the `fnoxKey`: two `FetchSecret` steps with
///   one key and a different `fromPath` or `runOn` conflict like two states
///   of one thing, and an exact repeat is the same step.
/// - In `plan`, `check` and `diff` it contacts neither fnox nor the host, so
///   it reports known-after-apply rather than a fingerprint comparison; the
///   comparison and the store happen only in `apply`.
class FetchSecret extends Step {
  hidden fixed kind = "fetchSecret"
  /// The file to read, on the one named host. Read at apply only.
  fromPath: FilePath
  /// The one host the file is read on, stated and never inferred: a stage
  /// with several hosts must not race to write one key (last writer wins,
  /// possibly a host without the file).
  runOn: Host
  /// The fnox key the content is stored under. It must match the fnox key
  /// shape.
  fnoxKey: FnoxKey
}

// ── Files ───────────────────────────────────────────────────────────────────

/// A file with exactly this content. A stage writes it once, where it first
/// appears; an exact repeat is the same step, and a second, different
/// content for the same path is rejected: write it in a later stage.
///
///     new File { path = "/root/.zshrc"; content = read("files/zshrc").text }
class File extends Step {
  hidden fixed kind = "file"
  path: FilePath
  /// May contain run-time values (`currentHost`, `Capture.stdout()`) and
  /// secrets (`core.fnox(…)`, `core.onePassword(…)`, `SecretText.join`),
  /// which are resolved on the host, never on the controller.
  ///
  /// The secret functions are reached through an import of Core, not
  /// through the workflow's own module: under pklr, a call through
  /// `module.fnox(…)` from inside a step duplicates every play in the
  /// lowered configuration. Import Core as `core` and call `core.fnox(…)`.
  content: String
  /// A file whose content holds a secret must be `0600` or narrower (no
  /// permission for group or other): a wider mode with secret content is
  /// rejected.
  mode: FileMode = "0644"
  /// `null` leaves the current owner unchanged.
  owner: Account? = null
  group: Account? = null
  /// A command that must accept the new content before it replaces the
  /// file. `%s` stands for the candidate, `.<name>.ruxel-candidate` beside
  /// the file. A file without secrets keeps the candidate between runs, so
  /// a second apply reports no change; a file whose content holds a secret
  /// uses a temporary candidate that is removed after validation, success or
  /// failure, so no resolved plaintext stays on the host.
  ///
  /// `check` and `diff` do not run it: it needs the candidate on the host,
  /// and they write nothing. They report content the validator would reject
  /// as a pending change; `apply` then fails at the validator and leaves the
  /// file as it was.
  ///
  ///     validate { "haproxy"; "-c"; "-f"; "%s" }
  validate: StaticList(isEmpty || !toList().first.isEmpty && toList().any((a) -> a.contains("%s"))) = new {}
}

class Directory extends Step {
  hidden fixed kind = "directory"
  path: AbsolutePath
  mode: FileMode = "0755"
}

class Symlink extends Step {
  hidden fixed kind = "symlink"
  path: FilePath
  target: AbsolutePath
}

// ── Commands ────────────────────────────────────────────────────────────────

/// What a command or script needs: when to run, and what to report.
///
/// Ruxel cannot see what a program does, so say when it has to run:
///
/// - `creates`: skip it when this path exists — the check happens on the
///   controller before the environment is resolved, so a skipped action
///   reads no secret store;
/// - `onChangeOf`: run it only when one of these steps changed;
/// - both: run it when the path is missing or one of the steps changed;
/// - neither: run it on every apply.
abstract class Action extends Step {
  creates: AbsolutePath? = null
  /// Each must be an earlier step of the same stage that can report a
  /// change. Not a recipe: a recipe has no change of its own, so list the
  /// recipe's steps that matter.
  ///
  /// A step that runs again where it is written (`AptPackages`, `Command`, …)
  /// counts once for every earlier run with the same settings, including
  /// runs added by another use of the same recipe. This step runs when any
  /// of them changed.
  onChangeOf: Listing<Step>
  /// What the run reports after the program succeeds:
  /// - `"always"` (default): a change;
  /// - `"never"`: no change, because the program only refreshes or inspects;
  /// - `new UnlessOutput { … }`: a change, unless the output contains the text.
  changes: "always"|"never"|UnlessOutput = "always"
  /// Environment values for the program. A value is static text or a secret
  /// (`core.fnox(…)`, `core.onePassword(…)`, `SecretText.join`); pass the
  /// secret itself, never a secret or run-time value interpolated into text —
  /// a program that needs host state reads it from the rendered config or a
  /// capture. A secret value marks the step sensitive: it is redacted from
  /// output and never recorded.
  ///
  /// The secret functions are reached through an import of Core, not
  /// through the workflow's own module: under pklr, a call through
  /// `module.fnox(…)` from inside a step duplicates every play in the
  /// lowered configuration. Import Core as `core` and call `core.fnox(…)`.
  ///
  /// No explicit `= new {}` default: pklr cannot amend a `Mapping` whose
  /// value type is a union with a `String` branch through an explicit
  /// default; the implicit empty mapping works under both evaluators.
  environment: Mapping<EnvKey, Static|SecretText>
}

/// A change is reported unless the output contains this text. Set exactly
/// one of the two fields.
class UnlessOutput {
  stdoutContains: Static? = null
  stderrContains: Static? = null
}

/// An environment variable name: a letter or underscore, then letters,
/// digits and underscores.
typealias EnvKey = String(matches(Regex("[A-Za-z_][A-Za-z0-9_]*")))

/// A program with arguments, run without a shell.
///
///     new Command { run { "git"; "lfs"; "install" }; changes = "never" }
class Command extends Action {
  hidden fixed kind = "command"
  run: Arguments
}

/// A Bash script, run with `set -euo pipefail`.
class Script extends Action {
  hidden fixed kind = "script"
  bash: Static
}

/// A read-only Bash script whose output later steps use:
///
///     local release = new Capture { bash = "cat /etc/debian_version" }
///     new File { path = "/etc/motd"; content = "Debian \(release.stdout())" }
///
/// - A capture runs once per stage, where it is listed, so a `local`
///   holding it holds one value. Listing it again is rejected.
/// - It runs in `check` and `diff` too, because later steps need its real
///   output there. So it must only read: it may not change the host.
/// - Two captures are the same capture when their plan line (title, or the
///   generated "Capture <first line>"), script, `runOn` and `retry` match.
/// - To read again after a change, make a second capture with its own
///   title: `new Capture { title = "Read release after the upgrade"; … }`.
/// - To share a value between recipes, the stage lists the capture once and
///   passes it as a parameter; the recipe reads its `stdout()` without
///   listing it. An optional parameter (`sharedCaHash: Capture? = null`)
///   lets a recipe read the value itself when nobody shares it.
/// - A recipe used more than once whose capture script is the same for
///   every use, and that wants its own read per use, derives the title from
///   a parameter.
class Capture extends Step {
  hidden fixed kind = "capture"
  /// Run with `set -euo pipefail`. It must not change any host.
  bash: Static
  /// Runs on this host, once for each host of the stage, instead of on the
  /// stage's hosts.
  runOn: Host? = null
  retry: Retry = new Retry {}

  /// The script's standard output, for `File.content` of a later step.
  function stdout(): String = "__ruxel_rt_8d41.results.\(id()).stdout__"

  function id(): String =
    // Each field is prefixed with its length, so no text stands for two.
    "capture_" + List(title ?? description(), if (runOn == null) "-" else "+" + runOn.name, "\(retry.attempts)", "\(retry.delay.toUnit("s").value.toInt())", bash)
      .map((v) -> "\(v.length):\(v)").join("").sha256.substring(0, 32)

  /// The generated plan line, used when there is no title.
  function description(): String = "Capture " + bash.trim().split("\n").first
}

/// Repeats a step until it succeeds.
class Retry {
  attempts: Int(isBetween(1, 100)) = 1
  /// Whole seconds; at least one.
  delay: Duration = 5.s
}

// ── Content ─────────────────────────────────────────────────────────────────

/// Renders a Pkl value as a YAML document. Write `module.yaml(…)`, for the
/// reason given at `currentHost`.
const function yaml(value: Any): String = new YamlRenderer {}.renderDocument(value)
