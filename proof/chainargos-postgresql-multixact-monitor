#!/usr/bin/env bash
set -Eeuo pipefail

readonly DATA_DIRECTORY="/var/lib/postgresql/19/main"
readonly MULTIXACT_MEMBER_DIRECTORY="${DATA_DIRECTORY}/pg_multixact/members"
readonly MULTIXACT_OFFSET_DIRECTORY="${DATA_DIRECTORY}/pg_multixact/offsets"
readonly DATABASE_AGE_WARN=300000000
readonly DATABASE_AGE_CRIT=400000000
readonly RELATION_AGE_WARN=200000000
readonly RELATION_AGE_CRIT=400000000
readonly TRANSACTION_AGE_WARN=3600
readonly TRANSACTION_AGE_CRIT=86400
readonly IDLE_TRANSACTION_WARN=300
readonly MEMBER_STORAGE_WARN=$((10 * 1024 * 1024 * 1024))
readonly MEMBER_STORAGE_CRIT=$((20 * 1024 * 1024 * 1024))
readonly LOG_TAG="chainargos-postgresql-multixact-monitor"
readonly PSQL=(/usr/bin/runuser -u postgres -- /usr/bin/psql -X -qAt -v ON_ERROR_STOP=1 -p 40000)

status=0

log_alert() {
    local priority="$1"
    local message="$2"

    /usr/bin/logger -t "$LOG_TAG" -p "$priority" -- "$message"
    if [[ "$priority" == daemon.crit ]]; then
        status=2
    elif (( status == 0 )); then
        status=1
    fi
}

check_age() {
    local label="$1"
    local age="$2"
    local warn="$3"
    local crit="$4"

    if (( age >= crit )); then
        log_alert daemon.crit "$label MultiXact age=${age} (critical threshold=${crit})"
    elif (( age >= warn )); then
        log_alert daemon.warning "$label MultiXact age=${age} (warning threshold=${warn})"
    fi
}

if ! database_rows="$("${PSQL[@]}" -d postgres -c '
    SELECT datname, mxid_age(datminmxid)
    FROM pg_database
    WHERE datallowconn AND datname LIKE '\''verify_%'\''
    ORDER BY datname
')"; then
    log_alert daemon.crit "cannot read database MultiXact ages"
    exit "$status"
fi

while IFS='|' read -r database age; do
    [[ -z "${database:-}" ]] && continue
    check_age "database=${database}" "$age" "$DATABASE_AGE_WARN" "$DATABASE_AGE_CRIT"

    if ! relation_age="$("${PSQL[@]}" -d "$database" -c '
        SELECT COALESCE(MAX(mxid_age(c.relminmxid)), 0)
        FROM pg_class AS c
        JOIN pg_namespace AS n ON n.oid = c.relnamespace
        WHERE c.relkind IN ('\''r'\'', '\''m'\'')
          AND n.nspname NOT IN ('\''pg_catalog'\'', '\''information_schema'\'')
    ')"; then
        log_alert daemon.crit "cannot read relation MultiXact age database=${database}"
        continue
    fi
    check_age "database=${database} relation_max" "$relation_age" "$RELATION_AGE_WARN" "$RELATION_AGE_CRIT"
done <<< "$database_rows"

if ! transaction_row="$("${PSQL[@]}" -d postgres -c '
    SELECT
        COALESCE(MAX(EXTRACT(EPOCH FROM (clock_timestamp() - xact_start))) FILTER (WHERE xact_start IS NOT NULL), 0)::bigint,
        COUNT(*) FILTER (WHERE xact_start < clock_timestamp() - INTERVAL '\''1 hour'\''),
        COUNT(*) FILTER (
            WHERE state = '\''idle in transaction'\''
              AND state_change < clock_timestamp() - INTERVAL '\''5 minutes'\''
        )
    FROM pg_stat_activity
    WHERE backend_type = '\''client backend'\''
      AND datname LIKE '\''verify_%'\''
')"; then
    log_alert daemon.crit "cannot read verification transaction ages"
else
    IFS='|' read -r oldest_transaction old_transaction_count idle_transaction_count <<< "$transaction_row"
    if (( oldest_transaction >= TRANSACTION_AGE_CRIT )); then
        log_alert daemon.crit "verification transaction age=${oldest_transaction}s (critical threshold=${TRANSACTION_AGE_CRIT}s, old_count=${old_transaction_count})"
    elif (( oldest_transaction >= TRANSACTION_AGE_WARN )); then
        log_alert daemon.warning "verification transaction age=${oldest_transaction}s (warning threshold=${TRANSACTION_AGE_WARN}s, old_count=${old_transaction_count})"
    fi
    if (( idle_transaction_count > 0 )); then
        log_alert daemon.warning "verification idle-in-transaction sessions=${idle_transaction_count} (threshold=${IDLE_TRANSACTION_WARN}s)"
    fi
fi

if ! member_storage="$(
    /usr/bin/du -sb "$MULTIXACT_MEMBER_DIRECTORY" "$MULTIXACT_OFFSET_DIRECTORY" |
        /usr/bin/awk '{ total += $1 } END { print total + 0 }'
)"; then
    log_alert daemon.crit "cannot read pg_multixact storage"
else
    if (( member_storage >= MEMBER_STORAGE_CRIT )); then
        log_alert daemon.crit "pg_multixact member_and_offset_bytes=${member_storage} (critical threshold=${MEMBER_STORAGE_CRIT})"
    elif (( member_storage >= MEMBER_STORAGE_WARN )); then
        log_alert daemon.warning "pg_multixact member_and_offset_bytes=${member_storage} (warning threshold=${MEMBER_STORAGE_WARN})"
    fi
fi

exit "$status"
