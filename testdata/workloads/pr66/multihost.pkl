import "../../../schema/Ruxel.pkl"

output {
  value = new Ruxel.Config {
    inventory {
      hosts {
        for (i in 1..6) { ["fixture-\(i)"] { address = "127.0.0.1" } }
      }
      groups {
        ["multihost"] { hosts { for (i in 1..6) "fixture-\(i)" } }
      }
    }
    plays {
      new {
        name = "Synthetic six-host scheduling workload"
        targets { "multihost" }
        tasks {
          new {
            name = "Run one-second independent host work"
            operation = new Ruxel.Command { cmd = "/bin/sleep 1" }
            changedWhen = new Ruxel.Literal { value = false }
          }
        }
      }
    }
  }
}
