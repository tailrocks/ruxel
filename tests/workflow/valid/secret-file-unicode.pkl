// A secret between non-BMP characters: the placeholder's regex offsets count
// UTF-16 code units while Pkl string indexes count code points. Lowering must
// still keep the literal text on both sides of the lookup intact.
// The secret functions are reached through an import of Core, as in the other
// secret corpus cases.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "Unicode"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/unicode.env"
    mode = "0600"
    content = "😀P=\(core.fnox("AB"))TAIL😀"
  }
} } }
