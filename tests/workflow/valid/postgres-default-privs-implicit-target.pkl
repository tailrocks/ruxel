// An implied default-privilege target is the login role the agent changes,
// so the same grant with the target stated and implied is one declaration,
// not two states in conflict.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Postgres.pkl" as postgres
import "../inventory.pkl"

stages { new Stage { title = "Looker reads future redshift tables"; hosts = inventory.workers; steps {
  new postgres.Privilege {
    loginDb = "redshift"
    type = "default_privs"
    privs = "SELECT"
    schema = "public"
    role = "looker"
    loginUser = "postgres"
    loginPort = 40000
  }
  new postgres.Privilege {
    loginDb = "redshift"
    type = "default_privs"
    privs = "SELECT"
    schema = "public"
    role = "looker"
    targetRoles { "postgres" }
    loginUser = "postgres"
    loginPort = 40000
  }
} } }

name = "valid/postgres-default-privs-implicit-target.pkl"
