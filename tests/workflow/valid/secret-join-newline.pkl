// A `join` separator may carry a newline: the separator is static text and
// the secret reference encoding stores it verbatim, so the placeholder
// payload of this legal pair contains a literal LF. Lowering's placeholder
// capture must span lines — a line-bound capture refuses the pair as a
// malformed secret reference — without letting one placeholder swallow a
// later one; the payload still cannot contain the `__` terminator.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

local pair = core.fnox("KUBEADM_TOKEN_ID").join("\n", core.fnox("KUBEADM_TOKEN_SECRET"))

stages { new Stage { title = "Kubeadm"; hosts = inventory.workers; steps {
  new File {
    title = "Write the bootstrap token pair for this node"
    path = "/etc/kubernetes/bootstrap-token"
    mode = "0400"
    content = "P=\(pair)\n"
  }
} } }
