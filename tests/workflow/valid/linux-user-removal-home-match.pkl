// A recursive removal that states the effective home is consistent:
// the declared home is the one the workflow last declared present for
// the account, which `userdel -r` deletes.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage { title = "account"; hosts = inventory.workers; steps {
    new linux.User { user = "alice"; uid = 1500; home = "/srv/alice" }
  } }
  new Stage { title = "remove"; hosts = inventory.workers; steps {
    new linux.User { user = "alice"; uid = 1500; home = "/srv/alice"; state = "absent"; removeHome = true }
  } }
}

name = "valid/linux-user-removal-home-match.pkl"
