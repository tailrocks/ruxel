// The account's task creates the missing home before the later stage
// publishes inside it: the earlier stage declares the account, so the
// home exists when the later file task opens its parent, and the
// cross-stage provider-order check admits the workflow.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage {
    title = "first"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice" }
    }
  }
  new Stage {
    title = "second"
    hosts = inventory.workers
    steps {
      new File { path = "/home/alice/config"; content = "x\n" }
    }
  }
}
