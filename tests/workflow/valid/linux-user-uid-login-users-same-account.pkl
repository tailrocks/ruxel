amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// One machine, one identity, two login users: both stages reach
// 192.0.2.50:22 — the first as root, the second as deployer — and both
// declare Alice with 1500, so no second identity ever contends for the
// number. Keying the machine by endpoint and port merges the two
// stages onto one host, where the same name redeclared is the same
// identity, not a clash.
local webRoot = new Host { name = "web-root"; address = "192.0.2.50" }
local webDeployer = new Host { name = "web-deployer"; address = "192.0.2.50"; user = "deployer" }

stages {
  new Stage {
    title = "first"
    hosts { webRoot }
    steps {
      new linux.User { user = "alice"; uid = 1500 }
    }
  }
  new Stage {
    title = "second"
    hosts { webDeployer }
    steps {
      new linux.User { user = "alice"; uid = 1500 }
    }
  }
}
