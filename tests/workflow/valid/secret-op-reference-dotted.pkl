// A full `op://` reference names its parts with `/`, so a dot is an
// ordinary character of a label there: the reference is read as it is
// written, and the field labeled `API.Password` is the field it names.
// The structured `onePassword` selector keeps its stricter grammar, because
// it reaches `op item get --fields`, whose dot is the section separator.
//
// The secret functions are reached through an import of Core, not through
// `module.fnox(…)`: under pklr, calling a function through the workflow's
// own amended module chain from inside a step duplicates every play in the
// lowered configuration. Through an import both evaluators lower it once.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "Lightdash"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/lightdash/dotted.env"
    mode = "0600"
    content = "PASSWORD=\(core.onePasswordReference("op://Ops.Vault/Item.v2/API.Password"))\n"
  }
  new File {
    path = "/etc/lightdash/dotted-section.env"
    mode = "0600"
    content = "PASSWORD=\(core.onePasswordReference("op://Ops.Vault/Item.v2/API.Section/Password"))\n"
  }
} } }
