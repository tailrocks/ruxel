// A PostgreSQL role whose name the secret store holds, with a secret
// password: both the 1Password username and password reach the host
// resolved. The plan names the step without its reference, and the task that
// carries them is never logged.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "modulepath:/ruxel/Postgres.pkl" as postgres
import "../inventory.pkl"

local processorPassword = core.fnox("PROCESSOR_VERIFY_BITCOIN_PASSWORD")
local processorUsername = core.onePassword("ChainArgos", "ChainArgos bitcoin@postgresql-nova PostgreSQL", "username", new core.OnePasswordOptions {})

stages { new Stage { title = "Chain roles log in with stored credentials"; hosts = inventory.workers; steps {
  new postgres.Role {
    name = postgres.secretName(processorUsername)
    password = postgres.secretPassword(processorPassword)
    loginUser = "postgres"
    loginPort = 40000
  }
} } }

name = "valid/postgres-role-secret-name.pkl"
