amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The universal destination is the omitted one: `0.0.0.0/0` has the
// same effect as omitting the address option, so the two declarations
// are an exact repeat of one rule and lower to one task.
stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.IptablesRule { chain = "INPUT"; protocol = "tcp"; jump = "DROP" }
  new linux.IptablesRule { chain = "INPUT"; protocol = "tcp"; destination = "0.0.0.0/0"; jump = "DROP" }
} } }
