// A `creates` guard must gate the task before the controller resolves its
// environment: a skipped action reads no secret store, so a deleted store
// value cannot fail an action that never runs, and no store call is spent
// on a value the action would never read.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "Creates"; hosts { inventory.worker1 }; steps {
  new Command {
    title = "Initialize the app"
    run { "app-init"; "--marker" }
    creates = "/tmp/ruxel-creates-skip-fixture/marker"
    environment { ["APP_INIT_TOKEN"] = core.fnox("APP_INIT_TOKEN") }
  }
} } }
