// The erased supplementary membership comes back: the second stage
// removes the group `staff` while Alice keeps it, but the third stage
// recreates the group and restores her membership on every shared host,
// so the run ends with the membership the first stage declares. Alice
// keeps an explicit primary group throughout, so no automatic number
// stands in the way of the restored one.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage {
    title = "first"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "staff"; gid = 1501 }
      new linux.Group { name = "users"; gid = 1502 }
      new linux.User { user = "alice"; uid = 1500; group = "users"; groups = new Listing { "staff" } }
    }
  }
  new Stage {
    title = "second"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "staff"; state = "absent"; gid = 1501 }
    }
  }
  new Stage {
    title = "third"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "staff"; gid = 1501 }
      new linux.Group { name = "users"; gid = 1502 }
      new linux.User { user = "alice"; uid = 1500; group = "users"; groups = new Listing { "staff" } }
    }
  }
}

name = "valid/linux-group-removed-supplementary-restored.pkl"
