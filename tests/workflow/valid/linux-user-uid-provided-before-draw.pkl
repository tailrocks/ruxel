// No allocator draw where an earlier stage already provided the
// identity: Alice's number is 1500 from the first stage, so the second
// stage's unnumbered redeclaration leaves it unchanged at runtime —
// and the third stage may claim 1600, which no draw reserves anymore.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage { title = "numbered"; hosts = inventory.workers; steps {
    new linux.User { user = "alice"; uid = 1500 }
  } }
  new Stage { title = "unnumbered"; hosts = inventory.workers; steps {
    new linux.User { user = "alice" }
  } }
  new Stage { title = "claim"; hosts = inventory.workers; steps {
    new linux.User { user = "bob"; uid = 1600 }
  } }
}
