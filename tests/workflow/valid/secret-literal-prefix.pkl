// Literal text that looks like a reserved prefix is ordinary content: the
// words `ruxel_rt_8d41.` and `ruxel_secret_8d41.` are not placeholders on
// their own, and a secret placeholder followed by such text lowers to the
// lookup and the text. The secret comes first in the lines below: its
// terminator `__` is what the following word completes into a full
// reserved prefix in the lowered text, and that overlapping prefix is the
// word's own text, never a second placeholder or a malformed reference.
//
// The secret functions are reached through an import of Core, not through
// `module.fnox(…)`: under pklr, calling a function through the workflow's
// own amended module chain from inside a step duplicates every play in the
// lowered configuration. Through an import both evaluators lower it once.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.fnox("APP_SECRET"))ruxel_secret_8d41.ruxel_rt_8d41.\n"
      + "Q=\(core.fnox("APP_SECRET_TWO"))ruxel_secret_8d41.\n"
      + "R=\(core.fnox("APP_SECRET"))ruxel_rt_8d41.ruxel_secret_8d41.\n"
      + "S=ruxel_secret_8d41.ruxel_rt_8d41.\n"
  }
} } }
