amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// `iptables` and `ip6tables` are separate rule sets: the same rule for
// both versions is two rules, and a stage declares them side by side.
// The match a rule carries belongs to the family of its version, so the
// match both rules share is the one every address has.
name = "valid/iptables-parallel-versions.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.IptablesRule { chain = "INPUT"; protocol = "tcp"; jump = "DROP" }
  new linux.IptablesRule { chain = "INPUT"; protocol = "tcp"; jump = "DROP"; ipVersion = "ipv6" }
} } }
