// The full account form: the step manages one account — its shell, its
// home, its groups, its id — and lowers to the engine's user operation
// alone, with no pre-check that reads /etc/passwd.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage {
    title = "Users"
    hosts = inventory.workers
    steps {
      new linux.User {
        user = "ruxel-app"
        shell = "/bin/zsh"
        home = "/home/ruxel-app"
        group = "ruxel-app"
        groups = new Listing { "docker" }
        uid = 1500
        system = false
        state = "present"
        removeHome = false
      }
    }
  }
}
