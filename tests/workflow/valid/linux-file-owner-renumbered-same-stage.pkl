amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The ownership is reconciled in the renumbering stage itself: the
// first stage numbers Alice 1500 and writes the file, and the second
// stage renumbers her to 1600 and then redeclares the same file with
// the same owner — the file task resolves the name after `usermod -u`
// and writes the new number, so no stale-ownership diagnostic is due.
stages {
  new Stage {
    title = "s1"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1500 }
      new File { path = "/srv/app.conf"; content = "x\n"; owner = "alice" }
    }
  }
  new Stage {
    title = "s2"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1600 }
      new File { path = "/srv/app.conf"; content = "x\n"; owner = "alice" }
    }
  }
}

name = "valid/linux-file-owner-renumbered-same-stage.pkl"
