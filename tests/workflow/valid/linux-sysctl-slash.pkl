// Slash-first notation: when a kernel parameter's first separator is a
// slash, every later dot is a literal of its component and every later
// slash a separator — the spelling a parameter on a dotted interface
// name needs (`enp3s0.200`), which the dot-only spelling cannot carry.
// Both live readers keep those separators as written: the /proc/sys
// path is the name beneath /proc/sys, never the dots translated away.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage {
    title = "t"
    hosts = inventory.workers
    steps {
      new linux.Sysctl {
        name = "net/ipv4/conf/enp3s0.200/forwarding"
        value = "1"
        path = "/etc/sysctl.d/90-vlan.conf"
      }
    }
  }
}
