// A command that reads a secret through its environment: the value is a
// `SecretText`, never text, so it is redacted from output, the task carries
// the no-log flag, and a static value sits beside it unchanged. The joined
// kubeadm pair is the other secret an environment can take.
//
// The secret functions are reached through an import of Core; see
// secret-file.pkl for why `module.fnox(…)` cannot be spelled here.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

local bootstrapToken = core.fnox("KUBEADM_TOKEN_ID").join(".", core.fnox("KUBEADM_TOKEN_SECRET"))

stages { new Stage { title = "Kubernetes"; hosts = inventory.controlPlanes; steps {
  new Command {
    title = "Refresh the bootstrap token"
    run { "kubeadm"; "token"; "create"; "--ttl"; "24h" }
    environment {
      ["KUBECONFIG"] = "/etc/kubernetes/admin.conf"
      ["BOOTSTRAP_TOKEN"] = bootstrapToken
    }
  }
} } }
