// A managed shell link resolves through every hop created before the
// account: the link leads to another link, whose target file is
// executable and already there when the account's task reads through
// the whole chain.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage {
    title = "t"
    hosts = inventory.workers
    steps {
      new File { path = "/opt/real"; mode = "0755"; content = "#!/bin/sh\n" }
      new Symlink { path = "/opt/link"; target = "/opt/real" }
      new Symlink { path = "/usr/local/bin/mysh"; target = "/opt/link" }
      new linux.User { user = "app"; shell = "/usr/local/bin/mysh" }
    }
  }
}

name = "valid/linux-user-shell-symlink-chain-before-account.pkl"
