// The kubeadm token pair: two fnox keys — a six-character id and a
// sixteen-character secret — joined by `SecretText.join`, whose result stays
// a `SecretText` with the same sinks. Its shape is checked at apply time,
// after resolution, never at evaluation.
//
// The secret functions are reached through an import of Core; see
// secret-file.pkl for why `module.fnox(…)` cannot be spelled here.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

local token = core.fnox("KUBEADM_TOKEN_ID").join(".", core.fnox("KUBEADM_TOKEN_SECRET"))

stages { new Stage { title = "Kubeadm"; hosts = inventory.workers; steps {
  new File {
    title = "Write the bootstrap token for this node"
    path = "/etc/kubernetes/bootstrap-token"
    mode = "0400"
    content = "\(token)\n"
  }
} } }
