// The uid 1001 changes hands with proof: stage 2 removes the account
// that held it, so stage 3 may assign it to another account — the number
// is reused only after a proven intervening removal, which is exactly
// what lets a later stage's `useradd -u 1001` succeed on the host.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage {
    title = "s1"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1001 }
    }
  }
  new Stage {
    title = "s2"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1001; state = "absent" }
    }
  }
  new Stage {
    title = "s3"
    hosts = inventory.workers
    steps {
      new linux.User { user = "bob"; uid = 1001 }
    }
  }
}
