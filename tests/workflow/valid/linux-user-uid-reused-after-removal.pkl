// The uid 1001 changes hands with proof: stage 2 removes the account
// and takes its home with it (`removeHome`), so no file stays owned by
// the freed number — and stage 3 may assign it to another account. A
// removal frees a uid for reuse only this way: without the home the
// later `useradd -u 1001` would hand Bob Alice's files.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage {
    title = "s1"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1001 }
    }
  }
  new Stage {
    title = "s2"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1001; home = "/home/alice"; state = "absent"; removeHome = true }
    }
  }
  new Stage {
    title = "s3"
    hosts = inventory.workers
    steps {
      new linux.User { user = "bob"; uid = 1001 }
    }
  }
}

name = "valid/linux-user-uid-reused-after-removal.pkl"
