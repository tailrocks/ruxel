// A file whose content interpolates a secret and carries a validator: the
// candidate the validator reads is temporary — the stage and validate tasks
// sit in a block whose `always` removes the candidate, success or failure, so
// no resolved plaintext stays on the host (a file without secrets keeps the
// persistent candidate instead, so a second apply reports no change). Every
// task of the block is never logged.
//
// The secret functions are reached through an import of Core, not through
// `module.fnox(…)`: under pklr, calling a function through the workflow's own
// amended module chain from inside a step duplicates every play in the
// lowered configuration (the same defect mis-lowers `module.currentHost` in
// file content). Through an import both evaluators lower it once.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "TLS"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/tls.env"
    mode = "0600"
    content = "TLS_KEY=\(core.fnox("TLS_KEY"))\n"
    validate { "app"; "check"; "--config"; "%s" }
  }
} } }
