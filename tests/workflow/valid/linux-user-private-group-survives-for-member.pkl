// The private group survives the account's removal where another live
// account keeps it: Bob stays a supplementary member of Alice's group,
// so `userdel` leaves the group behind — and the later file can still
// resolve it.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage { title = "accounts"; hosts = inventory.workers; steps {
    new linux.User { user = "alice"; uid = 1500 }
    new linux.User { user = "bob"; uid = 1501; groups = new Listing { "alice" } }
  } }
  new Stage { title = "remove"; hosts = inventory.workers; steps {
    new linux.User { user = "alice"; uid = 1500; state = "absent" }
  } }
  new Stage { title = "file"; hosts = inventory.workers; steps {
    new File { path = "/srv/app-team.txt"; content = "keep\n"; group = "alice" }
  } }
}
