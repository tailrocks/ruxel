// The legacy file stands outside the directory shadowing: `sysctl
// --system` loads `/etc/sysctl.conf` after every directory file and
// never skips it, so the legacy file and the same-named directory file
// both load — even where the two stages persist them apart — and no key
// reverts after reboot.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage { title = "legacy"; hosts = inventory.workers; steps {
    new linux.Sysctl { name = "net.ipv4.ip_forward"; value = "1"; path = "/etc/sysctl.conf" }
  } }
  new Stage { title = "directory"; hosts = inventory.workers; steps {
    new linux.Sysctl { name = "net.ipv4.conf.all.forwarding"; value = "0"; path = "/etc/sysctl.d/sysctl.conf" }
  } }
}
