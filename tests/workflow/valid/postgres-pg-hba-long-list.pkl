// A long column of short names stays admitted: PostgreSQL truncates
// identifiers, not columns, so each comma-separated member is checked
// alone. The aggregate database list below is 72 characters; its longest
// member is 15.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "modulepath:/ruxel/Systemd.pkl" as systemd
import "modulepath:/ruxel/Postgres.pkl" as postgres
import "../inventory.pkl"

local pgHba = postgres.renderPgHba(new Listing {
  new postgres.PgHbaRule { type = "host"; database = "redshift,bitcoin,ethereum,tron,base,bsc,wallet-screening,looker,metabase"; user = "chainargos"; address = "0.0.0.0/0"; method = "scram-sha-256" }
}, "/etc/postgresql/19/main/pg_hba.conf")

stages { new Stage { title = "PostgreSQL reads its configuration without a restart"; hosts = inventory.workers; steps {
  pgHba
  new systemd.Service { name = "postgresql@19-main"; enabled = true; running = true; reloadOnChangeOf { pgHba } }
} } }

name = "valid/postgres-pg-hba-long-list.pkl"
