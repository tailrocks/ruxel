// FetchSecret of a kubeconfig-shaped file: the content is read on the one
// named host at apply and stored into fnox under the key, as a no-log slurp
// written with `fnox set` on stdin. In `plan`, `check` and `diff` it
// contacts neither fnox nor the host and reports known-after-apply.
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new FetchSecret {
    title = "Store the cluster admin kubeconfig"
    fromPath = "/etc/kubernetes/admin.conf"
    runOn = inventory.cp1
    fnoxKey = "K8S_ADMIN_KUBECONFIG"
  }
} } }
