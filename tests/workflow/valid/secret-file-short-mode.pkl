// A three-digit mode spells the same file mode as its four-digit form:
// "600" is 0600, narrow enough for content that holds a secret (no
// permission for group or other, no execute for the owner).
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "Lightdash"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/lightdash/short.env"
    mode = "600"
    content = "LIGHTDASH_SECRET=\(core.fnox("LIGHTDASH_SECRET"))\n"
  }
} } }
