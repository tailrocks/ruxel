// A generated key consumed by a file: `apply` creates PROCESSOR_DB_PASSWORD
// in fnox, once per run, under the fnox write lock (check presence, generate
// in the named format, store with the value on stdin, read back, compare),
// before any secret is resolved. `plan`, `check` and `diff` never generate:
// they resolve the lookup synthetically, to a selector-derived placeholder.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new core.File {
    path = "/etc/processor/processor.env"
    mode = "0600"
    content = "PROCESSOR_DB_PASSWORD=\(core.fnoxGenerated("PROCESSOR_DB_PASSWORD", "hex32"))\n"
  }
} } }
