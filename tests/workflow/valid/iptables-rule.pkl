amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// An iptables rule: the chain and the match are the rule's identity, so a
// second rule for the same chain and match with another jump is a
// conflict, and `state = "absent"` removes the rule instead of adding it.
stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.IptablesRule { chain = "INPUT"; protocol = "tcp"; destination = "10.0.0.0/8"; jump = "DROP" }
  new linux.IptablesRule { chain = "OUTPUT"; outInterface = "eth0"; ipVersion = "ipv6" }
} } }
