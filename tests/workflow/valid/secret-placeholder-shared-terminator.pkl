// The valid side of the incomplete shared candidate: the secret's
// terminator below opens the reserved words `ruxel_secret_8d41.` and
// `ruxel_rt_8d41.` — the reserved words without an encoded body, never a
// candidate of their own. The words carry no terminator of their own, so
// the secret lowers to the lookup and the words stay the literal text they
// are, exactly as the longer `secret-literal-prefix.pkl` spells it.
//
// The secret functions are reached through an import of Core, not through
// `module.fnox(…)`: under pklr, calling a function through the workflow's
// own amended module chain from inside a step duplicates every play in the
// lowered configuration. Through an import both evaluators lower it once.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.fnox("APP_SECRET"))ruxel_secret_8d41.ruxel_rt_8d41.\n"
  }
} } }
