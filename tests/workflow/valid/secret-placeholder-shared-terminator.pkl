// The valid side of the shared terminator: what the secret's terminator
// opens is reserved WORDS and nothing more — never a candidate name. The
// secret below shares its terminator with `ruxel_secret_8d41.` and
// `ruxel_rt_8d41.` (the reserved words without an encoded body, which are
// not placeholders on their own), with `ruxel_secret_8d41.` beside the
// next placeholder's delimiters, and with bare reserved words at the very
// end of each content — `ruxel_secret_8d41.` and `ruxel_rt_8d41.` with no
// candidate name after the dot and no terminator of their own. The
// classification is local: a bare word is the word's own text whatever
// follows elsewhere, only a candidate name makes a candidate. Each secret
// lowers to the lookup and the words stay the literal text they are, as
// `secret-literal-prefix.pkl` spells it at length.
//
// The secret functions are reached through an import of Core, not through
// `module.fnox(…)`: under pklr, calling a function through the workflow's
// own amended module chain from inside a step duplicates every play in the
// lowered configuration. Through an import both evaluators lower it once.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.fnox("APP_SECRET"))ruxel_secret_8d41.ruxel_rt_8d41.\n"
      + "Q=\(core.fnox("APP_SECRET_TWO"))ruxel_secret_8d41.\n"
      + "R=\(core.fnox("APP_SECRET"))ruxel_secret_8d41."
  }
  new File {
    path = "/etc/app/app-two.env"
    mode = "0600"
    content = "S=\(core.fnox("APP_SECRET"))ruxel_rt_8d41."
  }
} } }
