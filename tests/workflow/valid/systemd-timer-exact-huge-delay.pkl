// A timer whose boot delay is a whole number of milliseconds at a
// magnitude the Float conversions of the lowering cannot carry: the
// count of an integer delay is taken in integer arithmetic, so every
// digit the author wrote survives — a value above 2^53 in its own unit,
// a converted count above 2^53 milliseconds, and an exactly integral
// value the old half-up rounding moved to a neighbor and then refused.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Systemd.pkl" as systemd
import "../inventory.pkl"

stages {
  new Stage {
    title = "Timers fire long after the boot, exactly"
    hosts = inventory.workers
    steps {
      new systemd.SystemdTimer { title = "The exact huge second"; name = "postgresql-exact-huge-second"; onBoot = 9007199254740994.s }
      new systemd.SystemdTimer { title = "The exact converted millisecond"; name = "postgresql-exact-converted"; onBoot = 4503599627370497.s }
      new systemd.SystemdTimer { title = "The exact millisecond"; name = "postgresql-exact-millisecond"; onBoot = 4503599627370497.ms }
      new systemd.SystemdTimer { title = "The exact half-even millisecond"; name = "postgresql-exact-half-even"; onBoot = 4503599627370497.0.ms }
    }
  }
}
