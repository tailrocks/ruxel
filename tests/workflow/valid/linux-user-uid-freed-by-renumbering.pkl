// The uid 1500 changes hands with proof: stage 2 renumbers the account
// that held it — `usermod -u 1600` releases 1500 — so stage 3 may
// assign it to another account, exactly as a proven removal would. The
// number is freed per machine, so the renumbering must reach every
// host both claims share.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage {
    title = "s1"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1500 }
    }
  }
  new Stage {
    title = "s2"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1600 }
    }
  }
  new Stage {
    title = "s3"
    hosts = inventory.workers
    steps {
      new linux.User { user = "bob"; uid = 1500 }
    }
  }
}
