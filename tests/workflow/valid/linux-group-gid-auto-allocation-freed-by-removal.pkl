// The private group of an account is created with it (`useradd -U`) and
// draws a number of its own — the first free number of the range on a
// clean default host. `userdel` takes that empty same-name group with
// the account, so the removal frees the number the group held and a
// later stage may claim it explicitly: the draw reserves its range
// only until a proven removal empties it.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage {
    title = "draw"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1500 }
    }
  }
  new Stage {
    title = "remove"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1500; state = "absent" }
    }
  }
  new Stage {
    title = "claim"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "staff"; gid = 1000 }
    }
  }
}
