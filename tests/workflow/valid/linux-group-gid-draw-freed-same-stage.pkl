amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The automatic allocation is released inside the later stage itself:
// Alice's group draws its gid in the first stage, and the second stage
// removes her group before claiming 1000 for Bob's — the steps of a
// stage run where the author wrote them, so the `absent` listed before
// the claim frees whatever the allocator drew, the way an intervening
// stage's removal would.
stages {
  new Stage {
    title = "draw"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "alice" }
    }
  }
  new Stage {
    title = "claim"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "alice"; state = "absent" }
      new linux.Group { name = "bob"; gid = 1000 }
    }
  }
}
