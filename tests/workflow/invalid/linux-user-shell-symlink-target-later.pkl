// expect: names the shell /opt/esh, whose target /opt/esh-real
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// A managed shell that is a link is only as good as its target: the
// account's task follows the link and reads the target's metadata, so a
// target that a later step creates leaves the link dangling when the
// account runs — the task refuses the shell before the target is there.
stages {
  new Stage {
    title = "t"
    hosts = inventory.workers
    steps {
      new Symlink { path = "/opt/esh"; target = "/opt/esh-real" }
      new linux.User { user = "app"; shell = "/opt/esh" }
      new File { path = "/opt/esh-real"; content = "#!/bin/sh\n"; mode = "0755" }
    }
  }
}
