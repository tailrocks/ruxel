// expect: protocol icmpv6 is the ICMP of IPv6
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// `icmpv6` is the ICMP of IPv6; the ICMP of IPv4 is `icmp`.
name = "invalid/iptables-icmpv6-version.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.IptablesRule { chain = "INPUT"; protocol = "icmpv6"; ipVersion = "ipv4"; jump = "DROP" }
} } }
