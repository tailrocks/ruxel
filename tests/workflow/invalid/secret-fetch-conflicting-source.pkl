// Identity is the `fnoxKey`: two FetchSecret steps with one key and a
// different `fromPath` conflict like two states of one thing — last writer
// wins would store whichever host finished last. An exact repeat would be
// the same step; a different source for one key is a conflict.
// expect: both manage the fnox key K8S_ADMIN_KUBECONFIG
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new FetchSecret { fromPath = "/etc/kubernetes/admin.conf"; runOn = inventory.cp1; fnoxKey = "K8S_ADMIN_KUBECONFIG" }
  new FetchSecret { fromPath = "/var/lib/kubeconfig/admin.conf"; runOn = inventory.cp2; fnoxKey = "K8S_ADMIN_KUBECONFIG" }
} } }
