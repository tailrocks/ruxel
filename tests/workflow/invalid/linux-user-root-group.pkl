// expect: group = wheel is rejected for root
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The superuser keeps its primary group, the root group: a primary-group
// change on the root account would move the superuser's identity away
// from GID 0 and strand every file it owns.
stages { new Stage { title = "t"; hosts = inventory.workers; steps { new linux.User { user = "root"; group = "wheel" } } } }
