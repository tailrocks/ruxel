// expect: which is a system root
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

// `/bin` is the system's own link into the merged tree: a removal never
// takes it.
name = "invalid/absent-floor-system-alias.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new Absent { path = "/bin" }
} } }
