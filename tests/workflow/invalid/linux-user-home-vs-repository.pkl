// expect: one path cannot be both a directory and a file
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

local key = "-----BEGIN PGP PUBLIC KEY BLOCK-----\nsynthetic\n-----END PGP PUBLIC KEY BLOCK-----\n"

// A managed home is a directory, whatever step leaves the regular file
// at its path: the earlier stage's apt repository writes
// /etc/apt/sources.list.d/docker.sources, and the later account claims
// that exact path as its home. The type clash covers every
// path-bearing step that leaves a non-directory, not just files and
// links.
stages {
  new Stage { title = "repository"; hosts = inventory.workers; steps {
    new debian.AptRepository { name = "docker"; url = "https://apt.example.test/"; suite = "stable"; components { "main" }; signingKey = key }
  } }
  new Stage { title = "account"; hosts = inventory.workers; steps {
    new linux.User { user = "alice"; home = "/etc/apt/sources.list.d/docker.sources" }
  } }
}

name = "invalid/linux-user-home-vs-repository.pkl"
