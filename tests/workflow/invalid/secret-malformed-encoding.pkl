// A malformed secret encoding must not pass through as literal file content.
// The payload contains `_`, which the encoding reserves, so the placeholder
// does not segment into a valid secret atom and Lowering refuses it.
// expect: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

local malformed = new core.SecretText { parts = "f3:A_B" }

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app/app.env"; mode = "0600"; content = "P=\(malformed)\n" }
} } }
