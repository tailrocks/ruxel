// expect-pkl: Type constraint `this != "/"` violated
// expect-pklr: expected FilePath?
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// `/` is the root directory, not an account's home: the home of an
// account is a file path, any absolute path but `/` itself.
stages { new Stage { title = "t"; hosts = inventory.workers; steps { new linux.User { user = "app"; home = "/" } } } }
