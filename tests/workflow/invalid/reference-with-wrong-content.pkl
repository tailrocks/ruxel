// expect: which is not an earlier step of this stage with exactly these settings
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Systemd.pkl" as systemd
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app.conf"; content = "real" }
  new systemd.Service { name = "app"; restartOnChangeOf { new File { path = "/etc/app.conf"; content = "invented" } } }
} } }
