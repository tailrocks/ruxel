// The reference decoder reads a length prefix of at most eighteen digits:
// a prefix of nineteen digits names more text than any body can hold and
// more than a length can be, so the reference is refused as malformed
// rather than decoded into a lookup with a forged length.
// expect: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_secret_8d41.f9999999999999999999:AB__\n"
  }
} } }
