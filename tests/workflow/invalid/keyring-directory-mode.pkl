// expect: both manage /etc/apt/keyrings: apt repositories create it (0755), so remove the Directory
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new Directory { path = "/etc/apt/keyrings"; mode = "0700" }
  new debian.AptRepository { name = "example"; url = "https://apt.example.test/"; suite = "stable"; components { "main" }; signingKey = "-----BEGIN PGP PUBLIC KEY BLOCK-----\nsynthetic\n-----END PGP PUBLIC KEY BLOCK-----\n" }
} } }
