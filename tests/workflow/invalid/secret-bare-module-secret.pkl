// expect-pklr: unknown method 'secret'
// expect-pkl: Cannot find method `secret` in module `Workflow`.
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app/app.env"; mode = "0600"; content = "S=\(module.secret("APP_SECRET"))\n" }
} } }
