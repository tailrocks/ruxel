// A schema holds no database, which the agent would fail only during
// apply: without one the schema names no namespace at all.
// expect: the schema's database is empty; name the database that holds the schema
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Postgres.pkl" as postgres
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new postgres.Schema {
    name = "wallet_tags"
    loginDb = ""
    owner = "chainargos"
    loginUser = "postgres"
    loginPort = 40000
  }
} } }

name = "invalid/postgres-schema-empty-login-db.pkl"
