// A database grant names no objects: it grants on the database itself,
// which loginDb already names.
// expect: a database grant names no objects; it grants on the database itself
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Postgres.pkl" as postgres
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new postgres.Privilege {
    loginDb = "redshift"
    type = "database"
    privs = "CONNECT"
    objs { "production" }
    role = "looker"
    loginUser = "postgres"
    loginPort = 40000
  }
} } }

name = "invalid/postgres-privilege-database-objs.pkl"
