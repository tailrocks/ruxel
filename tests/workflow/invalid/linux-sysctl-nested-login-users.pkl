// expect: is a file, so /etc/sysctl.d/99-x.conf/child cannot be inside it
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// One machine keeps one filesystem whatever login user opened the SSH
// connection: both stages reach 192.0.2.50:22 — the first as root, the
// second as deployer — so the sysctl's persistence file leaves no room
// for the later stage's managed path inside it, and the apply fails
// when the parent turns out to be the sysctl's file. The nested check
// keys the machine by endpoint and port, not by the SSH login user.
local webRoot = new Host { name = "web-root"; address = "192.0.2.50" }
local webDeployer = new Host { name = "web-deployer"; address = "192.0.2.50"; user = "deployer" }

stages {
  new Stage { title = "lower"; hosts { webRoot }; steps {
    new linux.Sysctl { name = "net.ipv4.ip_forward"; value = "1"; path = "/etc/sysctl.d/99-x.conf" }
  } }
  new Stage { title = "higher"; hosts { webDeployer }; steps {
    new File { path = "/etc/sysctl.d/99-x.conf/child"; content = "x\n" }
  } }
}

name = "invalid/linux-sysctl-nested-login-users.pkl"
