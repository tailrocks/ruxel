// expect: is a file, so /etc/sysctl.d/90-ruxel.conf/child cannot be inside it
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// A sysctl persists its entry in a regular file, and a regular file
// holds nothing inside it: a later overlapping-host stage that manages
// a path inside the persistence file cannot create it — its parent is
// the file the sysctl wrote. The same-stage leaf/descendant rule
// applies across stages.
stages {
  new Stage {
    title = "first"
    hosts = inventory.workers
    steps {
      new linux.Sysctl { name = "net.ipv4.ip_forward"; value = "1"; path = "/etc/sysctl.d/90-ruxel.conf" }
    }
  }
  new Stage {
    title = "second"
    hosts = inventory.workers
    steps {
      new File { path = "/etc/sysctl.d/90-ruxel.conf/child"; content = "x\n" }
    }
  }
}

name = "invalid/linux-sysctl-nested-path-later-stage.pkl"
