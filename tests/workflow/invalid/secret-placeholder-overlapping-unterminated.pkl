// A valid placeholder may share its terminator with an unterminated
// secret candidate: the candidate below has an encoded body (`f2:CD`) and
// no closing `__` of its own. The first secret matches and lowers, and
// without the guard the overlap-aware prefix count would call the trailing
// prefix covered by that match — the absence of a complete standalone
// candidate being taken for the word's own text — and
// `ruxel_secret_8d41.f2:CD` would be left behind as literal content,
// although the same unterminated candidate alone fails the reserved-prefix
// count and is refused. Lowering refuses the text instead: absence from
// the standalone-candidate search is never evidence that a prefix belongs
// to the preceding match, only the reserved words beside a placeholder's
// delimiters are, and the incomplete candidate's prefix counts as never
// covered — a malformed secret reference, refused under both evaluators.
// expect: File content contains a malformed secret reference
// expect-pkl: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_secret_8d41.f2:AB__ruxel_secret_8d41.f2:CD\n"
  }
} } }
