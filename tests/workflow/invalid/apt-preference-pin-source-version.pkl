// expect-pklr: property 'pin' expected PreferencePin, got String
// expect-pkl: Type constraint `matches(Regex(#"((?i:version|origin)\s+\S+|(?i:release)\s+(([anvcol]=[^,=\s]([^,=]*[^,=\s])?)(,[anvcol]=[^,=\s]([^,=]*[^,=\s])?)*|([1-9][0-9]*:)?[0-9][A-Za-z0-9.+~-]*))"#))` violated.
// `source-version` is no pin type apt implements: apt-cache 2.8.3 prints
// `W: Did not understand pin type source-version` and ignores the policy,
// while the copy task reports success; the form is refused here instead
// of silently doing nothing.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new debian.AptPreference { title = "Pin nginx"; package = "nginx"; pin = "source-version 1.25.0"; priority = 500 }
} } }
