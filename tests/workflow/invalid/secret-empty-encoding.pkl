// An empty secret payload is not a valid encoding. Lowering must refuse it
// instead of treating the reserved prefix as literal file content.
// expect: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

local malformed = new core.SecretText { parts = "" }

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app/app.env"; mode = "0600"; content = "P=\(malformed)\n" }
} } }
