// A 1Password selector is static text. A secret reference interpolated into
// the vault name would make the selector carry a reserved secret prefix, so
// the store function refuses it before any lookup can be built.
// expect-pklr: 1Password vault
// expect-pkl: isOpLabel(this)
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.onePassword(core.fnox("ABC").toString(), "Item", "field", new core.OnePasswordOptions {}))\n"
  }
} } }
