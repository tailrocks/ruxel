// expect: 'Pin nginx' (step 1) writes an apt preference, and 'Install nginx' (step 2) plans against the candidate policy; in check and diff mode the preference is never written before the plan runs, so check and apply disagree — put the two in different stages
// A plain install may need the candidate of every package it does not
// find installed: the agent resolves the missing ones against the
// candidate policy. The preference stanza is written with the generic
// copy task, which in check and diff mode writes nothing, so a later
// package step of the same stage plans against the policy the host still
// has, while apply mode plans against the stanza just written — and for
// a package the stanza leaves without a candidate, apply then fails where
// check reported a pending install.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new debian.AptPreference { title = "Pin nginx"; package = "nginx"; pin = "release n=stable"; priority = 500 }
  new debian.AptPackages { title = "Install nginx"; names { "nginx" } }
} } }
