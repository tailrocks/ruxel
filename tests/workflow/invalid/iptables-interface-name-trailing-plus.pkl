// expect-pklr: expected InterfaceName
// expect-pkl: Type constraint
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// A trailing `+` is a wildcard, not a device: `iptables -o` reads it as
// every interface with the prefix, so a rule that matches on it can match
// far more traffic than the name says and must be refused here.
name = "invalid/iptables-interface-name-trailing-plus.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.IptablesRule { chain = "OUTPUT"; outInterface = "vpn+"; jump = "DROP" }
} } }
