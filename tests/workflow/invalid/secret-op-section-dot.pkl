// A section and its field together form the CLI's `--fields` selector, so a
// dot inside the section name is read as another section separator: the
// fetch would name a different selector than the author named. Authoring
// refuses a dot in a section, like a comma or an equals sign.
// expect: 1Password section "A.B" may not contain a dot: `op item get --fields` reads a dot as the section separator
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.onePassword("Vault", "Item", "Password", new core.OnePasswordOptions { section = "A.B" }))\n"
  }
} } }
