// expect: takes its gid automatically
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The historical membership still blocks the draw where nothing takes
// it off: Bob stays in Alice's private group, so the account removal
// leaves the group behind — and the later explicit claim of a number
// the private-group draw can take is refused.
stages {
  new Stage { title = "groups"; hosts = inventory.workers; steps {
    new linux.Group { name = "staff"; gid = 2500 }
  } }
  new Stage { title = "join"; hosts = inventory.workers; steps {
    new linux.User { user = "alice"; uid = 1500 }
    new linux.User { user = "bob"; uid = 1501; group = "staff"; groups = new Listing { "alice" } }
  } }
  new Stage { title = "remove"; hosts = inventory.workers; steps {
    new linux.User { user = "alice"; uid = 1500; state = "absent" }
  } }
  new Stage { title = "claim"; hosts = inventory.workers; steps {
    new linux.Group { name = "team"; gid = 1000 }
  } }
}

name = "invalid/linux-group-gid-held-blocks-free.pkl"
