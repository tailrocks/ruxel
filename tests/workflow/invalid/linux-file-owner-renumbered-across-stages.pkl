// expect: renumbers the owner alice to uid 1002
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// `usermod -u` renumbers the account but does not repair the files it
// owns, so the file the earlier stage wrote keeps the old number and no
// longer has the owner it declares.
stages {
  new Stage {
    title = "s1"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1001 }
      new File { path = "/srv/app.conf"; content = "x\n"; owner = "alice" }
    }
  }
  new Stage {
    title = "s2"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1002 }
    }
  }
}
