// expect-pkl: !contains("\n") && !contains("\r")
// expect-pklr: expected SysctlValue
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage {
    title = "Kernel"
    hosts = inventory.workers
    steps {
      new linux.Sysctl { name = "net.ipv4.ip_forward"; value = "1\n2" }
    }
  }
}
