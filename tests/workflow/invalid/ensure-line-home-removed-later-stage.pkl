// expect: removes with the account's home directory
// A line entry under a home an earlier stage removes never lands: the
// directory is gone by the time the entry reads it, so the later stage
// declares the home again first.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage { title = "Remove"; hosts = inventory.workers; steps {
    new linux.User { title = "Remove holla"; user = "holla"; state = "absent"; uid = 1500; home = "/home/holla"; removeHome = true }
  } }
  new Stage { title = "Configure"; hosts = inventory.workers; steps {
    new EnsureLine { title = "Set the holla config line"; path = "/home/holla/.config"; line = "key = value" }
  } }
}

name = "invalid/ensure-line-home-removed-later-stage.pkl"
