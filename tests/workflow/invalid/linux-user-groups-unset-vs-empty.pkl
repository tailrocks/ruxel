// expect: both manage the account app with different settings
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// An explicit empty supplementary-group list and an unmanaged one are two
// states of one account, not one: `groups = new Listing {}` reconciles the memberships
// to none, a step without `groups` leaves them alone.
stages {
  new Stage {
    title = "t"
    hosts = inventory.workers
    steps {
      new linux.User { user = "app" }
      new linux.User { user = "app"; groups = new Listing {} }
    }
  }
}
