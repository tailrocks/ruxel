// expect: groupdel succeeds but erases the account's membership in it
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// Recreating the group alone does not bring the membership back: the
// third stage declares `staff` present again but leaves Alice's listing
// empty, so her erased membership stays erased and the removal is still
// refused. Only a stage that restores the membership too lifts it.
stages {
  new Stage {
    title = "first"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "staff"; gid = 1501 }
      new linux.Group { name = "users"; gid = 1502 }
      new linux.User { user = "alice"; uid = 1500; group = "users"; groups = new Listing { "staff" } }
    }
  }
  new Stage {
    title = "second"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "staff"; state = "absent"; gid = 1501 }
    }
  }
  new Stage {
    title = "third"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "staff"; gid = 1501 }
      new linux.Group { name = "users"; gid = 1502 }
      new linux.User { user = "alice"; uid = 1500; group = "users"; groups = new Listing {} }
    }
  }
}

name = "invalid/linux-group-removed-supplementary-unrestored.pkl"
