// expect-pkl: Type constraint `this != "/"` violated
// expect-pklr: expected FilePath?
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// `/` is a directory, not a login shell: the shell of an account is a
// file path, any absolute path but `/` itself.
stages { new Stage { title = "t"; hosts = inventory.workers; steps { new linux.User { user = "app"; shell = "/" } } } }
