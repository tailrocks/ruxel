// expect: onCalendar must be a nonempty calendar expression on one line
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Systemd.pkl" as systemd
import "../inventory.pkl"

stages {
  new Stage {
    title = "A timer that names no time"
    hosts = inventory.workers
    steps {
      new systemd.SystemdTimer { title = "The nameless timer"; name = "postgresql-nameless"; onCalendar = "" }
    }
  }
}
