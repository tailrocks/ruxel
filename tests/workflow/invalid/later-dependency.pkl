// expect: is not an earlier step of this stage
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

local config = new File { path = "/etc/app.conf"; content = "x" }
stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new Service { name = "app"; restartOnChangeOf { config } }
  config
} } }
