// The terminator of a run-time placeholder may not be the opening of another
// reserved prefix: the run-time placeholder below ends on the secret
// candidate's opening `__`, so the run-time match would consume that opening
// and the overlap-aware prefix count would treat the secret prefix as covered
// by the match — and the secret candidate, body and terminator and all,
// would be left behind as literal content: a malformed secret reference
// laundered into the lowered text as `Ref("inventoryHost")` plus the literal
// words. Lowering refuses the text instead: the run-time terminator carries
// the same lookahead the secret's already carries — a terminator that opens
// a reserved candidate is not a terminator at all — and a prefix the
// terminator opened counts as never covered, so the malformed reference is
// parsed and refused, never left behind as literal content.
// expect: File content contains a malformed secret reference
// expect-pkl: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_rt_8d41.inventoryHost__ruxel_secret_8d41.bad body__\n"
  }
} } }
