// A forged SecretText: its hidden `parts` carry a join separator holding
// \u{1e}, which the encoding writes for a literal \u{1f}. Lowering re-validates
// the separator it decodes, so the forged encoding is refused rather than
// silently rewritten.
// expect: join separator contains \u{1f} or \u{1e}, which the secret reference encoding reserves
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

local forged = new core.SecretText { parts = "f2:ABs3:a\u{1e}bf2:EF" }

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app/app.env"; mode = "0600"; content = "P=\(forged)\n" }
} } }
