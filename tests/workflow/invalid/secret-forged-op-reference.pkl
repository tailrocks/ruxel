// A forged SecretText: its hidden `parts` encode a reference the store
// functions refuse (a trailing `/` names an empty part). Lowering re-validates
// everything it decodes with the same sentences, so forging the encoding
// bypasses nothing.
// expect: is not an op:// reference: op://<vault>/<item>/<field>
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

local forged = new core.SecretText { parts = "r25:op://Vault/Item/password/" }

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app/app.env"; mode = "0600"; content = "P=\(forged)\n" }
} } }
