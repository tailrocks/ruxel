// expect: remove the account app with different system flags
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// An absent declaration merges with an exact repeat, so two removals of
// one account that differ only in the system flag share one identity
// and the merge keeps the first: a system-false-first ordering would
// hide the system removal from the system-account refusal, while the
// reverse order refuses. The mismatch is refused at the merge instead.
stages {
  new Stage {
    title = "t"
    hosts = inventory.workers
    steps {
      new linux.User { user = "app"; uid = 1500; state = "absent" }
      new linux.User { user = "app"; uid = 1500; state = "absent"; system = true }
    }
  }
}

name = "invalid/linux-user-absent-system-flag-mismatch.pkl"
