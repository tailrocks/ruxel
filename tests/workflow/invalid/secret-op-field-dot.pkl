// A field labeled `API.Password` is a legal `OpLabel`, but the 1Password CLI
// reads a dot in `op item get --fields` as the section separator: the fetch
// would name section `API`, field `Password` — a different selector than the
// author named. Authoring refuses a dot in a field.
// expect: 1Password field "API.Password" may not contain a dot: `op item get --fields` reads a dot as the section separator
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.onePassword("Vault", "Item", "API.Password", new core.OnePasswordOptions {}))\n"
  }
} } }
