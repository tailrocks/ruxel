// expect: both manage gid 1500 with different settings
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// An explicit gid is a managed thing of its own, the way a uid is: two
// groups with one id fail the second groupadd on the duplicate.
stages {
  new Stage {
    title = "t"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "wheel"; gid = 1500 }
      new linux.Group { name = "docker"; gid = 1500 }
    }
  }
}
