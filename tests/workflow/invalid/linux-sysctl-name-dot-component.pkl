// expect-pkl: Type constraint
// expect-pklr: expected SysctlName
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The slash-first form's components are path segments beneath
// /proc/sys: a `.` or `..` component would escape it
// (`net/../../../etc/hostname` reads /etc/hostname), so the notation
// admits no dot components.
stages {
  new Stage {
    title = "t"
    hosts = inventory.workers
    steps {
      new linux.Sysctl { name = "net/../../../etc/hostname"; value = "ruxel" }
    }
  }
}
