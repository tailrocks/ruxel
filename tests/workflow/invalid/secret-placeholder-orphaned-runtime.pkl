// The terminator of a secret placeholder may not be the opening of another
// reserved prefix: the secret below ends on the run-time placeholder's
// opening `__`, so it would swallow the run-time value that follows.
// Lowering refuses the text instead — the secret placeholder never
// matches, so its reserved prefix fails the count and the file is rejected
// as a malformed secret reference.
// expect: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_secret_8d41.f2:AB__ruxel_rt_8d41.inventoryHost__\n"
  }
} } }
