// expect: 'Set the holla port': the match is empty; an empty match names every line of /etc/holla/holla.conf, so name the match or drop it and match the line itself
// A line entry names its match: an empty match names every line of the
// file, so the entry names a match or drops it and matches the line itself.
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new EnsureLine { title = "Set the holla port"; path = "/etc/holla/holla.conf"; line = "port = 8080"; regexp = "" }
} } }

name = "invalid/ensure-line-empty-regexp.pkl"
