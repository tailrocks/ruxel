// expect-pklr: fnoxGenerated format "garbage" is not one of hex16, hex32, base64-32 or alnum32
// expect-pkl: Expected value of type `"hex16"|"hex32"|"base64-32"|"alnum32"`
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app/app.env"; mode = "0600"; content = "P=\(core.fnoxGenerated("PROCESSOR_DB_PASSWORD", "garbage"))\n" }
} } }
