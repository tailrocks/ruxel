// A grant with no privileges grants nothing.
// expect: no privileges granted; name at least one database privilege
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Postgres.pkl" as postgres
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new postgres.Privilege {
    loginDb = "redshift"
    type = "database"
    privs = " , "
    role = "looker"
    loginUser = "postgres"
    loginPort = 40000
  }
} } }

name = "invalid/postgres-privilege-blank-privs.pkl"
