// expect: needs the group docker, which 'Remove group docker' (step 2) removes
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The contradiction holds regardless of ordering: the removal after the
// account is the order that deletes a group the final account state
// requires.
stages {
  new Stage {
    title = "t"
    hosts = inventory.workers
    steps {
      new linux.User { user = "app"; groups = new Listing { "docker" } }
      new linux.Group { name = "docker"; state = "absent" }
    }
  }
}
