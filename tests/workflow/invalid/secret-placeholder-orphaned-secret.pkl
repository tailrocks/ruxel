// The terminator of a secret placeholder may not be the opening of another
// secret placeholder: the first secret below ends on the second one's
// opening `__`, and the second one's length-prefixed body carries the `:`
// the encoding writes, so a lookahead that only knows run-time bodies does
// not recognize it. The first match would then succeed, the overlap-aware
// prefix count would treat the second prefix as belonging to that match,
// and the second lookup would be emitted as literal text instead. Lowering
// refuses the text instead, like the analogous orphaned run-time
// placeholder: the first secret never matches, so its reserved prefix
// fails the count and the file is rejected as a malformed secret
// reference.
// expect: File content contains a malformed secret reference
// expect-pkl: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_secret_8d41.f2:AB__ruxel_secret_8d41.f2:CD__\n"
  }
} } }
