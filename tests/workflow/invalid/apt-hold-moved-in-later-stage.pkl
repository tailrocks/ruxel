// expect: 'Hold bash' (step 1) of stage "a" holds bash=2, and 'Move bash' (step 1) of stage "b" would move it; a held package is never upgraded, and the hold outlives its stage, so put the two stages on different hosts
// A hold freezes the package on the host, and the mark outlives the
// stage that set it: a later stage on the same host that moves the held
// package would ask apt to move a frozen package, which apt refuses.
// Stages order the steps; they do not reset the holds of the host.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages {
  new Stage { title = "a"; hosts = inventory.workers; steps {
    new debian.AptPackages { title = "Hold bash"; names { "bash=1" }; hold = true }
  } }
  new Stage { title = "b"; hosts = inventory.workers; steps {
    new debian.AptPackages { title = "Move bash"; names { "bash=2" } }
  } }
}
