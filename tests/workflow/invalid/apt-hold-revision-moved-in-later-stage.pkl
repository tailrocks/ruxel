// expect: 'Hold bash' (step 1) of stage "a" holds bash=1.0-1, and 'Move bash' (step 1) of stage "b" would move it; a held package is never upgraded, and the hold outlives its stage, so put the two stages on different hosts
// The absent-revision equality does not reach a real revision: `1.0` and
// `1.0-1` are two versions, so a later stage that pins the other one
// moves the held package and is refused, as any version movement is.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages {
  new Stage { title = "a"; hosts = inventory.workers; steps {
    new debian.AptPackages { title = "Hold bash"; names { "bash=1.0" }; hold = true }
  } }
  new Stage { title = "b"; hosts = inventory.workers; steps {
    new debian.AptPackages { title = "Move bash"; names { "bash=1.0-1" } }
  } }
}
