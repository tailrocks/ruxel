// expect-pkl: this != "/"
// expect-pklr: expected FilePath
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The agent reads the sysctl file and rewrites it atomically, so the
// path is a file path, never `/`, which is a directory.
stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.Sysctl { name = "net.ipv4.ip_forward"; value = "1"; path = "/" }
} } }
