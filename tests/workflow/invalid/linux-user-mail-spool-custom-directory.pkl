// expect: both manage the mail spool of app (/srv/mail/app)
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// `useradd` writes the mail spool in the host's mail directory, the
// MAIL_DIR setting of /etc/default/useradd, wherever the host points
// it: a step that manages a path carrying the account's name in a
// custom directory declares a second state for the spool the account
// creation writes, the way the conventional directories conflict
// through the creation footprint.
stages {
  new Stage {
    title = "t"
    hosts = inventory.workers
    steps {
      new Directory { path = "/srv/mail/app"; mode = "0755" }
      new linux.User { user = "app"; uid = 1500 }
    }
  }
}

name = "invalid/linux-user-mail-spool-custom-directory.pkl"
