// expect-pklr: expected ChainName
// expect-pkl: Type constraint
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The chain parser of the firewall refuses a name that begins with `-`
// or `!`: such a name is an option, not a chain.
name = "invalid/iptables-chain-option-name.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.IptablesRule { chain = "-L"; jump = "DROP" }
} } }
