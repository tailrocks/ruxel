// Certificate authentication checks the client's TLS certificate, so a
// rule without encryption takes no cert method.
// expect: pg_hba method "cert" checks the client's TLS certificate
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Postgres.pkl" as postgres
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  postgres.renderPgHba(new Listing {
    new postgres.PgHbaRule { type = "host"; database = "all"; user = "all"; address = "0.0.0.0/0"; method = "cert" }
  }, "/etc/postgresql/18/main/pg_hba.conf")
} } }

name = "invalid/postgres-pg-hba-host-cert.pkl"
