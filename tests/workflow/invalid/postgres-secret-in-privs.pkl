// Grants name static privileges alone: a secret smuggled into the listing
// never reaches the host. pklr does not check listing elements, so the
// lowering refuses it; official Pkl refuses the assignment itself.
// expect-pklr: property 'privs' expected Privileges, got List
// expect-pkl: Expected value of type `Static|StaticList`, but got a different `Listing`.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "modulepath:/ruxel/Postgres.pkl" as postgres
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new postgres.Privilege {
    loginDb = "redshift"
    type = "database"
    privs = new Listing { "CONNECT"; "\(core.fnox("SOME_PRIV"))" }
    role = "looker"
    loginUser = "postgres"
    loginPort = 40000
  }
} } }

name = "invalid/postgres-secret-in-privs.pkl"
