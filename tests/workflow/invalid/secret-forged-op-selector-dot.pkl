// A forged SecretText: its hidden `parts` encode a 1Password selector whose
// field carries a dot. Lowering re-validates everything it decodes with the
// same sentences the store functions use, so the forged encoding is refused
// where Core's `onePassword` refuses the authored field: the 1Password CLI
// reads a dot in `op item get --fields` as the section separator.
// expect: 1Password field "API.Password" may not contain a dot
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

local forged = new core.SecretText { parts = "o5:Vault4:Item0:12:API.Password" }

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app/app.env"; mode = "0600"; content = "P=\(forged)\n" }
} } }
