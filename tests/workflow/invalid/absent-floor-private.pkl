// expect: which is a system root
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

// `/private` holds the real `/etc` and `/var` of the platform the agent
// also runs on: a removal never takes a system root.
name = "invalid/absent-floor-private.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new Absent { path = "/private"; recursive = true }
} } }
