// expect: state = "absent" is rejected for root and for an account below UID 1000
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps { new linux.User { user = "root"; state = "absent" } } } }
