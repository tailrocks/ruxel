// expect-pkl: BranchName
// expect-pklr: expected BranchName
// A branch name has no leading-dot component: git check-ref-format
// refuses one, so the agent could never resolve it and the name is
// refused first.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.GitBranch { title = "Follow the hidden branch"; repository = "git@git.example.test:holla/holla.git"; path = "/opt/holla"; branch = ".hidden" }
} } }

name = "invalid/git-branch-dot.pkl"
