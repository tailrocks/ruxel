// expect: 'Follow the qualified ref': branch "refs/heads/main" is a fully qualified ref; after fetching, the agent probes refs/remotes/origin/refs/heads/main and falls back to the stale clone-time commit, so the checkout never converges — name the branch itself
// A branch checkout names a branch: a fully qualified ref would resolve
// to the stale clone-time commit after the fetch, so the author names
// the branch itself.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.GitBranch { title = "Follow the qualified ref"; repository = "git@git.example.test:holla/holla.git"; path = "/opt/holla"; branch = "refs/heads/main" }
} } }

name = "invalid/git-branch-qualified-ref.pkl"
