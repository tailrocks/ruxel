// expect-pklr: expected InterfaceName
// expect-pkl: Type constraint
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The kernel refuses an interface name that holds a `:`: no Linux device
// is ever named `eth0:1` (the alias spelling of another age), so a rule
// that matches on it can never match and must be refused here.
name = "invalid/iptables-interface-name-colon.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.IptablesRule { chain = "OUTPUT"; outInterface = "eth0:1"; jump = "DROP" }
} } }
