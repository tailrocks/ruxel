// A FetchSecret's key must match the fnox key shape: the store refuses to
// read it, and the step's identity is the key, so a malformed one must fail
// evaluation, never reach apply. pklr hides the violated constraint (G16) and
// names the type instead; official Pkl names the constraint. Both refuse.
// expect-pklr: expected FnoxKey
// expect-pkl: Type constraint `matches(Regex("[A-Z][A-Z0-9_]{1,127}"))`
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new FetchSecret {
    fromPath = "/etc/kubernetes/admin.conf"
    runOn = inventory.cp1
    fnoxKey = "k8s-admin-kubeconfig"
  }
} } }
