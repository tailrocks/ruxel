// A capture is the check-only context: it runs in `check` and `diff`, where
// the design forbids resolving — and forbids generating — secrets. A
// generated key requested for a capture would force exactly that, so a
// secret can never sit in a capture's script: `Static` refuses the reserved
// secret-reference prefix, and the capture never lowers.
// expect-pklr: expected Static, got String
// expect-pkl: Type constraint `!contains("__ruxel_rt_8d41.")
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new Capture { bash = "register-node \(core.fnoxGenerated("NODE_SECRET", "hex32"))" }
} } }
