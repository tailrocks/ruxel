// The run-time analogue of the incomplete shared candidate: the run-time
// placeholder's terminator opens the secret candidate `f2:CD`, which has
// no closing `__` of its own. The run-time match would lower normally and
// the unterminated candidate would leak behind it as literal content,
// although alone the candidate fails the reserved-prefix count and is
// refused. Lowering refuses the text instead: a prefix that starts a
// candidate which is not a complete standalone candidate is never covered
// by the match whose terminator opened it — the reserved words beside a
// placeholder's delimiters are the only literal text there.
// expect: File content contains a malformed secret reference
// expect-pkl: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_rt_8d41.inventoryHost__ruxel_secret_8d41.f2:CD\n"
  }
} } }
