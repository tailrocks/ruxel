// expect-pkl: Expected value of type `OneLine|SecretAnswer`, but got a different `String`.
// expect-pklr: property 'value' expected OneLine|SecretAnswer, got String
// A debconf answer is static text or a secret answer, never text that
// carries the secret inside it: interpolating a secret into the answer
// would write the secret into a file apt reads and a log records.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new debian.DebconfEntry {
    package = "postfix"
    question = "postfix/relay_pw"
    type = "password"
    value = "pw-\(core.fnox("POSTFIX_RELAY_PW"))"
  }
} } }
