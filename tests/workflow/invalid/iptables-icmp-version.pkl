// expect: protocol icmp is the ICMP of IPv4
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// `icmp` is the ICMP of IPv4; the ICMP of IPv6 is `icmpv6`.
stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.IptablesRule { chain = "INPUT"; protocol = "icmp"; ipVersion = "ipv6"; jump = "DROP" }
} } }
