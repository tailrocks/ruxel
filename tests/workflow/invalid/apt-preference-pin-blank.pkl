// expect-pklr: property 'pin' expected PreferencePin, got String
// expect-pkl: Type constraint `matches(Regex(#"(?i)(version|source-version|release|origin)\s+.*\S.*"#))` violated.
// The `Pin:` line must carry a pin: apt warns `Did not understand pin
// type` and applies no preference for a blank pin, so a blank one is
// refused here instead of silently doing nothing.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new debian.AptPreference { title = "Pin nginx"; package = "nginx"; pin = "  "; priority = 500 }
} } }
