// expect: both manage the ipv6 iptables rule INPUT tcp with different settings
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The IPv6 spelling of the same rule: `::/0` is the omitted destination
// of the IPv6 rule set, so the two declarations are one rule of one
// chain and match, and two jumps for it are a conflict.
name = "invalid/iptables-universal-destination-ipv6-conflict.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.IptablesRule { chain = "INPUT"; protocol = "tcp"; jump = "DROP"; ipVersion = "ipv6" }
  new linux.IptablesRule { chain = "INPUT"; protocol = "tcp"; destination = "::/0"; jump = "ACCEPT"; ipVersion = "ipv6" }
} } }
