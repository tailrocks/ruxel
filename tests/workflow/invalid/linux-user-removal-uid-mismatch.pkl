// expect: state the effective uid
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The removal names another id than the workflow's last word for the
// account: Alice's effective uid is 1001, and removing her with 1002
// fails where the runtime verifies the declared id against the live
// entry — even though no later stage reuses either number.
stages {
  new Stage { title = "account"; hosts = inventory.workers; steps {
    new linux.User { user = "alice"; uid = 1001 }
  } }
  new Stage { title = "remove"; hosts = inventory.workers; steps {
    new linux.User { user = "alice"; uid = 1002; state = "absent" }
  } }
}
