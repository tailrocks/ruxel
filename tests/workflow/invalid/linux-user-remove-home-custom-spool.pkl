// expect: removes with the account's mail spool
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// A host that configures MAIL_DIR=/srv/mail turns the earlier stage's
// managed file into the removed account's spool: `userdel -r` deletes
// `<MAIL_DIR>/app` whatever directory the host points at, so the path
// does not survive the later recursive removal.
stages {
  new Stage { title = "spool"; hosts = inventory.workers; steps {
    new File { path = "/srv/mail/app"; content = "spooled\n" }
  } }
  new Stage { title = "remove"; hosts = inventory.workers; steps {
    new linux.User { user = "app"; uid = 1500; home = "/home/app"; state = "absent"; removeHome = true }
  } }
}
