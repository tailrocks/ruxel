// The terminator of a secret placeholder may not open a second placeholder
// whose body is malformed: the second secret below ends on the first one's
// terminator `__`, and its body is an attempt without its colon whose text
// bears a line break — outside the run of one-line characters the guard
// recognized, which let the newline-bearing reference through as ordinary
// content. The same candidate alone is parsed and refused; overlapped, it
// was left behind as literal text: the first match succeeded, the overlap-
// aware prefix count treated the second prefix as belonging to that match,
// and the newline-bearing reference became literal content. Lowering
// refuses the text instead: the overlap guard recognizes any terminated
// placeholder candidate and leaves body validation to the parser, so the
// second secret matches on its own and is refused as malformed, and the
// orphaned first prefix fails the count.
// expect: File content contains a malformed secret reference
// expect-pkl: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_secret_8d41.f2:AB__ruxel_secret_8d41.bad\nbody__\n"
  }
} } }
