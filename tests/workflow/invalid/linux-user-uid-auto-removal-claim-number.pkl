// expect: takes its uid automatically
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// An account that states no uid lets the host's allocator draw one —
// `useradd alice` takes the first free number at UID_MIN (1000 on a
// clean default host). A later removal that declares the number the
// last account claims proves nothing about the number the draw took:
// the allocator may have handed the account another one, and the
// runtime verifies the declared uid against the live entry and refuses
// the removal when the two differ, so the drawn number is never freed
// and the later explicit claim of it collides.
stages {
  new Stage {
    title = "draw"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice" }
    }
  }
  new Stage {
    title = "remove"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1500; state = "absent" }
    }
  }
  new Stage {
    title = "claim"
    hosts = inventory.workers
    steps {
      new linux.User { user = "bob"; uid = 1500 }
    }
  }
}
