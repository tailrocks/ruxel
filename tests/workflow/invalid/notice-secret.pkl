// expect: 'Leak the token': the message carries a secret; a notice prints on the controller, so read a capture's output instead
// A notice prints on the controller: a secret in the message would be
// printed and logged in the clear, so a notice reads a capture's output,
// never the secret store.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new Notice { title = "Leak the token"; message = "token \(core.fnox("HOLLA_TOKEN"))" }
} } }

name = "invalid/notice-secret.pkl"
