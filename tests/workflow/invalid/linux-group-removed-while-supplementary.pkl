// expect: groupdel succeeds but erases the account's membership in it
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// An earlier stage leaves the account in the supplementary group
// `staff` and a later stage removes the group: unlike the primary
// group, which `groupdel` refuses, a supplementary membership is no
// obstacle to the removal — the command succeeds and erases the
// membership, so the account's declared state does not hold at the end
// of the run.
stages {
  new Stage {
    title = "first"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "staff"; gid = 1501 }
      new linux.User { user = "alice"; uid = 1500; groups = new Listing { "staff" } }
    }
  }
  new Stage {
    title = "second"
    hosts = inventory.workers
    steps {
      new linux.Group { name = "staff"; state = "absent"; gid = 1501 }
    }
  }
}
