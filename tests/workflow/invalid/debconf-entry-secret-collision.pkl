// expect: 'Set the token' (step 1) and 'Set the token with the secret' (step 2) both manage the debconf answer of postfix/token with different settings; a stage declares one state for each thing, so put the second state in a later stage
// A static answer that spells the encoded reference of a secret ("f3:KEY"
// is `core.fnox("KEY")`'s parts) and that secret's own answer used to
// share one identity, so the secret task was silently discarded. Each
// variant of an answer is tagged and length-encoded in the identity, so
// the two are two steps — and two answers for one question conflict, as
// any second answer does. The entries are `string`, not `password`: a
// password takes a secret answer alone
// (`invalid/debconf-entry-password-static.pkl`).
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new debian.DebconfEntry { title = "Set the token"; package = "postfix"; question = "postfix/token"; type = "string"; value = "f3:KEY" }
  new debian.DebconfEntry { title = "Set the token with the secret"; package = "postfix"; question = "postfix/token"; type = "string"; value = debian.secretAnswer(core.fnox("KEY")) }
} } }
