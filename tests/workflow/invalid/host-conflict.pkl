// expect: is declared twice with different settings
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages {
  new Stage { title = "a"; hosts { new Host { name = "web"; address = "192.0.2.50" } }; steps { new linux.Timezone { name = "UTC" } } }
  new Stage { title = "b"; hosts { new Host { name = "web"; address = "192.0.2.51" } }; steps { new linux.Timezone { name = "UTC" } } }
}
