// expect: 'The idle check': repeat 0.s is zero; a timer fires after its last firing, not at it
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Systemd.pkl" as systemd
import "../inventory.pkl"

stages {
  new Stage {
    title = "A timer repeats at once"
    hosts = inventory.workers
    steps {
      new systemd.SystemdTimer { title = "The idle check"; name = "postgresql-idle-check"; service = "postgresql-idle-check"; onCalendar = "daily"; repeat = 0.s }
    }
  }
}

name = "invalid/timer-repeat-zero.pkl"
