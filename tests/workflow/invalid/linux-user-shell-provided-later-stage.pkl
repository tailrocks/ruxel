// expect: names the shell /opt/esh, which 'Write /opt/esh' (step 1) of stage "second" manages
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The apply runs the stages where the author wrote them: useradd verifies
// the shell path when the account's task runs, so a stage that declares
// the account before the stage that creates its shell fails in
// `shell_allowed` before the provider can run. The stage-local ordering
// check sees one stage at a time and admits this workflow; the provider
// must live in a stage before the account, never after it.
stages {
  new Stage {
    title = "first"
    hosts = inventory.workers
    steps {
      new linux.User { user = "app"; shell = "/opt/esh" }
    }
  }
  new Stage {
    title = "second"
    hosts = inventory.workers
    steps {
      new File { path = "/opt/esh"; content = "#!/bin/sh\n"; mode = "0755" }
    }
  }
}

name = "invalid/linux-user-shell-provided-later-stage.pkl"
