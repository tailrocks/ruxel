// expect-pkl: !contains("@.service")
// expect-pklr: expected ServiceName
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Systemd.pkl" as systemd
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps { new systemd.Service { name = "getty@.service"; running = true; enabled = true } } } }
