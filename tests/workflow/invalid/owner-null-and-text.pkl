// expect: both manage /etc/app.conf with different settings
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app.conf"; content = "a" }
  new File { path = "/etc/app.conf"; content = "a"; owner = "null" }
} } }