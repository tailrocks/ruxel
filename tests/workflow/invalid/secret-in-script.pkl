// expect-pklr: expected Static
// expect-pkl: !contains("__ruxel_secret_8d41.")
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new Script {
    title = "Rotate the database password"
    bash = "psql -c \"ALTER ROLE app PASSWORD '\(core.fnox("APP_DB_PASSWORD"))'\""
  }
} } }
