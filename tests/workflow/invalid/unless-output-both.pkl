// expect: UnlessOutput takes exactly one of stdoutContains and stderrContains
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new Command { run { "true" }; changes = new UnlessOutput { stdoutContains = "a"; stderrContains = "b" } }
} } }
