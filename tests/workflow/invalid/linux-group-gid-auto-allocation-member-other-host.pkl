// expect: takes its gid automatically
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux

// The private group of an account is created with it (`useradd -U`) and
// draws a number of its own. `userdel` takes that group with the
// account only where it is empty: on host a the account `bob` keeps a
// membership in it, and the removal of `bob` runs on host b alone, so
// on host a the group survives the removal of `alice` and its number
// stays taken. The proof of the removal must be per host.
local a = new Host { name = "a"; address = "127.0.0.1" }
local b = new Host { name = "b"; address = "127.0.0.2" }

stages {
  new Stage { title = "setup"; hosts { a; b }; steps {
    new linux.User { user = "alice"; uid = 1500 }
  } }
  new Stage { title = "member"; hosts { a }; steps {
    new linux.User { user = "bob"; uid = 1501; group = "alice" }
  } }
  new Stage { title = "leave"; hosts { b }; steps {
    new linux.User { user = "bob"; uid = 1501; state = "absent" }
  } }
  new Stage { title = "remove"; hosts { a }; steps {
    new linux.User { user = "alice"; uid = 1500; state = "absent" }
  } }
  new Stage { title = "claim"; hosts { a }; steps {
    new linux.Group { name = "staff"; gid = 1000 }
  } }
}

name = "invalid/linux-group-gid-auto-allocation-member-other-host.pkl"
