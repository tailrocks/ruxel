// expect: onBoot 9007199254740992.ns must be a whole number of milliseconds; a systemd timer reads the delay in seconds or milliseconds
// A whole-nanosecond delay whose count of milliseconds is fractional.
// Both evaluators round the literal `9007199254740993.ns` at parse — a
// `Duration` is a number in its unit held in a float — a loss this
// schema refuses to act on: a millisecond count at or beyond 2^53 is
// refused outright rather than emitted from rounded digits, and this
// one, below that bound, is refused for the fraction of a millisecond it
// still carries. The expect line names the value the evaluators hold.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Systemd.pkl" as systemd
import "../inventory.pkl"

stages {
  new Stage {
    title = "A timer fires a fraction of a millisecond, spelled in whole nanoseconds"
    hosts = inventory.workers
    steps {
      new systemd.SystemdTimer { title = "The integer check"; name = "postgresql-integer-check"; onBoot = 9007199254740993.ns }
    }
  }
}
