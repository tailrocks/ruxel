// expect: both manage the account root with different settings
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps { new linux.User { user = "root"; shell = "/bin/zsh" }; new linux.User { user = "root"; shell = "/bin/bash" } } } }
