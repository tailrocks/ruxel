// expect: gid = 1234 is rejected for root
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// The root group keeps gid 0: moving it to another id would change the
// superuser's primary group identity and strand every file owned by the
// numeric GID 0.
stages { new Stage { title = "t"; hosts = inventory.workers; steps { new linux.Group { name = "root"; gid = 1234 } } } }
