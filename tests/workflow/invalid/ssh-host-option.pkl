// expect-pkl: !startsWith("-")
// expect-pklr: expected SshHost
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts { new Host { name = "web"; address = "192.0.2.1"; sshHost = "-oProxyCommand=x" } }; steps { new linux.Timezone { name = "UTC" } } } }
