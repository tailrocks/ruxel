// expect-pkl: !contains("__ruxel_rt_8d41.")
// expect-pklr: expected
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new Command { run { "true" }; changes = new UnlessOutput { stdoutContains = "host \(module.currentHost.name)" } }
} } }
