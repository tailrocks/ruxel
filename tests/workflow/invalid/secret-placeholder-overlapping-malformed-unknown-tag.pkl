// The overlap guard must recognize every terminated secret candidate and leave body validation to SecretParser: the second candidate's tag is unknown, and its terminator is the first secret's, so without the guard the unknown-tag reference is left behind as literal content. The guard refuses the first terminator instead, and the file is rejected as a malformed secret reference.
// expect: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_secret_8d41.f2:AB__ruxel_secret_8d41.x1:Z__\n"
  }
} } }
