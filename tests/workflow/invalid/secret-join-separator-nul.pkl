// The text between two joined secrets is static text and cannot hold NUL.
// pklr does not enforce the `Static` parameter constraint, so the store
// function checks it in its body as well.
// expect-pklr: join separator contains NUL
// expect-pkl: !contains("\u{0}")
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.fnox("AB").join("\u{0}", core.fnox("EF")))\n"
  }
} } }
