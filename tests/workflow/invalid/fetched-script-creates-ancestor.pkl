// expect: 'Fetch and run the holla installer': the marker is at or above the destination; the download runs before the probe and leaves the marker present, so the probe skips the run on every apply and the fetched script never runs
// A fetched script's marker guards its run: a marker at or above the
// destination is already present once the download lands, so the probe
// skips the run on every apply and the fetched script never runs.
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new FetchedScript { title = "Fetch and run the holla installer"; url = "https://get.example.test/holla/install.sh"; dest = "/opt/holla/install.sh"; creates = "/opt/holla"; onChangeOf {} }
} } }

name = "invalid/fetched-script-creates-ancestor.pkl"
