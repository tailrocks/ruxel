// The same overlap with a WELL-FORMED secret body: the secret candidate
// would decode, so without the guard the run-time match would swallow the
// secret's opening `__`, the overlap-aware prefix count would call the
// secret prefix covered, and the lowering would emit the run-time reference
// beside a real lookup — the run-time placeholder's own text left behind as
// literal content. Lowering refuses the text instead: the run-time
// terminator may not open a reserved candidate, and the orphaned run-time
// prefix counts as never covered by the secret's match, so the text is
// rejected as a malformed secret reference rather than lowered into a mix
// of literal words and lookups.
// expect: File content contains a malformed secret reference
// expect-pkl: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_rt_8d41.inventoryHost__ruxel_secret_8d41.f2:AB__\n"
  }
} } }
