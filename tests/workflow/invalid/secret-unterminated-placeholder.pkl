// An unterminated secret placeholder may not swallow a later placeholder.
// The reserved prefix appears here as literal text without its own `__`
// terminator, and the run-time value after it supplies one: a capture that
// ends the secret on the run-time placeholder's opening `__` parses the
// payload happily and leaves the run-time value behind as literal content.
// Lowering refuses the text instead — the secret placeholder never matches,
// so its reserved prefix fails the count and the file is rejected as a
// malformed secret reference.
// expect: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_secret_8d41.f2:AB\(core.currentHost.name)Q\n"
  }
} } }
