// The word exemption is only for a genuinely bodyless reserved word: the
// trailing candidate below starts with the reserved word
// `ruxel_secret_8d41.` and then carries a BODY (`f2:CD`), so it is not the
// words without an encoded body — it is an unterminated candidate whose
// prefix alone fails the reserved-prefix count and is refused. Without
// the guard the first secret matches, the exemption for a leading
// reserved word swallows the whole trailing shape, and
// `ruxel_secret_8d41.ruxel_secret_8d41.f2:CD` is left behind as literal
// content beside the lookup. Lowering refuses the text instead: the
// exemption applies only where the reserved word stays bodyless, and a
// body-carrying candidate name counts as never covered — a malformed
// secret reference under both evaluators.
// expect: File content contains a malformed secret reference
// expect-pkl: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_secret_8d41.f2:AB__ruxel_secret_8d41.ruxel_secret_8d41.f2:CD\n"
  }
} } }
