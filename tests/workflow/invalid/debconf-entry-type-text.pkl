// expect-pkl: Expected value of type `"string"|"boolean"|"select"|"multiselect"|"password"|"note"`, but got `"text"`.
// expect-pklr: property 'type' expected "string"|"boolean"|"select"|"multiselect"|"password"|"note", got String
// The type of a debconf answer is a closed union and `text` is not in it:
// a `text` entry is a note the template shows, not an answer the database
// holds, so `debconf-get-selections` could never converge it.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new debian.DebconfEntry { package = "postfix"; question = "postfix/x"; type = "text"; value = "x" }
} } }
