// expect: takes its uid automatically
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// A removal between the provider and the recreation re-arms the
// allocator: the first stage numbers Alice 1500, the second removes
// her, and the third recreates her without a uid — `useradd` draws a
// fresh number then, which may be 1500 again — so the fourth stage's
// `useradd -u 1500` for Bob can claim the number the new draw took and
// fails on the taken number. Only a provider still present at the
// draw's stage suppresses the draw; an earlier one a removal took away
// does not.
stages {
  new Stage {
    title = "numbered"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1500 }
    }
  }
  new Stage {
    title = "remove"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice"; uid = 1500; state = "absent" }
    }
  }
  new Stage {
    title = "recreate"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice" }
    }
  }
  new Stage {
    title = "claim"
    hosts = inventory.workers
    steps {
      new linux.User { user = "bob"; uid = 1500 }
    }
  }
}

name = "invalid/linux-user-uid-draw-recreated-after-removal.pkl"
