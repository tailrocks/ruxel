// The field part of an `op://` reference reaches the same selector grammar
// as a direct 1Password field. The 1Password CLI reads a dot in `op item get
// --fields` as the section separator, so a dotted field would fetch a
// different selector than the author named.
// expect-pklr: 1Password field "API.Password" may not contain a dot
// expect-pkl: isOpReference(this)
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.onePasswordReference("op://Vault/Item/API.Password"))\n"
  }
} } }
