// The secret reference encoding reserves \u{1f} (it spells an escaped `_`),
// so a separator holding one cannot round-trip: it is refused.
// expect: join separator contains \u{1f} or \u{1e}, which the secret reference encoding reserves
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.fnox("AB").join("a\u{1f}b", core.fnox("EF")))\n"
  }
} } }
