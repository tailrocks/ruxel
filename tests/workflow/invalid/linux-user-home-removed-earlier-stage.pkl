// expect: which stage "s1" removes with the account's home directory
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// `userdel -r` deletes the home directory of the account it removes: a
// later stage that manages a path inside it writes into a directory that
// is gone, so the file task cannot open its parent.
stages {
  new Stage {
    title = "s1"
    hosts = inventory.workers
    steps {
      new linux.User { user = "app"; uid = 1500; home = "/home/app"; state = "absent"; removeHome = true }
    }
  }
  new Stage {
    title = "s2"
    hosts = inventory.workers
    steps {
      new File { path = "/home/app/.config"; content = "x\n" }
    }
  }
}
