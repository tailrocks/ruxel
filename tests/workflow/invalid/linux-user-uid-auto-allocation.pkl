// expect: takes its uid automatically
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// An account created without uid lets the host's allocator draw one —
// `useradd alice` takes the first free number at UID_MIN (1000 on a
// clean default host) — so a later stage's `useradd -u 1000` for bob
// can claim exactly the number the draw took and fails on the taken
// number. The automatic allocation reserves its range before a later
// explicit claim is accepted, until a proven removal of the drawing
// account frees it.
stages {
  new Stage {
    title = "draw"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice" }
    }
  }
  new Stage {
    title = "claim"
    hosts = inventory.workers
    steps {
      new linux.User { user = "bob"; uid = 1000 }
    }
  }
}
