// The terminator of a secret placeholder may not open a second placeholder
// whose body is malformed: the second secret below ends on the first one's
// terminator `__`, and its body is an attempt without its colon whose text
// bears punctuation — outside the encoding's tag, size and text characters
// the guard recognized, which let the punctuation-bearing reference through
// as ordinary content. The first match would then succeed, the overlap-aware
// prefix count would treat the second prefix as belonging to that match,
// and the punctuation-bearing reference would be left behind as literal
// text instead. Lowering refuses the text instead: the overlap guard
// recognizes any terminated placeholder candidate and leaves body
// validation to the parser, so the second secret matches on its own and is
// refused as malformed, and the orphaned first prefix fails the count.
// expect: File content contains a malformed secret reference
// expect-pkl: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=__ruxel_secret_8d41.f2:AB__ruxel_secret_8d41.f3A!B__\n"
  }
} } }
