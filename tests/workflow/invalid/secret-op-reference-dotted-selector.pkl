// A reference accepts a dot in a label, but not the CLI's own selector
// syntax: a comma and an equals sign are how `op item get --fields` reads
// a field list and a selector, so a label that carries one would fetch
// unintended fields. The reference is refused, as the structured selector
// is.
// expect-pklr: 1Password field "API.Password,key" may not contain a comma or an equals sign
// expect-pkl: isOpReference(this)
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.onePasswordReference("op://Vault/Item/API.Password,key"))\n"
  }
} } }
