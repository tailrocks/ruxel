// expect: both manage the file /etc/sysctl.d/90-ruxel.conf
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// A sysctl step manages the entries of the file at its path, so a File at
// that path would declare a second state for the same file: whichever ran
// later would clobber the other.
stages {
  new Stage {
    title = "t"
    hosts = inventory.workers
    steps {
      new File { path = "/etc/sysctl.d/90-ruxel.conf"; content = "net.ipv4.ip_forward = 1\n" }
      new linux.Sysctl { name = "net.ipv4.ip_forward"; value = "1" }
    }
  }
}
