// expect: takes its uid automatically
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

// A host configured with `UID_MIN=500` hands 500 to the first account
// that draws its uid, so a later stage's `useradd -u 500` for bob can
// claim exactly the number the draw took and fails on the taken
// number. The range the host's allocator draws from is the host's own
// configuration (`UID_MIN`..`UID_MAX` in `login.defs`, the `SYS_`
// counterparts for a system account), which the schema cannot read, so
// the automatic allocation reserves every number an id supports — not
// only the default distribution's 1000..60000.
stages {
  new Stage {
    title = "draw"
    hosts = inventory.workers
    steps {
      new linux.User { user = "alice" }
    }
  }
  new Stage {
    title = "claim"
    hosts = inventory.workers
    steps {
      new linux.User { user = "bob"; uid = 500 }
    }
  }
}
