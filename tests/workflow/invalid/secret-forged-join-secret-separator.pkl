// A forged SecretText whose join separator carries the reserved secret
// prefix. Lowering re-validates every decoded atom, so this separator is
// refused instead of becoming literal secret-prefix text in the file.
// expect: join separator "__ruxel_secret_8d41." carries a secret or run-time value
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

local unit = 31.toChar().toString()
local prefix = "__ruxel_secret_8d41.".replaceAll("_", unit)
local forged = new core.SecretText { parts = "f2:ABs20:\(prefix)f2:CD" }

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app/app.env"; mode = "0600"; content = "P=\(forged)\n" }
} } }
