// The field part of an `op://` reference reaches the same selector grammar
// as a direct 1Password field. A comma or equals sign would make the 1Password
// CLI fetch unintended fields, so authoring refuses it.
// expect-pklr: 1Password field "API,key" may not contain a comma or an equals sign
// expect-pkl: isOpReference(this)
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.onePasswordReference("op://Vault/Item/API,key"))\n"
  }
} } }
