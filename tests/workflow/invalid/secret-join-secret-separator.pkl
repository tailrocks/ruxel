// The middle argument of join is static text; interpolating a secret there
// would lower the reference placeholder as literal file content.
// expect-pklr: carries a secret or run-time value
// expect-pkl: Type constraint `!contains("__ruxel_rt_8d41.")
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File {
    path = "/etc/app/app.env"
    mode = "0600"
    content = "P=\(core.fnox("AB").join("\(core.fnox("CD"))", core.fnox("EF")))\n"
  }
} } }
