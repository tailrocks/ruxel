// expect: has running = false, so it cannot reload on a change
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Systemd.pkl" as systemd
import "../inventory.pkl"

local config = new File { path = "/etc/app.conf"; content = "x" }
stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  config
  new systemd.Service { name = "app"; running = false; reloadOnChangeOf { config } }
} } }
