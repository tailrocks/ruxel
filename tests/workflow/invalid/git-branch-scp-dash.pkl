// expect-pkl: isSshGitUrl(this)
// expect-pklr: expected SshGitUrl
// An SCP-style URL starts with its user: a leading dash reads as a flag
// to the Git agent, which refuses every repository beginning with one,
// so the checkout refuses it first.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Linux.pkl" as linux
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new linux.GitBranch { title = "Follow the holla release branch"; repository = "-git@git.example.test:holla/holla.git"; path = "/opt/holla"; branch = "main" }
} } }

name = "invalid/git-branch-scp-dash.pkl"
