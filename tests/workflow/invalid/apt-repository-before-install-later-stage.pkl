// expect: 'Add the repo' (step 1) of stage "a" writes an apt repository, and 'Install nginx' (step 1) of stage "b" plans against the candidate policy; in check and diff mode the repository is never written before the plan runs, so check and apply disagree — put the two stages on different hosts
// The same refusal across the stages of one host: the `.sources` file
// outlives its stage, so the later play's package plan still runs
// against the candidates the host had.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages {
  new Stage { title = "a"; hosts = inventory.workers; steps {
    new debian.AptRepository { title = "Add the repo"; name = "x"; url = "https://example.test"; suite = "stable"; components { "main" }; signingKey = "-----BEGIN PGP PUBLIC KEY BLOCK-----" }
  } }
  new Stage { title = "b"; hosts = inventory.workers; steps {
    new debian.AptPackages { title = "Install nginx"; names { "nginx" }; latest = true }
  } }
}
