// A forged SecretText: its hidden `parts` end in a join separator. `join`
// writes a separator only between two lookups, so no authored encoding ends
// in one — a trailing separator lowers to a lookup plus arbitrary static
// text after it. Lowering enforces the authoring grammar at decode, so the
// forged encoding is refused as malformed rather than lowered.
// expect: File content contains a malformed secret reference
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Core.pkl" as core
import "../inventory.pkl"

local forged = new core.SecretText { parts = "f2:ABs7: suffix" }

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new File { path = "/etc/app/app.env"; mode = "0600"; content = "P=\(forged)\n" }
} } }
