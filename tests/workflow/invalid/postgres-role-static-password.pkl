// A literal password would be committed to the workflow and printed in the
// clear, so the password takes a secret alone.
// expect-pklr: property 'password' expected SecretPassword, got String
// expect-pkl: Expected value of type `Postgres#SecretPassword`, but got type `String`.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Postgres.pkl" as postgres
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new postgres.Role {
    name = "chainargos"
    password = "hunter2"
    loginUser = "postgres"
    loginPort = 40000
  }
} } }

name = "invalid/postgres-role-static-password.pkl"
