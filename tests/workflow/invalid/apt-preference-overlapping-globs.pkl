// expect: 'Pin the ba glob' (step 1) and 'Pin the bash glob' (step 2) pin overlapping package selectors (ba* and bash*); apt applies every matching stanza and the highest priority decides, so keep one selector or put the second in a later stage
// Two trailing globs overlap when one's prefix covers the other's: bash
// matches both, so the two stanzas would pin one package twice and
// silently disagree on its priority. One selector per package per stage.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new debian.AptPreference { title = "Pin the ba glob"; package = "ba*"; pin = "version 1.0"; priority = 100 }
  new debian.AptPreference { title = "Pin the bash glob"; package = "bash*"; pin = "version 2.0"; priority = 200 }
} } }
