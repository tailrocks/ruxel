// expect: 'Set the relay password': a password's answer is a secret (debian.secretAnswer(…)), never static text; a literal password would be committed to the workflow and printed in the clear
// A password entry's answer is always a secret: a literal password would
// be committed to the workflow, and the selection that carries it would
// pass it through the tracked parameters of `debconf-set-selections`.
amends "modulepath:/ruxel/Workflow.pkl"
import "modulepath:/ruxel/Debian.pkl" as debian
import "../inventory.pkl"

stages { new Stage { title = "t"; hosts = inventory.workers; steps {
  new debian.DebconfEntry {
    title = "Set the relay password"
    package = "postfix"
    question = "postfix/relay_pw"
    type = "password"
    value = "hunter2"
  }
} } }
