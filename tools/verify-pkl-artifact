#!/bin/sh
# Verify the pkl artifact Mise installed against the URL and checksum
# committed in mise.lock.
#
# The generated lanes run `mise install pkl@0.33.0` with MISE_LOCKFILE=0,
# so the install resolves metadata remotely and never consumes the
# checksum committed in mise.lock: an exact version string does not pin
# artifact identity. This gate closes that: after the install, the binary
# is hashed and compared against the committed checksum for this
# platform, and a binary that does not match is refused before any
# mandatory test executes it.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
lock="$script_dir/../mise.lock"

os=$(uname -s)
arch=$(uname -m)
case "$os" in
  Linux) platform=linux ;;
  Darwin) platform=macos ;;
  *) echo "verify-pkl-artifact: unsupported operating system: $os" >&2; exit 1 ;;
esac
case "$arch" in
  x86_64 | amd64) platform="$platform-x64" ;;
  aarch64 | arm64) platform="$platform-arm64" ;;
  *) echo "verify-pkl-artifact: unsupported architecture: $arch" >&2; exit 1 ;;
esac
# The musl slot pins a different asset than the glibc one; only Linux can
# be musl. A musl loader is the tell.
if [ "$platform" = "linux-x64" ] || [ "$platform" = "linux-arm64" ]; then
  if ldd --version 2>&1 | grep -qi musl || ls /lib/ld-musl-* >/dev/null 2>&1; then
    platform="$platform-musl"
  fi
fi

want=$(awk -v key="platforms.$platform" '
  $0 == "[tools.pkl.\"" key "\"]" { in_section = 1; next }
  /^\[/ { in_section = 0 }
  in_section && /^checksum = / { sub(/.*sha256:/, ""); sub(/".*/, ""); print; exit }
' "$lock")
if [ -z "$want" ]; then
  echo "verify-pkl-artifact: mise.lock carries no pkl checksum for $platform" >&2
  exit 1
fi

# Where Mise keeps (or just installed) the binary: the configured data
# directory first, then the default, mirroring the dual-evaluator
# discovery.
data_dirs=""
if [ -n "${MISE_DATA_DIR:-}" ]; then
  data_dirs="$MISE_DATA_DIR"
elif [ -n "${XDG_DATA_HOME:-}" ]; then
  data_dirs="$XDG_DATA_HOME/mise"
fi
if [ -n "${HOME:-}" ]; then
  data_dirs="$data_dirs $HOME/.local/share/mise"
fi

binary=""
for data in $data_dirs; do
  for candidate in "$data/installs/pkl/0.33.0/pkl" "$data/shims/pkl"; do
    if [ -f "$candidate" ]; then
      binary=$candidate
      break 2
    fi
  done
done
if [ -z "$binary" ]; then
  echo "verify-pkl-artifact: no pkl 0.33.0 install found under $data_dirs" >&2
  exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
  hasher="sha256sum"
else
  hasher="shasum -a 256"
fi
got=$($hasher < "$binary" | awk '{ print $1 }')
if [ "$got" != "$want" ]; then
  echo "verify-pkl-artifact: $binary is SHA-256 $got, not the committed $want for $platform; refusing to run it" >&2
  exit 1
fi
echo "verify-pkl-artifact: $binary matches the committed $platform checksum $want"
