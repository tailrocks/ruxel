#!/bin/sh
# Verify the pkl artifact Mise installed against the URL and checksum
# committed in mise.lock.
#
# The task install steps consume the mise.lock URL for the current
# platform (`mise install --locked` with config and lockfile re-enabled
# for the install subprocess), but an install that reports "already
# installed" never re-hashes, and a foreign binary may pre-date the
# lock-consuming install. This gate closes that: after the install, the
# binary is hashed and compared against the committed checksum for this
# platform, and a binary that does not match is refused before any
# mandatory test executes it.
#
# Exit codes:
#   0  the installed binary matches the committed checksum
#   1  the binary is missing, or its checksum does not match the
#      committed one
#   3  this platform has no official pkl artifact to verify against
#
# Code 3 is a verdict of its own: a platform upstream does not publish
# for is neither a missing nor a tampered binary, and saying so is the
# only honest answer there.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
lock="$script_dir/../mise.lock"

# The refusal for a platform with no official artifact. The message
# names the upstream fact, so the reader learns why the platform is
# refused instead of guessing at a missing or a tampered binary.
unsupported() {
  echo "verify-pkl-artifact: unsupported platform $1: $2" >&2
  exit 3
}

os=$(uname -s)
arch=$(uname -m)
case "$os" in
  Linux) platform=linux ;;
  Darwin) platform=macos ;;
  *) unsupported "os $os" "the verifier judges Linux and macOS hosts only" ;;
esac
case "$arch" in
  x86_64 | amd64) platform="$platform-x64" ;;
  aarch64 | arm64) platform="$platform-arm64" ;;
  *) unsupported "arch $arch" "the verifier judges x86_64 and aarch64 hosts only" ;;
esac
# Upstream publishes no macOS x86_64 (Intel) pkl artifact: 0.32.2 was
# the last release that carried one (pkl-macos-amd64), and 0.33.0 ships
# only pkl-macos-aarch64. There is no official build to compare an
# installed binary against, so the platform is refused before the
# lookup: an Intel Mac must never be told that its pkl is missing or
# tampered, because no official Intel build exists to be missing.
case "$platform" in
  macos-x64)
    unsupported "$platform" "official pkl ships no macOS x86_64 artifact since 0.32.2 (0.32.2's pkl-macos-amd64 was the last); for 0.33.0 only pkl-macos-aarch64 exists"
    ;;
esac
# The musl slot pins a different asset than the glibc one; only Linux can
# be musl. The ACTIVE libc decides: `ldd` speaks for the loader in use,
# while a musl loader that some toolchain merely installed beside glibc
# is not the running libc and must not reclassify the host (that
# secondary presence used to send glibc hosts to the alpine checksum,
# which then rejected the correct binary).
if [ "$platform" = "linux-x64" ] || [ "$platform" = "linux-arm64" ]; then
  if ldd --version 2>&1 | grep -qi musl; then
    platform="$platform-musl"
  fi
fi
# Alpine aarch64 has no official pkl artifact to pin either: 0.33.0
# ships pkl-alpine-linux-amd64 only (pkl-alpine-linux-aarch64 does not
# exist), and pkl-linux-aarch64 is a glibc binary that cannot start on
# a musl host. The checksum of a binary that cannot run is not a
# verdict, so the platform is refused with the same unsupported result
# as macos-x64, before the checksum lookup: a musl aarch64 host must
# never be told that its pkl is missing or tampered.
case "$platform" in
  linux-arm64-musl)
    unsupported "$platform" "official pkl ships no alpine aarch64 artifact (for 0.33.0 only pkl-alpine-linux-amd64 exists; pkl-linux-aarch64 is a glibc binary)"
    ;;
esac

want=$(awk -v key="platforms.$platform" '
  $0 == "[tools.pkl.\"" key "\"]" { in_section = 1; next }
  /^\[/ { in_section = 0 }
  in_section && /^checksum = / { sub(/.*sha256:/, ""); sub(/".*/, ""); print; exit }
' "$lock")
if [ -z "$want" ]; then
  echo "verify-pkl-artifact: mise.lock carries no pkl checksum for $platform" >&2
  exit 1
fi

# Where Mise keeps (or just installed) the binary: the configured data
# directory first, then the default, mirroring the dual-evaluator
# discovery. Each directory is one quoted positional parameter: a
# configured path may carry whitespace, and a word-split scalar would
# turn one valid directory into several candidates.
set --
if [ -n "${MISE_DATA_DIR:-}" ]; then
  set -- "$MISE_DATA_DIR"
elif [ -n "${XDG_DATA_HOME:-}" ]; then
  set -- "$XDG_DATA_HOME/mise"
fi
if [ -n "${HOME:-}" ]; then
  set -- "$@" "$HOME/.local/share/mise"
fi

binary=""
for data in "$@"; do
  for candidate in "$data/installs/pkl/0.33.0/pkl" "$data/shims/pkl"; do
    if [ -f "$candidate" ]; then
      binary="$candidate"
      break 2
    fi
  done
done
if [ -z "$binary" ]; then
  echo "verify-pkl-artifact: no pkl 0.33.0 install found under: $*" >&2
  exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
  hasher="sha256sum"
else
  hasher="shasum -a 256"
fi
got=$($hasher < "$binary" | awk '{ print $1 }')
if [ "$got" != "$want" ]; then
  echo "verify-pkl-artifact: $binary is SHA-256 $got, not the committed $want for $platform; refusing to run it" >&2
  exit 1
fi
# On success stdout carries the absolute path of the artifact just
# hashed and nothing else: verification and execution must resolve to
# one binary, so the dual-evaluator task captures this line into
# RUXEL_PKL and the suite executes exactly the hashed artifact. The
# human verdict goes to stderr, where diagnostics live.
case "$binary" in
  /*) absolute="$binary" ;;
  *) absolute="$(CDPATH= cd -- "$(dirname -- "$binary")" && pwd)/$(basename -- "$binary")" ;;
esac
echo "verify-pkl-artifact: $absolute matches the committed $platform checksum $want" >&2
echo "$absolute"
