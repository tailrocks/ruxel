import "../../schema/Ruxel.pkl" as R

fleet: R.Fleet = new R.Fleet {
  name = "slice"
  ssh = new R.Ssh {
    identityFile = "/tmp/id_ed25519"
    knownHostsFile = "/tmp/known_hosts"
  }
  hosts = new {
    ["h1"] = new R.Host {
      name = "h1"
      address = "192.0.2.10"
      resources = new {
        ["file:x"] = new R.File { path = "/tmp/x" }
        ["directory:x"] = new R.Directory { path = "/tmp/x" }
        ["packages:x"] = new R.Packages { names = new { "curl" } }
        ["service:x"] = new R.Service { unit = "example.service" }
        ["command:x"] = new R.Command { argv = new { "true" } }
      }
    }
  }
}
